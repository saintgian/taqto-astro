PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para scripts locales/servidor (npm run sync:catalog). NUNCA debe
# tener el prefijo PUBLIC_ ni usarse en codigo que corre en el navegador.
# SUPABASE_SECRET_KEY es la nomenclatura moderna de Supabase y es la
# preferida. SUPABASE_SERVICE_ROLE_KEY se acepta como fallback legado
# (ver scripts/sync-catalog.mjs) por si el dashboard del proyecto
# todavia no migro a la nueva nomenclatura.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=