---
import Footer from "../components/Footer.astro";
import WhatsAppFloatButton from "../components/WhatsAppFloatButton.astro";

interface Props {
	title: string;
	description?: string;
}

/*
 * En localhost normalmente será:
 * /taqto-astro/
 *
 * En GitHub Pages:
 * /taqto-astro/
 */
const rawBase = import.meta.env.BASE_URL;

const base = rawBase.endsWith("/")
	? rawBase
	: `${rawBase}/`;

const {
	title,
	description = "Piezas peruanas de madera y cuero con grabado láser personalizado gratuito.",
} = Astro.props;

/*
 * Este bloque se inserta sin que Vite procese las rutas.
 * Las fuentes continúan dentro de public/fonts.
 */
const fontFaceCss = `
	@font-face {
		font-family: "Poppins";
		src: url("${base}fonts/poppins-v24-latin-300.woff2") format("woff2");
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Poppins";
		src: url("${base}fonts/poppins-v24-latin-regular.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Poppins";
		src: url("${base}fonts/poppins-v24-latin-500.woff2") format("woff2");
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Poppins";
		src: url("${base}fonts/poppins-v24-latin-600.woff2") format("woff2");
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Poppins";
		src: url("${base}fonts/poppins-v24-latin-700.woff2") format("woff2");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}
`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<!--
			No es procesado por Vite.
			Las rutas conservan el BASE_URL de Astro.
		-->
		<style is:inline set:html={fontFaceCss}></style>

		<link
			rel="icon"
			type="image/svg+xml"
			href={`${base}brand/isotipo/isotipo-colorprincipal01.svg`}
		/>

		<meta
			name="description"
			content={description}
		/>

		<meta
			name="theme-color"
			content="#141414"
		/>

		<title>{title}</title>
	</head>

	<body id="top">
		<slot />

		<Footer />
		<WhatsAppFloatButton />
	</body>
</html>

<style is:global>
	:root {
		--color-black: #141414;
		--color-beige: #fff6ed;
		--color-orange: #ff4d2a;
		--color-orange-hover: #e5431f;
		--color-brown: #5b312a;
		--color-brown-hover: #472520;
		--color-white: #ffffff;

		--font-primary: "Poppins", Arial, Helvetica, sans-serif;

		--page-width: 1440px;
		--page-padding: clamp(20px, 4vw, 64px);

		/*
		 * Sistema de contenedores fluidos, tres niveles:
		 * "comercial" (1440-1520px) para fotografía, categorías,
		 * productos y galerías; "editorial" (1120-1240px) para
		 * composiciones de imagen+texto más contenidas; "lectura"
		 * para texto largo. Los bloques full bleed usan el ancho
		 * comercial como límite de su contenido interior.
		 */
		--container-comercial: 1520px;
		--container-editorial: 1200px;
		--container-lectura: 760px;
		--container-gutter: clamp(18px, 4vw, 64px);

		/*
		 * Ritmo vertical compartido entre secciones. --section-py se
		 * aplica en padding-block de cada sección estándar: al sumar
		 * el padding inferior de una sección con el superior de la
		 * siguiente da la separación real entre bloques. Las
		 * secciones full bleed estratégicas (fondo oscuro/foto que
		 * llega a los bordes) usan --section-py-strategic, que es un
		 * padding único (no se suma a un vecino del mismo tipo).
		 * --header-gap separa un encabezado de sección de su
		 * contenido.
		 */
		--section-py: clamp(18px, 3.2vw, 40px);
		--section-py-strategic: clamp(32px, 6vw, 88px);
		--header-gap: clamp(18px, 3vw, 32px);

		/*
		 * Superficie dominante: blanco. El crema queda como superficie
		 * secundaria para diferenciar puntualmente (no es el fondo base).
		 */
		--surface: var(--color-white);
		--surface-warm: var(--color-beige);

		/*
		 * Neutros derivados de --color-black para texto y bordes sobre
		 * fondo claro. No es una paleta nueva: son tintas de la tinta
		 * oficial.
		 */
		--ink-70: rgba(20, 20, 20, 0.72);
		--ink-55: rgba(20, 20, 20, 0.55);
		--ink-35: rgba(20, 20, 20, 0.35);
		--ink-15: rgba(20, 20, 20, 0.14);
		--ink-08: rgba(20, 20, 20, 0.07);

		/*
		 * Crema tintado para texto sobre fondo negro (header, footer,
		 * minicarrito). Consolida las variantes de opacidad usadas antes.
		 */
		--cream-90: rgba(255, 246, 237, 0.9);
		--cream-80: rgba(255, 246, 237, 0.8);
		--cream-70: rgba(255, 246, 237, 0.7);
		--cream-60: rgba(255, 246, 237, 0.6);
		--cream-50: rgba(255, 246, 237, 0.5);
		--cream-40: rgba(255, 246, 237, 0.4);

		/* Bordes y rellenos sobre fondo negro */
		--line-on-dark: rgba(255, 255, 255, 0.12);
		--line-on-dark-strong: rgba(255, 255, 255, 0.2);
		--fill-on-dark-1: rgba(255, 255, 255, 0.05);
		--fill-on-dark-2: rgba(255, 255, 255, 0.09);

		/*
		 * Escala tipografica fluida (clamp), reutilizable en todo el sitio.
		 * xs/sm: texto auxiliar (nunca por debajo de 14px).
		 * base/md: cuerpo y contenido editorial (17-20px).
		 * lg: H3 (22-28px). 2xl: H2 (27-42px, contenido a propósito).
		 * 3xl: H1/display (38-64px).
		 */
		--text-xs: clamp(0.875rem, 0.85rem + 0.1vw, 0.9375rem);
		--text-sm: clamp(0.9375rem, 0.9rem + 0.15vw, 1rem);
		--text-base: clamp(1.0625rem, 1.03rem + 0.15vw, 1.125rem);
		--text-md: clamp(1.125rem, 1.08rem + 0.2vw, 1.25rem);
		--text-lg: clamp(1.375rem, 1.25rem + 0.6vw, 1.75rem);
		--text-2xl: clamp(1.6875rem, 1.5rem + 1vw, 2.625rem);
		--text-3xl: clamp(2.375rem, 1.85rem + 2.4vw, 4rem);

		--leading-tight: 1.15;
		--leading-snug: 1.35;
		--leading-normal: 1.6;
		--leading-relaxed: 1.7;

		/* Espaciado con base 4/8px, con pasos fluidos donde conviene */
		--space-3xs: 4px;
		--space-2xs: 8px;
		--space-xs: 12px;
		--space-sm: 16px;
		--space-md: clamp(20px, 2.4vw, 28px);
		--space-lg: clamp(28px, 3.6vw, 40px);
		--space-xl: clamp(36px, 5vw, 64px);
		--space-2xl: clamp(52px, 7vw, 96px);

		--radius-sm: 10px;
		--radius-md: 16px;
		--radius-lg: 24px;
		--radius-full: 999px;

		/*
		 * Sistema unificado de CTA comerciales: esquinas moderadas
		 * (nunca cápsula) y altura compartida entre Hero, campaña,
		 * personalización, empresas e historia.
		 */
		--button-radius: 12px;
		--button-height: 48px;

		/* Sombras de elevacion sobrias (sin resplandor de color) */
		--shadow-sm: 0 1px 2px rgba(20, 20, 20, 0.06);
		--shadow-md: 0 10px 28px rgba(20, 20, 20, 0.1);
		--shadow-lg: 0 22px 48px rgba(20, 20, 20, 0.16);
		--shadow-dark-md: 0 14px 34px rgba(0, 0, 0, 0.3);
		--shadow-dark-lg: 0 26px 60px rgba(0, 0, 0, 0.4);

		--focus-ring: 0 0 0 3px rgba(255, 77, 42, 0.5);
		--focus-ring-on-dark: 0 0 0 3px rgba(255, 246, 237, 0.6);

		/*
		 * Movimiento: vocabulario compartido del sitio. Aqui solo se
		 * declara; cada componente adopta los tokens en su propia fase,
		 * sin refactor masivo de las duraciones ya existentes.
		 *
		 * out: entradas y salidas. in-out: lo que se desplaza en pantalla
		 * sin entrar ni salir. panel: apertura de capas ancladas.
		 */
		--ease-out: cubic-bezier(0.23, 1, 0.32, 1);
		--ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
		--ease-panel: cubic-bezier(0.32, 0.72, 0, 1);

		--dur-press: 150ms;
		--dur-exit: 160ms;
		--dur-panel: 220ms;
		--dur-content: 280ms;
		--dur-entry: 420ms;

		/*
		 * Alias con el vocabulario del manual de marca. No son colores
		 * nuevos: apuntan a los tokens que ya usaba el proyecto, para que
		 * el sistema de CTA se lea igual que el manual.
		 */
		--color-ink: var(--color-black);
		--color-cream: var(--color-beige);
		--color-accent: var(--color-orange);
		--color-brand: var(--color-brown);

		/*
		 * CTA primario: degradado vertical entre dos tonos de naranja en
		 * todos los estados. Nunca marron, nunca naranja hacia blanco.
		 */
		--cta-gradient-top: #ff6a45;
		--cta-gradient-bottom: #ff4d2a;
		--cta-hover: #ff5532;
		--cta-hover-gradient-top: #ff7655;
		--cta-active: #e94324;
		--cta-active-gradient-top: #ff5532;
		--cta-foreground-interactive: #ffffff;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background: var(--surface);
		font-family: var(--font-primary);
	}

	body {
		margin: 0;
		min-width: 320px;
		background: var(--surface);
		color: var(--color-black);
		font-family: var(--font-primary);
		font-weight: 400;
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	p,
	a,
	span,
	strong,
	small,
	label,
	button,
	input,
	textarea,
	select {
		font-family: inherit;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-weight: 600;
	}

	strong,
	b {
		font-weight: 700;
	}

	img,
	picture,
	svg,
	video {
		display: block;
		max-width: 100%;
	}

	button,
	input,
	textarea,
	select {
		font: inherit;
	}

	a {
		color: inherit;
	}

	a:not([class]) {
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;
	}

	button {
		cursor: pointer;
	}

	button:disabled,
	[aria-disabled="true"] {
		cursor: not-allowed;
		opacity: 0.5;
	}

	label {
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--ink-70);
	}

	a:focus-visible,
	button:focus-visible,
	input:focus-visible,
	textarea:focus-visible,
	select:focus-visible,
	summary:focus-visible,
	[tabindex]:focus-visible {
		outline: none;
		box-shadow: var(--focus-ring);
		border-radius: var(--radius-sm);
	}

	/*
	 * ------------------------------------------------------------------
	 * Sistema unico de botones
	 * ------------------------------------------------------------------
	 * Aqui viven la geometria y los estados. Los componentes solo aportan
	 * posicion (margen, ancho, alineacion, area de grid): no repiten
	 * fondo, color, radio ni hover. No existe un segundo sistema.
	 */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2xs);
		min-height: var(--button-height);
		padding-inline: 22px;
		border: 1px solid transparent;
		border-radius: var(--button-radius);
		color: inherit;
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color 200ms ease,
			background-image 200ms ease,
			border-color 200ms ease,
			color 200ms ease,
			transform 200ms ease,
			box-shadow 200ms ease,
			scale 105ms var(--ease-out);
	}

	.btn svg {
		width: 17px;
		height: 17px;
		flex: 0 0 auto;
	}

	/*
	 * El anillo de foco no depende del color del boton: aro claro interior
	 * + aro oscuro exterior, legible sobre fondo blanco, crema, negro o
	 * fotografia. Se declara aqui para que gane al radio de 10px que la
	 * regla generica de :focus-visible aplica a cualquier boton.
	 */
	.btn:focus-visible {
		outline: none;
		border-radius: var(--button-radius);
		box-shadow:
			0 0 0 2px var(--color-white),
			0 0 0 4px var(--color-ink);
	}

	/*
	 * Feedback de presion, compartido por todas las variantes pulsables.
	 * Usa `scale` (independiente de `transform`) para no interferir con
	 * el `translateY` de hover-lift de `.btn--primary`: ambas propiedades
	 * componen sin pisarse. La entrada usa `--dur-press` (150ms); la
	 * liberacion, al no redeclararse aqui, cae en la duracion de `scale`
	 * del `.btn` base (105ms) — mas rapida, para que soltar se sienta
	 * inmediato. No aplica ni a `:disabled` ni a `.is-loading`.
	 */
	.btn:active:not(:disabled):not([aria-disabled="true"]):not(.is-loading) {
		scale: 0.98;
		transition: scale var(--dur-press) var(--ease-out);
	}

	/* ---------- Primario: degradado vertical naranja en reposo ---------- */

	.btn--primary {
		background-color: var(--cta-gradient-bottom);
		background-image: linear-gradient(
			to bottom,
			var(--cta-gradient-top) 0%,
			var(--cta-gradient-bottom) 100%
		);
		color: var(--cta-foreground-interactive);
		border-color: transparent;
	}

	@media (hover: hover) and (pointer: fine) {
		.btn--primary:hover:not(:disabled):not([aria-disabled="true"]) {
			background-color: var(--cta-hover);
			background-image: linear-gradient(
				to bottom,
				var(--cta-hover-gradient-top) 0%,
				var(--cta-hover) 100%
			);
			color: var(--cta-foreground-interactive);
			border-color: transparent;
			transform: translateY(-1px);
			box-shadow: 0 8px 18px rgba(255, 77, 42, 0.22);
		}
	}

	.btn--primary:active:not(:disabled):not([aria-disabled="true"]) {
		background-color: var(--cta-active);
		background-image: linear-gradient(
			to bottom,
			var(--cta-active-gradient-top) 0%,
			var(--cta-active) 100%
		);
		color: var(--cta-foreground-interactive);
		border-color: transparent;
		transform: translateY(0);
		box-shadow: none;
	}

	/*
	 * Foco solo por teclado: aro naranja simple, sin el doble anillo
	 * generico de `.btn:focus-visible` (pensado para variantes claras).
	 */
	.btn--primary:focus-visible:not(:disabled):not([aria-disabled="true"]) {
		outline: 2px solid var(--cta-gradient-bottom);
		outline-offset: 3px;
		box-shadow: none;
	}

	/* ---------- Secundario ---------- */

	.btn--secondary {
		border-color: var(--ink-15);
		background: var(--surface);
		color: var(--color-ink);
		font-weight: 500;
	}

	@media (hover: hover) and (pointer: fine) {
		.btn--secondary:hover:not(:disabled):not([aria-disabled="true"]) {
			border-color: var(--ink-35);
			background: var(--ink-08);
		}
	}

	/* ---------- Terciario ---------- */

	.btn--tertiary {
		background: transparent;
		color: var(--color-ink);
		font-weight: 500;
	}

	@media (hover: hover) and (pointer: fine) {
		.btn--tertiary:hover:not(:disabled):not([aria-disabled="true"]) {
			background: var(--ink-08);
		}
	}

	/* ---------- Destructivo ---------- */

	.btn--danger {
		min-height: 44px;
		padding-inline: 8px;
		background: transparent;
		color: var(--ink-55);
		font-size: 14px;
		font-weight: 500;
	}

	.btn--danger svg {
		width: 16px;
		height: 16px;
	}

	@media (hover: hover) and (pointer: fine) {
		.btn--danger:hover:not(:disabled):not([aria-disabled="true"]) {
			background: rgba(168, 51, 26, 0.08);
			color: #a8331a;
		}
	}

	/* ---------- Solo icono ---------- */

	.btn--icon {
		width: 44px;
		min-width: 44px;
		height: 44px;
		min-height: 44px;
		padding: 0;
		gap: 0;
		border-color: var(--ink-15);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--color-ink);
	}

	@media (hover: hover) and (pointer: fine) {
		.btn--icon:hover:not(:disabled):not([aria-disabled="true"]) {
			background: var(--ink-08);
		}
	}

	.btn--icon svg {
		width: 18px;
		height: 18px;
	}

	.btn--icon:focus-visible {
		border-radius: var(--radius-sm);
	}

	/* ---------- Estados compartidos ---------- */

	.btn:disabled,
	.btn[aria-disabled="true"] {
		background-color: var(--ink-15);
		background-image: none;
		border-color: transparent;
		color: var(--ink-70);
		transform: none;
		opacity: 1;
		cursor: not-allowed;
	}

	/*
	 * Cargando: el ancho no cambia porque el texto permanece. El nombre
	 * accesible tampoco desaparece.
	 */
	.btn.is-loading {
		pointer-events: none;
		opacity: 0.72;
	}

	.btn.is-loading .btn__spinner {
		animation: btn-spin 900ms linear infinite;
	}

	@keyframes btn-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.btn--full {
		width: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		/*
		 * Reposo, hover y foco no se desplazan. `:active` queda fuera a
		 * proposito: el feedback de presion es puntual y no espacial, asi
		 * que se conserva tambien con movimiento reducido.
		 */
		.btn,
		.btn:hover,
		.btn:focus-visible {
			transform: none;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
		}
	}

	.container {
		width: min(
			calc(100% - (var(--page-padding) * 2)),
			var(--page-width)
		);
		margin-inline: auto;
	}

	.container-comercial,
	.container-editorial,
	.container-lectura {
		width: 100%;
		margin-inline: auto;
		padding-inline: var(--container-gutter);
	}

	.container-comercial {
		max-width: var(--container-comercial);
	}

	.container-editorial {
		max-width: var(--container-editorial);
	}

	.container-lectura {
		max-width: var(--container-lectura);
	}
</style>