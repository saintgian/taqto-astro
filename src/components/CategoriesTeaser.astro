---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { sanityClient } from "../lib/sanity";
import { categoryPathsQuery } from "../lib/categoryQueries";
import { ArrowRight } from "@lucide/astro";

interface Category {
	_id: string;
	title: string;
	description?: string;
	slug: string;
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const categoryImageFiles: Record<string, string> = {
	parrilla: "parrilla.webp",
	"cocina-y-mesa": "cocina-mesa.webp",
	oficina: "oficina.webp",
};

function getCategoryImageSrc(slug: string): string | undefined {
	const fileName = categoryImageFiles[slug];
	if (!fileName) return undefined;

	const absolutePath = resolve(
		process.cwd(),
		"public",
		"images",
		"home",
		"categorias",
		fileName,
	);

	if (!existsSync(absolutePath)) {
		return undefined;
	}

	return `${base}images/home/categorias/${fileName}`;
}

const categories = await sanityClient.fetch<Category[]>(
	categoryPathsQuery,
);

const featured = categories.slice(0, 3).map((category) => ({
	...category,
	imageSrc: getCategoryImageSrc(category.slug),
}));
---

{
	featured.length > 0 && (
		<section class="categories-teaser">
			<div class="categories-teaser__heading">
				<h2>
					Cada categoría, una forma distinta de
					crear.
				</h2>

				<a
					class="categories-teaser__all"
					href={`${base}categorias/`}
				>
					Ver todas las categorías
					<ArrowRight aria-hidden="true" stroke-width={1.75} />
				</a>
			</div>

			<div class="categories-teaser__grid">
				{featured.map((category) => (
					<a
						class:list={[
							"categories-teaser__card",
							!category.imageSrc &&
								"categories-teaser__card--placeholder",
						]}
						href={`${base}categorias/${category.slug}/`}
					>
						<div
							class:list={[
								"categories-teaser__image",
								!category.imageSrc &&
									"categories-teaser__image--placeholder",
							]}
						>
							{
								category.imageSrc && (
									<img
										src={category.imageSrc}
										alt=""
										aria-hidden="true"
										width="480"
										height="360"
										loading="lazy"
										decoding="async"
									/>
								)
							}
						</div>

						<div class="categories-teaser__scrim" aria-hidden="true"></div>

						<div class="categories-teaser__content">
							<h3>{category.title}</h3>

							{category.description && (
								<p>{category.description}</p>
							)}

							{
								!category.imageSrc && (
									<p class="categories-teaser__placeholder-note">
										Foto próximamente
									</p>
								)
							}

							<span class="categories-teaser__link">
								Ver colección
								<ArrowRight aria-hidden="true" stroke-width={1.75} />
							</span>
						</div>
					</a>
				))}
			</div>
		</section>
	)
}

<style>
	.categories-teaser {
		padding-block: var(--section-py);
		padding-inline: var(--container-gutter);
		background: var(--surface);
	}

	.categories-teaser__heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: clamp(16px, 3vw, 32px);
		width: min(100%, var(--container-comercial));
		margin: 0 auto var(--header-gap);
	}

	.categories-teaser__heading h2 {
		max-width: 620px;
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--color-black);
	}

	.categories-teaser__all {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		gap: 8px;
		margin-bottom: 6px;
		color: var(--color-brown);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-decoration: none;
		white-space: nowrap;
	}

	.categories-teaser__all svg {
		width: 16px;
		height: 16px;
		transition: transform 180ms ease;
	}

	.categories-teaser__all:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 4px;
		border-radius: var(--radius-sm);
	}

	@media (hover: hover) and (pointer: fine) {
		.categories-teaser__all:hover svg {
			transform: translateX(4px);
		}
	}

	.categories-teaser__grid {
		width: min(100%, var(--container-comercial));
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(20px, 2vw, 32px);
	}

	.categories-teaser__card {
		position: relative;
		aspect-ratio: 4 / 5;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		overflow: hidden;
		border: 1px solid rgba(20, 20, 20, 0.1);
		border-radius: var(--radius-lg);
		background: rgba(20, 20, 20, 0.04);
		color: var(--color-beige);
		text-decoration: none;
		transition:
			transform 220ms ease,
			box-shadow 220ms ease;
	}

	.categories-teaser__card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
	}

	.categories-teaser__card--placeholder {
		color: var(--color-black);
	}

	.categories-teaser__image {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.categories-teaser__image--placeholder {
		background:
			radial-gradient(
				circle at 20% 15%,
				rgba(255, 77, 42, 0.12),
				transparent 55%
			),
			rgba(20, 20, 20, 0.03);
	}

	.categories-teaser__image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 420ms ease;
	}

	.categories-teaser__card:hover .categories-teaser__image img {
		transform: scale(1.05);
	}

	.categories-teaser__scrim {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			180deg,
			rgba(10, 8, 7, 0) 0%,
			rgba(10, 8, 7, 0.18) 45%,
			rgba(10, 8, 7, 0.86) 100%
		);
	}

	.categories-teaser__card--placeholder .categories-teaser__scrim {
		display: none;
	}

	.categories-teaser__content {
		position: relative;
		z-index: 2;
		padding: clamp(20px, 3vw, 30px);
		text-align: left;
	}

	.categories-teaser__card h3 {
		margin: 0;
		color: #fff;
		font-size: clamp(21px, 1vw + 18px, 27px);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.categories-teaser__card p {
		max-width: 340px;
		margin: 8px 0 0;
		color: inherit;
		opacity: 0.92;
		font-size: clamp(16.5px, 0.4vw + 15.5px, 18px);
		line-height: 1.5;
	}

	.categories-teaser__placeholder-note {
		color: rgba(20, 20, 20, 0.4);
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.categories-teaser__link {
		margin-top: 12px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: inherit;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.categories-teaser__link svg {
		width: 15px;
		height: 15px;
		transition: transform 180ms ease;
	}

	.categories-teaser__card:hover .categories-teaser__link svg {
		transform: translateX(4px);
	}

	@media (max-width: 1024px) and (min-width: 769px) {
		.categories-teaser__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.categories-teaser__card:first-child {
			grid-column: 1 / -1;
			aspect-ratio: 16 / 9;
		}
	}

	@media (max-width: 768px) {
		.categories-teaser__heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 10px;
		}

		.categories-teaser__all {
			margin-bottom: 0;
		}

		.categories-teaser__grid {
			grid-template-columns: 1fr;
		}

		.categories-teaser__card {
			aspect-ratio: 4 / 3.1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.categories-teaser__card,
		.categories-teaser__image img,
		.categories-teaser__link svg {
			transition: none;
		}
	}
</style>
