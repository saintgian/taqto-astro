---
import { sanityClient } from "../lib/sanity";
import { featuredProductsQuery } from "../lib/featuredProductsQuery";
import ProductCard from "./ProductCard.astro";
import { ArrowRight } from "@lucide/astro";

interface Product {
	_id: string;
	title: string;
	slug: string;
	[key: string]: unknown;
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const products = await sanityClient.fetch<Product[]>(
	featuredProductsQuery,
);
---

{
	products.length > 0 && (
		<section class="featured-products">
			<div class="featured-products__heading">
				<h2>Productos destacados</h2>

				<a
					class="featured-products__all"
					href={`${base}tienda/`}
				>
					Ver tienda
					<ArrowRight aria-hidden="true" stroke-width={1.75} />
				</a>
			</div>

			<div class="featured-products__grid">
				{products.map((product) => (
					<ProductCard product={product} hoverGallery />
				))}
			</div>
		</section>
	)
}

<style>
	.featured-products {
		padding-block: var(--home-section-py);
		padding-inline: var(--container-gutter);
		background: var(--surface);
	}

	.featured-products__heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: clamp(16px, 3vw, 32px);
		width: min(100%, var(--container-comercial));
		margin: 0 auto var(--home-header-gap);
	}

	.featured-products__heading h2 {
		margin: 0;
		font-size: var(--home-title);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--color-black);
	}

	.featured-products__all {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		gap: 8px;
		margin-bottom: 6px;
		color: var(--color-brown);
		font-size: 14.4px;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-decoration: none;
		white-space: nowrap;
	}

	.featured-products__all svg {
		width: 16px;
		height: 16px;
		transition: transform 180ms ease;
	}

	.featured-products__all:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 4px;
		border-radius: var(--radius-sm);
	}

	@media (hover: hover) and (pointer: fine) {
		.featured-products__all:hover svg {
			transform: translateX(4px);
		}
	}

	.featured-products__grid {
		width: min(100%, var(--container-comercial));
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--home-gap);
	}

	/*
	 * Contexto de la vitrina destacada: menos texto, precio con más
	 * presencia. No se toca ProductCard.astro para no romper /tienda.
	 */
	.featured-products__grid :global(.product-card__description) {
		display: none;
	}

	.featured-products__grid :global(.product-card__price) {
		font-size: 15.5px;
	}

	.featured-products__grid :global(.product-card__information + .product-card__bottom) {
		margin-top: 12px;
	}

	@media (max-width: 1100px) {
		.featured-products__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.featured-products {
			padding-inline: 20px;
		}

		.featured-products__heading {
			flex-wrap: wrap;
		}

		.featured-products__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--home-gap);
		}
	}

	@media (max-width: 480px) {
		.featured-products__heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 10px;
		}

		.featured-products__all {
			margin-bottom: 0;
		}
	}

	@media (max-width: 480px) {
		.featured-products__grid {
			grid-template-columns: 1fr;
			max-width: 360px;
		}
	}

	/*
	 * Revelado al entrar en viewport (solo primera vez), con escalonado
	 * limitado a los primeros cuatro productos. El JS solo agrega
	 * `is-pending` a las tarjetas que no son visibles en la carga
	 * inicial, asi que sin JavaScript ninguna tarjeta queda oculta.
	 */
	.featured-products__grid > :global(.product-card.is-pending) {
		opacity: 0;
		transform: translateY(26px);
		transition:
			opacity 660ms var(--ease-out),
			transform 660ms var(--ease-out);
	}

	.featured-products__grid
		> :global(.product-card.is-pending.is-inview) {
		opacity: 1;
		transform: translateY(0);
	}

	.featured-products__grid
		> :global(.product-card):nth-child(2).is-pending {
		transition-delay: 65ms;
	}

	.featured-products__grid
		> :global(.product-card):nth-child(3).is-pending {
		transition-delay: 130ms;
	}

	.featured-products__grid
		> :global(.product-card):nth-child(4).is-pending {
		transition-delay: 195ms;
	}

	@media (max-width: 760px) {
		.featured-products__grid > :global(.product-card.is-pending) {
			transform: translateY(14px);
			transition-duration: 520ms;
		}

		.featured-products__grid
			> :global(.product-card):nth-child(2).is-pending {
			transition-delay: 45ms;
		}

		.featured-products__grid
			> :global(.product-card):nth-child(3).is-pending {
			transition-delay: 90ms;
		}

		.featured-products__grid
			> :global(.product-card):nth-child(4).is-pending {
			transition-delay: 135ms;
		}
	}
</style>

<script>
	const revealItems = document.querySelectorAll<HTMLElement>(
		".featured-products__grid > .product-card",
	);

	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (
		!prefersReducedMotion &&
		revealItems.length > 0 &&
		"IntersectionObserver" in window
	) {
		const viewportHeight = window.innerHeight;

		const pending = Array.from(revealItems).filter((el) => {
			const rect = el.getBoundingClientRect();
			return rect.top >= viewportHeight || rect.bottom <= 0;
		});

		pending.forEach((el) => el.classList.add("is-pending"));

		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-inview");
						obs.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.18 },
		);

		pending.forEach((el) => observer.observe(el));
	}
</script>
