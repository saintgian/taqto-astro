---
import { sanityClient } from "../lib/sanity";
import { featuredProductsQuery } from "../lib/featuredProductsQuery";
import ProductCard from "./ProductCard.astro";

interface Product {
	_id: string;
	title: string;
	slug: string;
	[key: string]: unknown;
}

const products = await sanityClient.fetch<Product[]>(
	featuredProductsQuery,
);
---

{
	products.length > 0 && (
		<section class="featured-products">
			<div class="featured-products__heading">
				<h2>Productos destacados</h2>
			</div>

			<div class="featured-products__grid">
				{products.map((product) => (
					<ProductCard product={product} />
				))}
			</div>
		</section>
	)
}

<style>
	.featured-products {
		padding-block: clamp(28px, 8.5vw, 36px);
		padding-inline: var(--page-padding);
		background: var(--surface);
	}

	.featured-products__heading {
		width: min(100%, 1560px);
		margin: 0 auto clamp(20px, 2.5vw, 32px);
		text-align: center;
	}

	.featured-products__heading h2 {
		margin: 0;
		font-size: clamp(1.8125rem, 1.5rem + 1.5vw, 2.875rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--color-black);
	}

	.featured-products__grid {
		width: min(100%, 1560px);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 26px;
	}

	@media (min-width: 768px) {
		.featured-products {
			padding-block: clamp(36px, 5.2vw, 44px);
		}
	}

	@media (min-width: 1024px) {
		.featured-products {
			padding-block: clamp(48px, 3.4vw, 56px);
		}
	}

	@media (max-width: 1100px) {
		.featured-products__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.featured-products__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 18px;
		}
	}

	@media (max-width: 480px) {
		.featured-products__grid {
			grid-template-columns: 1fr;
			max-width: 360px;
		}
	}
</style>
