---
import { sanityClient } from "../lib/sanity";
import { featuredProductsQuery } from "../lib/featuredProductsQuery";
import ProductCard from "./ProductCard.astro";

interface Product {
	_id: string;
	title: string;
	slug: string;
	[key: string]: unknown;
}

const products = await sanityClient.fetch<Product[]>(
	featuredProductsQuery,
);
---

{
	products.length > 0 && (
		<section class="featured-products">
			<div class="featured-products__heading">
				<p class="featured-products__eyebrow">
					Selección TAQTO
				</p>

				<h2>Productos destacados</h2>
			</div>

			<div class="featured-products__grid">
				{products.map((product) => (
					<ProductCard product={product} />
				))}
			</div>
		</section>
	)
}

<style>
	.featured-products {
		padding:
			clamp(50px, 7vw, 90px)
			var(--page-padding)
			clamp(70px, 9vw, 130px);
		background: var(--color-beige);
	}

	.featured-products__heading {
		width: min(100%, var(--page-width));
		margin: 0 auto clamp(32px, 4vw, 52px);
		text-align: center;
	}

	.featured-products__eyebrow {
		margin: 0 0 12px;
		color: var(--color-orange);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.featured-products__heading h2 {
		margin: 0;
		font-size: clamp(28px, 3.6vw, 44px);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--color-black);
	}

	.featured-products__grid {
		width: min(100%, var(--page-width));
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 26px;
	}

	@media (max-width: 1100px) {
		.featured-products__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.featured-products__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 18px;
		}
	}

	@media (max-width: 480px) {
		.featured-products__grid {
			grid-template-columns: 1fr;
			max-width: 360px;
		}
	}
</style>
