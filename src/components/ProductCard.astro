---
import {
	formatPEN,
	getProductPriceRange,
	isSaleActive,
} from "../lib/productPricing";

import {
	urlForImage,
} from "../lib/sanity";

interface Props {
	product: any;
}

const {
	product,
} = Astro.props;

const plainTextFromBlocks = (
	blocks?: any[],
): string =>
	(blocks || [])
		.filter((block) => block._type === "block")
		.map((block) =>
			(block.children || [])
				.map((child: any) => child.text || "")
				.join(""),
		)
		.join(" ")
		.trim();

const cardDescription = plainTextFromBlocks(
	product.shortDescription,
);

const base = import.meta.env.BASE_URL;

const productHref =
	`${base}productos/${product.slug}/`;

const mainImage =
	product.gallery?.[0];

const imageUrl = mainImage
	? urlForImage(mainImage)
			.width(900)
			.height(1200)
			.fit("crop")
			.auto("format")
			.url()
	: "";

const imageAlt =
	mainImage?.alt ||
	product.title ||
	"Producto TAQTO";

const priceRange =
	getProductPriceRange(product);

const saleActive =
	isSaleActive(
		product.saleStart,
		product.saleEnd,
	);

const hasAnySale =
	saleActive &&
	(
		typeof product.uniqueProduct?.salePrice ===
			"number" ||
		product.variants?.some(
			(variant: any) =>
				variant.active !== false &&
				typeof variant.salePrice ===
					"number",
		)
	);

const modeLabels: Record<string, string> = {
	unique: "Pieza única",
	wood: "Elige la madera",
	size: "Elige el tamaño",
	woodSize: "Madera y tamaño",
};
---

<article class="product-card">
	<a
		class="product-card__media"
		href={productHref}
		aria-label={`Ver ${product.title}`}
	>
		{
			imageUrl ? (
				<img
					src={imageUrl}
					alt={imageAlt}
					width="900"
					height="1200"
					loading="lazy"
					decoding="async"
				/>
			) : (
				<div class="product-card__placeholder">
					<span>TAQTO</span>
					<small>Imagen pendiente</small>
				</div>
			)
		}

		<div class="product-card__badges">
			{
				hasAnySale && (
					<span
						class="
							product-card__badge
							product-card__badge--sale
						"
					>
						Oferta
					</span>
				)
			}

			{
				product.productMode &&
					product.productMode !== "unique" && (
						<span class="product-card__badge">
							{
								modeLabels[
									product.productMode
								] || "Varias opciones"
							}
						</span>
					)
			}
		</div>

		<span
			class="product-card__arrow"
			aria-hidden="true"
		>
			→
		</span>
	</a>

	<div class="product-card__content">
		<div class="product-card__information">
			<p class="product-card__category">
				{
					product.subcategory?.title ||
						product.category?.title ||
						"TAQTO"
				}
			</p>

			<h2 class="product-card__title">
				<a href={productHref}>
					{product.title}
				</a>
			</h2>

			{
				cardDescription && (
					<p class="product-card__description">
						{cardDescription}
					</p>
				)
			}
		</div>

		<div class="product-card__bottom">
			<p class="product-card__price">
				{
					priceRange.minimum > 0
						? priceRange.hasRange
							? `Desde ${formatPEN(
									priceRange.minimum,
								)}`
							: formatPEN(
									priceRange.minimum,
								)
						: "Precio por consultar"
				}
			</p>

			<a
				class="product-card__link"
				href={productHref}
			>
				Ver producto
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</article>

<style>
	.product-card {
		display: flex;
		min-width: 0;
		height: 100%;
		flex-direction: column;
	}

	.product-card__media {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border: 1px solid rgba(20, 20, 20, 0.07);
		border-radius: 20px;
		background: #ffffff;
		color: inherit;
		text-decoration: none;
		isolation: isolate;
	}

	.product-card__media img {
		display: block;
		width: 100%;
		height: 100%;
		padding: clamp(10px, 1.4vw, 16px);
		background: #ffffff;
		object-fit: contain;
		object-position: center;
		transition:
			transform 450ms
			cubic-bezier(0.22, 1, 0.36, 1);
	}

	.product-card__placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		place-content: center;
		gap: 7px;
		padding: 24px;
		color: #5b312a;
		text-align: center;
	}

	.product-card__placeholder span {
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.product-card__placeholder small {
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		opacity: 0.6;
	}

	.product-card__badges {
		position: absolute;
		z-index: 2;
		top: 13px;
		left: 13px;
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: 6px;
		pointer-events: none;
	}

	.product-card__badge {
		padding: 7px 10px;
		border: 1px solid
			rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: rgba(20, 20, 20, 0.88);
		color: #fff6ed;
		font-size: 9px;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		box-shadow:
			0 5px 18px
			rgba(20, 20, 20, 0.08);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	.product-card__badge--sale {
		background: #ff4d2a;
	}

	.product-card__arrow {
		position: absolute;
		z-index: 2;
		right: 13px;
		bottom: 13px;
		display: grid;
		width: 40px;
		height: 40px;
		place-items: center;
		border: 1px solid
			rgba(255, 255, 255, 0.3);
		border-radius: 50%;
		background: rgba(20, 20, 20, 0.9);
		color: #fff6ed;
		font-size: 16px;
		line-height: 1;
		opacity: 0;
		transform: translateY(6px);
		box-shadow:
			0 8px 24px
			rgba(20, 20, 20, 0.12);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition:
			transform 200ms ease,
			opacity 200ms ease,
			background-color 200ms ease;
	}

	.product-card__content {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 16px 3px 0;
	}

	.product-card__information {
		min-width: 0;
	}

	.product-card__category {
		margin: 0 0 7px;
		color: #ff4d2a;
		font-size: 10px;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.product-card__title {
		margin: 0;
		font-size: clamp(20px, 1.75vw, 25px);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.03em;
	}

	.product-card__title a {
		color: #141414;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.product-card__description {
		display: -webkit-box;
		overflow: hidden;
		margin: 10px 0 0;
		color: rgba(20, 20, 20, 0.72);
		font-size: 14px;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.product-card__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin-top: auto;
		padding-top: 16px;
		border-top: 1px solid
			rgba(20, 20, 20, 0.1);
	}

	.product-card__information
		+ .product-card__bottom {
		margin-top: 17px;
	}

	.product-card__price {
		margin: 0;
		color: #141414;
		font-size: 14px;
		font-weight: 700;
		line-height: 1.3;
	}

	.product-card__link {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		gap: 8px;
		color: #141414;
		font-size: 10px;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.product-card__link span {
		font-size: 14px;
		transition: transform 180ms ease;
	}

	.product-card__media:focus-visible,
	.product-card__title a:focus-visible,
	.product-card__link:focus-visible {
		outline: 2px solid #ff4d2a;
		outline-offset: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.product-card:hover
			.product-card__media img {
			transform: scale(1.018);
		}

		.product-card:hover
			.product-card__arrow {
			opacity: 1;
			transform: translateY(0);
			background: #5b312a;
		}

		.product-card__title a:hover {
			color: #5b312a;
		}

		.product-card__link:hover span {
			transform: translateX(4px);
		}
	}

	@media (max-width: 900px) {
		.product-card__media {
			border-radius: 18px;
		}

		.product-card__content {
			padding-top: 15px;
		}

		.product-card__bottom {
			align-items: flex-end;
		}

		.product-card__link {
			font-size: 9px;
		}
	}

	@media (max-width: 600px) {
		.product-card__media {
			border-radius: 16px;
		}

		.product-card__media img {
			padding: 13px;
		}

		.product-card__arrow {
			right: 11px;
			bottom: 11px;
			width: 38px;
			height: 38px;
			opacity: 1;
			transform: none;
		}

		.product-card__badges {
			top: 11px;
			left: 11px;
		}

		.product-card__badge {
			padding: 6px 9px;
			font-size: 8px;
		}

		.product-card__content {
			padding: 14px 2px 0;
		}

		.product-card__category {
			margin-bottom: 6px;
			font-size: 9px;
		}

		.product-card__title {
			font-size: clamp(18px, 5.5vw, 22px);
			line-height: 1.14;
		}

		.product-card__description {
			margin-top: 8px;
			font-size: 14px;
			line-height: 1.5;
		}

		.product-card__bottom {
			gap: 10px;
			padding-top: 14px;
		}

		.product-card__information
			+ .product-card__bottom {
			margin-top: 15px;
		}

		.product-card__price {
			font-size: 13px;
		}

		.product-card__link {
			gap: 6px;
			font-size: 8px;
			letter-spacing: 0.06em;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.product-card__media img,
		.product-card__arrow,
		.product-card__link span,
		.product-card__title a {
			transition: none;
		}
	}
</style>