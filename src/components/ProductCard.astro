---
import {
	formatPEN,
	getProductPriceRange,
	isSaleActive,
} from "../lib/productPricing";

import {
	urlForImage,
} from "../lib/sanity";

interface Props {
	product: any;
	hoverGallery?: boolean;
}

const {
	product,
	hoverGallery = false,
} = Astro.props;

const plainTextFromBlocks = (
	blocks?: any[],
): string =>
	(blocks || [])
		.filter((block) => block._type === "block")
		.map((block) =>
			(block.children || [])
				.map((child: any) => child.text || "")
				.join(""),
		)
		.join(" ")
		.trim();

const cardDescription = plainTextFromBlocks(
	product.shortDescription,
);

const base = import.meta.env.BASE_URL;

const productHref =
	`${base}productos/${product.slug}/`;

const mainImage =
	product.gallery?.[0];

const imageUrl = mainImage
	? urlForImage(mainImage)
			.width(900)
			.height(1200)
			.fit("crop")
			.auto("format")
			.url()
	: "";

const imageAlt =
	mainImage?.alt ||
	product.title ||
	"Producto TAQTO";

const secondaryImage = product.gallery?.[1];

const secondaryImageUrl = secondaryImage
	? urlForImage(secondaryImage)
			.width(900)
			.height(1200)
			.fit("crop")
			.auto("format")
			.url()
	: "";

const hasHoverGallery =
	hoverGallery &&
	Boolean(secondaryImageUrl) &&
	secondaryImageUrl !== imageUrl;

const priceRange =
	getProductPriceRange(product);

const saleActive =
	isSaleActive(
		product.saleStart,
		product.saleEnd,
	);

const hasAnySale =
	saleActive &&
	(
		typeof product.uniqueProduct?.salePrice ===
			"number" ||
		product.variants?.some(
			(variant: any) =>
				variant.active !== false &&
				typeof variant.salePrice ===
					"number",
		)
	);

const modeLabels: Record<string, string> = {
	unique: "Pieza única",
	wood: "Elige la madera",
	size: "Elige el tamaño",
	woodSize: "Madera y tamaño",
};
---

<article class="product-card">
	<a
		class:list={[
			"product-card__media",
			{ "product-card__media--hover-gallery": hasHoverGallery },
		]}
		href={productHref}
		aria-label={`Ver ${product.title}`}
	>
		{
			imageUrl ? (
				<img
					class="product-card__image product-card__image--primary"
					src={imageUrl}
					alt={imageAlt}
					width="900"
					height="1200"
					loading="lazy"
					decoding="async"
				/>
			) : (
				<div class="product-card__placeholder">
					<span>TAQTO</span>
					<small>Imagen pendiente</small>
				</div>
			)
		}

		{
			hasHoverGallery && (
				<img
					class="product-card__image product-card__image--secondary"
					src={secondaryImageUrl}
					alt=""
					width="900"
					height="1200"
					loading="lazy"
					decoding="async"
					aria-hidden="true"
				/>
			)
		}

		<div class="product-card__badges">
			{
				hasAnySale && (
					<span
						class="
							product-card__badge
							product-card__badge--sale
						"
					>
						Oferta
					</span>
				)
			}

			{
				product.productMode &&
					product.productMode !== "unique" && (
						<span class="product-card__badge">
							{
								modeLabels[
									product.productMode
								] || "Varias opciones"
							}
						</span>
					)
			}
		</div>
	</a>

	<div class="product-card__content">
		<div class="product-card__information">
			<p class="product-card__category">
				{
					product.subcategory?.title ||
						product.category?.title ||
						"TAQTO"
				}
			</p>

			<h2 class="product-card__title">
				<a href={productHref}>
					{product.title}
				</a>
			</h2>

			{
				cardDescription && (
					<p class="product-card__description">
						{cardDescription}
					</p>
				)
			}
		</div>

		<div class="product-card__bottom">
			<p class="product-card__price">
				{
					priceRange.minimum > 0
						? priceRange.hasRange
							? `Desde ${formatPEN(
									priceRange.minimum,
								)}`
							: formatPEN(
									priceRange.minimum,
								)
						: "Precio por consultar"
				}
			</p>

			<a
				class="btn btn--primary product-card__link"
				href={productHref}
			>
				Ver producto
			</a>
		</div>
	</div>
</article>

<style>
	.product-card {
		display: grid;
		min-width: 0;
		height: 100%;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		border: 1px solid rgba(20, 20, 20, 0.12);
		border-radius: 14px;
		background: #ffffff;
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease,
			transform 240ms var(--ease-out);
	}

	.product-card__media {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #ffffff;
		color: inherit;
		text-decoration: none;
		isolation: isolate;
	}

	.product-card__media img {
		display: block;
		width: 100%;
		height: 100%;
		padding: clamp(16px, 2.2vw, 26px);
		object-fit: contain;
		object-position: center;
		transition: transform 240ms var(--ease-out);
	}

	.product-card__placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		place-content: center;
		gap: 7px;
		padding: 24px;
		color: #5b312a;
		text-align: center;
	}

	.product-card__placeholder span {
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.product-card__placeholder small {
		font-size: 10px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		opacity: 0.6;
	}

	.product-card__badges {
		position: absolute;
		z-index: 2;
		top: 13px;
		left: 13px;
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: 6px;
		pointer-events: none;
	}

	.product-card__badge {
		padding: 7px 10px;
		border: 1px solid
			rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: rgba(20, 20, 20, 0.88);
		color: #fff6ed;
		font-size: 9px;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		box-shadow:
			0 5px 18px
			rgba(20, 20, 20, 0.08);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	.product-card__badge--sale {
		background: #ff4d2a;
	}

	.product-card__content {
		display: flex;
		height: 100%;
		flex-direction: column;
		padding: clamp(16px, 1.6vw, 18px);
	}

	.product-card__information {
		min-width: 0;
	}

	.product-card__category {
		margin: 0 0 6px;
		color: #ff4d2a;
		font-size: clamp(10.5px, 0.85vw, 11.5px);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.product-card__title {
		margin: 0;
		font-size: clamp(14.75px, 1.35vw, 17px);
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.02em;
	}

	.product-card__title a {
		color: #141414;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.product-card__description {
		display: -webkit-box;
		overflow: hidden;
		margin: 8px 0 0;
		color: rgba(20, 20, 20, 0.68);
		font-size: clamp(13.5px, 0.86vw, 14.4px);
		line-height: 1.45;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.product-card__bottom {
		display: flex;
		min-height: 52px;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
		padding-top: 14px;
		border-top: 1px solid
			rgba(20, 20, 20, 0.1);
	}

	.product-card__price {
		margin: 0;
		color: #141414;
		font-size: clamp(16.5px, 1.24vw, 18.4px);
		font-weight: 700;
		line-height: 1.2;
	}

	/*
	 * Solo posicion y escala compacta de tarjeta: color y estados vienen
	 * de `.btn--primary`.
	 */
	.product-card__link {
		flex-shrink: 0;
		min-height: 40px;
		padding-inline: 16px;
		font-size: clamp(12.25px, 0.83vw, 13.2px);
	}

	.product-card__media--hover-gallery img {
		position: absolute;
		inset: 0;
	}

	.product-card__image--primary {
		opacity: 1;
	}

	.product-card__image--secondary {
		opacity: 0;
	}

	.product-card__media--hover-gallery img {
		transition: opacity 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	@media (hover: hover) and (pointer: fine) {
		.product-card__media--hover-gallery:hover
			.product-card__image--primary,
		.product-card__media--hover-gallery:focus-within
			.product-card__image--primary {
			opacity: 0;
		}

		.product-card__media--hover-gallery:hover
			.product-card__image--secondary,
		.product-card__media--hover-gallery:focus-within
			.product-card__image--secondary {
			opacity: 1;
		}
	}

	/*
	 * Vista previa tactil: activada por JS via pointerdown/up/cancel/leave
	 * (solo pointerType "touch"), no por CSS `:hover`, asi que funciona
	 * igual en dispositivos hibridos con mouse y pantalla tactil.
	 */
	.product-card__media--hover-gallery.is-touch-preview
		.product-card__image--primary {
		opacity: 0;
	}

	.product-card__media--hover-gallery.is-touch-preview
		.product-card__image--secondary {
		opacity: 1;
	}

	.product-card:focus-within {
		border-color: #ff4d2a;
	}

	.product-card__media:focus-visible,
	.product-card__title a:focus-visible {
		outline: 2px solid #ff4d2a;
		outline-offset: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.product-card:hover {
			border-color: rgba(20, 20, 20, 0.28);
			box-shadow: 0 1px 2px rgba(20, 20, 20, 0.06);
			transform: translateY(-4px);
		}

		.product-card:hover
			.product-card__media img {
			transform: scale(1.025);
		}

		.product-card__title a:hover {
			color: #5b312a;
		}
	}

	@media (max-width: 600px) {
		.product-card__media img {
			padding: 14px;
		}

		.product-card__badges {
			top: 11px;
			left: 11px;
		}

		.product-card__badge {
			padding: 6px 9px;
			font-size: 8px;
		}

		.product-card__content {
			padding: 16px;
		}

		.product-card__description {
			margin-top: 8px;
		}

		.product-card__bottom {
			flex-wrap: wrap;
			gap: 10px;
			padding-top: 14px;
		}

		.product-card__link {
			min-height: 44px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.product-card,
		.product-card__media img,
		.product-card__link,
		.product-card__title a {
			transition: none;
		}
	}
</style>

<script>
	/*
	 * Vista previa tactil de la segunda imagen: solo pointerType "touch",
	 * asi que mouse y teclado siguen su propio camino (hover / focus-within
	 * en CSS). Sin preventDefault en ningun punto: el scroll vertical y el
	 * tap que abre la ficha no se tocan. Cuando el gesto se convierte en
	 * scroll el navegador dispara "pointercancel" antes del "click", asi
	 * que la vista se cierra sola y no hay navegacion accidental.
	 */
	const bindTouchPreview = (
		media: HTMLElement,
	) => {
		if (media.dataset.touchPreviewBound === "true") return;
		media.dataset.touchPreviewBound = "true";

		const show = (event: PointerEvent) => {
			if (event.pointerType !== "touch") return;
			media.classList.add("is-touch-preview");
		};

		const hide = () => {
			media.classList.remove("is-touch-preview");
		};

		media.addEventListener("pointerdown", show);
		media.addEventListener("pointerup", hide);
		media.addEventListener("pointercancel", hide);
		media.addEventListener("pointerleave", hide);
	};

	const initTouchPreviews = () => {
		document
			.querySelectorAll<HTMLElement>(
				".product-card__media--hover-gallery",
			)
			.forEach(bindTouchPreview);
	};

	initTouchPreviews();
	document.addEventListener("astro:page-load", initTouchPreviews);

	// Red de seguridad: ninguna tarjeta debe volver de una navegacion (o de
	// la cache del navegador al ir atras) con la imagen secundaria pegada.
	document.addEventListener("astro:before-swap", () => {
		document
			.querySelectorAll(".is-touch-preview")
			.forEach((element) => {
				element.classList.remove("is-touch-preview");
			});
	});
</script>
