---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { ArrowRight } from "@lucide/astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const historyHref = `${base}nosotros/`;

const originImagePath = resolve(
	process.cwd(),
	"public",
	"images",
	"home",
	"historia",
	"origen-taqto.webp",
);

const originImageSrc = existsSync(originImagePath)
	? `${base}images/home/historia/origen-taqto.webp`
	: undefined;

const originMobileImagePath = resolve(
	process.cwd(),
	"public",
	"images",
	"home",
	"historia",
	"origen-taqto-mobile.webp",
);

const originMobileImageSrc = existsSync(originMobileImagePath)
	? `${base}images/home/historia/origen-taqto-mobile.webp`
	: originImageSrc;

const features = [
	{
		number: "01",
		title: "Tradición",
		description:
			"Conocimiento transmitido a través del oficio, la experiencia y el respeto por la materia.",
	},
	{
		number: "02",
		title: "Ingeniería",
		description:
			"Proporción, funcionalidad y precisión aplicadas al diseño de cada pieza.",
	},
	{
		number: "03",
		title: "Tecnología",
		description:
			"Herramientas contemporáneas que elevan el oficio sin perder su origen artesanal.",
	},
];
---

<section
	class:list={[
		"origin",
		originImageSrc && "origin--has-image",
	]}
	style={
		originImageSrc
			? `--origin-image-desktop: url(${originImageSrc}); --origin-image-mobile: url(${originMobileImageSrc});`
			: undefined
	}
>
	<div class="origin__inner">
		<div class="origin__text">
			<h2>
				Diseño que nace con tradición
			</h2>

			<p class="origin__description">
				TAQTO nace del oficio de trabajar la madera
				con paciencia y precisión. Hoy combinamos ese
				conocimiento artesanal con ingeniería y
				tecnología para crear piezas hechas para
				acompañar tu día a día.
			</p>

			<a class="btn btn--primary origin__cta" href={historyHref}>
				<span>Conoce nuestra historia</span>
				<ArrowRight aria-hidden="true" stroke-width={1.75} />
			</a>

			<div class="origin__divider"></div>

			<p class="origin__tagline">
				El legado continúa en cada pieza.
			</p>
		</div>

		<aside class="origin__stat" data-origin-stat>
			<p class="origin__stat-label">Más de</p>

			<p class="origin__stat-number">
				<span
					data-counter-target="20"
					data-counter-current="0"
				>
					0
				</span>
			</p>

			<p class="origin__stat-caption">
				años de tradición
			</p>

			<div class="origin__stat-divider"></div>

			<ul class="origin__stat-list">
				{features.map((feature) => (
					<li>
						<span class="origin__stat-index">
							{feature.number}
						</span>

						<div>
							<strong>{feature.title}</strong>
							<p>{feature.description}</p>
						</div>
					</li>
				))}
			</ul>
		</aside>
	</div>
</section>

<script>
	const initOriginCounters = () => {
		const counters =
			document.querySelectorAll<HTMLElement>(
				"[data-counter-target]",
			);

		if (!counters.length) return;

		const animateCounter = (el: HTMLElement) => {
			if (el.dataset.counterDone === "true") return;
			el.dataset.counterDone = "true";

			const target = Number(
				el.dataset.counterTarget || "0",
			);

			const duration = 1400;
			const start = performance.now();

			const step = (now: number) => {
				const progress = Math.min(
					(now - start) / duration,
					1,
				);

				const eased =
					1 - Math.pow(1 - progress, 3);

				el.textContent = String(
					Math.round(target * eased),
				);

				if (progress < 1) {
					requestAnimationFrame(step);
				}
			};

			requestAnimationFrame(step);
		};

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						animateCounter(
							entry.target as HTMLElement,
						);
					}
				});
			},
			{ threshold: 0.5 },
		);

		counters.forEach((counter) =>
			observer.observe(counter),
		);
	};

	initOriginCounters();

	document.addEventListener(
		"astro:page-load",
		initOriginCounters,
	);
</script>

<style>
	.origin {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(
				circle at 15% 20%,
				rgba(255, 77, 42, 0.16),
				transparent 55%
			),
			var(--color-black);
		color: var(--color-beige);
	}

	.origin--has-image {
		background-image: var(--origin-image-desktop);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.origin--has-image::before {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(
				circle at 15% 20%,
				rgba(255, 77, 42, 0.16),
				transparent 55%
			),
			linear-gradient(
				100deg,
				rgba(20, 15, 12, 0.82) 0%,
				rgba(20, 15, 12, 0.5) 28%,
				rgba(20, 15, 12, 0.14) 48%,
				rgba(20, 15, 12, 0) 64%
			);
		content: "";
	}

	.origin__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--container-comercial);
		margin-inline: auto;
		padding-block: clamp(40px, 5vw, 72px);
		padding-inline: var(--container-gutter);
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.85fr);
		gap: clamp(28px, 4vw, 56px);
		align-items: center;
	}

	@media (min-width: 901px) {
		.origin__inner {
			min-height: clamp(360px, 22vw, 480px);
		}
	}

	.origin__text h2 {
		margin: 0;
		font-size: var(--home-title);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.origin__description {
		max-width: 460px;
		margin: 12px 0 0;
		color: rgba(255, 246, 237, 0.78);
		font-size: var(--home-intro);
		line-height: 1.6;
	}

	/* Solo posicion: color, geometria y estados vienen de `.btn--primary`. */
	.origin__cta {
		margin-top: 24px;
		width: fit-content;
	}

	.origin__cta svg {
		width: 17px;
		height: 17px;
		transition: transform 180ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.origin__cta:hover svg {
			transform: translateX(4px);
		}
	}

	.origin__divider {
		margin-top: 24px;
		height: 1px;
		background: rgba(255, 255, 255, 0.14);
	}

	.origin__tagline {
		margin: 18px 0 0;
		color: rgba(255, 246, 237, 0.5);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.origin__stat {
		padding: clamp(20px, 2.4vw, 28px);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 22px;
		background: rgba(20, 15, 12, 0.38);
		backdrop-filter: blur(3px);
	}

	.origin__stat-label {
		margin: 0;
		color: rgba(255, 246, 237, 0.5);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.origin__stat-number {
		margin: 6px 0 0;
		font-size: clamp(46px, 5.5vw, 68px);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--color-orange);
	}

	.origin__stat-caption {
		margin: 4px 0 0;
		font-size: 14px;
		font-weight: 600;
		color: rgba(255, 246, 237, 0.8);
	}

	.origin__stat-divider {
		margin: 18px 0;
		height: 1px;
		background: rgba(255, 255, 255, 0.14);
	}

	.origin__stat-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.origin__stat-list li {
		display: flex;
		gap: 14px;
	}

	.origin__stat-index {
		flex-shrink: 0;
		color: var(--color-orange);
		font-size: 12px;
		font-weight: 700;
	}

	.origin__stat-list strong {
		display: block;
		margin-bottom: 4px;
		font-size: 14px;
		font-weight: 700;
	}

	.origin__stat-list p {
		margin: 0;
		color: rgba(255, 246, 237, 0.68);
		font-size: 14px;
		line-height: 1.55;
	}

	@media (max-width: 900px) {
		.origin__inner {
			grid-template-columns: 1fr;
			padding-block: clamp(32px, 8vw, 56px);
		}

		.origin--has-image {
			background-image: var(--origin-image-mobile, var(--origin-image-desktop));
		}

		/*
		 * En una sola columna, el texto queda siempre arriba de la
		 * fotografía. El overlay se localiza detrás del texto (mas
		 * oscuro arriba, mas claro hacia el panel de estadisticas)
		 * en vez de oscurecer la imagen de forma pareja.
		 */
		.origin--has-image::before {
			background:
				radial-gradient(
					circle at 15% 20%,
					rgba(255, 77, 42, 0.16),
					transparent 55%
				),
				linear-gradient(
					180deg,
					rgba(16, 12, 10, 0.84) 0%,
					rgba(16, 12, 10, 0.48) 32%,
					rgba(16, 12, 10, 0.14) 56%,
					rgba(16, 12, 10, 0.22) 100%
				);
		}

		.origin__stat {
			background: rgba(20, 15, 12, 0.42);
		}
	}

	@media (max-width: 600px) {
		.origin--has-image {
			background-position: 70% 20%;
		}
	}
</style>
