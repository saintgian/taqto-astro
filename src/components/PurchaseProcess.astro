---
import {
	ArrowRight,
	Search,
	SlidersHorizontal,
	ClipboardCheck,
	PackageCheck,
} from "@lucide/astro";

interface PurchaseLink {
	label: string;
	href: string;
}

interface Props {
	links?: PurchaseLink[];
}

const { links = [] } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const findLink = (label: string) =>
	links.find(
		(link) =>
			link.label === label &&
			link.href?.trim().length > 0,
	);

const shippingLink = findLink("Envíos");
const faqLink = findLink("Preguntas frecuentes");

const steps = [
	{
		number: "01",
		title: "Elige tu pieza",
		description:
			"Explora el catálogo y encuentra el diseño que mejor se adapte a tu espacio, uso o regalo.",
		cta: { label: "Ver tienda", href: `${base}tienda/` },
		icon: Search,
		modifier: "search",
	},
	{
		number: "02",
		title: "Define la personalización",
		description:
			"Selecciona las opciones disponibles y añade el nombre, frase o imagen que quieras grabar.",
		cta: {
			label: "Ver personalización",
			href: "#personalization-title",
		},
		icon: SlidersHorizontal,
		modifier: "customize",
	},
	{
		number: "03",
		title: "Confirmamos los detalles",
		description:
			"Revisamos la información necesaria para preparar correctamente tu pieza antes de producirla.",
		cta: faqLink
			? { label: "Ver preguntas frecuentes", href: faqLink.href }
			: undefined,
		icon: ClipboardCheck,
		modifier: "confirm",
	},
	{
		number: "04",
		title: "Preparamos y enviamos",
		description:
			"Trabajamos tu pedido, lo embalamos con cuidado y coordinamos el envío correspondiente.",
		cta: shippingLink
			? { label: "Ver envíos", href: shippingLink.href }
			: undefined,
		icon: PackageCheck,
		modifier: "ship",
	},
];

const auxLinks = links.filter(
	(link) =>
		(link.label === "Cuidados" || link.label === "Garantía") &&
		link.label?.trim().length > 0 &&
		link.href?.trim().length > 0,
);
---

<section
	class="purchase-process"
	aria-labelledby="purchase-process-title"
>
	<div class="purchase-process__container">
		<header class="purchase-process__header">
			<h2 id="purchase-process-title">
				De tu elección a tu entrega
			</h2>

			<p class="purchase-process__intro">
				Un proceso claro para que sepas qué ocurre
				desde que eliges tu pieza hasta que la recibes.
			</p>
		</header>

		<ol class="purchase-process__steps">
			{
				steps.map((step) => {
					const CardTag = step.cta ? "a" : "div";
					const Icon = step.icon;

					return (
						<li
							class="purchase-process__step"
							data-reveal-item
						>
							<CardTag
								class:list={[
									"purchase-process__card",
									`purchase-process__card--${step.modifier}`,
								]}
								href={step.cta?.href}
							>
								<span
									class="purchase-process__icon"
									aria-hidden="true"
								>
									<Icon stroke-width={1.6} />
									<span class="purchase-process__number">
										{step.number}
									</span>
								</span>

								<h3>{step.title}</h3>
								<p>{step.description}</p>

								{
									step.cta && (
										<span class="purchase-process__action">
											<span class="purchase-process__action-label">
												{step.cta.label}
											</span>
											<span
												class="purchase-process__arrow"
												aria-hidden="true"
											>
												<ArrowRight stroke-width={1.75} />
											</span>
										</span>
									)
								}
							</CardTag>
						</li>
					);
				})
			}
		</ol>

		{
			auxLinks.length > 0 && (
				<p class="purchase-process__aux">
					También puede interesarte:{" "}
					{auxLinks.map((link, index) => (
						<>
							<a href={link.href}>{link.label}</a>
							{index < auxLinks.length - 1 && (
								<span aria-hidden="true"> · </span>
							)}
						</>
					))}
				</p>
			)
		}
	</div>
</section>

<script>
	const revealItems = document.querySelectorAll<HTMLElement>(
		".purchase-process__step[data-reveal-item]",
	);

	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (
		!prefersReducedMotion &&
		revealItems.length > 0 &&
		"IntersectionObserver" in window
	) {
		const viewportHeight = window.innerHeight;

		const pending = Array.from(revealItems).filter((el) => {
			const rect = el.getBoundingClientRect();
			return rect.top >= viewportHeight || rect.bottom <= 0;
		});

		pending.forEach((el) => el.classList.add("is-pending"));

		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-inview");
						obs.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.18 },
		);

		pending.forEach((el) => observer.observe(el));
	}
</script>

<style>
	.purchase-process {
		padding-block: var(--home-section-py);
		padding-inline: var(--container-gutter);
		background: var(--surface);
		color: var(--color-black);
	}

	.purchase-process__container {
		width: min(100%, var(--container-comercial));
		margin-inline: auto;
	}

	.purchase-process__header {
		max-width: 62ch;
		margin-bottom: var(--home-header-gap);
	}

	.purchase-process__header h2 {
		margin: 0;
		color: var(--color-black);
		font-size: var(--home-title);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.purchase-process__intro {
		max-width: 60ch;
		margin: 10px 0 0;
		color: var(--ink-70);
		font-size: var(--home-intro);
		line-height: 1.6;
	}

	.purchase-process__steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--home-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.purchase-process__step {
		height: 100%;
	}

	.purchase-process__card {
		position: relative;
		display: flex;
		height: 100%;
		flex-direction: column;
		min-width: 0;
		padding: clamp(20px, 1.4vw, 26px);
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 200ms ease,
			background-color 200ms ease,
			scale 150ms var(--ease-out);
	}

	.purchase-process__icon {
		position: relative;
		display: grid;
		width: 44px;
		height: 44px;
		flex: 0 0 auto;
		place-items: center;
		margin: 0 0 14px;
		border: 1px solid var(--ink-15);
		border-radius: 50%;
		background: var(--ink-08);
		color: var(--color-brown);
		transition:
			transform 200ms var(--ease-out),
			border-color 200ms ease,
			background-color 200ms ease;
	}

	.purchase-process__icon svg {
		width: 20px;
		height: 20px;
	}

	.purchase-process__number {
		position: absolute;
		right: -4px;
		bottom: -4px;
		display: grid;
		width: 17px;
		height: 17px;
		place-items: center;
		border: 1px solid var(--ink-15);
		border-radius: 50%;
		background: var(--surface);
		color: var(--color-brown);
		font-size: 8.5px;
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.purchase-process__card h3 {
		margin: 0;
		color: var(--color-black);
		font-size: var(--home-card-title);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
		transition: color 200ms ease;
	}

	.purchase-process__card p {
		margin: 8px 0 0;
		color: var(--ink-70);
		font-size: var(--home-card-body);
		line-height: 1.55;
	}

	.purchase-process__action {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: auto;
		padding-top: 18px;
	}

	.purchase-process__action-label {
		color: var(--color-brown);
		font-size: clamp(14px, 0.2vw + 13.7px, 16px);
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.purchase-process__arrow {
		display: inline-flex;
		width: 42px;
		height: 42px;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--ink-15);
		border-radius: 50%;
		background: transparent;
		color: var(--color-black);
		transition:
			transform 200ms ease,
			border-color 200ms ease,
			background-color 200ms ease;
	}

	.purchase-process__arrow svg {
		width: 18px;
		height: 18px;
	}

	.purchase-process__card:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 3px;
		border-color: var(--ink-35);
		background: var(--ink-08);
	}

	.purchase-process__card:focus-visible h3 {
		color: var(--color-brown);
	}

	.purchase-process__card:focus-visible .purchase-process__arrow {
		border-color: var(--color-brown);
		background: var(--surface);
	}

	@media (hover: hover) and (pointer: fine) {
		.purchase-process__card:hover {
			border-color: var(--ink-35);
			background: var(--ink-08);
		}

		.purchase-process__card:hover h3 {
			color: var(--color-brown);
		}

		.purchase-process__card:hover .purchase-process__arrow {
			border-color: var(--color-brown);
			background: var(--surface);
		}

		.purchase-process__card--search:hover .purchase-process__icon {
			border-color: rgba(255, 77, 42, 0.45);
			background: var(--surface);
			transform: translateY(-2px) scale(1.04) translateX(2px);
		}

		.purchase-process__card--customize:hover .purchase-process__icon {
			border-color: rgba(255, 77, 42, 0.45);
			background: var(--surface);
			transform: translateY(-2px) scale(1.04) rotate(3deg);
		}

		.purchase-process__card--confirm:hover .purchase-process__icon {
			border-color: rgba(255, 77, 42, 0.45);
			background: var(--surface);
			transform: translateY(-2px) scale(1.08);
		}

		.purchase-process__card--ship:hover .purchase-process__icon {
			border-color: rgba(255, 77, 42, 0.45);
			background: var(--surface);
			transform: translateY(-2px) scale(1.04) translateX(3px);
		}
	}

	a.purchase-process__card:active {
		scale: 0.98;
	}

	@media (prefers-reduced-motion: no-preference) {
		.purchase-process__card:hover .purchase-process__arrow,
		.purchase-process__card:focus-visible .purchase-process__arrow {
			transform: translateX(3px);
		}
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.purchase-process__card {
			transition:
				border-color 200ms ease,
				background-color 200ms ease,
				transform 200ms ease,
				scale 150ms var(--ease-out);
		}

		.purchase-process__card:hover {
			transform: translateY(-2px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.purchase-process__card--search:hover .purchase-process__icon,
		.purchase-process__card--customize:hover .purchase-process__icon,
		.purchase-process__card--confirm:hover .purchase-process__icon,
		.purchase-process__card--ship:hover .purchase-process__icon {
			transform: none;
		}

		a.purchase-process__card:active {
			scale: 1;
		}
	}

	.purchase-process__aux {
		margin: clamp(24px, 2.4vw, 32px) 0 0;
		padding-top: 20px;
		border-top: 1px solid var(--ink-15);
		color: var(--ink-70);
		font-size: 14px;
	}

	.purchase-process__aux a {
		color: var(--color-brown);
		font-weight: 700;
		text-decoration: none;
	}

	.purchase-process__aux a:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 3px;
		border-radius: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.purchase-process__aux a:hover {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}
	}

	@media (max-width: 920px) {
		.purchase-process__steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--home-gap);
		}
	}

	@media (max-width: 640px) {
		.purchase-process {
			padding-inline: 20px;
		}

		.purchase-process__header {
			margin-bottom: var(--home-header-gap);
		}

		.purchase-process__steps {
			grid-template-columns: 1fr;
			gap: var(--home-gap);
		}

		.purchase-process__aux {
			margin-top: var(--home-gap);
		}
	}

	/*
	 * Revelado por tarjeta al entrar en viewport (solo primera vez). El
	 * JS solo agrega `is-pending` a las tarjetas que no son visibles en
	 * la carga inicial, asi que sin JavaScript ninguna queda oculta.
	 */
	.purchase-process__step.is-pending {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 520ms var(--ease-out),
			transform 520ms var(--ease-out);
	}

	.purchase-process__step.is-pending.is-inview {
		opacity: 1;
		transform: translateY(0);
	}

	.purchase-process__step:nth-child(2).is-pending {
		transition-delay: 60ms;
	}

	.purchase-process__step:nth-child(3).is-pending {
		transition-delay: 120ms;
	}

	.purchase-process__step:nth-child(4).is-pending {
		transition-delay: 180ms;
	}

	/*
	 * Entrada propia del icono, mas corta que la de la tarjeta y
	 * desacoplada de la transicion de hover (usa `animation`).
	 */
	@keyframes purchase-process-icon-in {
		from {
			opacity: 0;
			transform: translateY(6px) scale(0.94);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	.purchase-process__step.is-pending .purchase-process__icon {
		opacity: 0;
	}

	.purchase-process__step.is-pending.is-inview .purchase-process__icon {
		animation: purchase-process-icon-in 300ms var(--ease-out) 40ms both;
	}
</style>
