---
interface WoodGuideImage {
	src: string;
	alt: string;
	width: number;
	height: number;
}

interface WoodGuideItem {
	id: string;
	name: string;
	description?: string;
	image?: WoodGuideImage;
}

interface Props {
	woods?: WoodGuideItem[];
}

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const getWoodImage = (fileName: string): string =>
	`${base}images/home/maderas/${fileName}`;

/*
 * =========================================================
 * CONTENIDO EDITABLE DE LAS MADERAS
 * =========================================================
 *
 * Para modificar los textos, cambia únicamente:
 *
 * name: nombre mostrado en las cards y como título.
 * description: descripción visible en el panel de detalle.
 * alt: descripción accesible de la imagen.
 *
 * No cambies id ni el nombre del archivo salvo que también
 * renombres la imagen dentro de public/images/home/maderas/.
 */

const defaultWoods: WoodGuideItem[] = [
	{
		id: "huayruro",
		name: "Huayruro",

		// TEXTO EDITABLE: descripción del Huayruro
		description:
			"Madera de expresión marcada y variaciones naturales que hacen que cada pieza tenga una apariencia única.",

		image: {
			src: getWoodImage("huayruro.webp"),

			// TEXTO EDITABLE: descripción accesible de la imagen
			alt: "Detalle de la veta natural de la madera Huayruro utilizada por TAQTO",

			// Cambia estas medidas si conoces las dimensiones reales.
			width: 1600,
			height: 1280,
		},
	},
	{
		id: "pumaquiro",
		name: "Pumaquiro",

		// TEXTO EDITABLE: descripción del Pumaquiro
		description:
			"Madera de apariencia cálida y veta natural, seleccionada para crear piezas funcionales y visualmente equilibradas.",

		image: {
			src: getWoodImage("pumaquiro.webp"),

			// TEXTO EDITABLE: descripción accesible de la imagen
			alt: "Detalle de la veta natural de la madera Pumaquiro utilizada por TAQTO",

			width: 1600,
			height: 1280,
		},
	},
	{
		id: "shihuahuaco",
		name: "Shihuahuaco",

		// TEXTO EDITABLE: descripción del Shihuahuaco
		description:
			"Madera de presencia sólida y veta definida, con variaciones naturales de tono entre una pieza y otra.",

		image: {
			src: getWoodImage("shihuahuaco.webp"),

			// TEXTO EDITABLE: descripción accesible de la imagen
			alt: "Detalle de la veta natural de la madera Shihuahuaco utilizada por TAQTO",

			width: 1600,
			height: 1280,
		},
	},
	{
		id: "cachimbo",
		name: "Cachimbo",

		// TEXTO EDITABLE: descripción del Cachimbo
		description:
			"Madera de tonalidad cálida y apariencia natural, adecuada para piezas de diseño limpio y uso cotidiano.",

		image: {
			src: getWoodImage("cachimbo.webp"),

			// TEXTO EDITABLE: descripción accesible de la imagen
			alt: "Detalle de la veta natural de la madera Cachimbo utilizada por TAQTO",

			width: 1600,
			height: 1280,
		},
	},
	{
		id: "teca",
		name: "Teca",

		// TEXTO EDITABLE: descripción de la Teca
		description:
			"Madera de apariencia cálida y veta reconocible, utilizada para crear piezas sobrias y funcionales.",

		image: {
			src: getWoodImage("teca.webp"),

			// TEXTO EDITABLE: descripción accesible de la imagen
			alt: "Detalle de la veta natural de la madera Teca utilizada por TAQTO",

			width: 1600,
			height: 1280,
		},
	},
];

const { woods = [] } = Astro.props;

/*
 * Si la página envía datos mediante la prop `woods`, se combinan con
 * `defaultWoods` (por `id`) para conservar imagen y descripción locales
 * aunque la página solo especifique `id` y `name`. Si no envía nada,
 * se utilizan directamente los datos anteriores.
 */
const defaultWoodsById = new Map(
	defaultWoods.map((wood) => [wood.id, wood]),
);

const sourceWoods: WoodGuideItem[] =
	woods.length > 0
		? woods.map((wood) => {
				const fallback = defaultWoodsById.get(wood.id);

				return {
					...fallback,
					...wood,
					description: wood.description ?? fallback?.description,
					image: wood.image ?? fallback?.image,
				};
			})
		: defaultWoods;

const visibleWoods = sourceWoods.filter(
	(wood) => wood.id?.trim() && wood.name?.trim(),
);

const safeId = (value: string): string =>
	value
		.toLowerCase()
		.trim()
		.replace(/[^a-z0-9-_]+/g, "-")
		.replace(/^-+|-+$/g, "");

const componentId = `wood-guide-${safeId(
	visibleWoods[0]?.id || "materials",
)}`;

const panelId = `${componentId}-panel`;
const firstWood = visibleWoods[0];
---

{
	visibleWoods.length > 0 && (
		<section
			class="wood-guide"
			aria-labelledby={`${componentId}-title`}
			data-wood-guide
		>
			<div class="wood-guide__container">
				<header class="wood-guide__header">
					<p class="wood-guide__eyebrow">
						Materiales TAQTO
					</p>

					<div class="wood-guide__heading">
						<h2 id={`${componentId}-title`}>
							Conoce nuestras maderas
						</h2>

						<p>
							Explora las especies disponibles
							en nuestras piezas.
						</p>
					</div>
				</header>

				<div
					class="wood-guide__selector"
					role="tablist"
					aria-label="Selecciona una especie de madera"
					data-wood-selector
				>
					{
						visibleWoods.map((wood, index) => {
							const tabId = `${componentId}-tab-${index}`;

							return (
								<button
									id={tabId}
									class="wood-guide__card"
									type="button"
									role="tab"
									aria-selected={index === 0 ? "true" : "false"}
									aria-controls={panelId}
									tabindex={index === 0 ? 0 : -1}
									data-wood-tab
									data-wood-tab-index={index}
									data-wood-name={wood.name}
									data-wood-description={wood.description || ""}
									data-wood-image-src={wood.image?.src || ""}
									data-wood-image-alt={wood.image?.alt || ""}
									data-wood-image-width={wood.image?.width || ""}
									data-wood-image-height={wood.image?.height || ""}
								>
									<span class="wood-guide__card-name">
										{wood.name}
									</span>
								</button>
							);
						})
					}
				</div>

				<article
					id={panelId}
					class="wood-guide__panel"
					aria-live="polite"
					data-wood-panel
				>
					<div class="wood-guide__media" data-wood-media>
						{
							firstWood?.image ? (
								<img
									data-wood-media-img
									src={firstWood.image.src}
									alt={firstWood.image.alt}
									width={firstWood.image.width}
									height={firstWood.image.height}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div
									class="wood-guide__placeholder"
									data-wood-placeholder
								>
									<span>Foto próximamente</span>
								</div>
							)
						}
					</div>

					<div class="wood-guide__content">
						<p class="wood-guide__selected-label">
							Madera seleccionada
						</p>

						<h3 data-wood-name-output>
							{firstWood?.name}
						</h3>

						<p
							class="wood-guide__description"
							data-wood-description-output
						>
							{firstWood?.description}
						</p>
					</div>
				</article>
			</div>
		</section>
	)
}

<script>
	const initializeWoodGuide = () => {
		const sections = document.querySelectorAll<HTMLElement>(
			"[data-wood-guide]",
		);

		sections.forEach((section) => {
			if (section.dataset.initialized === "true") {
				return;
			}

			section.dataset.initialized = "true";

			const tabs = Array.from(
				section.querySelectorAll<HTMLButtonElement>(
					"[data-wood-tab]",
				),
			);

			const panel = section.querySelector<HTMLElement>(
				"[data-wood-panel]",
			);

			if (tabs.length === 0 || !panel) {
				return;
			}

			const mediaContainer = panel.querySelector<HTMLElement>(
				"[data-wood-media]",
			);
			const nameOutput = panel.querySelector<HTMLElement>(
				"[data-wood-name-output]",
			);
			const descriptionOutput = panel.querySelector<HTMLElement>(
				"[data-wood-description-output]",
			);

			const renderPanel = (tab: HTMLButtonElement) => {
				const {
					woodName,
					woodDescription,
					woodImageSrc,
					woodImageAlt,
					woodImageWidth,
					woodImageHeight,
				} = tab.dataset;

				if (nameOutput) {
					nameOutput.textContent = woodName || "";
				}

				if (descriptionOutput) {
					descriptionOutput.textContent = woodDescription || "";
				}

				if (mediaContainer) {
					// Astro aplica los estilos con ámbito mediante un atributo
					// data-astro-cid-* generado en build. Los elementos creados
					// aquí en runtime deben heredarlo del contenedor o quedan
					// fuera del alcance de los estilos del componente.
					const scopeAttr = Array.from(
						mediaContainer.attributes,
					).find((attr) => attr.name.startsWith("data-astro-cid-"));

					if (woodImageSrc) {
						mediaContainer.innerHTML = "";

						const img = document.createElement("img");
						img.setAttribute("data-wood-media-img", "");
						img.src = woodImageSrc;
						img.alt = woodImageAlt || "";
						img.loading = "lazy";
						img.decoding = "async";

						if (woodImageWidth) {
							img.width = Number(woodImageWidth);
						}

						if (woodImageHeight) {
							img.height = Number(woodImageHeight);
						}

						if (scopeAttr) {
							img.setAttribute(scopeAttr.name, scopeAttr.value);
						}

						mediaContainer.appendChild(img);
					} else {
						mediaContainer.innerHTML = "";

						const placeholder = document.createElement("div");
						placeholder.className = "wood-guide__placeholder";
						placeholder.setAttribute("data-wood-placeholder", "");

						if (scopeAttr) {
							placeholder.setAttribute(
								scopeAttr.name,
								scopeAttr.value,
							);
						}

						const span = document.createElement("span");
						span.textContent = "Foto próximamente";

						if (scopeAttr) {
							span.setAttribute(scopeAttr.name, scopeAttr.value);
						}

						placeholder.appendChild(span);

						mediaContainer.appendChild(placeholder);
					}
				}
			};

			const activateTab = (
				index: number,
				moveFocus = false,
			) => {
				const normalizedIndex =
					((index % tabs.length) + tabs.length) % tabs.length;

				tabs.forEach((tab, tabIndex) => {
					const isSelected = tabIndex === normalizedIndex;

					tab.setAttribute(
						"aria-selected",
						isSelected ? "true" : "false",
					);

					tab.setAttribute(
						"tabindex",
						isSelected ? "0" : "-1",
					);
				});

				renderPanel(tabs[normalizedIndex]);

				if (moveFocus) {
					tabs[normalizedIndex]?.focus();
				}
			};

			tabs.forEach((tab, index) => {
				tab.addEventListener("click", () => {
					activateTab(index);
				});

				tab.addEventListener("keydown", (event) => {
					let nextIndex: number | null = null;

					switch (event.key) {
						case "ArrowRight":
						case "ArrowDown":
							nextIndex = index + 1;
							break;

						case "ArrowLeft":
						case "ArrowUp":
							nextIndex = index - 1;
							break;

						case "Home":
							nextIndex = 0;
							break;

						case "End":
							nextIndex = tabs.length - 1;
							break;
					}

					if (nextIndex === null) {
						return;
					}

					event.preventDefault();
					activateTab(nextIndex, true);
				});
			});
		});
	};

	initializeWoodGuide();

	document.addEventListener(
		"astro:page-load",
		initializeWoodGuide,
	);
</script>

<style>
	.wood-guide {
		padding:
			clamp(64px, 8vw, 130px)
			var(--page-padding);
		background: #ffffff;
		color: var(--color-black);
	}

	.wood-guide__container {
		width: min(100%, var(--page-width));
		margin-inline: auto;
	}

	.wood-guide__header {
		display: grid;
		grid-template-columns:
			minmax(0, 0.42fr)
			minmax(0, 1fr);
		align-items: end;
		gap: clamp(24px, 5vw, 80px);
		margin-bottom: clamp(32px, 4vw, 52px);
	}

	.wood-guide__eyebrow {
		margin: 0 0 8px;
		color: var(--color-orange);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.wood-guide__heading h2 {
		max-width: 780px;
		margin: 0;
		color: var(--color-black);
		font-size: clamp(30px, 4.4vw, 56px);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

	.wood-guide__heading > p {
		max-width: 480px;
		margin: 14px 0 0;
		color: rgba(20, 20, 20, 0.64);
		font-size: 14.5px;
		line-height: 1.6;
	}

	.wood-guide__selector {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: clamp(10px, 1.4vw, 16px);
		margin-bottom: clamp(30px, 4vw, 48px);
	}

	.wood-guide__card {
		display: flex;
		min-width: 0;
		min-height: 44px;
		align-items: center;
		justify-content: center;
		padding: 12px 8px;
		border: 0;
		border-bottom: 2px solid rgba(20, 20, 20, 0.1);
		background: transparent;
		font: inherit;
		text-align: center;
		cursor: pointer;
		transition: border-color 180ms ease;
	}

	.wood-guide__card-name {
		min-width: 0;
		overflow: hidden;
		color: rgba(20, 20, 20, 0.6);
		font-size: 14px;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-overflow: ellipsis;
		white-space: nowrap;
		transition: color 180ms ease;
	}

	.wood-guide__card[aria-selected="true"] {
		border-bottom-color: var(--color-brown);
	}

	.wood-guide__card[aria-selected="true"] .wood-guide__card-name {
		color: var(--color-black);
	}

	.wood-guide__card:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.wood-guide__card:hover {
			border-bottom-color: rgba(91, 49, 42, 0.4);
		}

		.wood-guide__card:hover .wood-guide__card-name {
			color: var(--color-black);
		}
	}

	.wood-guide__panel {
		display: grid;
		grid-template-columns:
			minmax(0, 1.18fr)
			minmax(0, 0.82fr);
		align-items: center;
		gap: clamp(36px, 5vw, 90px);
	}

	.wood-guide__media {
		min-width: 0;
		overflow: hidden;
		border-radius: 22px;
		background: var(--color-beige);
	}

	.wood-guide__media img {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		object-fit: contain;
		object-position: center;
	}

	.wood-guide__placeholder {
		display: grid;
		width: 100%;
		aspect-ratio: 5 / 4;
		place-items: center;
		border: 1px dashed rgba(20, 20, 20, 0.22);
		border-radius: 22px;
		background: rgba(20, 20, 20, 0.03);
	}

	.wood-guide__placeholder span {
		color: rgba(20, 20, 20, 0.35);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.wood-guide__content {
		min-width: 0;
		max-width: 520px;
	}

	.wood-guide__selected-label {
		margin: 0;
		color: var(--color-orange);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.wood-guide__content h3 {
		margin: 10px 0 0;
		color: var(--color-black);
		font-size: clamp(30px, 3.8vw, 48px);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

	.wood-guide__description {
		margin: 18px 0 0;
		color: rgba(20, 20, 20, 0.68);
		font-size: 14.5px;
		line-height: 1.6;
	}

	@media (max-width: 960px) {
		.wood-guide__header {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.wood-guide__selector {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.wood-guide__panel {
			grid-template-columns: 1fr;
			gap: 28px;
		}

		.wood-guide__content {
			max-width: 640px;
		}
	}

	@media (max-width: 680px) {
		.wood-guide {
			padding: 64px 18px;
		}

		.wood-guide__header {
			margin-bottom: 26px;
		}

		.wood-guide__heading h2 {
			font-size: clamp(30px, 10vw, 42px);
		}

		.wood-guide__selector {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.wood-guide__card:last-child:nth-child(odd) {
			grid-column: 1 / -1;
		}

		.wood-guide__media {
			border-radius: 16px;
		}

		.wood-guide__content h3 {
			font-size: 32px;
		}
	}
</style>
