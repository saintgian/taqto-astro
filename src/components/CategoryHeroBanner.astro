---
import { existsSync } from "node:fs";
import { resolve } from "node:path";

interface Props {
	categorySlug: string;
	eyebrow?: string;
	title: string;
	description?: string;
	count: number;
	countLabel: string;
}

const {
	categorySlug,
	eyebrow,
	title,
	description,
	count,
	countLabel,
} = Astro.props;

const base = import.meta.env.BASE_URL;

interface CategoryHeroTheme {
	/**
	 * Nombre de archivo dentro de public/images/banner categories/.
	 * Si existe en disco, tiene prioridad absoluta sobre `fallbackFile`.
	 */
	independentImage?: string;
	/** Ruta relativa a public/images/home/, usada como fallback (imagen ya vista en la home). */
	fallbackFile: string;
	/** object-position del <img> en desktop. */
	objectPosition: string;
	/** object-position del <img> en mobile (opcional, si el encuadre necesita ajustarse). */
	objectPositionMobile?: string;
	alt: string;
	/** Variante de overlay: cada una tiene su propio gradiente/filtro definido en <style>. */
	overlay: "warm-dark" | "warm-light" | "cool-dark" | "neutral-dark";
	/** Intensidad del overlay central, 0-1. 1 = valores base de la variante. */
	overlayIntensity?: number;
}

// Una identidad visual por categoria. "parrilla" usa su fotografia
// independiente (public/images/banner categories/parrilla-banner.webp);
// las demas conservan la fotografia ya usada en la home como fallback
// hasta que existan imagenes propias en esa carpeta. No se inventan rutas.
const categoryHeroThemes: Record<string, CategoryHeroTheme> = {
	parrilla: {
		independentImage: "parrilla-banner.webp",
		fallbackFile: "categorias/parrilla.webp",
		objectPosition: "50% 32%",
		objectPositionMobile: "50% 28%",
		alt: "Brasas encendidas y carne a la parrilla junto a una tabla TAQTO",
		overlay: "warm-dark",
		overlayIntensity: 1,
	},
	"cocina-y-mesa": {
		fallbackFile: "categorias/cocina-mesa.webp",
		objectPosition: "50% 68%",
		alt: "Tabla TAQTO servida con quesos y fiambres sobre una mesa luminosa",
		overlay: "warm-light",
		overlayIntensity: 1,
	},
	oficina: {
		fallbackFile: "categorias/oficina.webp",
		objectPosition: "50% 55%",
		alt: "Escritorio de madera organizado con un soporte para celular TAQTO",
		overlay: "cool-dark",
		overlayIntensity: 1,
	},
	empresas: {
		fallbackFile: "empresas-regalos-corporativos.webp",
		objectPosition: "45% 55%",
		alt: "Pedido corporativo de tablas TAQTO personalizadas y envueltas para regalo",
		overlay: "neutral-dark",
		overlayIntensity: 1,
	},
};

function getCategoryHeroImage(
	slug: string,
): { src: string; theme: CategoryHeroTheme } | null {
	const theme = categoryHeroThemes[slug];
	if (!theme) return null;

	if (theme.independentImage) {
		const independentAbsolutePath = resolve(
			process.cwd(),
			"public",
			"images",
			"banner categories",
			theme.independentImage,
		);

		if (existsSync(independentAbsolutePath)) {
			return {
				src: `${base}images/${encodeURI("banner categories")}/${theme.independentImage}`,
				theme,
			};
		}
	}

	const fallbackAbsolutePath = resolve(
		process.cwd(),
		"public",
		"images",
		"home",
		theme.fallbackFile,
	);

	if (!existsSync(fallbackAbsolutePath)) return null;

	return {
		src: `${base}images/home/${theme.fallbackFile}`,
		theme,
	};
}

const hero = getCategoryHeroImage(categorySlug);
const overlayIntensity = hero?.theme.overlayIntensity ?? 1;
---

<header
	class:list={[
		"theme-hero",
		`theme-hero--${categorySlug}`,
		{ "theme-hero--has-image": Boolean(hero) },
		hero ? `theme-hero--overlay-${hero.theme.overlay}` : undefined,
	]}
	style={`--hero-overlay-intensity: ${overlayIntensity};`}
>
	{
		hero && (
			<div class="theme-hero__image">
				<img
					src={hero.src}
					alt=""
					aria-hidden="true"
					width="1600"
					height="900"
					loading="eager"
					decoding="async"
					style={`object-position: ${hero.theme.objectPosition}; --hero-object-position-mobile: ${hero.theme.objectPositionMobile || hero.theme.objectPosition};`}
				/>
			</div>
		)
	}

	<div class="theme-hero__content">
		{
			eyebrow && (
				<p class="theme-hero__eyebrow">{eyebrow}</p>
			)
		}

		<h1>{title}</h1>

		{
			description && (
				<p class="theme-hero__description">
					{description}
				</p>
			)
		}

		<p class="theme-hero__count">
			<strong>{count}</strong>
			<span>{countLabel}</span>
		</p>
	</div>
</header>

<style>
	.theme-hero {
		position: relative;
		width: min(100%, 1450px);
		height: clamp(320px, 26vw, 400px);
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		padding-inline: clamp(24px, 4vw, 60px);
		border-radius: 18px 22px;
		background:
			radial-gradient(
				circle at 50% 0%,
				rgba(255, 255, 255, 0.05),
				transparent 60%
			),
			#141414;
		color: #fff6ed;
		text-align: center;
	}

	.theme-hero__image {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.theme-hero__image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.045);
		animation: theme-hero-zoom 12s ease-out forwards;
	}

	/* Vinieta suave en bordes + oscurecimiento central detras del texto,
	   la fotografia permanece visible. */
	.theme-hero__image::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: radial-gradient(
			ellipse 70% 65% at 50% 50%,
			rgba(8, 6, 5, calc(0.4 * var(--hero-overlay-intensity, 1))) 0%,
			rgba(8, 6, 5, calc(0.12 * var(--hero-overlay-intensity, 1))) 55%,
			transparent 80%
		);
	}

	.theme-hero__image::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(10, 8, 7, calc(0.42 * var(--hero-overlay-intensity, 1))) 0%,
			rgba(10, 8, 7, calc(0.22 * var(--hero-overlay-intensity, 1))) 40%,
			rgba(10, 8, 7, calc(0.72 * var(--hero-overlay-intensity, 1))) 100%
		);
	}

	@keyframes theme-hero-zoom {
		from {
			transform: scale(1.045);
		}

		to {
			transform: scale(1);
		}
	}

	.theme-hero__content {
		position: relative;
		z-index: 2;
		max-width: 780px;
		margin-inline: auto;
	}

	/* Frase superior: elemento editorial dominante, sin capsula ni fondo. */
	.theme-hero__eyebrow {
		width: min(88%, 1050px);
		margin: 0 auto 16px;
		color: #fff6ed;
		font-size: clamp(16px, 1.55vw, 24px);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: clamp(0.12em, 0.35vw, 0.24em);
		text-transform: uppercase;
		text-wrap: balance;
		text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
	}

	.theme-hero h1 {
		margin: 0;
		font-size: clamp(50px, 5.4vw, 76px);
		font-weight: 650;
		line-height: 0.98;
		letter-spacing: -0.03em;
		color: #fff6ed;
		text-wrap: balance;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.theme-hero__description {
		max-width: min(100%, 700px);
		margin: 14px auto 0;
		color: rgba(255, 246, 237, 0.82);
		font-size: clamp(16px, 1.25vw, 19px);
		line-height: 1.5;
		text-wrap: balance;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	.theme-hero__count {
		margin: 12px 0 0;
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 6px;
		color: rgba(255, 246, 237, 0.56);
		font-size: 12.5px;
	}

	.theme-hero__count strong {
		color: rgba(255, 246, 237, 0.85);
		font-weight: 700;
	}

	.theme-hero__count span {
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	/* ---------- PARRILLA ---------- */

	.theme-hero--parrilla {
		background:
			radial-gradient(
				circle at 50% 110%,
				rgba(255, 106, 42, 0.35),
				transparent 60%
			),
			#161311;
	}

	.theme-hero--overlay-warm-dark .theme-hero__image img {
		filter: saturate(1.12) contrast(1.08) brightness(1.02);
	}

	.theme-hero--overlay-warm-dark .theme-hero__image::after {
		background:
			radial-gradient(
				circle at 50% 78%,
				rgba(255, 130, 45, calc(0.3 * var(--hero-overlay-intensity, 1))),
				transparent 55%
			),
			linear-gradient(
				180deg,
				rgba(12, 8, 6, calc(0.42 * var(--hero-overlay-intensity, 1))) 0%,
				rgba(12, 8, 6, calc(0.24 * var(--hero-overlay-intensity, 1))) 40%,
				rgba(12, 8, 6, calc(0.76 * var(--hero-overlay-intensity, 1))) 100%
			);
	}

	/* ---------- COCINA Y MESA ---------- */

	.theme-hero--cocina-y-mesa {
		background:
			radial-gradient(
				circle at 50% 100%,
				rgba(255, 200, 150, 0.22),
				transparent 65%
			),
			#181410;
	}

	.theme-hero--overlay-warm-light .theme-hero__image::after {
		background: linear-gradient(
			180deg,
			rgba(20, 15, 10, calc(0.22 * var(--hero-overlay-intensity, 1))) 0%,
			rgba(20, 15, 10, calc(0.3 * var(--hero-overlay-intensity, 1))) 42%,
			rgba(20, 15, 10, calc(0.72 * var(--hero-overlay-intensity, 1))) 100%
		);
	}

	/* ---------- OFICINA ---------- */

	.theme-hero--oficina {
		background: #131417;
	}

	.theme-hero--overlay-cool-dark .theme-hero__image::after {
		background: linear-gradient(
			180deg,
			rgba(10, 10, 13, calc(0.48 * var(--hero-overlay-intensity, 1))) 0%,
			rgba(10, 10, 13, calc(0.36 * var(--hero-overlay-intensity, 1))) 42%,
			rgba(10, 10, 13, calc(0.8 * var(--hero-overlay-intensity, 1))) 100%
		);
	}

	/* ---------- EMPRESAS ---------- */

	.theme-hero--empresas {
		background:
			radial-gradient(
				circle at 50% 0%,
				rgba(255, 77, 42, 0.14),
				transparent 65%
			),
			#141414;
	}

	.theme-hero--overlay-neutral-dark .theme-hero__image::after {
		background: linear-gradient(
			180deg,
			rgba(12, 10, 8, calc(0.44 * var(--hero-overlay-intensity, 1))) 0%,
			rgba(12, 10, 8, calc(0.32 * var(--hero-overlay-intensity, 1))) 42%,
			rgba(12, 10, 8, calc(0.76 * var(--hero-overlay-intensity, 1))) 100%
		);
	}

	/* ---------- Default (kits y regalos, y otras sin foto propia) ---------- */

	.theme-hero:not(.theme-hero--parrilla):not(.theme-hero--cocina-y-mesa):not(.theme-hero--oficina):not(.theme-hero--empresas) {
		background:
			radial-gradient(
				circle at 50% 0%,
				rgba(255, 77, 42, 0.16),
				transparent 65%
			),
			#141414;
	}

	.theme-hero--has-image {
		background: #141414;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-hero__image img {
			animation: none;
			transform: scale(1);
		}
	}

	@media (max-width: 767px) {
		.theme-hero {
			height: auto;
			min-height: clamp(360px, 108vw, 430px);
			padding-inline: clamp(20px, 6vw, 26px);
			padding-block: 0;
			border-radius: 14px 18px;
		}

		.theme-hero__image img {
			object-position: var(--hero-object-position-mobile, center);
		}

		.theme-hero__content {
			display: flex;
			flex-direction: column;
			align-items: center;
			width: min(100% - 36px, 560px);
			margin-inline: auto;
			padding-block: 36px;
			gap: 12px;
		}

		.theme-hero__eyebrow {
			width: 100%;
			max-width: 92%;
			margin: 0;
			font-size: clamp(11px, 3.4vw, 13px);
			line-height: 1.25;
			letter-spacing: 0.12em;
			-webkit-line-clamp: 2;
			display: -webkit-box;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		.theme-hero h1 {
			margin: 0;
			font-size: clamp(42px, 13vw, 56px);
			line-height: 0.94;
			letter-spacing: -0.035em;
			max-width: 100%;
		}

		.theme-hero__description {
			margin: 0;
			max-width: 31ch;
			font-size: clamp(15px, 4.2vw, 17px);
			line-height: 1.45;
			-webkit-line-clamp: 4;
		}

		.theme-hero__count {
			margin: 2px 0 0;
			font-size: 12px;
			line-height: 1.3;
		}
	}
</style>
