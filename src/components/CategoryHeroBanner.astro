---
interface Props {
	categorySlug: string;
	eyebrow?: string;
	title: string;
	description?: string;
	count: number;
	countLabel: string;
	imageSrc?: string;
}

const {
	categorySlug,
	eyebrow,
	title,
	description,
	count,
	countLabel,
	imageSrc,
} = Astro.props;
---

<header
	class:list={[
		"theme-hero",
		`theme-hero--${categorySlug}`,
		{ "theme-hero--has-image": Boolean(imageSrc) },
	]}
	style={imageSrc ? `--hero-image: url('${imageSrc}');` : undefined}
>
	{
		imageSrc && (
			<div class="theme-hero__image" aria-hidden="true" />
		)
	}

	<div class="theme-hero__content">
		{
			eyebrow && (
				<p class="theme-hero__eyebrow">{eyebrow}</p>
			)
		}

		<h1>{title}</h1>

		{
			description && (
				<p class="theme-hero__description">
					{description}
				</p>
			)
		}

		<div class="theme-hero__count">
			<strong>{count}</strong>
			<span>{countLabel}</span>
		</div>
	</div>
</header>

<style>
	.theme-hero {
		position: relative;
		width: min(100%, 1450px);
		margin-inline: auto;
		overflow: hidden;
		padding: clamp(26px, 3.5vw, 42px) clamp(20px, 5vw, 60px);
		border-radius: 26px;
		background:
			radial-gradient(
				circle at 50% 0%,
				rgba(255, 255, 255, 0.05),
				transparent 60%
			),
			#141414;
		color: #fff6ed;
		text-align: center;
	}

	.theme-hero__image {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background-image: var(--hero-image);
		background-size: cover;
		background-position: center;
		transform: scale(1.045);
		animation: theme-hero-zoom 12s ease-out forwards;
	}

	.theme-hero__image::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(10, 8, 7, 0.5) 0%,
			rgba(10, 8, 7, 0.32) 45%,
			rgba(10, 8, 7, 0.78) 100%
		);
	}

	@keyframes theme-hero-zoom {
		from {
			transform: scale(1.045);
		}

		to {
			transform: scale(1);
		}
	}

	.theme-hero__content {
		position: relative;
		z-index: 2;
		max-width: 760px;
		margin-inline: auto;
	}

	.theme-hero__eyebrow {
		margin: 0 0 14px;
		color: #ff8a5c;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.theme-hero h1 {
		margin: 0;
		font-size: clamp(32px, 5vw, 56px);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.theme-hero__description {
		max-width: 560px;
		margin: 12px auto 0;
		color: rgba(255, 246, 237, 0.72);
		font-size: 15px;
		line-height: 1.55;
	}

	.theme-hero__count {
		margin: 18px auto 0;
		width: fit-content;
		padding: 10px 22px;
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.06);
	}

	.theme-hero__count strong {
		font-size: 20px;
		font-weight: 700;
	}

	.theme-hero__count span {
		color: rgba(255, 246, 237, 0.6);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	/* ---------- PARRILLA ---------- */

	.theme-hero--parrilla {
		background:
			radial-gradient(
				circle at 50% 110%,
				rgba(255, 106, 42, 0.35),
				transparent 60%
			),
			#161311;
	}

	/* ---------- COCINA Y MESA ---------- */

	.theme-hero--cocina-y-mesa {
		background:
			radial-gradient(
				circle at 50% 100%,
				rgba(255, 200, 150, 0.22),
				transparent 65%
			),
			#181410;
	}

	/* ---------- OFICINA ---------- */

	.theme-hero--oficina {
		background: #131417;
	}

	/* ---------- Default (kits y regalos, empresas, etc.) ---------- */

	.theme-hero:not(.theme-hero--parrilla):not(.theme-hero--cocina-y-mesa):not(.theme-hero--oficina) {
		background:
			radial-gradient(
				circle at 50% 0%,
				rgba(255, 77, 42, 0.16),
				transparent 65%
			),
			#141414;
	}

	/*
	 * Con imagen de fondo, la foto reemplaza el fondo decorativo del
	 * tema; se mantiene un fondo solido como respaldo si la imagen
	 * tarda en cargar. Los efectos (brasas, vapor, grid) siguen
	 * renderizando encima, como una capa adicional sutil.
	 */
	.theme-hero--has-image {
		background: #141414;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-hero__image {
			animation: none;
			transform: scale(1);
		}
	}

	@media (max-width: 640px) {
		.theme-hero {
			padding: 32px 18px;
			border-radius: 20px;
		}
	}
</style>
