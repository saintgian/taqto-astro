---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { ArrowRight } from "@lucide/astro";

interface LifestyleItem {
	label: string;
	title: string;
	description?: string;
	href: string;
	image?: {
		src: string;
		alt: string;
		width: number;
		height: number;
	};
}

interface Props {
	items?: LifestyleItem[];
}

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

function getHomeImage(
	fileName: string,
	alt: string,
	width = 1600,
	height = 1000,
): LifestyleItem["image"] | undefined {
	const absolutePath = resolve(
		process.cwd(),
		"public",
		"images",
		"home",
		fileName,
	);

	if (!existsSync(absolutePath)) {
		return undefined;
	}

	return {
		src: `${base}images/home/${fileName}`,
		alt,
		width,
		height,
	};
}

const defaultItems: LifestyleItem[] = [
	{
		label: "Parrilla",
		title: "Momentos alrededor del fuego",
		description:
			"Piezas diseñadas para servir, compartir y acompañar cada encuentro.",
		href: `${base}categorias/parrilla/`,
		image: getHomeImage(
			"lifestyle-parrilla.webp",
			"Tabla parrillera TAQTO utilizada en una parrilla contemporánea",
		),
	},
	{
		label: "Cocina y mesa",
		title: "Diseño para compartir",
		description:
			"Tablas funcionales para preparar, presentar y disfrutar cada comida.",
		href: `${base}categorias/cocina-y-mesa/`,
		image: getHomeImage(
			"lifestyle-cocina-mesa.webp",
			"Tabla de madera TAQTO utilizada en una cocina y mesa contemporánea",
		),
	},
	{
		label: "Oficina",
		title: "Orden con materiales honestos",
		description:
			"Accesorios de madera que aportan organización y calidez al espacio de trabajo.",
		href: `${base}categorias/oficina/`,
		image: getHomeImage(
			"lifestyle-oficina.webp",
			"Organizador de madera TAQTO en un escritorio minimalista",
		),
	},
];

const { items = [] } = Astro.props;

const categoriesHref = `${base}categorias/`;

const sourceItems = items.length > 0 ? items : defaultItems;

const visibleItems = sourceItems.slice(0, 3).map((item, index) => ({
	...defaultItems[index],
	...item,
	image: item.image ?? defaultItems[index]?.image,
}));
---
{
	visibleItems.length > 0 && (
		<section
			class="lifestyle-gallery"
			aria-labelledby="lifestyle-gallery-title"
		>
			<div class="lifestyle-gallery__container">
				<header class="lifestyle-gallery__header">
					<p class="lifestyle-gallery__eyebrow">
						Momentos reales
					</p>

					<h2 id="lifestyle-gallery-title">
						Diseñadas para momentos reales
					</h2>

					<div class="lifestyle-gallery__subrow">
						<p class="lifestyle-gallery__intro">
							Piezas funcionales para compartir,
							organizar y acompañar cada día.
						</p>

						<a
							class="lifestyle-gallery__cta"
							href={categoriesHref}
						>
							Ver todas las categorías
							<ArrowRight aria-hidden="true" stroke-width={1.75} />
						</a>
					</div>
				</header>

				<ul
					class="lifestyle-gallery__grid"
					aria-label="Momentos y espacios con piezas TAQTO"
				>
					{
						visibleItems.map((item, index) => (
							<li
								class:list={[
									"lifestyle-gallery__item",
									index === 0 &&
										"lifestyle-gallery__item--main",
								]}
							>
								<article class="lifestyle-card">
									<a
										class="lifestyle-card__media"
										href={item.href}
										aria-label={`Ver ${item.title}`}
									>
										{
											item.image ? (
												<img
													src={item.image.src}
													alt={item.image.alt}
													width={item.image.width}
													height={item.image.height}
													loading="lazy"
													decoding="async"
												/>
											) : (
												<div class="lifestyle-card__placeholder">
													<span>Foto próximamente</span>
												</div>
											)
										}
									</a>

									<div class="lifestyle-card__caption">
										<p class="lifestyle-card__label">
											{item.label}
										</p>

										<h3>
											<a href={item.href}>
												{item.title}
											</a>
										</h3>

										{
											item.description && (
												<p class="lifestyle-card__description">
													{item.description}
												</p>
											)
										}

										<a
											class="lifestyle-card__link"
											href={item.href}
										>
											Descubrir
											<ArrowRight aria-hidden="true" stroke-width={1.75} />
										</a>
									</div>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	)
}

<style>
	.lifestyle-gallery {
		padding-block: var(--section-py);
		padding-inline: var(--container-gutter);
		background: var(--surface);
		color: var(--color-black);
	}

	.lifestyle-gallery__container {
		width: min(100%, var(--container-comercial));
		margin-inline: auto;
	}

	.lifestyle-gallery__header {
		margin-bottom: var(--header-gap);
	}

	.lifestyle-gallery__eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 14px;
		color: var(--color-orange);
		font-size: clamp(12px, 0.15vw + 11.7px, 14px);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.lifestyle-gallery__eyebrow::before {
		width: 28px;
		height: 1px;
		background: currentColor;
		content: "";
	}

	.lifestyle-gallery__header h2 {
		max-width: 640px;
		margin: 0 0 18px;
		color: var(--color-black);
		font-size: clamp(34px, 3vw, 42px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.lifestyle-gallery__subrow {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px 32px;
	}

	.lifestyle-gallery__intro {
		max-width: 56ch;
		margin: 0;
		color: var(--ink-70);
		font-size: clamp(17px, 0.3vw + 16.4px, 19px);
		line-height: 1.6;
	}

	.lifestyle-gallery__cta {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		color: var(--color-brown);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.01em;
		text-decoration: none;
		white-space: nowrap;
	}

	.lifestyle-gallery__cta svg {
		width: 15px;
		height: 15px;
		transition: transform 180ms ease;
	}

	.lifestyle-gallery__cta:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 4px;
		border-radius: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.lifestyle-gallery__cta:hover svg {
			transform: translateX(4px);
		}
	}

	.lifestyle-gallery__grid {
		display: grid;
		grid-template-columns:
			minmax(0, 1.55fr)
			minmax(280px, 0.8fr);
		grid-template-rows: repeat(2, minmax(0, 1fr));
		gap: clamp(20px, 2.5vw, 36px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.lifestyle-gallery__item {
		min-width: 0;
	}

	.lifestyle-gallery__item--main {
		grid-row: 1 / 3;
	}

	.lifestyle-card {
		display: flex;
		height: 100%;
		flex-direction: column;
	}

	.lifestyle-card__media {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 20px;
		background: rgba(20, 20, 20, 0.04);
		color: inherit;
		text-decoration: none;
	}

	.lifestyle-gallery__item--main .lifestyle-card__media {
		flex: 1;
		min-height: clamp(420px, 52vw, 680px);
	}

	.lifestyle-gallery__item:not(.lifestyle-gallery__item--main)
		.lifestyle-card__media {
		aspect-ratio: 4 / 3;
	}

	.lifestyle-card__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.lifestyle-card__placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		min-height: 220px;
		place-items: center;
		border: 1px dashed rgba(20, 20, 20, 0.22);
		border-radius: 20px;
		background: rgba(20, 20, 20, 0.03);
	}

	.lifestyle-card__placeholder span {
		color: rgba(20, 20, 20, 0.35);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.lifestyle-card__caption {
		padding-top: 12px;
	}

	.lifestyle-card__label {
		margin: 0 0 6px;
		color: var(--color-orange);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.lifestyle-card__caption h3 {
		margin: 0;
		font-size: clamp(21px, 0.6vw + 19.5px, 25px);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.lifestyle-card__caption h3 a {
		color: var(--color-black);
		text-decoration: none;
		transition: color 180ms ease;
	}

	.lifestyle-card__description {
		max-width: 480px;
		margin: 8px 0 0;
		color: var(--ink-70);
		font-size: clamp(16px, 0.3vw + 15.4px, 18px);
		line-height: 1.55;
	}

	.lifestyle-card__link {
		display: inline-flex;
		min-height: 40px;
		align-items: center;
		gap: 8px;
		margin-top: 6px;
		color: var(--color-brown);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	.lifestyle-card__link svg {
		width: 14px;
		height: 14px;
		transition: transform 180ms ease;
	}

	.lifestyle-card__media:focus-visible,
	.lifestyle-card__caption h3 a:focus-visible,
	.lifestyle-card__link:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.lifestyle-card__caption h3 a:hover {
			color: var(--color-brown);
		}

		.lifestyle-card__link:hover svg {
			transform: translateX(4px);
		}
	}

	@media (max-width: 980px) {
		.lifestyle-gallery__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: auto;
		}

		.lifestyle-gallery__item--main {
			grid-column: 1 / -1;
			grid-row: auto;
		}

		.lifestyle-gallery__item--main .lifestyle-card__media {
			min-height: 0;
			aspect-ratio: 16 / 10;
		}
	}

	@media (max-width: 680px) {
		.lifestyle-gallery {
			padding-inline: 18px;
		}

		.lifestyle-gallery__header {
			margin-bottom: 24px;
		}

		.lifestyle-gallery__header h2 {
			max-width: none;
			font-size: clamp(27px, 8vw, 32px);
		}

		.lifestyle-gallery__subrow {
			flex-direction: column;
			align-items: flex-start;
			gap: 14px;
		}

		.lifestyle-gallery__intro {
			max-width: none;
			font-size: clamp(16px, 1vw + 15px, 17px);
		}

		.lifestyle-gallery__grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.lifestyle-gallery__item--main {
			grid-column: auto;
		}

		.lifestyle-gallery__item--main .lifestyle-card__media,
		.lifestyle-gallery__item:not(.lifestyle-gallery__item--main)
			.lifestyle-card__media {
			aspect-ratio: 4 / 5;
			min-height: 0;
		}

		.lifestyle-card__media,
		.lifestyle-card__placeholder {
			border-radius: 16px;
		}
	}
</style>
