---
interface BusinessImage {
	src: string;
	alt: string;
	width: number;
	height: number;
}

interface BusinessLink {
	label: string;
	href: string;
	description: string;
}

import { ArrowRight } from "@lucide/astro";

interface Props {
	image?: BusinessImage;
	mainHref: string;
	corporateGiftsHref: string;
	wholesaleHref: string;
	theme?: "dark" | "light";
}

const {
	image,
	mainHref,
	corporateGiftsHref,
	wholesaleHref,
	theme = "dark",
} = Astro.props;

const businessLinks: BusinessLink[] = [
	{
		label: "Regalos corporativos",
		href: corporateGiftsHref,
		description:
			"Piezas personalizadas para clientes, equipos y aliados.",
	},
	{
		label: "Ventas al por mayor",
		href: wholesaleHref,
		description:
			"Pedidos en volumen para negocios, tiendas y espacios profesionales.",
	},
];
---

<section
	class:list={[
		"business-gateway",
		theme === "light"
			? "business-gateway--light"
			: "business-gateway--dark",
	]}
	aria-labelledby="business-gateway-title"
>
	<div class="business-gateway__container">
		<div class="business-gateway__media">
			{
				image ? (
					<img
						src={image.src}
						alt={image.alt}
						width={image.width}
						height={image.height}
						loading="lazy"
						decoding="async"
					/>
				) : (
					<div class="business-gateway__placeholder">
						<span>Foto próximamente</span>
					</div>
				)
			}
		</div>

		<div class="business-gateway__content">
			<h2 id="business-gateway-title">
				Piezas que representan tu marca
			</h2>

			<p class="business-gateway__description">
				Soluciones de madera personalizadas
				para regalos corporativos y negocios
				que necesitan pedidos en volumen.
			</p>

			<ul
				class="business-gateway__links"
				aria-label="Soluciones para empresas"
			>
				{
					businessLinks.map((link) => (
						<li>
							<a href={link.href}>
								<span class="business-gateway__link-copy">
									<strong>{link.label}</strong>
									<small>{link.description}</small>
								</span>

								<span
									class="business-gateway__link-arrow"
									aria-hidden="true"
								>
									<ArrowRight stroke-width={1.75} />
								</span>
							</a>
						</li>
					))
				}
			</ul>

			<a class="btn btn--primary business-gateway__cta" href={mainHref}>
				Conoce las soluciones para empresas
				<ArrowRight aria-hidden="true" stroke-width={1.75} />
			</a>
		</div>
	</div>
</section>

<style>
	.business-gateway {
		padding-block: clamp(64px, 5vw, 80px);
		padding-inline: var(--container-gutter);
	}

	.business-gateway--dark {
		--business-background: var(--color-black);
		--business-foreground: var(--color-beige);
		--business-muted: rgba(255, 246, 237, 0.66);
		--business-line: rgba(255, 246, 237, 0.16);
		--business-link-hover: rgba(255, 246, 237, 0.07);
		--business-button-background: var(--color-beige);
		--business-button-foreground: var(--color-black);
	}

	.business-gateway--light {
		--business-background: var(--surface);
		--business-foreground: var(--color-black);
		--business-muted: rgba(20, 20, 20, 0.64);
		--business-line: rgba(20, 20, 20, 0.14);
		--business-link-hover: rgba(20, 20, 20, 0.045);
		--business-button-background: var(--color-brown);
		--business-button-foreground: var(--color-beige);
	}

	.business-gateway {
		background: var(--business-background);
		color: var(--business-foreground);
	}

	.business-gateway__container {
		display: grid;
		width: min(100%, var(--container-comercial));
		grid-template-columns:
			minmax(0, 0.92fr)
			minmax(320px, 1fr);
		align-items: center;
		gap: clamp(56px, 5vw, 72px);
		margin-inline: auto;
	}

	.business-gateway__media {
		position: relative;
		aspect-ratio: 4 / 3;
		max-height: 520px;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: rgba(20, 20, 20, 0.04);
	}

	.business-gateway__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 58%;
	}

	.business-gateway__placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		min-height: 320px;
		place-items: center;
		border: 1px dashed rgba(20, 20, 20, 0.22);
		border-radius: 24px;
		background: rgba(20, 20, 20, 0.03);
	}

	.business-gateway__placeholder span {
		color: rgba(20, 20, 20, 0.4);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.business-gateway__content {
		display: flex;
		align-self: center;
		flex-direction: column;
	}

	.business-gateway__content h2 {
		max-width: 600px;
		margin: 0;
		color: var(--business-foreground);
		font-size: clamp(36px, 0.9vw + 26.8px, 44px);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.business-gateway__description {
		max-width: 520px;
		margin: 12px 0 0;
		color: var(--business-muted);
		font-size: clamp(17px, 0.3vw + 16.4px, 18px);
		line-height: 1.6;
	}

	.business-gateway__links {
		margin: clamp(16px, 2vw, 24px) 0 0;
		padding: 0;
		border-top: 1px solid var(--business-line);
		list-style: none;
	}

	.business-gateway__links li {
		border-bottom: 1px solid var(--business-line);
	}

	.business-gateway__links a {
		display: flex;
		min-height: 70px;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 12px 4px;
		color: var(--business-foreground);
		text-decoration: none;
		transition:
			background-color 180ms ease,
			padding-inline 180ms ease;
	}

	.business-gateway__link-copy {
		display: grid;
		gap: 5px;
	}

	.business-gateway__link-copy strong {
		font-size: clamp(19px, 1vw + 16px, 22px);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.business-gateway__link-copy small {
		max-width: 420px;
		color: var(--business-muted);
		font-size: clamp(15.5px, 0.5vw + 15px, 17px);
		font-weight: 400;
		line-height: 1.5;
	}

	.business-gateway__link-arrow {
		display: grid;
		width: 40px;
		height: 40px;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid var(--business-line);
		border-radius: 50%;
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.business-gateway__link-arrow svg {
		width: 17px;
		height: 17px;
	}

	/* Solo posicion: color, geometria y estados vienen de `.btn--primary`. */
	.business-gateway__cta {
		width: fit-content;
		margin-top: clamp(14px, 1.8vw, 20px);
	}

	.business-gateway__cta svg {
		transition: transform 180ms ease;
	}

	.business-gateway__links a:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 4px;
	}

	@media (hover: hover) and (pointer: fine) {
		.business-gateway__links a:hover {
			padding-inline: 12px;
			background: var(--business-link-hover);
		}

		.business-gateway__links a:hover .business-gateway__link-arrow {
			border-color: var(--color-orange);
			transform: translateX(4px);
		}

		.business-gateway__cta:hover svg {
			transform: translateX(4px);
		}
	}

	@media (max-width: 980px) {
		.business-gateway {
			padding-block: clamp(52px, 6vw, 68px);
		}

		.business-gateway__container {
			grid-template-columns: 1fr;
			gap: 36px;
		}

		.business-gateway__media {
			max-height: none;
		}

		.business-gateway__content {
			max-width: 680px;
			padding-block: 0;
		}
	}

	@media (max-width: 680px) {
		.business-gateway {
			padding-inline: 18px;
			padding-block: clamp(40px, 8vw, 56px);
		}

		.business-gateway__container {
			gap: 30px;
		}

		.business-gateway__media,
		.business-gateway__placeholder {
			border-radius: 18px;
		}

		.business-gateway__links a {
			min-height: 86px;
			padding-block: 16px;
		}

		.business-gateway__cta {
			width: 100%;
			min-height: 50px;
			text-align: center;
		}
	}
</style>
