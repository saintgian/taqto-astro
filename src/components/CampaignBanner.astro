---
import { ArrowRight, X } from "@lucide/astro";

interface Props {
	eyebrow?: string;
	title?: string;
	description?: string;
	buttonText?: string;
	buttonHref?: string;
	campaignId?: string;
	imageUrl?: string;
	mobileImageUrl?: string;
	imageAlt?: string;
	theme?: "light" | "dark";
	layoutMode?: "editorial" | "productSpotlight";
	contentPosition?: "left" | "center" | "right";
	overlayStrength?: "soft" | "medium" | "strong";
	featuredProduct?: any;
}

const base = import.meta.env.BASE_URL;

const {
	eyebrow = "Nueva colección",
	title = "Piezas de madera con grabado láser personalizado.",
	description =
		"Diseños hechos a mano, listos para regalar o personalizar con tu propio mensaje.",
	buttonText = "Explorar colección",
	buttonHref = `${base}categorias/`,
	campaignId = "campana-inicio",
	imageUrl,
	mobileImageUrl,
	imageAlt = "",
	theme = "dark",
	contentPosition = "left",
	overlayStrength = "medium",
} = Astro.props;

const hasImage = Boolean(imageUrl);
const hasButton = Boolean(buttonText && buttonHref);
---

<aside
	class:list={[
		"campaign-banner",
		`campaign-banner--${theme}`,
		`campaign-banner--content-${contentPosition}`,
		`campaign-banner--overlay-${overlayStrength}`,
		{ "has-image": hasImage },
	]}
	data-campaign-banner
	data-campaign-id={campaignId}
	aria-label="Campaña destacada"
>
	{
		hasImage && (
			<picture class="campaign-banner__image" aria-hidden="true">
				{mobileImageUrl && (
					<source srcset={mobileImageUrl} media="(max-width: 768px)" />
				)}
				<img
					src={imageUrl}
					alt={imageAlt}
					loading="lazy"
					decoding="async"
					width="1400"
					height="700"
				/>
			</picture>
		)
	}

	<div class="campaign-banner__overlay" aria-hidden="true"></div>

	<div class="campaign-banner__container">
		<div class="campaign-banner__content">
			{eyebrow && <p class="campaign-banner__eyebrow">{eyebrow}</p>}

			<h2 class="campaign-banner__title">{title}</h2>

			{description && (
				<p class="campaign-banner__description">{description}</p>
			)}

			{hasButton && (
				<a
					class="btn btn--primary btn--on-dark campaign-banner__button"
					href={buttonHref}
				>
					<span>{buttonText}</span>

					<ArrowRight aria-hidden="true" stroke-width={1.75} />
				</a>
			)}
		</div>

		<button
			class="campaign-banner__close"
			type="button"
			aria-label="Cerrar campaña"
			data-campaign-close
		>
			<X aria-hidden="true" stroke-width={1.75} />
		</button>
	</div>

	<script is:inline>
		(function () {
			var banner = document.currentScript.parentElement;
			var campaignId = banner && banner.dataset.campaignId;
			if (!campaignId) return;

			try {
				if (
					sessionStorage.getItem(
						"taqto-campaign-" + campaignId,
					) === "closed"
				) {
					banner.hidden = true;
				}
			} catch (error) {}
		})();
	</script>
</aside>

<script>
	const campaignBanners = document.querySelectorAll<HTMLElement>(
		"[data-campaign-banner]",
	);

	campaignBanners.forEach((banner) => {
		const campaignId = banner.dataset.campaignId;
		const closeButton =
			banner.querySelector<HTMLButtonElement>("[data-campaign-close]");

		if (!campaignId || banner.hidden) return;

		const storageKey = `taqto-campaign-${campaignId}`;

		closeButton?.addEventListener("click", () => {
			banner.classList.add("is-closing");

			window.setTimeout(() => {
				banner.hidden = true;
				sessionStorage.setItem(storageKey, "closed");
			}, 300);
		});
	});
</script>

<style>
	.campaign-banner {
		position: relative;
		display: flex;
		width: 100%;
		min-width: 0;
		max-width: 100%;
		min-height: clamp(500px, 34vw, 560px);
		overflow: hidden;
		border-radius: inherit;
		background: var(--color-brown, #5b312a);
		color: var(--color-beige, #fff6ed);
		box-shadow: var(--shadow-md);
		transition:
			opacity 300ms ease,
			max-height 300ms ease,
			transform 300ms ease;
	}

	.campaign-banner.is-closing {
		max-height: 0;
		min-height: 0;
		opacity: 0;
		transform: translateY(-12px);
	}

	.campaign-banner--light {
		background: var(--color-beige, #fff6ed);
		color: var(--color-black, #141414);
	}

	.campaign-banner__image {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: block;
	}

	.campaign-banner__image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.campaign-banner__overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			100deg,
			rgba(20, 20, 20, 0.8) 0%,
			rgba(20, 20, 20, 0.52) 24%,
			rgba(20, 20, 20, 0.14) 42%,
			rgba(20, 20, 20, 0) 56%
		);
	}

	.campaign-banner--light.has-image .campaign-banner__overlay {
		background: linear-gradient(
			100deg,
			rgba(255, 246, 237, 0.94) 0%,
			rgba(255, 246, 237, 0.66) 24%,
			rgba(255, 246, 237, 0.18) 42%,
			rgba(255, 246, 237, 0) 56%
		);
	}

	.campaign-banner--overlay-soft .campaign-banner__overlay {
		opacity: 0.6;
	}

	.campaign-banner--overlay-medium .campaign-banner__overlay {
		opacity: 1;
	}

	.campaign-banner--overlay-strong .campaign-banner__overlay {
		opacity: 1.35;
		filter: saturate(1.1);
	}

	.campaign-banner__container {
		position: relative;
		z-index: 2;
		flex: 1;
		min-width: 0;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		padding-inline: clamp(48px, 5vw, 72px);
		padding-block: clamp(48px, 6vw, 72px);
	}

	.campaign-banner__content {
		display: flex;
		flex-direction: column;
		min-width: 0;
		gap: 22px;
		width: min(100%, 520px);
		max-width: 520px;
	}

	.campaign-banner--content-center .campaign-banner__container {
		justify-content: center;
	}

	.campaign-banner--content-center .campaign-banner__content {
		align-items: center;
		text-align: center;
		margin-inline: auto;
	}

	.campaign-banner--content-right .campaign-banner__container {
		justify-content: flex-end;
	}

	.campaign-banner--content-right .campaign-banner__content {
		align-items: flex-end;
		text-align: right;
		margin-left: auto;
	}

	.campaign-banner__eyebrow {
		margin: 0;
		font-size: 11px;
		font-weight: 700;
		line-height: 1.4;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	.campaign-banner__title {
		margin: 0;
		font-size: clamp(1.65rem, 1.37rem + 1.37vw, 2.62rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.campaign-banner__description {
		max-width: 480px;
		margin: 0;
		font-size: clamp(15px, 1.2vw, 17px);
		line-height: 1.55;
		opacity: 0.85;
	}

	.campaign-banner--content-center .campaign-banner__description {
		margin-inline: auto;
	}

	/* Solo posicion: color, geometria y estados vienen de `.btn--primary`. */
	.campaign-banner__button {
		margin-top: 6px;
		align-self: flex-start;
		white-space: nowrap;
	}

	.campaign-banner--content-center .campaign-banner__button {
		align-self: center;
	}

	.campaign-banner--content-right .campaign-banner__button {
		align-self: flex-end;
	}

	.campaign-banner__button svg {
		transition: transform 200ms ease;
	}

	.campaign-banner__button:hover svg {
		transform: translateX(4px);
	}

	.campaign-banner__close {
		position: absolute;
		top: 20px;
		right: 20px;
		z-index: 3;
		width: 40px;
		height: 40px;
		padding: 0;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		cursor: pointer;
		opacity: 0.62;
		transition:
			background-color 180ms ease,
			opacity 180ms ease;
	}

	.campaign-banner__close:hover {
		background: rgba(255, 246, 237, 0.12);
		opacity: 1;
	}

	.campaign-banner--light .campaign-banner__close:hover {
		background: rgba(20, 20, 20, 0.08);
	}

	.campaign-banner__close svg {
		width: 19px;
		height: 19px;
	}

	.campaign-banner__close:focus-visible {
		outline: 2px solid var(--color-orange, #ff4d2a);
		outline-offset: 3px;
	}

	@media (max-width: 1080px) {
		.campaign-banner {
			min-height: clamp(420px, 46vw, 480px);
		}
	}

	@media (max-width: 768px) {
		.campaign-banner {
			min-height: 0;
		}

		.campaign-banner.has-image {
			aspect-ratio: 4 / 5;
			min-height: clamp(420px, 118vw, 560px);
			max-height: 620px;
		}

		.campaign-banner__overlay {
			background: linear-gradient(
				180deg,
				rgba(20, 20, 20, 0) 40%,
				rgba(20, 20, 20, 0.82) 100%
			);
		}

		.campaign-banner--light.has-image .campaign-banner__overlay {
			background: linear-gradient(
				180deg,
				rgba(255, 246, 237, 0) 40%,
				rgba(255, 246, 237, 0.94) 100%
			);
		}

		.campaign-banner__container {
			align-items: flex-end;
			padding-inline: clamp(20px, 6vw, 32px);
			padding-block: clamp(28px, 8vw, 48px);
		}

		.campaign-banner--content-right .campaign-banner__container,
		.campaign-banner--content-left .campaign-banner__container {
			justify-content: flex-start;
		}

		.campaign-banner--content-right .campaign-banner__content {
			align-items: flex-start;
			text-align: left;
			margin-left: 0;
		}

		.campaign-banner__content {
			width: min(100%, 92%);
			max-width: 92%;
			gap: 16px;
		}

		.campaign-banner__description {
			max-width: none;
		}
	}

	@media (max-width: 560px) {
		.campaign-banner__button {
			width: 100%;
		}

		.campaign-banner__close {
			top: 16px;
			right: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.campaign-banner,
		.campaign-banner__button,
		.campaign-banner__button svg {
			transition: none;
		}
	}
</style>
