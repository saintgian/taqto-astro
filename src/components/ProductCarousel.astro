---
import { sanityClient } from "../lib/sanity";
import { productDetailQuery } from "../lib/productDetailQuery";
import ProductCard from "./ProductCard.astro";

interface Product {
	_id: string;
	title: string;
	slug: string;
	[key: string]: unknown;
}

const products = await sanityClient.fetch<Product[]>(
	productDetailQuery,
);

const track = [...products, ...products];
---

{
	products.length > 0 && (
		<section class="carousel">
			<div class="carousel__heading">
				<h2>¿Aún no te decides?</h2>
			</div>

			<div
				class:list={[
					"carousel__viewport",
					{ "is-few": products.length < 4 },
				]}
				data-carousel-viewport
			>
				<div class="carousel__track">
					{track.map((product) => (
						<div class="carousel__item">
							<ProductCard product={product} />
						</div>
					))}
				</div>
			</div>
		</section>
	)
}

<script>
	const TOUCH_RESUME_DELAY = 2500;

	const initCarouselTouch = () => {
		document
			.querySelectorAll<HTMLElement>("[data-carousel-viewport]")
			.forEach((viewport) => {
				if (viewport.dataset.touchInitialized === "true") return;
				viewport.dataset.touchInitialized = "true";

				let resumeTimer: ReturnType<typeof setTimeout> | undefined;

				const pause = () => {
					if (resumeTimer) clearTimeout(resumeTimer);
					viewport.classList.add("is-touch-paused");
				};

				const scheduleResume = () => {
					if (resumeTimer) clearTimeout(resumeTimer);

					resumeTimer = setTimeout(() => {
						viewport.classList.remove("is-touch-paused");
					}, TOUCH_RESUME_DELAY);
				};

				viewport.addEventListener("touchstart", pause, {
					passive: true,
				});

				viewport.addEventListener("touchend", scheduleResume, {
					passive: true,
				});
			});
	};

	initCarouselTouch();
	document.addEventListener("astro:page-load", initCarouselTouch);
</script>

<style>
	.carousel {
		padding-block: var(--section-py);
		background: var(--surface);
		overflow: hidden;
	}

	.carousel__heading {
		width: min(100%, var(--container-comercial));
		margin: 0 auto var(--header-gap);
		padding-inline: var(--container-gutter);
		text-align: left;
	}

	.carousel__heading h2 {
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--color-black);
	}

	.carousel__viewport {
		width: 100%;
		overflow: hidden;
		mask-image: linear-gradient(
			90deg,
			transparent,
			#000 6%,
			#000 94%,
			transparent
		);
	}

	.carousel__track {
		display: flex;
		width: max-content;
		gap: 24px;
		padding-inline: var(--container-gutter);
		animation: carousel-scroll 140s linear infinite;
	}

	.carousel__viewport.is-few .carousel__track {
		animation-duration: 85s;
	}

	.carousel__viewport:hover .carousel__track,
	.carousel__viewport:focus-within .carousel__track,
	.carousel__viewport.is-touch-paused .carousel__track {
		animation-play-state: paused;
	}

	.carousel__item {
		width: 320px;
		flex-shrink: 0;
	}

	@keyframes carousel-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel__track {
			animation: none;
		}
	}

	@media (max-width: 600px) {
		.carousel__heading {
			padding-inline: 18px;
		}

		.carousel__item {
			width: 240px;
		}
	}
</style>
