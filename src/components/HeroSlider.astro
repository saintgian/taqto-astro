---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { ArrowRight, ChevronLeft, ChevronRight } from "@lucide/astro";

const base = import.meta.env.BASE_URL;

function heroImageExists(fileName: string): boolean {
	return existsSync(
		resolve(process.cwd(), "public", "images", "hero", fileName),
	);
}

const slides = [
	{
		eyebrow: "Madera maciza peruana",
		title: "Tablas parrilleras personalizadas",
		description:
			"Piezas robustas de madera seleccionada, creadas para acompañar cada corte y cada encuentro.",
		button: "Descubre tu tabla",
		href: `${base}categorias/parrilla/`,
		image: `${base}images/hero/hero-parrilla.webp`,
		mobileImage: heroImageExists("hero-parrilla-mobile.webp")
			? `${base}images/hero/hero-parrilla-mobile.webp`
			: undefined,
		alt: "Tabla parrillera personalizada de madera TAQTO",
		position: "center right",
		mobilePosition: "center 30%",
		theme: "dark",
	},
	{
		eyebrow: "Cocina y Mesa",
		title: "Diseño que transforma la mesa",
		description:
			"Objetos cálidos y contemporáneos para servir, compartir y hacer especial cada momento.",
		button: "Explorar la colección",
		href: `${base}categorias/cocina-y-mesa/`,
		image: `${base}images/hero/hero-cocina.webp`,
		mobileImage: heroImageExists("hero-cocina-mobile.webp")
			? `${base}images/hero/hero-cocina-mobile.webp`
			: undefined,
		alt: "Accesorios de madera para cocina y mesa TAQTO",
		position: "center center",
		mobilePosition: "center center",
		theme: "light",
	},
	{
		eyebrow: "Orden con carácter",
		title: "Tu espacio de trabajo, mejor diseñado",
		description:
			"Organizadores y accesorios de madera pensados para trabajar con claridad, orden y estilo.",
		button: "Ver colección de oficina",
		href: `${base}categorias/oficina/`,
		image: `${base}images/hero/hero-oficina.webp`,
		mobileImage: heroImageExists("hero-oficina-mobile.webp")
			? `${base}images/hero/hero-oficina-mobile.webp`
			: undefined,
		alt: "Organizador de escritorio de madera TAQTO",
		position: "center right",
		mobilePosition: "center 25%",
		theme: "dark",
	},
];
---

<section
	class="hero-slider"
	data-hero-slider
	aria-roledescription="carrusel"
	aria-label="Colecciones destacadas de TAQTO"
>
	<div class="hero-slider__viewport">
		{
			slides.map((slide, index) => (
				<article
					class:list={[
						"hero-slide",
						`hero-slide--${slide.theme}`,
						{ "is-active": index === 0 },
					]}
					data-slide
					aria-hidden={index === 0 ? "false" : "true"}
					inert={index === 0 ? undefined : true}
					style={`--slide-image: url('${slide.image}'); --slide-position: ${slide.position}; --slide-position-mobile: ${slide.mobilePosition || slide.position};${slide.overlayDesktop !== undefined ? ` --overlay-desktop-peak: ${slide.overlayDesktop};` : ""}${slide.overlayMobile !== undefined ? ` --overlay-mobile-peak: ${slide.overlayMobile};` : ""}`}
				>
					<picture>
						{
							slide.mobileImage && (
								<source
									srcset={slide.mobileImage}
									media="(max-width: 768px)"
								/>
							)
						}

						<img
							class="hero-slide__image"
							src={slide.image}
							alt={slide.alt}
							width="2048"
							height="900"
							loading={index === 0 ? "eager" : "lazy"}
							fetchpriority={index === 0 ? "high" : "auto"}
						/>
					</picture>

					<div class="hero-slide__overlay"></div>

					<div class="hero-slide__container">
						<div class="hero-slide__content">
							<p class="hero-slide__eyebrow">{slide.eyebrow}</p>

							{
								index === 0 ? (
									<h1>{slide.title}</h1>
								) : (
									<h2>{slide.title}</h2>
								)
							}

							<p class="hero-slide__description">
								{slide.description}
							</p>

							<a
								class="btn btn--primary btn--on-dark hero-slide__button"
								href={slide.href}
							>
								<span>{slide.button}</span>

								<ArrowRight aria-hidden="true" stroke-width={1.75} />
							</a>

							<div class="hero-slide__trust" aria-label="Beneficios">
								<span>Grabado láser gratuito</span>
								<span>Madera seleccionada</span>
								<span>Hecho en Perú</span>
							</div>
						</div>
					</div>
				</article>
			))
		}

		<button
			class="hero-slider__arrow hero-slider__arrow--previous"
			type="button"
			data-slider-previous
			aria-label="Ver diapositiva anterior"
		>
			<ChevronLeft aria-hidden="true" stroke-width={1.75} />
		</button>

		<button
			class="hero-slider__arrow hero-slider__arrow--next"
			type="button"
			data-slider-next
			aria-label="Ver siguiente diapositiva"
		>
			<ChevronRight aria-hidden="true" stroke-width={1.75} />
		</button>

		<div class="hero-slider__pagination" aria-label="Seleccionar diapositiva">
			{
				slides.map((slide, index) => (
					<button
						class:list={[
							"hero-slider__dot",
							{ "is-active": index === 0 },
						]}
						type="button"
						data-slider-dot
						aria-label={`Ver diapositiva ${index + 1}: ${slide.title}`}
						aria-current={index === 0 ? "true" : "false"}
					>
						<span></span>
					</button>
				))
			}
		</div>

		<div class="hero-slider__counter" aria-hidden="true">
			<span data-current-slide>01</span>
			<span class="hero-slider__counter-line"></span>
			<span>{String(slides.length).padStart(2, "0")}</span>
		</div>

		<div
			class="hero-slider__progress"
			aria-hidden="true"
			data-slider-progress
		></div>
	</div>
</section>

<script>
	const sliders = document.querySelectorAll<HTMLElement>("[data-hero-slider]");

	sliders.forEach((slider) => {
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				slider.setAttribute("data-ready", "true");
			});
		});

		const slides = Array.from(
			slider.querySelectorAll<HTMLElement>("[data-slide]"),
		);

		const dots = Array.from(
			slider.querySelectorAll<HTMLButtonElement>("[data-slider-dot]"),
		);

		const previousButton =
			slider.querySelector<HTMLButtonElement>("[data-slider-previous]");

		const nextButton =
			slider.querySelector<HTMLButtonElement>("[data-slider-next]");

		const currentCounter =
			slider.querySelector<HTMLElement>("[data-current-slide]");

		const progress =
			slider.querySelector<HTMLElement>("[data-slider-progress]");

		const autoplayDelay = 6000;
		const reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		let activeIndex = 0;
		let autoplayTimer: number | undefined;

		const restartProgress = () => {
			if (!progress || reducedMotion) return;

			progress.classList.remove("is-running");
			void progress.offsetWidth;
			progress.classList.add("is-running");
		};

		const showSlide = (newIndex: number) => {
			activeIndex = (newIndex + slides.length) % slides.length;

			slides.forEach((slide, index) => {
				const isActive = index === activeIndex;

				slide.classList.toggle("is-active", isActive);
				slide.setAttribute("aria-hidden", String(!isActive));
				slide.inert = !isActive;
			});

			dots.forEach((dot, index) => {
				const isActive = index === activeIndex;

				dot.classList.toggle("is-active", isActive);
				dot.setAttribute("aria-current", String(isActive));
			});

			if (currentCounter) {
				currentCounter.textContent = String(activeIndex + 1).padStart(
					2,
					"0",
				);
			}

			restartProgress();
		};

		const goToSlide = (newIndex: number) => {
			slider.setAttribute("data-interacted", "true");

			const targetIndex = (newIndex + slides.length) % slides.length;
			const targetImage = slides[targetIndex].querySelector<HTMLImageElement>(
				".hero-slide__image",
			);

			if (targetImage && typeof targetImage.decode === "function") {
				targetImage
					.decode()
					.catch(() => {})
					.finally(() => showSlide(newIndex));
			} else {
				showSlide(newIndex);
			}
		};

		const stopAutoplay = () => {
			if (autoplayTimer !== undefined) {
				window.clearInterval(autoplayTimer);
			}
		};

		const startAutoplay = () => {
			if (reducedMotion || slides.length <= 1) return;

			stopAutoplay();

			autoplayTimer = window.setInterval(() => {
				goToSlide(activeIndex + 1);
			}, autoplayDelay);
		};

		const restartAutoplay = () => {
			stopAutoplay();
			startAutoplay();
		};

		previousButton?.addEventListener("click", () => {
			goToSlide(activeIndex - 1);
			restartAutoplay();
		});

		nextButton?.addEventListener("click", () => {
			goToSlide(activeIndex + 1);
			restartAutoplay();
		});

		dots.forEach((dot, index) => {
			dot.addEventListener("click", () => {
				goToSlide(index);
				restartAutoplay();
			});
		});

		slider.addEventListener("mouseenter", stopAutoplay);
		slider.addEventListener("mouseleave", startAutoplay);

		slider.addEventListener("focusin", stopAutoplay);

		slider.addEventListener("focusout", (event) => {
			const nextFocus = event.relatedTarget;

			if (!(nextFocus instanceof Node) || !slider.contains(nextFocus)) {
				startAutoplay();
			}
		});

		slider.addEventListener("keydown", (event) => {
			if (event.key === "ArrowLeft") {
				goToSlide(activeIndex - 1);
				restartAutoplay();
			}

			if (event.key === "ArrowRight") {
				goToSlide(activeIndex + 1);
				restartAutoplay();
			}
		});

		document.addEventListener("visibilitychange", () => {
			if (document.hidden) {
				stopAutoplay();
			} else {
				startAutoplay();
			}
		});

		showSlide(0);
		startAutoplay();
	});
</script>

<style>
	.hero-slider {
		position: relative;
		width: 100%;
		background: #141414;
		overflow: hidden;
	}

	.hero-slider__viewport {
		position: relative;
		height: clamp(620px, calc(100svh - 122px), 880px);
		min-height: 620px;
		overflow: hidden;
	}

	.hero-slide {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: grid;
		opacity: 0;
		pointer-events: none;
		transition: opacity 280ms var(--ease-out);
	}

	.hero-slide.is-active {
		z-index: 1;
		opacity: 1;
		pointer-events: auto;
		transition: opacity 750ms var(--ease-out);
	}

	/*
	 * Tras la primera interaccion (flechas, dots, autoplay, teclado) el
	 * cambio de slide usa un crossfade mas corto que la entrada inicial:
	 * la foto de apertura merece un fundido mas largo (750ms, entrada de
	 * firma), el resto de transiciones deben sentirse agiles (460ms).
	 */
	.hero-slider[data-interacted] .hero-slide.is-active {
		transition: opacity 460ms var(--ease-out);
	}

	.hero-slide__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: var(--slide-position);
		transition:
			opacity 800ms var(--ease-out),
			transform 800ms var(--ease-out);
	}

	/*
	 * Entrada de firma: solo la foto del primer slide llega con un leve
	 * escalado (1.035 -> 1) y opacidad (0.82 -> 1). Nunca se repite en
	 * cambios de slide (ver nulificador `[data-interacted]` mas abajo) ni
	 * se convierte en Ken Burns continuo: al terminar, el transform queda
	 * fijo en su valor final.
	 */
	@starting-style {
		.hero-slide.is-active .hero-slide__image {
			opacity: 0.82;
			transform: scale(1.035);
		}
	}

	.hero-slider[data-interacted] .hero-slide__image {
		transition: none;
	}

	.hero-slide__overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		transition: opacity 550ms var(--ease-out);
		background:
			linear-gradient(
				90deg,
				rgba(10, 8, 7, var(--overlay-desktop-peak, 0.8)) 0%,
				rgba(10, 8, 7, 0.42) 30%,
				rgba(10, 8, 7, 0.14) 52%,
				rgba(10, 8, 7, 0) 72%
			),
			linear-gradient(
				0deg,
				rgba(10, 8, 7, 0.32) 0%,
				transparent 28%
			);
	}

	.hero-slide--light .hero-slide__overlay {
		background:
			linear-gradient(
				90deg,
				rgba(255, 246, 237, var(--overlay-desktop-peak, 0.92)) 0%,
				rgba(255, 246, 237, 0.58) 35%,
				rgba(255, 246, 237, 0.18) 60%,
				rgba(255, 246, 237, 0) 78%
			),
			linear-gradient(
				0deg,
				rgba(20, 20, 20, 0.12) 0%,
				transparent 32%
			);
	}

	.hero-slide__container {
		position: relative;
		z-index: 2;
		width: min(calc(100% - 80px), 1440px);
		height: 100%;
		margin-inline: auto;
		display: flex;
		align-items: center;
	}

	.hero-slide__content {
	width: min(640px, 52%);
	padding: 210px 0 120px;
	color: #fff6ed;
}

	.hero-slide--light .hero-slide__content {
		color: #141414;
	}

	.hero-slide__eyebrow {
		margin: 0 0 24px;
		display: flex;
		align-items: center;
		gap: 14px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.hero-slide__eyebrow::before {
		content: "";
		width: 36px;
		height: 1px;
		background: currentColor;
		opacity: 0.7;
	}

	.hero-slide h1,
	.hero-slide h2 {
		max-width: 720px;
		margin: 0;
		font-size: clamp(40.25px, 1.53vw + 29.75px, 57.5px);
		font-weight: 700;
		line-height: 0.98;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.hero-slide__description {
		max-width: 560px;
		margin: 28px 0 34px;
		font-size: clamp(16px, 1.05vw, 19.2px);
		line-height: 1.6;
		opacity: 0.86;
	}

	/*
	 * Solo posicion: color, geometria y estados vienen de `.btn--primary`.
	 * El feedback de hover/presion usa las propiedades `translate`/`scale`
	 * (independientes de `transform`) para no interferir con la entrada
	 * del boton, que anima `transform` por separado.
	 */
	.hero-slide__button {
		transition:
			translate 200ms var(--ease-out),
			scale 180ms var(--ease-out);
	}

	.hero-slide__button svg {
		transition: transform 200ms var(--ease-out);
	}

	.hero-slide__button:active {
		scale: 0.98;
	}

	@media (hover: hover) and (pointer: fine) {
		.hero-slide__button:hover {
			translate: 0 -2px;
		}

		.hero-slide__button:hover svg {
			transform: translateX(4px);
		}
	}

	.hero-slide__trust {
		margin-top: 44px;
		display: flex;
		flex-wrap: wrap;
		gap: 10px 24px;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.76;
	}

	.hero-slide__trust span {
		display: inline-flex;
		align-items: center;
		gap: 9px;
	}

	.hero-slide__trust span::before {
		content: "";
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: #ff4d2a;
	}

	.hero-slider__arrow {
		position: absolute;
		top: 50%;
		z-index: 4;
		width: 52px;
		height: 52px;
		display: grid;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.32);
		border-radius: 50%;
		background: rgba(20, 20, 20, 0.18);
		color: #fff;
		backdrop-filter: blur(10px);
		cursor: pointer;
		transform: translateY(-50%);
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			transform 180ms ease;
	}

	.hero-slider__arrow:hover {
		border-color: #fff;
		background: rgba(20, 20, 20, 0.72);
	}

	.hero-slider__arrow--previous {
		left: 22px;
	}

	.hero-slider__arrow--next {
		right: 22px;
	}

	.hero-slider__arrow svg {
		width: 22px;
		height: 22px;
	}

	.hero-slider__pagination {
		position: absolute;
		z-index: 5;
		right: 50%;
		bottom: 42px;
		display: flex;
		align-items: center;
		gap: 10px;
		transform: translateX(50%);
	}

	.hero-slider__dot {
		width: 34px;
		height: 18px;
		padding: 0;
		display: grid;
		place-items: center;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	.hero-slider__dot span {
		display: block;
		width: 100%;
		height: 2px;
		background: rgba(255, 255, 255, 0.4);
		transition:
			background-color 180ms ease,
			transform 180ms ease;
	}

	.hero-slider__dot.is-active span {
		background: #ff4d2a;
		transform: scaleY(2);
	}

	.hero-slider__counter {
		position: absolute;
		right: max(40px, calc((100% - 1440px) / 2));
		bottom: 38px;
		z-index: 5;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 6px 12px;
		border-radius: 999px;
		background: rgba(20, 20, 20, 0.65);
		backdrop-filter: blur(10px);
		color: #fff;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.hero-slider__counter-line {
		width: 28px;
		height: 1px;
		background: currentColor;
		opacity: 0.5;
	}

	.hero-slider__progress {
		position: absolute;
		right: 0;
		bottom: 0;
		z-index: 6;
		width: 100%;
		height: 3px;
		background: #ff4d2a;
		transform: scaleX(0);
		transform-origin: left;
	}

	.hero-slider__progress.is-running {
		animation: slider-progress 6s linear forwards;
	}

	.hero-slide__eyebrow,
	.hero-slide h1,
	.hero-slide h2,
	.hero-slide__description,
	.hero-slide__button,
	.hero-slide__trust {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 660ms var(--ease-out),
			transform 660ms var(--ease-out);
	}

	/*
	 * El titulo lleva el movimiento mas claro de la secuencia de firma:
	 * mayor desplazamiento (22px) y duracion (700ms) que el resto, que
	 * solo acompaña (18px / 660ms).
	 */
	.hero-slide h1,
	.hero-slide h2 {
		transform: translateY(22px);
		transition:
			opacity 700ms var(--ease-out),
			transform 700ms var(--ease-out);
	}

	.hero-slide.is-active .hero-slide__eyebrow,
	.hero-slide.is-active h1,
	.hero-slide.is-active h2,
	.hero-slide.is-active .hero-slide__description,
	.hero-slide.is-active .hero-slide__button,
	.hero-slide.is-active .hero-slide__trust {
		opacity: 1;
		transform: translateY(0);
	}

	.hero-slide.is-active h1,
	.hero-slide.is-active h2 {
		transition-delay: 85ms;
	}

	.hero-slide.is-active .hero-slide__description {
		transition-delay: 170ms;
	}

	.hero-slide.is-active .hero-slide__button {
		transition-delay: 255ms;
	}

	.hero-slide.is-active .hero-slide__trust {
		transition-delay: 340ms;
	}

	/*
	 * Tras la primera interaccion, el contenido del slide entrante usa un
	 * recorrido y un escalonado mas cortos que la entrada inicial: la
	 * secuencia larga (16px / 520ms / hasta 280ms de retardo) solo debe
	 * sentirse una vez, en la primera carga.
	 */
	.hero-slider[data-interacted] .hero-slide__eyebrow,
	.hero-slider[data-interacted] .hero-slide h1,
	.hero-slider[data-interacted] .hero-slide h2,
	.hero-slider[data-interacted] .hero-slide__description,
	.hero-slider[data-interacted] .hero-slide__button,
	.hero-slider[data-interacted] .hero-slide__trust {
		transform: translateY(10px);
		transition:
			opacity 450ms var(--ease-out),
			transform 450ms var(--ease-out);
	}

	.hero-slider[data-interacted] .hero-slide.is-active h1,
	.hero-slider[data-interacted] .hero-slide.is-active h2 {
		transition-delay: 55ms;
	}

	.hero-slider[data-interacted] .hero-slide.is-active .hero-slide__description {
		transition-delay: 110ms;
	}

	.hero-slider[data-interacted] .hero-slide.is-active .hero-slide__button {
		transition-delay: 165ms;
	}

	.hero-slider[data-interacted] .hero-slide.is-active .hero-slide__trust {
		transition-delay: 220ms;
	}

	/*
	 * Entrada del primer slide en la carga inicial. Sin soporte de
	 * `@starting-style` el navegador ignora el bloque completo y el
	 * slide llega directo a su estado final (opacity 1, sin
	 * desplazamiento) sin necesidad de JavaScript.
	 */
	@starting-style {
		.hero-slide.is-active {
			opacity: 0;
		}

		.hero-slide.is-active .hero-slide__eyebrow,
		.hero-slide.is-active .hero-slide__description,
		.hero-slide.is-active .hero-slide__button,
		.hero-slide.is-active .hero-slide__trust {
			opacity: 0;
			transform: translateY(18px);
		}

		.hero-slide.is-active h1,
		.hero-slide.is-active h2 {
			opacity: 0;
			transform: translateY(22px);
		}
	}

	@keyframes slider-progress {
		from {
