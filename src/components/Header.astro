	}

	/*
	 * Movimiento reducido: el minicarrito solo funde. El modal se centra
	 * con `translate(-50%, -50%)`, asi que aqui se fija su estado final
	 * en vez de anular el `transform`, que romperia el centrado. El
	 * popover se ancla con `top`/`right` y si puede prescindir de el.
	 */
	@media (prefers-reduced-motion: reduce) {
		/*
		 * El retardo de `visibility` (arriba, 160ms) esta pensado para la
		 * salida animada normal. Aqui se acorta a los mismos 150ms del
		 * fundido reducido para que nunca quede "invisible pero enfocable"
		 * ni tampoco desaparezca antes de terminar de fundirse.
		 */
		.minicart {
			transition-delay: 150ms;
		}

		.minicart__backdrop {
			transition: opacity 150ms linear;
		}

		.minicart__dialog {
			transform: translate(-50%, -50%);
			transition: opacity 150ms linear;
		}

		@media (min-width: 768px) {
			.minicart[data-mode="popover"] .minicart__dialog {
				transform: none;
			}
		}
	}

	/* ---------- Animacion "el carrito se llena" ---------- */

	/*
	 * Capa que asciende dentro del cuerpo de la bolsa Lucide. Los
	 * porcentajes replican el area interior del path (viewBox 0 0 24 24):
	 * de x=4 a x=20 y de y=7.2 a y=21.8.
	 */
	.cart-button__fill {
		position: absolute;
		inset: 30% 17% 9% 17%;
		border-radius: 1px 1px 3px 3px;
		background: var(--color-orange);
		transform: scaleY(0);
		transform-origin: bottom center;
		opacity: 0;
		pointer-events: none;
	}

	.cart-button.is-cart-adding .cart-button__fill {
		animation: cart-fill 560ms cubic-bezier(0.33, 1, 0.68, 1) forwards;
	}

	.cart-button.is-cart-adding .cart-button__icon {
		animation: cart-lift 560ms cubic-bezier(0.33, 1, 0.68, 1);
	}

	.cart-button.is-cart-adding .cart-count {
		animation: cart-badge-pulse 460ms cubic-bezier(0.33, 1, 0.68, 1);
	}

	@keyframes cart-fill {
		0% {
			transform: scaleY(0);
			opacity: 0;
		}

		18% {
			opacity: 1;
		}

		62% {
			transform: scaleY(1);
			opacity: 1;
		}

		100% {
			transform: scaleY(1);
			opacity: 0;
		}
	}

	@keyframes cart-lift {
		0%,
		100% {
			transform: translateY(0) scale(1);
		}

		42% {
			transform: translateY(-2px) scale(1.06);
		}
	}

	@keyframes cart-badge-pulse {
		0%,
		100% {
			transform: scale(1);
		}

		45% {
			transform: scale(1.18);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cart-button.is-cart-adding .cart-button__fill,
		.cart-button.is-cart-adding .cart-button__icon,
		.cart-button.is-cart-adding .cart-count {
			animation: none;
		}
	}

	/*
	 * El atributo `hidden` debe ganar siempre. Una regla `display` de
	 * autor sobre la misma clase lo anulaba (ese era el origen del
	 * "carrito vacio" mostrado junto a un producto). Va al final del
	 * bloque para imponerse por orden, sin recurrir a !important.
	 */
	.minicart [hidden] {
		display: none;
	}
