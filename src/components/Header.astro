		gap: 6px;
	}

	.minicart__empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		padding: 44px 16px 36px;
		text-align: center;
	}

	.minicart__empty-icon {
		width: 32px;
		height: 32px;
		color: var(--ink-35);
	}

	.minicart__empty-title {
		margin: 6px 0 0;
