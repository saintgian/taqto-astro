	/*
	 * ---------- Minicarrito ----------
	 * Movil: modal centrado con backdrop (composicion aprobada).
	 * Desktop: popover anclado al icono del Header. La capa sigue
	 * cubriendo el viewport, pero es transparente: solo sirve para
	 * detectar el clic exterior, no oscurece la pagina.
	 */
	/*
	 * `visibility` se anima con retardo (tecnica clasica, sin depender de
	 * `transition-behavior: allow-discrete`): al cerrar, permanece
	 * `visible` 160ms -- lo que tarda la salida mas lenta del dialogo --
	 * para que el fundido de salida termine de reproducirse antes de
	 * desaparecer. Al abrir, el retardo se anula para que aparezca de
	 * inmediato.
	 */
	.minicart {
		position: fixed;
		inset: 0;
		z-index: 300;
		visibility: hidden;
		transition: visibility 0s linear 160ms;
	}

	.minicart.is-open {
		visibility: visible;
		transition-delay: 0s;
	}

	.minicart__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(20, 20, 20, 0.34);
		opacity: 0;
		transition: opacity 140ms var(--ease-out);
	}

	.minicart.is-open .minicart__backdrop {
		opacity: 1;
		transition: opacity 180ms var(--ease-out);
	}

	.minicart__dialog {
		position: absolute;
		top: 50%;
		left: 50%;
		width: min(92vw, 560px);
		max-height: min(78vh, 720px);
		display: flex;
		flex-direction: column;
		padding: 24px;
		border: 1px solid var(--ink-15);
		border-radius: 18px;
		background: var(--surface);
		color: var(--color-black);
		box-shadow: 0 18px 44px rgba(20, 20, 20, 0.14);
		opacity: 0;
		transform: translate(-50%, calc(-50% + 8px));
		pointer-events: none;
		transition:
			opacity 160ms var(--ease-out),
			transform 160ms var(--ease-out);
	}

	.minicart.is-open .minicart__dialog {
		opacity: 1;
		transform: translate(-50%, -50%);
		pointer-events: auto;
		transition:
			opacity 220ms var(--ease-panel),
			transform 220ms var(--ease-panel);
	}

	/* ---------- Popover anclado (desktop) ---------- */

	@media (min-width: 768px) {
		.minicart[data-mode="popover"] .minicart__backdrop {
			background: transparent;
		}

		/*
		 * `--minicart-top` / `--minicart-right` los calcula el script a
		 * partir del rect real del trigger. Los valores por defecto
		 * corresponden al Header en reposo, asi que la primera apertura
		 * no depende de que el calculo llegue antes que la pintura.
		 */
		.minicart[data-mode="popover"] .minicart__dialog {
			top: var(--minicart-top, 106px);
			right: var(--minicart-right, 24px);
			left: auto;
			width: min(440px, calc(100vw - 32px));
			max-height: var(--minicart-max-height, min(70vh, 650px));
			padding: 20px;
			border-radius: 16px;
			box-shadow: 0 16px 40px rgba(20, 20, 20, 0.13);
			transform: translateY(-8px) scale(0.97);
			transform-origin: top right;
		}

		.minicart[data-mode="popover"].is-open .minicart__dialog {
			transform: translateY(0) scale(1);
		}

		/* El popover es mas estrecho: la miniatura baja al minimo util. */
		.minicart[data-mode="popover"] .minicart__item {
			grid-template-columns: 76px minmax(0, 1fr) auto;
			column-gap: 12px;
		}

		.minicart[data-mode="popover"] .minicart__item-media {
			width: 76px;
			height: 76px;
		}
	}

	.minicart__head {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-xs);
