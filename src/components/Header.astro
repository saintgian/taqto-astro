---
import { sanityClient } from "../lib/sanity";
import { navigationCategoriesQuery } from "../lib/categoryQueries";
import {
	WHATSAPP_NUMBER,
	EMPRESAS_CATEGORY_SLUG,
	EMPRESAS_SUBCATEGORIES,
} from "../lib/constants";
import ProductSearch from "./ProductSearch.astro";
import {
	Search,
	ChevronDown,
	ChevronRight,
	ArrowRight,
	X,
	ShoppingBag,
	Trash2,
	Minus,
	Plus,
	ArrowLeft,
	LockKeyhole,
	Flame,
	UtensilsCrossed,
	Laptop,
	Gift,
	Building2,
	LayoutGrid,
} from "@lucide/astro";

interface NavSubcategory {
	_id: string;
	title: string;
	slug: string;
}

interface NavCategory {
	_id: string;
	title: string;
	eyebrow?: string;
	slug: string;
	subcategories?: NavSubcategory[];
}

const fetchedCategories =
	await sanityClient.fetch<NavCategory[]>(
		navigationCategoriesQuery,
	);

// "Empresas" no tiene subcategorias de producto en Sanity: sus dos
// enlaces (regalos corporativos y venta al por mayor) son paginas de
// contenido estaticas. Se completan aqui para que el mismo dropdown del
// header las muestre sin duplicar el menu.
const productCategories = fetchedCategories.map((category) =>
	category.slug === EMPRESAS_CATEGORY_SLUG &&
	(!category.subcategories || category.subcategories.length === 0)
		? { ...category, subcategories: EMPRESAS_SUBCATEGORIES }
		: category,
);

const base = import.meta.env.BASE_URL;

const withBase = (path = "") =>
	`${base}${path.replace(/^\/+/, "")}`;

const basePath =
	base === "/"
		? ""
		: base.replace(/\/$/, "");

const currentPath =
	Astro.url.pathname.startsWith(basePath)
		? Astro.url.pathname.slice(basePath.length) || "/"
		: Astro.url.pathname;

const homeHref = withBase();
const storeHref = withBase("tienda/");
const cartHref = withBase("carrito/");

const headerLogo =
	`${base}brand/logotipo/logotipo-colorprincipal01.svg`;

const mobileLogo =
	`${base}brand/isotipo/isotipo-colorprincipal02.svg`;

const whatsappMessage = encodeURIComponent(
	"Hola TAQTO, quisiera información sobre sus productos.",
);

const whatsappHref =
	`https://wa.me/${WHATSAPP_NUMBER}?text=${whatsappMessage}`;

const categoryIcons: Record<string, typeof Flame> = {
	parrilla: Flame,
	"cocina-y-mesa": UtensilsCrossed,
	oficina: Laptop,
	"kits-y-regalos": Gift,
	empresas: Building2,
};

const getCategoryIcon = (slug: string) =>
	categoryIcons[slug] || LayoutGrid;
---

<header
	class="site-header"
	data-site-header
	transition:persist="site-header"
>
	<div class="header-shell">
		<div class="announcement">
			<p class="announcement__item">
				Grabado láser personalizado siempre gratuito
			</p>

			<span
				class="announcement__divider"
				aria-hidden="true"
			></span>

			<p class="announcement__item announcement__item--secondary">
				Envíos a todo Lima y el Perú
			</p>
		</div>

		<div class="header-main">
			<div class="header-mobile-left">
				<button
					class="menu-toggle"
					type="button"
					aria-label="Abrir menú"
					aria-expanded="false"
					aria-controls="primary-navigation"
					data-menu-toggle
				>
					<span></span>
					<span></span>
					<span></span>
				</button>

				<button
					type="button"
					class="icon-button mobile-search-button"
					aria-label="Buscar productos"
					aria-expanded="false"
					aria-controls="product-search-panel"
					data-search-trigger
				>
					<Search aria-hidden="true" stroke-width={1.75} />
				</button>
			</div>

			<a
				class="brand"
				href={homeHref}
				aria-label="TAQTO, volver al inicio"
			>
				<img
					class="brand__logo brand__logo--desktop"
					src={headerLogo}
					alt="TAQTO — Diseño con alma de madera"
					width="917"
					height="235"
				/>

				<img
					class="brand__logo brand__logo--mobile"
					src={mobileLogo}
					alt="TAQTO"
					width="511"
					height="425"
				/>
			</a>

			<nav
				id="primary-navigation"
				class="navigation"
				aria-label="Navegación principal"
				data-navigation
			>
				<ul class="navigation__list">
					<li class="navigation__item">
						<a
							class:list={[
								"navigation__link",
								{
									"is-current":
										currentPath === "/tienda/",
								},
							]}
							href={storeHref}
						>
							Tienda
						</a>
					</li>

					{
						productCategories.map((category) => {
							const categoryPath =
								`/categorias/${category.slug}/`;

							const categoryHref =
								withBase(`categorias/${category.slug}/`);

							const isCurrent =
								currentPath.startsWith(categoryPath);

							const CategoryIcon = getCategoryIcon(category.slug);

							return (
								<li
									class:list={[
										"navigation__item",
										"navigation__item--dropdown",
										{ "is-current-category": isCurrent },
									]}
									data-dropdown
								>
									<div class="navigation__parent">
										<a
											class:list={[
												"navigation__link",
												{ "is-current": isCurrent },
											]}
											href={categoryHref}
										>
											<span class="navigation__category-icon">
												<CategoryIcon aria-hidden="true" />
											</span>

											<span>{category.title}</span>
										</a>

										<button
											class="navigation__dropdown-toggle"
											type="button"
											aria-label={`Mostrar subcategorías de ${category.title}`}
											aria-expanded="false"
											data-dropdown-toggle
										>
											<ChevronDown aria-hidden="true" stroke-width={1.75} />
										</button>
									</div>

									<div
										class="dropdown"
										data-dropdown-menu
									>
										<div class="dropdown__header">
											<span class="dropdown__category-icon">
												<CategoryIcon aria-hidden="true" />
											</span>

											<div>
												<p>{category.eyebrow}</p>
												<h2>{category.title}</h2>
											</div>
										</div>

										<ul class="dropdown__links">
											{
												(category.subcategories || []).map(
													(subcategory) => (
														<li>
															<a
																href={withBase(
																	`categorias/${category.slug}/${subcategory.slug}/`,
																)}
															>
																<span>
																	{subcategory.title}
																</span>

																<ChevronRight aria-hidden="true" stroke-width={1.75} />
															</a>
														</li>
													),
												)
											}
										</ul>

										<a
											class="dropdown__view-all"
											href={categoryHref}
										>
											<span>Ver toda la categoría</span>
											<ArrowRight aria-hidden="true" size={16} stroke-width={1.75} />
										</a>
									</div>
								</li>
							);
						})
					}
				</ul>
			</nav>

			<div class="header-actions">
				<button
					type="button"
					class="icon-button desktop-search-button"
					aria-label="Buscar productos"
					aria-expanded="false"
					aria-controls="product-search-panel"
					data-search-trigger
				>
					<Search aria-hidden="true" stroke-width={1.75} />
				</button>

				<a
					class="icon-button whatsapp-button"
					href={whatsappHref}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Contactar a TAQTO por WhatsApp"
				>
					<img
						src={`${base}icons/icon-whastapp.svg`}
						alt=""
						width="22"
						height="22"
					/>
				</a>

				<button
					type="button"
					class="icon-button cart-button"
					aria-label="Carrito, 0 productos"
					aria-expanded="false"
					aria-controls="minicart"
					aria-haspopup="dialog"
					data-cart-trigger
				>
					<span class="cart-button__icon">
						<ShoppingBag aria-hidden="true" stroke-width={1.75} />

						<span
							class="cart-button__fill"
							aria-hidden="true"
						></span>

						<span class="cart-count" data-cart-count>0</span>
					</span>

					<span class="cart-button__total" data-cart-total>
						S/ 0.00
					</span>
				</button>
			</div>
		</div>
	</div>

	<!--
		Minicarrito: modal compacto centrado (no drawer). El cuerpo se
		reescribe entero en cada render para que el DOM represente una
		sola condicion: o lista de productos o estado vacio, nunca ambas.
	-->
	<div
		class="minicart"
		id="minicart"
		data-minicart
		data-state="empty"
		aria-hidden="true"
	>
		<div class="minicart__backdrop" data-minicart-backdrop></div>

		<div
			class="minicart__dialog"
			role="dialog"
			aria-modal="true"
			aria-labelledby="minicart-title"
			data-minicart-dialog
		>
			<div class="minicart__head">
				<!--
					El titulo del dialogo es un <p>, no un heading: la pagina
					mantiene su unico H1 y el esquema de encabezados no cambia.
					`aria-labelledby` no exige que sea un heading.
				-->
				<p class="minicart__title" id="minicart-title">
					<ShoppingBag
						class="minicart__title-icon"
						aria-hidden="true"
						stroke-width={1.75}
					/>
					Tu carrito
				</p>

				<button
					type="button"
					class="btn btn--icon minicart__close"
					data-minicart-close
					aria-label="Cerrar carrito"
					title="Cerrar carrito"
				>
					<X aria-hidden="true" stroke-width={1.75} />
				</button>
			</div>

			<div class="minicart__body" data-minicart-body>
				<div class="minicart__empty">
					<ShoppingBag
						class="minicart__empty-icon"
						aria-hidden="true"
						stroke-width={1.75}
					/>

					<p class="minicart__empty-title">
						Tu carrito está vacío
					</p>

					<p class="minicart__empty-text">
						Explora el catálogo y añade tu primera pieza
						con grabado personalizado.
					</p>

					<a
						class="btn btn--primary minicart__empty-link"
						href={storeHref}
					>
						Ver catálogo
					</a>
				</div>
			</div>

			<p
				class="minicart__stock-note"
				id="minicart-stock-note"
				role="status"
				aria-live="polite"
			></p>

			<div class="minicart__foot" data-minicart-foot hidden>
				<div class="minicart__subtotal">
					<span>Subtotal</span>
					<strong data-minicart-subtotal>S/ 0.00</strong>
				</div>

				<a
					class="btn btn--primary btn--full minicart__checkout"
					href={cartHref}
				>
					<LockKeyhole aria-hidden="true" stroke-width={1.75} />
					Ir a pagar
				</a>

				<button
					type="button"
					class="btn btn--secondary btn--full minicart__keep"
					data-minicart-close
				>
					<ArrowLeft aria-hidden="true" stroke-width={1.75} />
					Seguir comprando
				</button>
			</div>
		</div>
	</div>
</header>

<!--
	Plantillas del minicarrito. Mantienen los iconos Lucide reales
	(nada de SVG copiados a mano dentro de cadenas de innerHTML).
-->
<template data-minicart-list-template>
	<ul class="minicart__list"></ul>
</template>

<template data-minicart-empty-template>
	<div class="minicart__empty">
		<ShoppingBag
			class="minicart__empty-icon"
			aria-hidden="true"
			stroke-width={1.75}
		/>

		<p class="minicart__empty-title">Tu carrito está vacío</p>

		<p class="minicart__empty-text">
			Explora el catálogo y añade tu primera pieza con grabado
			personalizado.
		</p>

		<a class="btn btn--primary minicart__empty-link" href={storeHref}>
			Ver catálogo
		</a>
	</div>
</template>

<template data-minicart-item-template>
	<li class="minicart__item">
		<span class="minicart__item-media">
			<img data-role="image" alt="" loading="lazy" />
			<span class="minicart__item-placeholder" data-role="placeholder">
				TAQTO
			</span>
		</span>

		<div class="minicart__item-main">
			<p class="minicart__item-title" data-role="title"></p>
			<p class="minicart__item-variant" data-role="variant"></p>
			<p class="minicart__item-engraving" data-role="engraving"></p>
		</div>

		<div class="minicart__item-qty" data-role="quantity">
			<button type="button" data-role="decrease">
				<Minus aria-hidden="true" stroke-width={1.75} />
			</button>

			<span data-role="quantity-value">1</span>

			<button type="button" data-role="increase">
				<Plus aria-hidden="true" stroke-width={1.75} />
			</button>
		</div>

		<p class="minicart__item-price" data-role="price"></p>

		<button
			type="button"
			class="btn btn--danger minicart__item-remove"
			data-role="remove"
		>
			<Trash2 aria-hidden="true" stroke-width={1.75} />
			<span class="minicart__item-remove-text">Quitar</span>
		</button>
	</li>
</template>

<ProductSearch
	categories={productCategories.map((category) => ({
		title: category.title,
		slug: category.slug,
	}))}
/>

<script>
	import {
		getCart,
		getItemCount,
		getSubtotal,
		removeItem,
		updateQuantity,
		onCartUpdated,
		onCartItemAdded,
		type CartItem,
	} from "../lib/cart";

	import { formatPEN } from "../lib/productPricing";
	import { openOverlay, closeOverlay } from "../lib/overlay";

	const OVERLAY_ID = "minicart";
	const FILL_ANIMATION_MS = 560;

	const variantLabelOf = (item: CartItem) =>
		[item.woodTitle, item.sizeTitle]
			.filter(Boolean)
			.join(" · ");

	const initMinicart = () => {
		const minicart =
			document.querySelector<HTMLElement>("[data-minicart]");

		if (!minicart || minicart.dataset.initialized === "true") {
			return;
		}

		minicart.dataset.initialized = "true";

		const dialog = minicart.querySelector<HTMLElement>(
			"[data-minicart-dialog]",
		);
		const backdrop = minicart.querySelector<HTMLElement>(
			"[data-minicart-backdrop]",
		);
		const body = minicart.querySelector<HTMLElement>(
			"[data-minicart-body]",
		);
		const foot = minicart.querySelector<HTMLElement>(
			"[data-minicart-foot]",
		);
		const subtotalLabel = minicart.querySelector<HTMLElement>(
			"[data-minicart-subtotal]",
		);
		const stockNote = minicart.querySelector<HTMLElement>(
			"#minicart-stock-note",
		);
		const listTemplate = document.querySelector<HTMLTemplateElement>(
			"[data-minicart-list-template]",
		);
		const emptyTemplate = document.querySelector<HTMLTemplateElement>(
			"[data-minicart-empty-template]",
		);
		const itemTemplate = document.querySelector<HTMLTemplateElement>(
			"[data-minicart-item-template]",
		);

		if (
			!dialog ||
			!backdrop ||
			!body ||
			!foot ||
			!subtotalLabel ||
			!listTemplate ||
			!emptyTemplate ||
			!itemTemplate
		) {
			return;
		}

		let stockNoteTimer: number | undefined;

		const announceStockLimit = (
			title: string,
			limit: number,
		) => {
			if (!stockNote) return;

			if (stockNoteTimer !== undefined) {
				window.clearTimeout(stockNoteTimer);
			}

			stockNote.textContent = "";

			window.requestAnimationFrame(() => {
				stockNote.textContent = `${title}: alcanzaste el máximo disponible (${limit} unidad${limit === 1 ? "" : "es"}).`;
			});

			stockNoteTimer = window.setTimeout(() => {
				stockNote.textContent = "";
				stockNoteTimer = undefined;
			}, 3000);
		};

		const triggers = () =>
			Array.from(
				document.querySelectorAll<HTMLButtonElement>(
					"[data-cart-trigger]",
				),
			);

		const cloneOf = (template: HTMLTemplateElement) =>
			template.content.firstElementChild!.cloneNode(
				true,
			) as HTMLElement;

		const buildRow = (item: CartItem) => {
			const row = cloneOf(itemTemplate);

			row.dataset.itemId = item.id;

			const pick = <T extends HTMLElement>(role: string) =>
				row.querySelector<T>(`[data-role="${role}"]`);

			const image = pick<HTMLImageElement>("image");
			const placeholder = pick("placeholder");

			if (item.image && image) {
				image.src = item.image;
				image.alt = item.title;
				placeholder?.remove();
			} else {
				image?.remove();
			}

			const title = pick("title");
			if (title) title.textContent = item.title;

			const variantText = variantLabelOf(item);
			const variant = pick("variant");

			if (variant) {
				if (variantText) {
					variant.textContent = variantText;
				} else {
					variant.remove();
				}
			}

			const engraving = pick("engraving");

			if (engraving) {
				if (item.engravingText) {
					engraving.textContent = `Grabado: “${item.engravingText}”`;
				} else {
					engraving.remove();
				}
			}

			const quantityValue = pick("quantity-value");
			if (quantityValue) {
				quantityValue.textContent = String(item.quantity);
			}

			const quantityGroup = pick("quantity");
			quantityGroup?.setAttribute(
				"aria-label",
				`Cantidad de ${item.title}`,
			);

			const decrease = pick<HTMLButtonElement>("decrease");

			if (decrease) {
				decrease.setAttribute(
					"aria-label",
					`Disminuir cantidad de ${item.title}`,
				);
				decrease.disabled = item.quantity <= 1;
				decrease.addEventListener("click", () => {
					updateQuantity(item.id, item.quantity - 1);
				});
			}

			const increase = pick<HTMLButtonElement>("increase");

			if (increase) {
				const stockLimit =
					typeof item.stock === "number"
						? Math.max(0, Math.floor(item.stock))
						: undefined;

				const atMax =
					typeof stockLimit === "number" &&
					item.quantity >= stockLimit;

				increase.disabled = atMax;
				increase.setAttribute(
					"aria-disabled",
					String(atMax),
				);

				increase.setAttribute(
					"aria-label",
					`Aumentar cantidad de ${item.title}`,
				);
				increase.addEventListener("click", () => {
					if (atMax) {
						announceStockLimit(
							item.title,
							stockLimit as number,
						);
						return;
					}

					updateQuantity(item.id, item.quantity + 1);
				});
			}

			const price = pick("price");
			if (price) {
				price.textContent = formatPEN(
					item.unitPrice * item.quantity,
				);
			}

			const remove = pick<HTMLButtonElement>("remove");

			if (remove) {
				remove.setAttribute(
					"aria-label",
					`Quitar ${item.title} del carrito`,
				);
				remove.addEventListener("click", () => {
					removeItem(item.id);
				});
			}

			return row;
		};

		/*
		 * El cuerpo se reconstruye entero: o lista o estado vacio. Nunca
		 * conviven en el DOM, asi que no puede volver a verse "Tu carrito
		 * esta vacio" encima de un producto.
		 */
		/*
		 * El cuerpo se reescribe entero en cada render, asi que el control
		 * que tenia el foco desaparece. Se anota cual era para devolverlo:
		 * sin esto, ajustar la cantidad tira el foco al body y el popover
		 * pierde el contexto de teclado.
		 */
		const rememberFocus = () => {
			const element = document.activeElement as HTMLElement | null;

			if (!element || !body.contains(element)) return null;

			const row = element.closest<HTMLElement>("[data-item-id]");
			const role = element.getAttribute("data-role");

			return row?.dataset.itemId && role
				? { id: row.dataset.itemId, role }
				: null;
		};

		const restoreFocus = (
			memory: { id: string; role: string } | null,
		) => {
			if (!memory) return;

			const row = body.querySelector<HTMLElement>(
				`[data-item-id="${CSS.escape(memory.id)}"]`,
			);

			if (!row) return;

			const exact = row.querySelector<HTMLButtonElement>(
				`[data-role="${memory.role}"]`,
			);

			// Si el control quedo deshabilitado (bajar de 1, o llegar al
			// stock maximo) el foco pasa al hermano util en vez de perderse.
			const increaseBtn = row.querySelector<HTMLButtonElement>(
				'[data-role="increase"]',
			);
			const decreaseBtn = row.querySelector<HTMLButtonElement>(
				'[data-role="decrease"]',
			);
			const removeBtn = row.querySelector<HTMLButtonElement>(
				'[data-role="remove"]',
			);

			const target =
				exact && !exact.disabled
					? exact
					: (increaseBtn && !increaseBtn.disabled && increaseBtn) ||
						(decreaseBtn && !decreaseBtn.disabled && decreaseBtn) ||
						removeBtn;

			target?.focus();
		};

		const renderMinicart = () => {
			const focusMemory = rememberFocus();
			const items = getCart();
			const count = getItemCount();
			const subtotal = getSubtotal();
			const isEmpty = items.length === 0;

			document
				.querySelectorAll<HTMLElement>("[data-cart-count]")
				.forEach((badge) => {
					badge.textContent = String(count);
				});

			document
				.querySelectorAll<HTMLElement>("[data-cart-total]")
				.forEach((label) => {
					label.textContent = formatPEN(subtotal);
				});

			triggers().forEach((trigger) => {
				trigger.setAttribute(
					"aria-label",
					`Carrito, ${count} ${
						count === 1 ? "producto" : "productos"
					}`,
				);
			});

			minicart.dataset.state = isEmpty ? "empty" : "filled";
			body.replaceChildren();

			if (isEmpty) {
				body.appendChild(cloneOf(emptyTemplate));
				foot.hidden = true;
				subtotalLabel.textContent = formatPEN(0);
				return;
			}

			const list = cloneOf(listTemplate);
			items.forEach((item) => list.appendChild(buildRow(item)));

			body.appendChild(list);
			foot.hidden = false;
			subtotalLabel.textContent = formatPEN(subtotal);

			restoreFocus(focusMemory);
		};

		const isOpen = () => minicart.classList.contains("is-open");

		/*
		 * El breakpoint sale del layout: por debajo el Header colapsa y
		 * anclar un popover al icono deja de tener sentido.
		 */
		const desktopQuery = window.matchMedia("(min-width: 768px)");
		const isPopover = () => desktopQuery.matches;

		let anchorTrigger: HTMLElement | null = null;
		let anchorFrame = 0;

		/* Posicion del popover a partir del rect real del trigger. */
		const anchorToTrigger = () => {
			if (!anchorTrigger || !isPopover()) return;

			const rect = anchorTrigger.getBoundingClientRect();
			const top = rect.bottom + 12;

			/*
			 * El dialogo se posiciona contra el bloque contenedor inicial,
			 * que excluye la barra de scroll: usar `innerWidth` lo dejaria
			 * desplazado justo el ancho de esa barra.
			 */
			const viewportWidth = document.documentElement.clientWidth;
			const viewportHeight = document.documentElement.clientHeight;

			// Borde derecho alineado con el trigger, con margen seguro.
			const right = Math.max(
				16,
				Math.min(
					viewportWidth - rect.right,
					viewportWidth - 16,
				),
			);

			const available = viewportHeight - top - 16;

			const maxHeight = Math.max(
				260,
				Math.min(650, viewportHeight * 0.7, available),
			);

			minicart.style.setProperty("--minicart-top", `${top}px`);
			minicart.style.setProperty("--minicart-right", `${right}px`);

			minicart.style.setProperty(
				"--minicart-max-height",
				`${maxHeight}px`,
			);
		};

		const scheduleAnchor = () => {
			if (anchorFrame) return;

			anchorFrame = window.requestAnimationFrame(() => {
				anchorFrame = 0;
				anchorToTrigger();
			});
		};

		const closeMinicart = () => {
			if (!isOpen()) return;

			minicart.classList.remove("is-open");
			minicart.setAttribute("aria-hidden", "true");
			anchorTrigger = null;

			window.removeEventListener("resize", scheduleAnchor);
			window.removeEventListener("scroll", scheduleAnchor, true);

			triggers().forEach((trigger) => {
				trigger.setAttribute("aria-expanded", "false");
			});

			closeOverlay(OVERLAY_ID);
		};

		const openMinicart = (trigger: HTMLElement) => {
			if (isOpen()) return;

			const popover = isPopover();

			minicart.dataset.mode = popover ? "popover" : "modal";

			/*
			 * `aria-modal` solo cuando de verdad bloquea la pagina: el
			 * popover de desktop no lo hace.
			 */
			if (popover) {
				dialog.removeAttribute("aria-modal");
			} else {
				dialog.setAttribute("aria-modal", "true");
			}

			anchorTrigger = trigger;

			if (popover) {
				anchorToTrigger();

				window.addEventListener("resize", scheduleAnchor);
				window.addEventListener("scroll", scheduleAnchor, true);
			}

			minicart.classList.add("is-open");
			minicart.setAttribute("aria-hidden", "false");

			triggers().forEach((element) => {
				element.setAttribute("aria-expanded", "true");
			});

			openOverlay({
				id: OVERLAY_ID,
				container: dialog,
				trigger,
				close: closeMinicart,
				modal: !popover,
				initialFocus:
					minicart.querySelector<HTMLElement>(
						"[data-minicart-close]",
					),
			});
		};

		triggers().forEach((trigger) => {
			trigger.addEventListener("click", () => {
				if (isOpen()) {
					closeMinicart();
				} else {
					openMinicart(trigger);
				}
			});
		});

		// Cambiar de popover a modal (o al reves) con el panel abierto
		// dejaria un dialogo mal anclado: se cierra y se reabre limpio.
		desktopQuery.addEventListener("change", () => {
			if (isOpen()) closeMinicart();
		});

		backdrop.addEventListener("click", closeMinicart);

		minicart
			.querySelectorAll<HTMLElement>("[data-minicart-close]")
			.forEach((element) => {
				element.addEventListener("click", closeMinicart);
			});

		// ---------- Animacion "el carrito se llena" ----------

		let fillTimer: ReturnType<typeof setTimeout> | undefined;

		const playFillAnimation = () => {
			const prefersReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			if (prefersReducedMotion) return;

			const buttons = triggers();
			if (buttons.length === 0) return;

			// Un unico timer compartido: reagregar rapido reinicia la
			// animacion en vez de acumular temporizadores.
			if (fillTimer) clearTimeout(fillTimer);

			buttons.forEach((button) => {
				button.classList.remove("is-cart-adding");
			});

			// Reflow forzado para que el navegador reinicie la animacion
			// cuando la clase se quita y se vuelve a poner en el mismo tick.
			void buttons[0].offsetWidth;

			buttons.forEach((button) => {
				button.classList.add("is-cart-adding");
			});

			fillTimer = setTimeout(() => {
				buttons.forEach((button) => {
					button.classList.remove("is-cart-adding");
				});

				fillTimer = undefined;
			}, FILL_ANIMATION_MS);
		};

		renderMinicart();
		onCartUpdated(renderMinicart);
		onCartItemAdded(playFillAnimation);
	};

	initMinicart();
	document.addEventListener("astro:page-load", initMinicart);

	/*
	 * Reset duro y sincrono del menu movil. Vive fuera de
	 * `initializeHeaders` porque el <header> lleva `transition:persist`:
	 * sobrevive a las navegaciones del ClientRouter, asi que su estado
	 * abierto tambien lo haria si nadie lo limpiase. Es idempotente y no
	 * anima nada -- se usa justo antes de navegar, cuando el panel debe
	 * desaparecer de inmediato, no acompanar al fade.
	 */
	const resetMobileMenus = () => {
		document.body.classList.remove("menu-is-open");

		document
			.querySelectorAll<HTMLElement>("[data-site-header]")
			.forEach((header) => {
				header
					.querySelector<HTMLElement>("[data-navigation]")
					?.classList.remove("is-open");

				header
					.querySelector<HTMLButtonElement>("[data-menu-toggle]")
					?.setAttribute("aria-expanded", "false");

				header
					.querySelectorAll<HTMLElement>("[data-dropdown]")
					.forEach((dropdown) => {
						dropdown.classList.remove("is-open");

						dropdown
							.querySelector<HTMLButtonElement>(
								"[data-dropdown-toggle]",
							)
							?.setAttribute("aria-expanded", "false");

						const panel =
							dropdown.querySelector<HTMLElement>(
								"[data-dropdown-menu]",
							);

						/*
						 * La animacion de altura deja estilos en linea;
						 * hay que borrarlos o el panel reaparece con una
						 * altura fija en la siguiente pagina.
						 */
						if (panel) {
							panel.style.height = "";
							panel.style.transition = "";
						}
					});
			});
	};

	/*
	 * Doble red de seguridad alrededor de cada navegacion del router:
	 * antes de intercambiar el documento y despues de cargarlo. Se
	 * registran a nivel de modulo (una sola vez por carga completa), no
	 * dentro del bucle de headers, para no acumular listeners.
	 */
	document.addEventListener("astro:before-swap", resetMobileMenus);
	document.addEventListener("astro:after-swap", resetMobileMenus);

	const initializeHeaders = () => {
		const headers =
			document.querySelectorAll<HTMLElement>("[data-site-header]");

		headers.forEach((header) => {
			if (header.dataset.initialized === "true") return;

			header.dataset.initialized = "true";

			const menuButton =
				header.querySelector<HTMLButtonElement>("[data-menu-toggle]");

			const navigation =
				header.querySelector<HTMLElement>("[data-navigation]");

			const dropdowns = Array.from(
				header.querySelectorAll<HTMLElement>("[data-dropdown]"),
			);

			const isMobileNav = () => window.innerWidth <= 1180;

			const prefersReducedMotion = () =>
				window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				).matches;

			/*
			 * El panel movil vive en el flujo del documento (no es un
			 * overlay absoluto como en desktop), asi que abrir/cerrar
			 * anima su altura real -- medida en cada uso, nunca un
			 * numero grande arbitrario -- en vez de solo alternar
			 * visibilidad.
			 */
			const animateDropdownOpen = (panel: HTMLElement) => {
				if (!isMobileNav() || prefersReducedMotion()) return;

				const target = panel.scrollHeight;

				panel.style.transition = "none";
				panel.style.height = "0px";
				void panel.offsetHeight;

				requestAnimationFrame(() => {
					panel.style.transition = "height 220ms ease";
					panel.style.height = `${target}px`;
				});

				const onEnd = (event: TransitionEvent) => {
					if (
						event.propertyName !== "height" ||
						event.target !== panel
					) {
						return;
					}

					panel.style.height = "";
					panel.style.transition = "";
					panel.removeEventListener(
						"transitionend",
						onEnd,
					);
				};

				panel.addEventListener("transitionend", onEnd);
			};

			const animateDropdownClose = (panel: HTMLElement) => {
				if (!isMobileNav() || prefersReducedMotion()) return;

				const startHeight = panel.offsetHeight;

				panel.style.transition = "none";
				panel.style.height = `${startHeight}px`;
				void panel.offsetHeight;

				requestAnimationFrame(() => {
					panel.style.transition = "height 200ms ease";
					panel.style.height = "0px";
				});

				const onEnd = (event: TransitionEvent) => {
					if (
						event.propertyName !== "height" ||
						event.target !== panel
					) {
						return;
					}

					panel.style.height = "";
					panel.style.transition = "";
					panel.removeEventListener(
						"transitionend",
						onEnd,
					);
				};

				panel.addEventListener("transitionend", onEnd);
			};

			const closeDropdown = (dropdown: HTMLElement) => {
				if (!dropdown.classList.contains("is-open")) return;

				const panel = dropdown.querySelector<HTMLElement>(
					"[data-dropdown-menu]",
				);

				dropdown.classList.remove("is-open");

				dropdown
					.querySelector<HTMLButtonElement>(
						"[data-dropdown-toggle]",
					)
					?.setAttribute("aria-expanded", "false");

				if (panel) animateDropdownClose(panel);
			};

			const closeAllDropdowns = (
				exception?: HTMLElement,
			) => {
				dropdowns.forEach((dropdown) => {
					if (dropdown !== exception) {
						closeDropdown(dropdown);
					}
				});
			};

			const closeMobileMenu = () => {
				navigation?.classList.remove("is-open");

				menuButton?.setAttribute(
					"aria-expanded",
					"false",
				);

				document.body.classList.remove(
					"menu-is-open",
				);

				closeAllDropdowns();
			};

			menuButton?.addEventListener("click", () => {
				const willOpen =
					menuButton.getAttribute("aria-expanded") !==
					"true";

				menuButton.setAttribute(
					"aria-expanded",
					String(willOpen),
				);

				navigation?.classList.toggle(
					"is-open",
					willOpen,
				);

				document.body.classList.toggle(
					"menu-is-open",
					willOpen,
				);

				if (!willOpen) {
					closeAllDropdowns();
				}
			});

			dropdowns.forEach((dropdown) => {
				const toggle =
					dropdown.querySelector<HTMLButtonElement>(
						"[data-dropdown-toggle]",
					);

				let leaveTimer:
					| ReturnType<typeof setTimeout>
					| undefined;

				const openDropdown = () => {
					if (leaveTimer) {
						clearTimeout(leaveTimer);
					}

					closeAllDropdowns(dropdown);

					dropdown.classList.add("is-open");

					toggle?.setAttribute(
						"aria-expanded",
						"true",
					);
				};

				toggle?.addEventListener("click", (event) => {
					event.preventDefault();
					event.stopPropagation();

					const willOpen =
						!dropdown.classList.contains(
							"is-open",
						);

					closeAllDropdowns(dropdown);

					dropdown.classList.toggle(
						"is-open",
						willOpen,
					);

					toggle.setAttribute(
						"aria-expanded",
						String(willOpen),
					);

					if (willOpen) {
						const panel =
							dropdown.querySelector<HTMLElement>(
								"[data-dropdown-menu]",
							);

						if (panel) animateDropdownOpen(panel);
					}
				});

				dropdown.addEventListener(
					"mouseenter",
					() => {
						if (window.innerWidth > 1180) {
							openDropdown();
						}
					},
				);

				dropdown.addEventListener(
					"mouseleave",
					() => {
						if (window.innerWidth > 1180) {
							leaveTimer = setTimeout(() => {
								closeDropdown(dropdown);
							}, 180);
						}
					},
				);
			});

			/*
			 * Causa del bug original: el unico cierre por click vivia en
			 * el listener de "click fuera del header", y los enlaces del
			 * menu estan *dentro* del header. Al navegar, el panel seguia
			 * abierto por encima del fade. Delegacion sobre el propio
			 * panel: un solo listener, valido tambien para el teclado
			 * (Enter sobre un enlace dispara "click").
			 */
			navigation?.addEventListener("click", (event) => {
				if (!isMobileNav()) return;

				const link =
					event.target instanceof Element
						? event.target.closest<HTMLAnchorElement>("a[href]")
						: null;

				if (!link || !navigation.contains(link)) return;

				/*
				 * Clicks que no navegan en esta pestana (nueva pestana,
				 * descarga, click con modificador o boton central): el
				 * usuario se queda donde esta, cerrar el menu seria
				 * inesperado.
				 */
				if (
					event.defaultPrevented ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey ||
					("button" in event && event.button !== 0) ||
					link.hasAttribute("download") ||
					(link.target && link.target !== "_self")
				) {
					return;
				}

				resetMobileMenus();
			});

			document.addEventListener("click", (event) => {
				if (
					event.target instanceof Node &&
					!header.contains(event.target)
				) {
					closeMobileMenu();
				}
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					closeMobileMenu();
				}
			});

			window.addEventListener("resize", () => {
				if (window.innerWidth > 1180) {
					navigation?.classList.remove("is-open");

					menuButton?.setAttribute(
						"aria-expanded",
						"false",
					);

					document.body.classList.remove(
						"menu-is-open",
					);
				}

				closeAllDropdowns();
			});
		});
	};

	initializeHeaders();

	document.addEventListener(
		"astro:page-load",
		initializeHeaders,
	);
</script>

