---
import { sanityClient } from "../lib/sanity";
import { navigationCategoriesQuery } from "../lib/categoryQueries";
import {
	WHATSAPP_NUMBER,
	EMPRESAS_CATEGORY_SLUG,
} from "../lib/constants";

interface Props {
	whatsappNumber?: string;
	whatsappMessage?: string;
}

const {
	whatsappNumber = WHATSAPP_NUMBER,
	whatsappMessage =
		"Hola TAQTO, quisiera información sobre sus productos.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const getUrl = (path: string) =>
	`${base}${path.startsWith("/") ? path : `/${path}`}`;

const footerLogo =
	`${base}/brand/imagotipo/imagotipo-colorprincipal02.svg`;

interface FooterCategory {
	_id: string;
	title: string;
	slug: string;
}

const navCategories =
	await sanityClient.fetch<FooterCategory[]>(
		navigationCategoriesQuery,
	);

/* Comprar: tienda + categorias reales de Sanity (sin "empresas", que
 * tiene su propio grupo). */
const compraLinks = [
	{ label: "Tienda", href: getUrl("/tienda/") },
	...navCategories
		.filter(
			(category) => category.slug !== EMPRESAS_CATEGORY_SLUG,
		)
		.map((category) => ({
			label: category.title,
			href: getUrl(`/categorias/${category.slug}/`),
		})),
];

const taqtoLinks = [
	{ label: "Nosotros", href: getUrl("/nosotros/") },
	{
		label: "Empresas",
		href: getUrl(`/categorias/${EMPRESAS_CATEGORY_SLUG}/`),
	},
	{
		label: "Regalos corporativos",
		href: getUrl(
			`/categorias/${EMPRESAS_CATEGORY_SLUG}/regalos-corporativos/`,
		),
	},
	{ label: "Contáctanos", href: getUrl("/contactanos/") },
];

const ayudaLinks = [
	{ label: "Envíos", href: getUrl("/envios/") },
	{ label: "Cuidados", href: getUrl("/cuidados/") },
	{
		label: "Preguntas frecuentes",
		href: getUrl("/preguntas-frecuentes/"),
	},
	{
		label: "Garantía de productos",
		href: getUrl("/garantia/"),
	},
];

const navGroups = [
	{ title: "Comprar", links: compraLinks },
	{ title: "TAQTO", links: taqtoLinks },
	{ title: "Ayuda", links: ayudaLinks },
];

const formattedWhatsappMsg =
	encodeURIComponent(whatsappMessage);

const whatsappUrl =
	`https://wa.me/${whatsappNumber}?text=${formattedWhatsappMsg}`;

const socialLinks = [
	{
		label: "Instagram",
		href: "https://instagram.com/",
		icon: "instagram",
	},
	{
		label: "Facebook",
		href: "https://facebook.com/",
		icon: "facebook",
	},
	{
		label: "TikTok",
		href: "https://tiktok.com/",
		icon: "tiktok",
	},
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-top">
			<nav
				class="footer-nav"
				aria-label="Navegación del pie de página"
			>
				{
					navGroups.map((group) => (
						<div class="footer-nav-group">
							<h3>{group.title}</h3>

							<ul>
								{group.links.map((link) => (
									<li>
										<a href={link.href}>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>

			<div
				class="footer-nav-mobile"
				aria-label="Navegación del pie de página"
			>
				{
					navGroups.map((group) => (
						<details class="footer-accordion">
							<summary>
								{group.title}

								<svg
									class="footer-accordion__chevron"
									viewBox="0 0 16 16"
									aria-hidden="true"
								>
									<path d="M4 6l4 4 4-4"></path>
								</svg>
							</summary>

							<ul>
								{group.links.map((link) => (
									<li>
										<a href={link.href}>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</details>
					))
				}
			</div>

			<div class="footer-brand">
				<a
					class="footer-brand__logo"
					href={getUrl("/")}
					aria-label="TAQTO, volver al inicio"
				>
					<img
						src={footerLogo}
						alt="TAQTO — Diseño con alma de madera"
						width="694"
						height="553"
						loading="lazy"
						decoding="async"
					/>
				</a>

				<a
					class="whatsapp-cta"
					href={whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					<img
						src={getUrl("/icons/icon-whastapp.svg")}
						alt=""
						width="20"
						height="20"
					/>
					<span>Escríbenos por WhatsApp</span>
				</a>

				<div
					class="footer-socials"
					aria-label="Redes sociales de TAQTO"
				>
					{
						socialLinks.map((social) => (
							<a
								class="social-button"
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.label}
							>
								{social.icon === "instagram" && (
									<svg
										viewBox="0 0 24 24"
										aria-hidden="true"
										class="icon-stroke"
									>
										<rect
											x="3"
											y="3"
											width="18"
											height="18"
											rx="5"
										></rect>

										<circle
											cx="12"
											cy="12"
											r="4"
										></circle>

										<circle
											cx="17.5"
											cy="6.5"
											r="0.8"
											class="social-dot"
										></circle>
									</svg>
								)}

								{social.icon === "facebook" && (
									<svg
										viewBox="0 0 24 24"
										aria-hidden="true"
										class="icon-fill"
									>
										<path d="M14 8h4V3h-4c-3 0-5 2-5 5v3H6v5h3v5h5v-5h4l1-5h-5V8Z"></path>
									</svg>
								)}

								{social.icon === "tiktok" && (
									<svg
										viewBox="0 0 24 24"
										aria-hidden="true"
										class="icon-fill"
									>
										<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 1 0 5.55 6.29V9.11a8.3 8.3 0 0 0 4.22 1.13V6.76a4.8 4.8 0 0 1-.45-.07z"></path>
									</svg>
								)}
							</a>
						))
					}
				</div>
			</div>
		</div>

		<div class="footer-divider"></div>

		<div class="footer-legal">
			<div class="footer-legal__group">
				<p class="footer-made">
					Hecho con
					<svg
						class="footer-made__heart"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="M12 20.5s-7.5-4.6-10-9.3C.5 8 2 4.5 5.3 4c2-.3 3.9.6 5 2.2 1.1-1.6 3-2.5 5-2.2C18.5 4.5 20 8 19.5 11.2c-2.5 4.7-10 9.3-10 9.3Z"></path>
					</svg>
					en Lima, Perú
				</p>

				<p class="footer-legal__copyright">
					© {currentYear} TAQTO. Todos los derechos
					reservados.
				</p>

				<a
					class="footer-legal__privacy"
					href={getUrl("/privacidad/")}
				>
					Política de privacidad
				</a>
			</div>

			<a class="footer-back-top" href="#top">
				<span>Volver arriba</span>
				<svg
					class="footer-back-top__arrow"
					viewBox="0 0 16 16"
					aria-hidden="true"
				>
					<path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"></path>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-black);
		color: var(--color-beige);
	}

	.site-footer :focus-visible {
		box-shadow: var(--focus-ring-on-dark);
		border-radius: var(--radius-full);
	}

	.footer-inner {
		width: min(
			calc(100% - (var(--page-padding) * 2)),
			1560px
		);
		margin-inline: auto;
		padding-block: var(--space-xl) var(--space-lg);
	}

	/* Nivel 1: navegación (izquierda) + marca (derecha), según croquis */
	.footer-top {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(280px, 0.8fr);
		grid-template-areas: "nav brand";
		align-items: start;
		gap: clamp(32px, 5vw, 72px);
	}

	.footer-nav {
		grid-area: nav;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(24px, 4vw, 48px);
	}

	.footer-nav-mobile {
		display: none;
	}

	.footer-nav-group h3 {
		margin: 0 0 var(--space-sm);
		color: var(--color-beige);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.footer-nav-group ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-nav-group a {
		color: var(--cream-70);
		font-size: clamp(1rem, 0.98rem + 0.1vw, 1.0625rem);
		line-height: var(--leading-normal);
		text-decoration: none;
		transition: color 180ms ease;
	}

	.footer-nav-group a:hover {
		color: var(--color-beige);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.footer-brand {
		grid-area: brand;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-sm);
	}

	.footer-brand__logo {
		display: block;
		margin-bottom: var(--space-3xs);
	}

	.footer-brand__logo img {
		display: block;
		width: clamp(240px, 15vw, 290px);
		max-width: 100%;
		height: auto;
		object-fit: contain;
	}

	.whatsapp-cta {
		min-height: 44px;
		padding: 0 var(--space-sm);
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		border: 1px solid var(--line-on-dark-strong);
		border-radius: 10px;
		background: transparent;
		color: var(--color-beige);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.01em;
		text-decoration: none;
		transition:
			background-color 180ms ease,
			border-color 180ms ease;
	}

	.whatsapp-cta:hover {
		background: var(--fill-on-dark-1);
		border-color: var(--cream-70);
	}

	.whatsapp-cta img {
		width: 18px;
		height: 18px;
	}

	.footer-socials {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.social-button {
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border: 1px solid var(--line-on-dark);
		border-radius: var(--radius-full);
		color: var(--cream-70);
		text-decoration: none;
		transition:
			background-color 180ms ease,
			color 180ms ease;
	}

	.social-button:hover {
		background: var(--fill-on-dark-1);
		color: var(--color-beige);
	}

	.social-button svg {
		display: block;
		width: 17px;
		height: 17px;
	}

	.social-button .icon-stroke {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.social-button .icon-fill {
		fill: currentColor;
		stroke: none;
	}

	.social-button .social-dot {
		fill: currentColor;
		stroke: none;
	}

	.footer-divider {
		height: 1px;
		margin-block: clamp(28px, 4vw, 40px);
		background: var(--line-on-dark);
	}

	/* Nivel 2: franja legal */
	.footer-legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
		color: var(--cream-50);
		font-size: var(--text-xs);
	}

	.footer-legal__group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 24px;
	}

	.footer-made {
		display: flex;
		align-items: center;
		gap: 6px;
		margin: 0;
	}

	.footer-made__heart {
		width: 13px;
		height: 13px;
		fill: var(--color-orange);
	}

	.footer-legal__copyright {
		margin: 0;
	}

	.footer-legal__privacy {
		color: inherit;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.footer-legal__privacy:hover {
		color: var(--color-beige);
	}

	.footer-back-top {
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: inherit;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.footer-back-top:hover {
		color: var(--color-beige);
	}

	.footer-back-top__arrow {
		width: 13px;
		height: 13px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Acordeones móviles (Comprar / TAQTO / Ayuda) */
	.footer-accordion {
		border-bottom: 1px solid var(--line-on-dark);
	}

	.footer-accordion summary {
		list-style: none;
		min-height: 44px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		padding-block: var(--space-xs);
		color: var(--color-beige);
		font-size: var(--text-sm);
		font-weight: 600;
		cursor: pointer;
	}

	.footer-accordion summary::-webkit-details-marker {
		display: none;
	}

	.footer-accordion__chevron {
		flex-shrink: 0;
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 180ms ease;
	}

	.footer-accordion[open] .footer-accordion__chevron {
		transform: rotate(180deg);
	}

	.footer-accordion ul {
		margin: 0;
		padding: 0 0 var(--space-sm);
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-accordion a {
		display: block;
		min-height: 44px;
		display: flex;
		align-items: center;
		color: var(--cream-70);
		font-size: clamp(1rem, 0.98rem + 0.1vw, 1.0625rem);
		text-decoration: none;
	}

	.footer-accordion a:hover {
		color: var(--color-beige);
	}

	/* TABLET: apila marca (primero) y navegación (después) */
	@media (max-width: 900px) {
		.footer-top {
			grid-template-columns: 1fr;
			grid-template-areas: "brand" "nav";
			gap: clamp(40px, 6vw, 56px);
		}
	}

	/* MÓVIL: logo, CTA, redes, navegación en acordeón, legal */
	@media (max-width: 680px) {
		.footer-inner {
			padding-block: 48px 28px;
		}

		.footer-brand__logo img {
			width: clamp(170px, 45vw, 200px);
		}

		.whatsapp-cta {
			width: 100%;
			max-width: 320px;
			justify-content: center;
		}

		.footer-nav {
			display: none;
		}

		.footer-nav-mobile {
			display: block;
		}

		.footer-legal {
			justify-content: center;
			text-align: center;
		}

		.footer-legal__group {
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.whatsapp-cta,
		.social-button,
		.footer-nav-group a,
		.footer-legal__privacy,
		.footer-back-top,
		.footer-accordion__chevron {
			transition: none;
		}
	}
</style>
