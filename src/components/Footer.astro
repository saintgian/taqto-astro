---
import { sanityClient } from "../lib/sanity";
import { navigationCategoriesQuery } from "../lib/categoryQueries";
import {
	WHATSAPP_NUMBER,
	EMPRESAS_CATEGORY_SLUG,
} from "../lib/constants";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";
import {
	ChevronDown,
	ArrowUp,
	ArrowRight,
	ShoppingBag,
	Flame,
	UtensilsCrossed,
	LampDesk,
	Gift,
	Package,
	Users,
	Building2,
	Handshake,
	Mail,
	Newspaper,
	Truck,
	SprayCan,
	CircleQuestionMark,
	ShieldCheck,
	Lock,
	Info,
} from "@lucide/astro";

interface Props {
	whatsappNumber?: string;
	whatsappMessage?: string;
}

const {
	whatsappNumber = WHATSAPP_NUMBER,
	whatsappMessage =
		"Hola TAQTO, quisiera información sobre sus productos.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const getUrl = (path: string) =>
	`${base}${path.startsWith("/") ? path : `/${path}`}`;

const footerLogo =
	`${base}/brand/imagotipo/imagotipo-colorprincipal02.svg`;

interface FooterCategory {
	_id: string;
	title: string;
	slug: string;
}

const navCategories =
	await sanityClient.fetch<FooterCategory[]>(
		navigationCategoriesQuery,
	);

/* Icono por slug de categoria. Las categorias vienen de Sanity, asi que
 * el mapa se consulta por slug y cae en un generico si alguna vez
 * aparece una nueva. */
const categoryIcons: Record<string, typeof Package> = {
	parrilla: Flame,
	"cocina-y-mesa": UtensilsCrossed,
	oficina: LampDesk,
	"kits-y-regalos": Gift,
};

/* Comprar: tienda + categorias reales de Sanity (sin "empresas", que
 * tiene su propio grupo). */
const compraLinks = [
	{ label: "Tienda", href: getUrl("/tienda/"), icon: ShoppingBag },
	...navCategories
		.filter(
			(category) => category.slug !== EMPRESAS_CATEGORY_SLUG,
		)
		.map((category) => ({
			label: category.title,
			href: getUrl(`/categorias/${category.slug}/`),
			icon: categoryIcons[category.slug] ?? Package,
		})),
];

const taqtoLinks = [
	{ label: "Nosotros", href: getUrl("/nosotros/"), icon: Users },
	{
		label: "Empresas",
		href: getUrl(`/categorias/${EMPRESAS_CATEGORY_SLUG}/`),
		icon: Building2,
	},
	{
		label: "Regalos corporativos",
		href: getUrl(
			`/categorias/${EMPRESAS_CATEGORY_SLUG}/regalos-corporativos/`,
		),
		icon: Handshake,
	},
	{
		label: "Contáctanos",
		href: getUrl("/contactanos/"),
		icon: Mail,
	},
	{ label: "Blog", href: getUrl("/blog/"), icon: Newspaper },
];

const ayudaLinks = [
	{ label: "Envíos", href: getUrl("/envios/"), icon: Truck },
	{ label: "Cuidados", href: getUrl("/cuidados/"), icon: SprayCan },
	{
		label: "Preguntas frecuentes",
		href: getUrl("/preguntas-frecuentes/"),
		icon: CircleQuestionMark,
	},
	{
		label: "Garantía de productos",
		href: getUrl("/garantia/"),
		icon: ShieldCheck,
	},
];

/* El icono del encabezado solo se pinta en el acordeon movil; en
 * escritorio los titulos siguen siendo texto limpio. */
const navGroups = [
	{ title: "Comprar", links: compraLinks, icon: ShoppingBag },
	{ title: "TAQTO", links: taqtoLinks, icon: Info },
	{ title: "Ayuda", links: ayudaLinks, icon: CircleQuestionMark },
];

const formattedWhatsappMsg =
	encodeURIComponent(whatsappMessage);

const whatsappUrl =
	`https://wa.me/${whatsappNumber}?text=${formattedWhatsappMsg}`;

const socialLinks = [
	{
		label: "Instagram",
		href: "https://www.instagram.com/taqto.pe/",
		icon: "instagram",
	},
	{
		label: "Facebook",
		href: "https://www.facebook.com/taqto.pe",
		icon: "facebook",
	},
	{
		label: "TikTok",
		href: "https://www.tiktok.com/@taqto.pe",
		icon: "tiktok",
	},
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-top">
			<nav
				class="footer-nav"
				aria-label="Navegación del pie de página"
			>
				{
					navGroups.map((group, index) => (
						<div class="footer-nav-group">
							<h3 id={`footer-nav-title-${index}`}>
								{group.title}
							</h3>

							<ul
								aria-labelledby={`footer-nav-title-${index}`}
							>
								{group.links.map((link) => {
									const Icon = link.icon;

									return (
										<li>
											<a
												class="footer-link"
												href={link.href}
												data-footer-link
											>
												<Icon
													class="footer-link__icon"
													aria-hidden="true"
													stroke-width={1.75}
												/>

												<span class="footer-link__label">
													{link.label}
												</span>
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					))
				}
			</nav>

			<nav
				class="footer-nav-mobile"
				aria-label="Navegación del pie de página"
			>
				<div class="footer-accordions">
					{navGroups.map((group, index) => {
						const GroupIcon = group.icon;
						const panelId = `footer-accordion-panel-${index}`;

						return (
							<details class="footer-accordion">
								<summary
									aria-expanded="false"
									aria-controls={panelId}
								>
									<span class="footer-accordion__title">
										<GroupIcon
											class="footer-accordion__icon"
											aria-hidden="true"
											stroke-width={1.75}
										/>

										{group.title}
									</span>

									<ChevronDown
										class="footer-accordion__chevron"
										aria-hidden="true"
										stroke-width={1.75}
									/>
								</summary>

								<div
									class="footer-accordion__panel"
									id={panelId}
								>
									<div class="footer-accordion__panel-inner">
										<ul>
											{group.links.map((link) => {
												const Icon = link.icon;

												return (
													<li>
														<a
															class="footer-link"
															href={link.href}
															data-footer-link
														>
															<Icon
																class="footer-link__icon"
																aria-hidden="true"
																stroke-width={1.75}
															/>

															<span class="footer-link__label">
																{link.label}
															</span>
														</a>
													</li>
												);
											})}
										</ul>
									</div>
								</div>
							</details>
						);
					})}
				</div>
			</nav>

			<div class="footer-brand">
				{/*
				 * Marca de agua editorial: el isotipo oficial reutilizado en
				 * linea (misma geometria que
				 * /brand/isotipo/isotipo-colornegro.svg) para poder pintarlo
				 * con `currentColor` en negro profundo sin tocar el asset ni
				 * crear uno nuevo. Solo escritorio.
				 */}
				<div class="footer-brand__watermark" aria-hidden="true">
					{/* viewBox completo del isotipo oficial (ave + base),
					sin recortar. `preserveAspectRatio` por defecto escala
					en modo "contain": la figura entra entera y conserva su
					proporción sea cual sea la caja. */}
					<svg
						viewBox="0 0 510.8 424.75"
						preserveAspectRatio="xMidYMid meet"
						fill="currentColor"
						focusable="false"
					>
						<rect
							x="127.05"
							y="398.63"
							width="258.59"
							height="26.12"
							rx="1.49"
							ry="1.49"></rect>
						<path
							d="M509.31,0h-150.3c-14.24,0-28.07,4.81-39.24,13.64l-25.14,19.88c-8.57,6.78-18.72,11.27-29.5,13.05l-63.5,13.42c-.69.15-1.18.75-1.18,1.46,0,.74.55,1.37,1.28,1.48l70.12,9.86c22.24,2.2,42.22,14.57,54.1,33.51l1.77,2.82L.59,358.81c-1.13.87-.52,2.68.9,2.68h257.98c96.01,0,173.84-77.83,173.84-173.84V61.37l57.09-43.58,9.55-7.29h0l10.25-7.82c1.13-.87.52-2.68-.9-2.68ZM330.85,317.01c-21.16,11.7-45.49,18.36-71.38,18.36H74.35l84.87-64.78c23.25,16.67,51.72,26.52,82.52,26.52,78.31,0,141.8-63.48,141.8-141.8,0-17.31-3.12-33.89-8.8-49.22l.27-.21c4.82,5.92,9.59,13.05,13.87,21.66,34.21,68.85,9.26,152.26-58.01,189.47Z"
						></path>
					</svg>
				</div>

				<div class="footer-brand__content">
					<a
						class="footer-brand__logo"
						href={getUrl("/")}
						aria-label="TAQTO, volver al inicio"
					>
						<img
							src={footerLogo}
							alt="TAQTO — Diseño con alma de madera"
							width="694"
							height="553"
							loading="lazy"
							decoding="async"
						/>
					</a>

					<a
						class="footer-whatsapp-cta"
						href={whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span
							class="footer-whatsapp-cta__icon"
							aria-hidden="true"
						>
							<WhatsAppIcon width={20} height={20} />
						</span>

						<span class="footer-whatsapp-cta__copy">
							<span class="footer-whatsapp-cta__eyebrow">
								Atención personalizada
							</span>

							<span class="footer-whatsapp-cta__label">
								Escríbenos por WhatsApp
							</span>
						</span>

						<ArrowRight
							class="footer-whatsapp-cta__arrow"
							aria-hidden="true"
							stroke-width={1.75}
						/>
					</a>

					<div
						class="footer-socials"
						role="group"
						aria-label="Redes sociales de TAQTO"
					>
						{
							socialLinks.map((social) => (
								<a
									class="social-button"
									href={social.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={social.label}
								>
									{social.icon === "instagram" && (
										<svg
											viewBox="0 0 24 24"
											aria-hidden="true"
											class="icon-stroke"
										>
											<rect
												x="3"
												y="3"
												width="18"
												height="18"
												rx="5"
											></rect>

											<circle
												cx="12"
												cy="12"
												r="4"
											></circle>

											<circle
												cx="17.5"
												cy="6.5"
												r="0.8"
												class="social-dot"
											></circle>
										</svg>
									)}

									{social.icon === "facebook" && (
										<svg
											viewBox="0 0 24 24"
											aria-hidden="true"
											class="icon-fill"
										>
											<path d="M14 8h4V3h-4c-3 0-5 2-5 5v3H6v5h3v5h5v-5h4l1-5h-5V8Z"></path>
										</svg>
									)}

									{social.icon === "tiktok" && (
										<svg
											viewBox="0 0 24 24"
											aria-hidden="true"
											class="icon-fill"
										>
											<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 1 0 5.55 6.29V9.11a8.3 8.3 0 0 0 4.22 1.13V6.76a4.8 4.8 0 0 1-.45-.07z"></path>
										</svg>
									)}
								</a>
							))
						}
					</div>
				</div>
			</div>
		</div>

		<div class="footer-divider"></div>

		<div class="footer-legal">
			<div class="footer-legal__group">
				<p class="footer-made">
					Hecho con
					<svg
						class="footer-made__heart"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="M12 20.5s-7.5-4.6-10-9.3C.5 8 2 4.5 5.3 4c2-.3 3.9.6 5 2.2 1.1-1.6 3-2.5 5-2.2C18.5 4.5 20 8 19.5 11.2c-2.5 4.7-10 9.3-10 9.3Z"></path>
					</svg>
					en Lima, Perú
				</p>

				<p class="footer-legal__copyright">
					© {currentYear} TAQTO. Todos los derechos
					reservados.
				</p>

				<a
					class="footer-link footer-link--sm footer-legal__privacy"
					href={getUrl("/privacidad/")}
					data-footer-link
				>
					<Lock
						class="footer-link__icon"
						aria-hidden="true"
						stroke-width={1.75}
					/>

					<span class="footer-link__label">
						Política de privacidad
					</span>
				</a>
			</div>

			<a class="footer-back-top" href="#top">
				<span>Volver arriba</span>
				<ArrowUp
					class="footer-back-top__arrow"
					aria-hidden="true"
					stroke-width={1.75}
				/>
			</a>
		</div>
	</div>
</footer>

<script>
	/*
	 * El <footer> lleva `transition:persist`, asi que sobrevive a las
	 * navegaciones del ClientRouter: marcar el enlace activo en el
	 * servidor lo dejaria congelado en la primera pagina visitada. Se
	 * recalcula en cada carga con el evento que ya usa el resto del
	 * proyecto.
	 */
	const markCurrentFooterLink = () => {
		const current = window.location.pathname.replace(/\/+$/, "");

		document
			.querySelectorAll<HTMLAnchorElement>("[data-footer-link]")
			.forEach((link) => {
				const target = new URL(
					link.href,
					window.location.origin,
				).pathname.replace(/\/+$/, "");

				if (target === current) {
					link.setAttribute("aria-current", "page");
				} else {
					link.removeAttribute("aria-current");
				}
			});
	};

	markCurrentFooterLink();
	document.addEventListener("astro:page-load", markCurrentFooterLink);

	/*
	 * Acordeones moviles. El <details> nativo es la unica fuente de
	 * verdad: el clic no se intercepta (sin `preventDefault`), asi que
	 * el toggle de `open` lo maneja el navegador. El panel nunca usa
	 * `display: none` (la regla de UA queda sobreescrita en CSS), asi
	 * que no hay salto de `display` que evitar con reflow forzado: el
	 * propio atributo `[open]` dispara la transicion de
	 * `grid-template-rows` en CSS. El script solo sincroniza
	 * `aria-expanded` con el evento nativo `toggle`, que se dispara
	 * ante cualquier cambio de `open` (clic, teclado, buscar en la
	 * pagina, boton atras).
	 */
	const setupFooterAccordions = () => {
		const nav = document.querySelector<HTMLElement>(
			".footer-nav-mobile",
		);

		// El footer lleva transition:persist: se enlaza una sola vez.
		if (!nav || nav.dataset.bound === "true") return;

		nav.dataset.bound = "true";

		nav.querySelectorAll<HTMLDetailsElement>(".footer-accordion").forEach(
			(details) => {
				const summary = details.querySelector("summary");

				if (!summary) return;

				const syncAria = () => {
					summary.setAttribute(
						"aria-expanded",
						String(details.open),
					);
				};

				details.addEventListener("toggle", syncAria);
				syncAria();
			},
		);
	};

	setupFooterAccordions();
	document.addEventListener("astro:page-load", setupFooterAccordions);
</script>

<style>
	.site-footer {
		/*
		 * Un único negro para todo el footer: el fondo es negro puro y
		 * todas las superficies internas son veladuras blancas sobre él
		 * (interna ~#060606, elevada ~#0d0d0d). No hay varios negros
		 * conviviendo: solo este y sus veladuras.
		 */
		--footer-bg: #000000;
		--footer-surface-1: rgba(255, 255, 255, 0.025);
		--footer-surface-2: rgba(255, 255, 255, 0.05);
		--footer-sunken: rgba(0, 0, 0, 0.3);
		--footer-line: rgba(255, 255, 255, 0.09);
		--footer-line-soft: rgba(255, 255, 255, 0.07);
		/* Página actual: ~#0b0b0b sobre negro. Se percibe al buscarlo,
		 * no salta a la vista. */
		--footer-current: rgba(255, 255, 255, 0.045);
		/*
		 * Acento naranja: lavado de fondo y anillo de 1px uniforme en los
		 * cuatro lados. Nunca una barra en un solo costado, que hacía que
		 * un lado concentrase todo el naranja.
		 */
		--footer-accent-wash: rgba(255, 77, 42, 0.05);
		--footer-accent-wash-strong: rgba(255, 77, 42, 0.09);
		--footer-accent-line: rgba(255, 77, 42, 0.16);
		--footer-ease: cubic-bezier(0.22, 1, 0.36, 1);

		/* El negro llega de borde a borde: el color vive en el <footer>,
		 * no en un contenedor interior, así que no hay franjas. */
		background-color: var(--footer-bg);
		color: var(--color-beige);
	}

	/*
	 * Foco con outline (no box-shadow): sigue el radio real de cada
	 * elemento, no obliga a una capsula y no compite con los fondos de
	 * acento de los enlaces.
	 */
	.site-footer :focus-visible {
		outline: 2px solid var(--cream-80);
		outline-offset: 2px;
	}

	.footer-inner {
		width: min(
			calc(100% - (var(--page-padding) * 2)),
			1560px
		);
		margin-inline: auto;
		padding-block: var(--space-xl) clamp(32px, 3.6vw, 44px);
	}

	/* Nivel 1: navegación (izquierda) + marca (derecha), según croquis */
	.footer-top {
		--footer-gap: clamp(32px, 4.5vw, 64px);
		--footer-rule: var(--footer-line-soft);

		display: grid;
		grid-template-columns: minmax(0, 1.85fr) minmax(320px, 1fr);
		grid-template-areas: "nav brand";
		align-items: stretch;
		gap: var(--footer-gap);
	}

	.footer-nav {
		--footer-nav-gap: clamp(24px, 3.25vw, 44px);

		grid-area: nav;
		min-width: 0;
		/* La navegación se alinea arriba: así los divisores verticales
		 * miden lo que mide la propia navegación y no atraviesan el
		 * hueco que deja la columna de marca, más alta. */
		align-self: start;
		display: grid;
		/* Proporciones ligeramente distintas: TAQTO y Ayuda llevan
		 * las etiquetas más largas. */
		grid-template-columns:
			minmax(0, 0.95fr)
			minmax(0, 1.1fr)
			minmax(0, 1fr);
		gap: var(--footer-nav-gap);
	}

	.footer-nav-group {
		position: relative;
	}

	/* Divisores verticales sutiles, centrados en el hueco de la
	 * cuadrícula. La columna de marca ya no lleva divisor: la marca de
	 * agua es quien separa esa zona. */
	.footer-nav-group + .footer-nav-group::before {
		content: "";
		position: absolute;
		inset-block: 2px 4px;
		inset-inline-start: calc(var(--footer-nav-gap) / -2);
		width: 1px;
		background: var(--footer-rule);
		pointer-events: none;
	}

	.footer-nav-mobile {
		display: none;
	}

	.footer-nav-group h3 {
		margin: 0 0 var(--space-xs);
		color: var(--cream-50);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.footer-nav-group ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	/*
	 * Enlaces con icono. El estado vive en la superficie completa (fondo
	 * + línea lateral), nunca en el color de la letra: el texto se
	 * mantiene blanco cálido en todos los estados.
	 */
	.footer-link {
		display: flex;
		/* `flex-start` mantiene el icono junto a la primera linea
		 * cuando una etiqueta larga hace wrap en tablet. */
		align-items: flex-start;
		/* La superficie se ajusta a la etiqueta: el acento no deja una
		 * banda vacía atravesando la columna. */
		width: fit-content;
		max-width: 100%;
		gap: 10px;
		padding: 7px 10px;
		/* Compensa el padding para que el texto siga alineado con el
		 * encabezado de la columna. */
		margin-inline: -10px;
		border-radius: 10px;
		background-color: transparent;
		/* Anillo interior de 1px: mismo grosor en los cuatro lados y
		 * dentro de la superficie, nunca sobresale ni se duplica. */
		box-shadow: inset 0 0 0 1px transparent;
		color: var(--cream-80);
		font-size: clamp(0.96rem, 0.94rem + 0.1vw, 1.02rem);
		line-height: var(--leading-snug);
		text-decoration: none;
		transition:
			background-color 200ms var(--footer-ease),
			box-shadow 200ms var(--footer-ease),
			color 200ms var(--footer-ease),
			transform 160ms var(--footer-ease);
	}

	.footer-link:hover,
	.footer-link:focus-visible,
	.footer-link:active {
		text-decoration: none;
	}

	.footer-link__icon {
		flex-shrink: 0;
		width: 15px;
		height: 15px;
		/* Centra el icono opticamente sobre la primera linea de texto. */
		margin-top: 0.24em;
		color: var(--color-orange);
		opacity: 0.6;
		transition:
			opacity 200ms var(--footer-ease),
			transform 200ms var(--footer-ease);
	}

	.footer-link__label {
		min-width: 0;
	}

	.footer-link:hover,
