---
import {
	Search,
	X,
	ArrowRight,
	SearchX,
	LoaderCircle,
	TriangleAlert,
	RotateCcw,
	LayoutGrid,
} from "@lucide/astro";

interface SearchCategory {
	title: string;
	slug: string;
}

interface Props {
	categories?: SearchCategory[];
}

const { categories = [] } = Astro.props;

const base = import.meta.env.BASE_URL;

const categoryHref = (slug: string) =>
	`${base}categorias/${slug}/`;
---

<!--
	Mega panel de busqueda anclado bajo el Header. Los cinco estados
	(idle / loading / success / empty / error) son nodos hermanos
	mutuamente excluyentes: el script solo deja uno sin `hidden`.
-->
<div
	class="megasearch"
	id="product-search-panel"
	data-search-panel
	data-state="idle"
	aria-hidden="true"
>
	<div class="megasearch__backdrop" data-search-backdrop></div>

	<div
		class="megasearch__panel"
		role="dialog"
		aria-modal="true"
		aria-labelledby="megasearch-title"
		data-search-dialog
	>
		<p class="sr-only" id="megasearch-title">Buscar productos</p>

		<div class="megasearch__head">
			<div class="megasearch__field">
				<Search
					class="megasearch__field-icon"
					aria-hidden="true"
					stroke-width={1.75}
				/>

				<label class="sr-only" for="product-search-input">
					Buscar productos
				</label>

				<input
					id="product-search-input"
					type="text"
					inputmode="search"
					autocomplete="off"
					spellcheck="false"
					placeholder="Buscar productos, categorías, madera..."
					data-search-input
				/>

				<button
					type="button"
					class="megasearch__clear"
					aria-label="Limpiar búsqueda"
					title="Limpiar búsqueda"
					data-search-clear
					hidden
				>
					<X aria-hidden="true" stroke-width={1.75} />
				</button>
			</div>

			<button
				type="button"
				class="megasearch__close"
				aria-label="Cerrar buscador"
				title="Cerrar buscador"
				data-search-close
			>
				<X aria-hidden="true" stroke-width={1.75} />
			</button>
		</div>

		<p class="sr-only" role="status" aria-live="polite" data-search-status>
		</p>

		<div class="megasearch__body">
			<div class="megasearch__state" data-search-state="idle">
				<p class="megasearch__idle-text">
					Escribe al menos 2 letras para buscar entre nuestras
					piezas.
				</p>

				{
					categories.length > 0 && (
						<div class="megasearch__categories">
							<p class="megasearch__categories-label">
								<LayoutGrid aria-hidden="true" stroke-width={1.75} />
								Explora por categoría
							</p>

							<ul class="megasearch__categories-list">
								{categories.map((category) => (
									<li>
										<a href={categoryHref(category.slug)}>
											{category.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>

			<div class="megasearch__state" data-search-state="loading" hidden>
				<p class="megasearch__feedback">
					<LoaderCircle
						class="megasearch__spinner"
						aria-hidden="true"
						stroke-width={1.75}
					/>
					Buscando…
				</p>
			</div>

			<div class="megasearch__state" data-search-state="success" hidden>
				<ul
					class="megasearch__grid"
					aria-label="Resultados de búsqueda"
					data-search-results
				></ul>
			</div>

			<div class="megasearch__state" data-search-state="empty" hidden>
				<p class="megasearch__feedback">
					<SearchX
						class="megasearch__feedback-icon"
						aria-hidden="true"
						stroke-width={1.75}
					/>
					No encontramos productos con esa búsqueda.
				</p>

				<p class="megasearch__feedback-hint">
					Prueba con el nombre de la pieza, una categoría o un
					tipo de madera.
				</p>
			</div>

			<div class="megasearch__state" data-search-state="error" hidden>
				<p class="megasearch__feedback megasearch__feedback--error">
					<TriangleAlert
						class="megasearch__feedback-icon"
						aria-hidden="true"
						stroke-width={1.75}
					/>
					No se pudo cargar el buscador.
				</p>

				<button
					type="button"
					class="btn btn--primary megasearch__retry"
					data-search-retry
				>
					<RotateCcw aria-hidden="true" stroke-width={1.75} />
					Intentar de nuevo
				</button>
			</div>
		</div>
	</div>
</div>

<template data-search-result-template>
	<li class="megasearch__result">
		<a class="megasearch__result-link">
			<span class="megasearch__result-media">
				<img data-role="image" alt="" loading="lazy" />
				<span class="megasearch__result-placeholder" data-role="placeholder">
					TAQTO
				</span>
			</span>

			<span class="megasearch__result-content">
				<span class="megasearch__result-category" data-role="category"></span>
				<span class="megasearch__result-title" data-role="title"></span>
				<span class="megasearch__result-wood" data-role="wood"></span>
				<span class="megasearch__result-price" data-role="price"></span>
			</span>

			<span class="megasearch__result-arrow" aria-hidden="true">
				<ArrowRight stroke-width={1.75} />
			</span>
		</a>
	</li>
</template>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/*
	 * `visibility` se anima con retardo (tecnica clasica, sin depender de
	 * `transition-behavior: allow-discrete`): al cerrar, permanece
	 * `visible` 160ms -- lo que tarda la salida mas lenta del panel --
	 * para que el fundido de salida termine de reproducirse antes de
	 * desaparecer. Al abrir, el retardo se anula para que aparezca de
	 * inmediato.
	 */
	.megasearch {
		position: fixed;
		inset: 0;
		z-index: 320;
		visibility: hidden;
		transition: visibility 0s linear 160ms;

		/*
		 * Distancia real hasta el borde inferior del Header. El script la
		 * recalcula al abrir y al redimensionar; este valor es el del
		 * header completo en escritorio, para que el primer render
		 * coincida con el estado posterior a load.
		 */
		--megasearch-top: 106px;
	}

	.megasearch.is-open {
		visibility: visible;
		transition-delay: 0s;
	}

	.megasearch__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(20, 20, 20, 0.22);
		opacity: 0;
		transition: opacity 140ms var(--ease-out);
	}

	.megasearch.is-open .megasearch__backdrop {
		opacity: 1;
		transition: opacity 180ms var(--ease-out);
	}

	.megasearch__panel {
		position: absolute;
		top: calc(var(--megasearch-top) + 12px);
		left: 50%;
		width: min(calc(100% - 48px), 1320px);
		max-height: min(74vh, 720px);
		display: flex;
		flex-direction: column;
		padding: 26px;
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-md);
		background: var(--surface);
		box-shadow: 0 18px 44px rgba(20, 20, 20, 0.14);
		opacity: 0;
		transform: translate(-50%, -10px) scale(0.98);
		transform-origin: top center;
		pointer-events: none;
		transition:
			opacity 160ms var(--ease-out),
			transform 160ms var(--ease-out);
	}

	.megasearch.is-open .megasearch__panel {
		opacity: 1;
		transform: translate(-50%, 0) scale(1);
		pointer-events: auto;
		transition:
			opacity 240ms var(--ease-panel),
			transform 240ms var(--ease-panel);
	}

	/*
	 * Apertura por teclado: sin desplazamiento espacial. `transform` sale
	 * de la lista de propiedades animadas, asi que su valor cambia de
	 * forma instantanea (en el mismo tick en que el script agrega ambas
	 * clases, antes de la primera pintura) en vez de recorrer la
	 * distancia; solo la opacidad se anima.
	 */
	.megasearch[data-open-input="keyboard"] .megasearch__panel {
		transition: opacity 160ms var(--ease-out);
	}

	.megasearch[data-open-input="keyboard"].is-open .megasearch__panel {
		transition: opacity 240ms var(--ease-panel);
	}

	.megasearch__head {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		gap: var(--space-xs);
	}

	.megasearch__field {
		position: relative;
		flex: 1;
		min-width: 0;
		height: 50px;
		display: flex;
		align-items: center;
		gap: 10px;
		padding-inline: 14px;
		border: 1px solid var(--ink-15);
		border-radius: var(--button-radius);
		background: var(--surface);
		transition: border-color 160ms ease;
	}

	.megasearch__field:focus-within {
		border-color: var(--ink-35);
	}

	.megasearch__field-icon {
		flex: 0 0 20px;
		width: 20px;
		height: 20px;
		color: var(--ink-55);
	}

	.megasearch__field input {
		flex: 1;
		min-width: 0;
		height: 100%;
		border: 0;
		background: transparent;
		color: var(--color-black);
		font-size: var(--text-sm);
	}

	.megasearch__field input::placeholder {
		color: var(--ink-35);
	}

	.megasearch__field input:focus {
		outline: none;
		box-shadow: none;
	}

	.megasearch__clear,
	.megasearch__close {
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--ink-55);
		cursor: pointer;
		transition:
			background-color 160ms ease,
			color 160ms ease;
	}

	.megasearch__clear {
		width: 44px;
		height: 44px;
		margin-right: -12px;
		border-radius: var(--radius-full);
	}

	.megasearch__close {
		width: 44px;
		height: 44px;
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-sm);
		color: var(--color-black);
	}

	.megasearch__clear:hover,
	.megasearch__close:hover {
		background: var(--ink-08);
		color: var(--color-black);
	}

	.megasearch__clear svg {
		width: 16px;
		height: 16px;
	}

	.megasearch__close svg {
		width: 18px;
		height: 18px;
	}

	.megasearch__body {
		flex: 1 1 auto;
		min-height: 0;
		margin-top: 20px;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.megasearch__idle-text {
		margin: 0;
		color: var(--ink-55);
		font-size: var(--text-sm);
	}

	.megasearch__categories {
		margin-top: 22px;
		padding-top: 20px;
		border-top: 1px solid var(--ink-15);
	}

	.megasearch__categories-label {
		margin: 0 0 12px;
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--ink-55);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.megasearch__categories-label svg {
		width: 16px;
		height: 16px;
	}

	.megasearch__categories-list {
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
	}

	.megasearch__categories-list a {
		min-height: 44px;
		padding-inline: 16px;
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-sm);
		color: var(--color-black);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: background-color 160ms ease;
	}

	.megasearch__categories-list a:hover {
		background: var(--ink-08);
	}

	.megasearch__feedback {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 26px 0 0;
		color: var(--ink-55);
		font-size: var(--text-sm);
	}

	.megasearch__feedback--error {
		color: var(--color-black);
	}

	.megasearch__feedback-icon {
		width: 28px;
		height: 28px;
		flex: 0 0 28px;
		color: var(--ink-35);
	}

	.megasearch__feedback--error .megasearch__feedback-icon {
		color: var(--color-orange);
	}

	.megasearch__feedback-hint {
		margin: 8px 0 0;
		padding-left: 38px;
		color: var(--ink-35);
		font-size: var(--text-sm);
	}

	.megasearch__spinner {
		width: 20px;
		height: 20px;
		flex: 0 0 20px;
		color: var(--ink-35);
		animation: megasearch-spin 900ms linear infinite;
	}

	@keyframes megasearch-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Solo posicion: color y estados vienen de `.btn--primary`. */
	.megasearch__retry {
		margin: 16px 0 0 38px;
	}

	.megasearch__grid {
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
		list-style: none;
	}

	@media (min-width: 1000px) {
		.megasearch__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 1320px) {
		.megasearch__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.megasearch__result-link {
		height: 100%;
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 10px;
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-sm);
		color: inherit;
		text-decoration: none;
		transition:
			background-color 150ms ease,
			border-color 150ms ease;
	}

	.megasearch__result-link:hover,
	.megasearch__result-link.is-active {
		background: var(--ink-08);
		border-color: var(--ink-35);
	}

	.megasearch__result-media {
		position: relative;
		flex: 0 0 80px;
		width: 80px;
		height: 80px;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		border: 1px solid var(--ink-15);
		border-radius: 10px;
		background: var(--surface);
	}

	.megasearch__result-media img {
		width: 100%;
		height: 100%;
		padding: 5px;
		object-fit: contain;
	}

	.megasearch__result-placeholder {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: var(--color-brown);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.megasearch__result-content {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 2px;
	}

	.megasearch__result-category {
		color: var(--ink-55);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.megasearch__result-title {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		color: var(--color-black);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: var(--leading-snug);
	}

	.megasearch__result-wood {
		overflow: hidden;
		color: var(--ink-55);
		font-size: 14px;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.megasearch__result-price {
		margin-top: 2px;
		color: var(--color-black);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.megasearch__result-arrow {
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		color: var(--ink-35);
	}

	.megasearch__result-arrow svg {
		width: 16px;
		height: 16px;
	}

	@media (max-width: 1180px) {
		.megasearch {
			--megasearch-top: 96px;
		}

		.megasearch__panel {
			width: calc(100% - 24px);
			padding: 20px;
		}
	}

	@media (max-width: 680px) {
		.megasearch__panel {
			inset: 0;
			top: 0;
			left: 0;
			width: 100%;
			max-height: none;
			height: 100dvh;
			padding: 14px 16px 20px;
			border: 0;
			border-radius: 0;
			box-shadow: none;
			transform: translateY(6px);
			transition:
				opacity 160ms var(--ease-out),
				transform 160ms var(--ease-out);
		}

		.megasearch.is-open .megasearch__panel {
			transform: translateY(0);
			transition:
				opacity 240ms var(--ease-panel),
				transform 240ms var(--ease-panel);
		}

		.megasearch__head {
			position: sticky;
			top: 0;
			z-index: 1;
			padding-block: 6px;
			background: var(--surface);
		}

		.megasearch__body {
			margin-top: 16px;
		}

		.megasearch__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 8px;
		}

		.megasearch__result-media {
			flex-basis: 68px;
			width: 68px;
			height: 68px;
		}

		.megasearch__result-title {
			-webkit-line-clamp: 2;
		}
	}

	/*
	 * Movimiento reducido: el panel solo funde. Se fija su estado final
	 * en vez de anular el `transform`, porque el centrado horizontal
	 * depende de `translate(-50%, …)`.
	 */
	@media (prefers-reduced-motion: reduce) {
		/*
		 * Mismo criterio que en el minicarrito: el retardo de `visibility`
		 * (arriba, 160ms) se acorta a los 150ms del fundido reducido, para
		 * que el panel nunca quede "invisible pero enfocable" ni
		 * desaparezca antes de terminar de fundirse.
		 */
		.megasearch {
			transition-delay: 150ms;
		}

		.megasearch__backdrop {
			transition: opacity 150ms linear;
		}

		.megasearch__panel {
			transform: translate(-50%, 0);
			transition: opacity 150ms linear;
		}

		/*
		 * En mobile el panel es pantalla completa (`left: 0`, sin
		 * centrado): el `translate(-50%, 0)` de arriba lo desplazaria
		 * fuera de lugar, asi que aqui se anula por completo.
		 */
		@media (max-width: 680px) {
			.megasearch__panel {
				transform: none;
			}
		}

		/*
		 * Los cinco estados (idle/loading/success/empty/error) solo
		 * funden, sin depender del retardo de `display` pensado para
		 * movimiento normal.
		 */
		.megasearch__state {
			transition:
				opacity 150ms linear,
				display 150ms allow-discrete;
		}

		.megasearch__result-link {
			transition: none;
		}

		.megasearch__spinner {
			animation: none;
		}
	}

	/*
	 * `hidden` debe ganar siempre sobre las reglas de layout de arriba.
	 * Sin esto, un `display` de autor en el mismo elemento anulaba el
	 * atributo y los cinco estados se pintaban a la vez.
	 */
	.megasearch [hidden] {
		display: none;
	}

	/*
	 * Fundido grupal entre loading/resultados/vacio/error: los cinco
	 * estados son hermanos que solo alternan `hidden`, asi que fundir la
	 * salida de uno con la entrada del otro exige animar a traves de
	 * `display: none`. `allow-discrete` retrasa el salto a `none` hasta
	 * que el fundido de salida termina; `@starting-style` da el punto de
	 * partida (opacity 0) la primera vez que un estado deja de estar
	 * oculto. Sin soporte, el navegador ignora ambas reglas y el cambio
	 * de estado vuelve a ser instantaneo -- el mismo comportamiento que
	 * ya existia, sin roturas.
	 */
	.megasearch__state {
		opacity: 1;
		transition:
			opacity 200ms var(--ease-out),
			display 200ms allow-discrete;
	}

	.megasearch__state[hidden] {
		opacity: 0;
	}

	@starting-style {
		.megasearch__state:not([hidden]) {
			opacity: 0;
		}
	}
</style>

<script>
	import { openOverlay, closeOverlay } from "../lib/overlay";

	interface SearchItem {
		id: string;
		title: string;
		slug: string;
		category: string;
		subcategory: string;
		wood: string;
		image: string;
		imageAlt: string;
		price: string;
	}

	interface ScoredItem {
		item: SearchItem;
		score: number;
	}

	type SearchState =
		| "idle"
		| "loading"
		| "success"
		| "empty"
		| "error";

	const base = import.meta.env.BASE_URL;
	const searchIndexUrl = `${base}search-index.json`;
	const productHrefFor = (slug: string) => `${base}productos/${slug}/`;

	const OVERLAY_ID = "megasearch";
	const MAX_RESULTS = 12;
	const MIN_QUERY_LENGTH = 2;
	const DEBOUNCE_MS = 220;

	/*
	 * Ventana de gracia antes de mostrar "Buscando...": si la respuesta
	 * llega antes, el loading nunca se pinta. Si llega a mostrarse, se
	 * mantiene al menos `LOADING_MIN_VISIBLE_MS` para no parpadear.
	 */
	const LOADING_SHOW_DELAY_MS = 150;
	const LOADING_MIN_VISIBLE_MS = 300;

	let cachedIndex: SearchItem[] | null = null;
	let indexPromise: Promise<SearchItem[]> | null = null;

	const normalize = (value: string) =>
		value
			.normalize("NFD")
			.replace(/[̀-ͯ]/g, "")
			.toLowerCase()
			.trim()
			.replace(/\s+/g, " ");

	const haystackOf = (item: SearchItem) =>
		normalize(
			[item.title, item.category, item.subcategory, item.wood]
				.filter(Boolean)
				.join(" "),
		);

	/*
	 * El indice es un JSON estatico compartido por todas las consultas:
	 * se descarga una vez y se cachea. Deliberadamente no recibe el
	 * `signal` de una consulta concreta — si lo hiciera, cancelar una
	 * busqueda abortaria la descarga que la siguiente ya esta esperando
	 * y el panel se quedaria en "loading" para siempre. La cancelacion
	 * vive un nivel mas arriba (signal + token de la consulta).
	 *
	 * Si falla, `indexPromise` se limpia para que "Intentar de nuevo"
	 * pueda reintentar de verdad; antes quedaba una promesa rechazada en
	 * cache y el buscador se quedaba en error de forma permanente.
	 */
	async function loadIndex(): Promise<SearchItem[]> {
		if (cachedIndex) return cachedIndex;

		if (!indexPromise) {
			indexPromise = fetch(searchIndexUrl)
				.then((response) => {
					if (!response.ok) {
						throw new Error(`search index ${response.status}`);
					}

					return response.json();
				})
				.then((data: SearchItem[]) => {
					cachedIndex = data;
					return data;
				})
				.catch((error) => {
					indexPromise = null;
					throw error;
				});
		}

		return indexPromise;
	}

	function scoreItem(item: SearchItem, normalizedQuery: string): number {
		const normalizedTitle = normalize(item.title);

		if (normalizedTitle === normalizedQuery) return 100;
		if (normalizedTitle.startsWith(normalizedQuery)) return 80;
		if (normalizedTitle.includes(normalizedQuery)) return 50;

		return 20;
	}

	function search(items: SearchItem[], query: string): SearchItem[] {
		const normalizedQuery = normalize(query);
		const words = normalizedQuery.split(" ").filter(Boolean);

		if (words.length === 0) return [];

		const scored: ScoredItem[] = [];

		for (const item of items) {
			const haystack = haystackOf(item);
			const matchesAll = words.every((word) => haystack.includes(word));

			if (!matchesAll) continue;

			scored.push({ item, score: scoreItem(item, normalizedQuery) });
		}

		scored.sort((a, b) => b.score - a.score);

		return scored.slice(0, MAX_RESULTS).map((entry) => entry.item);
	}

	function initSearchPanel() {
		const panel = document.querySelector<HTMLElement>(
			"[data-search-panel]",
		);

		if (!panel || panel.dataset.initialized === "true") return;
		panel.dataset.initialized = "true";

		const backdrop = panel.querySelector<HTMLElement>(
			"[data-search-backdrop]",
		);
		const dialog = panel.querySelector<HTMLElement>(
			"[data-search-dialog]",
		);
		const input = panel.querySelector<HTMLInputElement>(
			"[data-search-input]",
		);
		const clearButton = panel.querySelector<HTMLButtonElement>(
			"[data-search-clear]",
		);
		const closeButton = panel.querySelector<HTMLButtonElement>(
			"[data-search-close]",
		);
		const retryButton = panel.querySelector<HTMLButtonElement>(
			"[data-search-retry]",
		);
		const resultsList = panel.querySelector<HTMLElement>(
			"[data-search-results]",
		);
		const status = panel.querySelector<HTMLElement>(
			"[data-search-status]",
		);
		const template = document.querySelector<HTMLTemplateElement>(
			"[data-search-result-template]",
		);

		if (
			!backdrop ||
			!dialog ||
			!input ||
			!clearButton ||
			!closeButton ||
			!retryButton ||
			!resultsList ||
			!status ||
			!template
		) {
			return;
		}

		const stateNodes = new Map<SearchState, HTMLElement>();

		panel
			.querySelectorAll<HTMLElement>("[data-search-state]")
			.forEach((node) => {
				stateNodes.set(
					node.dataset.searchState as SearchState,
					node,
				);
			});

		const triggers = () =>
			Array.from(
				document.querySelectorAll<HTMLElement>(
					"[data-search-trigger]",
				),
			);

		let debounceTimer: ReturnType<typeof setTimeout> | undefined;
		let inFlight: AbortController | null = null;
		let requestToken = 0;

		/*
		 * Unico punto que cambia de estado. Solo un nodo queda sin
		 * `hidden`, asi que es imposible ver "Buscando…", "sin
		 * resultados", el error y la rejilla a la vez.
		 */
		const setState = (next: SearchState) => {
			panel.dataset.state = next;

			stateNodes.forEach((node, name) => {
				node.hidden = name !== next;
			});

			if (next !== "success") {
				resultsList.replaceChildren();
			}
		};

		const renderResults = (items: SearchItem[]) => {
			const fragment = document.createDocumentFragment();

			items.forEach((item) => {
				const node = template.content.firstElementChild!.cloneNode(
					true,
				) as HTMLElement;

				const pick = <T extends HTMLElement>(role: string) =>
					node.querySelector<T>(`[data-role="${role}"]`);

				const link = node.querySelector<HTMLAnchorElement>(
					".megasearch__result-link",
				);

				if (link) {
					link.href = productHrefFor(item.slug);
				}

				const image = pick<HTMLImageElement>("image");
				const placeholder = pick("placeholder");

				if (item.image && image) {
					image.src = item.image;
					image.alt = item.imageAlt || item.title;
					placeholder?.remove();
				} else {
					image?.remove();
				}

				const category = pick("category");
				const categoryText = item.subcategory || item.category;

				if (category) {
					if (categoryText) {
						category.textContent = categoryText;
					} else {
						category.remove();
					}
				}

				const title = pick("title");
				if (title) title.textContent = item.title;

				const wood = pick("wood");

				if (wood) {
					if (item.wood) {
						wood.textContent = item.wood;
					} else {
						wood.remove();
					}
				}

				const price = pick("price");

				if (price) {
					if (item.price) {
						price.textContent = item.price;
					} else {
						price.remove();
					}
				}

				fragment.appendChild(node);
			});

			resultsList.replaceChildren(fragment);
		};

		const announce = (count: number, query: string) => {
			status.textContent =
				count === 0
					? `Sin resultados para "${query}"`
					: `${count} ${
							count === 1 ? "resultado" : "resultados"
						} para "${query}"`;
		};

		const cancelInFlight = () => {
			inFlight?.abort();
			inFlight = null;
		};

		const runSearch = async (rawQuery: string) => {
			const query = rawQuery.trim();

			cancelInFlight();

			if (query.length < MIN_QUERY_LENGTH) {
				setState("idle");
				status.textContent = "";
				return;
			}

			const token = ++requestToken;
			const controller = new AbortController();
			inFlight = controller;

			let loadingShownAt: number | null = null;

			const loadingShowTimer = window.setTimeout(() => {
				if (controller.signal.aborted || token !== requestToken) {
					return;
				}

				loadingShownAt = performance.now();
				setState("loading");
			}, LOADING_SHOW_DELAY_MS);

			/*
			 * Punto unico de salida: si el loading nunca llego a
			 * mostrarse, aplica de inmediato. Si ya se mostro, espera lo
			 * que falte para completar `LOADING_MIN_VISIBLE_MS` antes de
			 * revelar el resultado, para que no parpadee.
			 */
			const settle = (apply: () => void) => {
				window.clearTimeout(loadingShowTimer);

				if (loadingShownAt === null) {
					apply();
					return;
				}

				const elapsed = performance.now() - loadingShownAt;
				const remaining = Math.max(
					0,
					LOADING_MIN_VISIBLE_MS - elapsed,
				);

				window.setTimeout(() => {
					if (controller.signal.aborted || token !== requestToken) {
						return;
					}

					apply();
				}, remaining);
			};

			try {
				const items = await loadIndex();

				// Cancelada (se cerro el panel o llego otra consulta) u
				// obsoleta: no debe pintar nada.
				if (controller.signal.aborted || token !== requestToken) {
					window.clearTimeout(loadingShowTimer);
					return;
				}

				const results = search(items, query);

				settle(() => {
					if (results.length === 0) {
						setState("empty");
					} else {
						renderResults(results);
						setState("success");
					}

					announce(results.length, query);
				});
			} catch (error) {
				// Un abort no es un fallo: no debe pintar el estado error.
				if (
					controller.signal.aborted ||
					(error as Error)?.name === "AbortError" ||
					token !== requestToken
				) {
					window.clearTimeout(loadingShowTimer);
					return;
				}

				settle(() => {
					setState("error");
					status.textContent = "No se pudo cargar el buscador.";
				});
			} finally {
				if (inFlight === controller) inFlight = null;
			}
		};

		const onInput = () => {
			clearButton.hidden = input.value.length === 0;

			if (debounceTimer) clearTimeout(debounceTimer);

			debounceTimer = setTimeout(() => {
				runSearch(input.value);
			}, DEBOUNCE_MS);
		};

		const isOpen = () => panel.classList.contains("is-open");

		/*
		 * El panel se ancla al borde inferior real del Header en lugar de
		 * a una constante: el anuncio superior cambia de alto por
		 * breakpoint.
		 */
		const anchorToHeader = () => {
			const header = document.querySelector<HTMLElement>(
				"[data-site-header]",
			);

			if (!header) return;

			const bottom = Math.round(
				header.getBoundingClientRect().bottom,
			);

			if (bottom > 0) {
				panel.style.setProperty(
					"--megasearch-top",
					`${bottom}px`,
				);
			}
		};

		const closePanel = () => {
			if (!isOpen()) return;

			cancelInFlight();

			if (debounceTimer) {
				clearTimeout(debounceTimer);
				debounceTimer = undefined;
			}

			panel.classList.remove("is-open");
			panel.setAttribute("aria-hidden", "true");

			triggers().forEach((element) => {
				element.setAttribute("aria-expanded", "false");
			});

			closeOverlay(OVERLAY_ID);
		};

		const openPanel = (
			trigger: HTMLElement,
			viaKeyboard = false,
		) => {
			if (isOpen()) return;

			anchorToHeader();

			// Sin `MouseEvent.detail` (0 = activado por teclado, no por
			// clic real) no hay forma de distinguir el origen: se lee
			// antes de abrir para que la regla de "sin movimiento
			// espacial" aplique desde el primer fotograma.
			panel.dataset.openInput = viaKeyboard
				? "keyboard"
				: "pointer";

			panel.classList.add("is-open");
			panel.setAttribute("aria-hidden", "false");

			triggers().forEach((element) => {
				element.setAttribute("aria-expanded", "true");
			});

			input.value = "";
			clearButton.hidden = true;
			status.textContent = "";
			requestToken += 1;
			setState("idle");

			openOverlay({
				id: OVERLAY_ID,
				container: dialog,
				trigger,
				close: closePanel,
				initialFocus: input,
			});
		};

		triggers().forEach((trigger) => {
			trigger.addEventListener("click", (event) => {
				event.preventDefault();

				if (isOpen()) {
					closePanel();
				} else {
					// `detail === 0` en un evento "click" indica
					// activacion por teclado (Enter/Espacio), no un clic
					// real de puntero.
					openPanel(trigger, event.detail === 0);
				}
			});
		});

		closeButton.addEventListener("click", closePanel);
		backdrop.addEventListener("click", closePanel);

		clearButton.addEventListener("click", () => {
			input.value = "";
			clearButton.hidden = true;
			input.focus();
			runSearch("");
		});

		retryButton.addEventListener("click", () => {
			runSearch(input.value);
		});

		input.addEventListener("input", onInput);

		const resultLinks = () =>
			Array.from(
				resultsList.querySelectorAll<HTMLAnchorElement>(
					".megasearch__result-link",
				),
			);

		const moveFocus = (delta: number) => {
			const links = resultLinks();
			if (links.length === 0) return;

			const currentIndex = links.findIndex(
				(link) => link === document.activeElement,
			);

			if (currentIndex === -1) {
				links[delta > 0 ? 0 : links.length - 1].focus();
				return;
			}

			const nextIndex = currentIndex + delta;

			if (nextIndex < 0) {
				input.focus();
			} else if (nextIndex < links.length) {
				links[nextIndex].focus();
			}
		};

		dialog.addEventListener("keydown", (event) => {
			if (event.key === "ArrowDown") {
				event.preventDefault();
				moveFocus(1);
			} else if (event.key === "ArrowUp") {
				event.preventDefault();
				moveFocus(-1);
			}
		});

		window.addEventListener("resize", () => {
			if (isOpen()) anchorToHeader();
		});
	}

	initSearchPanel();
	document.addEventListener("astro:page-load", initSearchPanel);
</script>
