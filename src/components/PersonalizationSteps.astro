---
import { ArrowRight } from "@lucide/astro";

interface Props {
	imageSrc?: string;
	imageAlt?: string;
	ctaHref: string;
}

const base = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const {
	imageSrc = `${base}images/home/personalizacion-grabado.webp`,
	imageAlt = "Detalle de una pieza TAQTO personalizada mediante grabado láser",
	ctaHref,
} = Astro.props;

const steps = [
	{
		number: "01",
		title: "Elige tu pieza",
		description:
			"Encuentra el diseño que acompañará tu mesa, cocina, parrilla o espacio de trabajo.",
	},
	{
		number: "02",
		title: "Selecciona la madera",
		description:
			"Escoge entre las maderas disponibles y sus variaciones naturales de tono y veta.",
	},
	{
		number: "03",
		title: "Añade tu grabado",
		description:
			"Personaliza la pieza con un nombre, una frase o una imagen preparada para grabado láser.",
	},
];
---

<section
	class="personalization"
	aria-labelledby="personalization-title"
>
	<div class="personalization__container">
		<div class="personalization__media">
			{
				imageSrc ? (
					<img
						src={imageSrc}
						alt={imageAlt}
						width="1586"
						height="992"
						loading="lazy"
						decoding="async"
					/>
				) : (
					<div class="personalization__placeholder">
						<span>Foto próximamente</span>
					</div>
				)
			}
		</div>

		<div class="personalization__content">
			<header class="personalization__header">
				<h2 id="personalization-title">
					Una pieza hecha para ti
				</h2>

				<p class="personalization__intro">
					Elige el diseño, selecciona la madera y añade un
					nombre, una frase o una imagen.
				</p>
			</header>

			<ol class="personalization__steps">
				{
					steps.map((step) => (
						<li class="personalization__step">
							<span
								class="personalization__number"
								aria-hidden="true"
							>
								{step.number}
							</span>

							<div class="personalization__step-copy">
								<h3>{step.title}</h3>
								<p>{step.description}</p>
							</div>
						</li>
					))
				}
			</ol>

			<a class="btn btn--primary personalization__cta" href={ctaHref}>
				Empieza a personalizar
				<ArrowRight aria-hidden="true" stroke-width={1.75} />
			</a>
		</div>
	</div>
</section>

<style>
	.personalization {
		padding-block: var(--section-py);
		padding-inline: var(--container-gutter);
		background: var(--surface);
		color: var(--color-black);
	}

	.personalization__container {
		display: grid;
		width: min(100%, var(--container-editorial));
		margin-inline: auto;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: stretch;
		gap: clamp(32px, 5vw, 64px);
	}

	.personalization__media {
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: rgba(20, 20, 20, 0.04);
	}

	.personalization__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 58%;
	}

	.personalization__placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		min-height: 320px;
		place-items: center;
		border: 1px dashed rgba(20, 20, 20, 0.22);
		border-radius: 24px;
		background: rgba(20, 20, 20, 0.03);
	}

	.personalization__placeholder span {
		color: rgba(20, 20, 20, 0.35);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.personalization__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.personalization__header {
		max-width: 560px;
	}

	.personalization__header h2 {
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.personalization__intro {
		max-width: 480px;
		margin: 14px 0 0;
		color: rgba(20, 20, 20, 0.7);
		font-size: clamp(17px, 0.3vw + 16.4px, 18px);
		line-height: 1.6;
	}

	.personalization__steps {
		position: relative;
		display: grid;
		gap: 0;
		margin: var(--header-gap) 0 0;
		padding: 0;
		list-style: none;
	}

	.personalization__steps::before {
		position: absolute;
		top: 26px;
		bottom: 26px;
		left: 25px;
		width: 1px;
		background: rgba(20, 20, 20, 0.18);
		content: "";
	}

	.personalization__step {
		position: relative;
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr);
		gap: 18px;
		padding: 0 0 20px;
	}

	.personalization__step:last-child {
		padding-bottom: 0;
	}

	.personalization__number {
		position: relative;
		z-index: 1;
		display: grid;
		width: 52px;
		height: 52px;
		place-items: center;
		border: 1px solid rgba(20, 20, 20, 0.16);
		border-radius: 50%;
		background: var(--surface);
		color: var(--color-brown);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.personalization__step-copy h3 {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.personalization__step-copy p {
		max-width: 440px;
		margin: 6px 0 0;
		color: rgba(20, 20, 20, 0.68);
		font-size: clamp(16px, 0.3vw + 15.4px, 17px);
		line-height: 1.55;
	}

	/* Solo posicion: color, geometria y estados vienen de `.btn--primary`. */
	.personalization__cta {
		width: fit-content;
		margin-top: clamp(22px, 3vw, 32px);
	}

	.personalization__cta svg {
		transition: transform 180ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.personalization__cta:hover svg {
			transform: translateX(4px);
		}
	}

	@media (max-width: 900px) {
		.personalization__container {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.personalization__media {
			aspect-ratio: 4 / 5;
		}

		.personalization__content {
			padding-block: 0;
		}
	}

	@media (max-width: 600px) {
		.personalization {
			padding-inline: 18px;
		}

		.personalization__container {
			gap: 32px;
		}

		.personalization__media {
			border-radius: 18px;
		}

		.personalization__placeholder {
			border-radius: 18px;
		}

		.personalization__steps {
			margin-top: 30px;
		}

		.personalization__steps::before {
			left: 23px;
		}

		.personalization__step {
			grid-template-columns: 48px minmax(0, 1fr);
			gap: 16px;
			padding-bottom: 24px;
		}

		.personalization__number {
			width: 48px;
			height: 48px;
			font-size: 14px;
		}

		.personalization__cta {
			width: 100%;
		}
	}
</style>
