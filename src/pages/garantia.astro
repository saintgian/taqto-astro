---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import { buildFaqJsonLd } from "../lib/seo";
import InfoCard from "../components/InfoCard.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import {
	ShieldCheck,
	BadgeCheck,
	FileText,
	TreePine,
	CircleOff,
	Sun,
	Droplets,
	Flame,
	Brush,
	ListChecks,
	CircleQuestionMark,
} from "@lucide/astro";

const base = import.meta.env.BASE_URL;
const cuidados = `${base}cuidados/`;

const wa = "https://wa.me/51977600400";

const resumen = [
	{
		icon: ShieldCheck,
		label: "Cobertura",
		value: "Seis meses",
		hint: "Desde la fecha en que recibes el producto.",
	},
	{
		icon: BadgeCheck,
		label: "Qué cubre",
		value: "Defectos de fabricación",
		hint: "Fallas que afecten el uso esperado de la pieza.",
	},
	{
		icon: FileText,
		label: "Cada solicitud",
		value: "Evaluación individual",
		hint: "Según el producto, la incidencia y el uso.",
	},
	{
		icon: TreePine,
		label: "Materiales naturales",
		value: "Veta y tono varían",
		hint: "El envejecimiento natural no es un defecto.",
	},
];

const evaluacion = [
	"El producto y sus características.",
	"La fecha de entrega.",
	"La descripción de la incidencia.",
	"El estado general de la pieza.",
	"Las condiciones de uso y cuidado.",
	"Las fotografías o evidencias proporcionadas.",
	"La relación entre la falla reportada y el proceso de fabricación.",
];

const noCubre = [
	{
		icon: CircleOff,
		title: "Mal uso",
		text: "Golpes, caídas, cortes profundos, sobrecarga, manipulación inadecuada o uso del producto para una función distinta a aquella para la que fue diseñado.",
	},
	{
		icon: Sun,
		title: "Exposición directa al sol",
		text: "La exposición prolongada al sol o a fuentes intensas de calor puede alterar el tono, resecar, deformar o afectar los materiales.",
	},
	{
		icon: Flame,
		title: "Uso de lavavajillas",
		text: "Las piezas de madera no deben colocarse en lavavajillas. La temperatura, la humedad y los detergentes pueden afectar su estructura y acabado.",
	},
	{
		icon: Droplets,
		title: "Remojo prolongado",
		text: "Dejar una pieza de madera sumergida o en contacto prolongado con agua puede causar deformaciones, fisuras o cambios en el material.",
	},
	{
		icon: TreePine,
		title: "Desgaste natural",
		text: "Las marcas superficiales, cambios graduales de tono, variaciones de textura y señales razonables producidas por el uso y el paso del tiempo forman parte del envejecimiento natural de la pieza.",
	},
	{
		icon: Brush,
		title: "Cuidados incorrectos",
		text: "El uso de productos abrasivos, químicos agresivos o métodos de limpieza diferentes a los recomendados puede afectar el acabado y la superficie.",
	},
];

const variaciones = [
	"Diferencias de veta entre dos unidades.",
	"Variaciones de tono dentro de una misma pieza.",
	"Pequeños rasgos propios de la madera.",
	"Cambios graduales de color.",
	"Marcas superficiales producidas por el uso cotidiano.",
	"Evolución de la apariencia del cuero.",
];

const informacion = [
	"Nombre de la persona que realizó el pedido.",
	"Producto adquirido.",
	"Fecha aproximada de entrega.",
	"Descripción de la incidencia.",
	"Momento en que fue identificada.",
	"Uso que se le dio al producto.",
	"Fotografías claras de la pieza completa.",
	"Fotografías cercanas de la zona afectada.",
	"Video breve, cuando ayude a comprender el problema.",
	"Número de pedido o comprobante de compra, cuando se encuentre disponible.",
];

const proceso = [
	{
		title: "Recibimos la información",
		text: "Nos envías los datos del pedido, una descripción de lo ocurrido y fotografías claras del producto.",
	},
	{
		title: "Revisamos el caso",
		text: "Evaluamos la pieza, sus características, el tiempo transcurrido y las condiciones de uso y cuidado.",
	},
	{
		title: "Solicitamos información adicional",
		text: "Cuando sea necesario, podremos pedir nuevas fotografías, un video o información complementaria.",
	},
	{
		title: "Comunicamos el resultado",
		text: "Te informaremos si la incidencia corresponde a un defecto atribuible a la fabricación y cuáles son los siguientes pasos.",
	},
	{
		title: "Coordinamos la solución aplicable",
		text: "Cuando corresponda la cobertura, TAQTO coordinará la solución adecuada de acuerdo con las características y la evaluación del caso.",
	},
];

const cuidadosEsenciales = [
	{
		label: "Lava a mano.",
		text: "Cuando el producto sea apto para lavado, utiliza una esponja suave, agua y un limpiador adecuado.",
	},
	{
		label: "No utilices lavavajillas.",
		text: "La exposición prolongada al calor, la humedad y los detergentes puede afectar la madera y su acabado.",
	},
	{
		label: "Evita el remojo.",
		text: "No dejes la pieza sumergida ni en contacto prolongado con agua.",
	},
	{
		label: "Seca inmediatamente.",
		text: "Después de limpiarla, retira el exceso de humedad y deja que seque correctamente.",
	},
	{
		label: "Evita el sol directo.",
		text: "No guardes ni dejes la pieza durante periodos prolongados bajo luz solar directa o junto a fuentes intensas de calor.",
	},
	{
		label: "Utiliza el producto según su función.",
		text: "Evita golpes, sobrecarga, manipulación brusca y usos distintos a los previstos para cada diseño.",
	},
	{
		label: "Consulta las indicaciones específicas.",
		text: "Los cuidados pueden variar según el tipo de producto, la madera, el cuero y el acabado.",
	},
];

const faqs = [
	{
		q: "¿Cuánto dura la garantía de TAQTO?",
		a: "Los productos TAQTO cuentan con una garantía comercial de seis meses contra defectos de fabricación, contados desde la fecha de entrega.",
	},
	{
		q: "¿Desde cuándo comienzan a contarse los seis meses?",
		a: "El plazo comienza el día en que recibes el producto.",
	},
	{
		q: "¿Qué se considera un defecto de fabricación?",
		a: "Es una falla atribuible al proceso de elaboración de la pieza que afecta su funcionalidad o el uso esperado. La determinación se realiza después de revisar cada caso.",
	},
	{
		q: "¿Una diferencia en la veta o el tono está cubierta?",
		a: "Las variaciones naturales de veta, tono y textura no se consideran por sí mismas defectos de fabricación. Cada pieza de madera o cuero puede presentar una apariencia ligeramente diferente.",
	},
	{
		q: "¿La garantía cubre daños por lavavajillas?",
		a: "No. Las piezas de madera no deben colocarse en lavavajillas, ya que el calor, la humedad y los detergentes pueden afectar el material y el acabado.",
	},
	{
		q: "¿La garantía cubre una pieza que estuvo en remojo?",
		a: "No cubre daños ocasionados por dejar el producto sumergido o en contacto prolongado con agua.",
	},
	{
		q: "¿La exposición al sol puede afectar el producto?",
		a: "Sí. La exposición prolongada al sol o a fuentes intensas de calor puede alterar el tono, resecar o afectar los materiales. Los daños producidos por esta exposición no están cubiertos por la garantía comercial.",
	},
	{
		q: "¿Los cortes y marcas de uso están cubiertos?",
		a: "Las marcas y el desgaste razonable producidos por el uso cotidiano no se consideran defectos de fabricación.",
	},
	{
		q: "¿Qué fotografías debo enviar?",
		a: "Envía una imagen completa de la pieza, fotografías cercanas de la zona afectada y diferentes ángulos que permitan comprender la incidencia.",
	},
	{
		q: "¿Necesito presentar mi comprobante de compra?",
		a: "Para identificar correctamente el pedido, podremos solicitar el número de pedido, comprobante u otra información relacionada con la compra.",
	},
	{
		q: "¿Qué ocurre después de enviar mi solicitud?",
		a: "TAQTO revisará la información y podrá solicitar evidencias adicionales. Después de la evaluación, te comunicaremos el resultado y los siguientes pasos.",
	},
	{
		q: "¿La garantía comercial reemplaza mis derechos como consumidor?",
		a: "No. Las condiciones de esta garantía comercial no excluyen los derechos que correspondan al consumidor de acuerdo con la normativa aplicable.",
	},
];

const faqJsonLd = buildFaqJsonLd(faqs);
const warrantyPageJsonLd = faqJsonLd ? [faqJsonLd] : [];
---

<PageLayout
	title="Garantía de productos de madera | TAQTO"
	description="Conoce la garantía de seis meses de TAQTO, qué defectos de fabricación cubre, qué situaciones no están incluidas y cómo solicitar una evaluación."
	jsonLd={warrantyPageJsonLd}
>
	<PageHero
		eyebrow="Garantía y respaldo"
		title="Garantía de los productos TAQTO"
		lede="Cada pieza TAQTO cuenta con una garantía comercial de seis meses contra defectos de fabricación, contados desde la fecha de entrega."
		split="7-5"
	>
		<p class="lede measure-lede" style="margin-top:14px">
			Si identificas una posible falla, comunícate con nosotros para que
			podamos conocer el caso, revisar la pieza y orientarte sobre los
			siguientes pasos.
		</p>

		<div class="actions">
			<a
				href={wa}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn--primary"
			>
				Solicitar evaluación
			</a>

			<a href="#cobertura" class="sp-btn sp-btn--ghost">
				Conocer la cobertura
			</a>
		</div>

		<p class="note">
			Ten a la mano la información de tu pedido y fotografías claras del
			producto.
		</p>

		<div slot="aside">
			<p class="facts-caption">Resumen de la garantía</p>

			<ul class="facts">
				{
					resumen.map((item) => {
						const Icon = item.icon;

						return (
							<li>
								<Icon
									class="facts__icon"
									aria-hidden="true"
									size={20}
									stroke-width={1.75}
								/>

								<div>
									<p class="facts__label">{item.label}</p>
									<p class="facts__value">{item.value}</p>
									<p class="facts__hint">{item.hint}</p>
								</div>
							</li>
						);
					})
				}
			</ul>
		</div>
	</PageHero>

	<!-- Contexto: encabezado 5 + explicación 7 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5">
					<h2>Una pieza natural también necesita cuidados</h2>
				</div>

				<div class="c7 flow measure" style="--flow:15px">
					<p>
						Los productos TAQTO están elaborados con madera, cuero o
						una combinación de ambos materiales.
					</p>

					<p>
						Debido a su origen natural, cada pieza presenta
						variaciones propias de veta, tono y textura. También
						puede experimentar cambios graduales como resultado del
						uso, el tiempo y el contacto con el entorno.
					</p>

					<p>
						La garantía protege al cliente frente a defectos
						atribuibles a la fabricación. No reemplaza los cuidados
						necesarios para conservar correctamente el producto.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Qué cubre: explicación 6 + criterios 6 -->
	<section class="sect" id="cobertura">
		<div class="wrap">
			<div class="g12">
				<div class="c6 flow" style="--flow:15px">
					<h2>¿Qué cubre la garantía de TAQTO?</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							La garantía comercial cubre, durante seis meses
							desde la entrega, los defectos atribuibles al
							proceso de fabricación que afecten la funcionalidad
							o el uso esperado del producto.
						</p>

						<p>
							Para determinar si una situación corresponde a la
							garantía, TAQTO evaluará las características de la
							pieza, la incidencia reportada y la información
							disponible sobre su uso y conservación.
						</p>
					</div>

					<p class="pull">
						La existencia de una marca, variación o cambio visible
						no significa necesariamente que exista un defecto de
						fabricación. Cada caso debe evaluarse considerando la
						naturaleza del material.
					</p>
				</div>

				<div class="c6">
					<div class="card">
						<span class="card__icon">
							<ListChecks
								aria-hidden="true"
								size={20}
								stroke-width={1.75}
							/>
						</span>

						<h3 class="card__title card__title--sm">
							La evaluación considera:
						</h3>

						<ul class="list">
							{evaluacion.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Qué no cubre -->
	<section class="sect sect--tint">
		<div class="wrap">
			<div class="sect__head">
				<h2>Situaciones que no corresponden a la garantía comercial</h2>

				<p class="lede measure-lede">
					La garantía no cubre daños o alteraciones ocasionados por un
					uso distinto al recomendado, una exposición inadecuada o el
					desgaste natural de los materiales.
				</p>
			</div>

			<ul class="cards" style="--cols:3">
				{
					noCubre.map((item) => (
						<li>
							<InfoCard
								icon={item.icon}
								title={item.title}
								variant="avoid"
								compactTitle
							>
								<p>{item.text}</p>
							</InfoCard>
						</li>
					))
				}
			</ul>

			<div
				class="g12"
				style="margin-top:clamp(28px,3vw,40px);align-items:center"
			>
				<p class="pull c7">
					La madera y el cuero evolucionan con el uso. El
					envejecimiento natural del material no equivale a una falla
					de fabricación.
				</p>

				<div class="c5 actions">
					<a href={cuidados} class="sp-btn sp-btn--ghost">
						Ver recomendaciones de cuidado
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Variaciones naturales: relato 7 + lista 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<h2>Cada pieza tiene una expresión propia</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							La veta, el tono y la textura pueden variar de una
							pieza a otra. Estas diferencias son características
							naturales de la madera y el cuero, y no representan
							por sí mismas un defecto.
						</p>

						<p>
							Las fotografías de la web muestran referencias del
							producto, pero la distribución de la veta, los
							matices y ciertos detalles naturales pueden cambiar
							en cada unidad.
						</p>

						<p>
							Con el tiempo, el uso y la exposición al ambiente
							también pueden modificar gradualmente la apariencia
							de los materiales.
						</p>

						<p class="pull">
							La variación natural no reduce el valor de la pieza:
							forma parte de la identidad del material con el que
							fue elaborada.
						</p>
					</div>
				</div>

				<div class="c5">
					<ul class="list">
						{variaciones.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Proceso de evaluación -->
	<section class="sect">
		<div class="wrap">
			<div class="sect__head">
				<h2>¿Cómo revisamos una solicitud?</h2>
			</div>

			<ProcessSteps steps={proceso} cols={3} />

			<p class="pull" style="margin-top:clamp(28px,3vw,40px)">
				Cada solicitud se revisa de manera individual. No se rechaza ni
				se aprueba automáticamente solo a partir de una fotografía.
			</p>
		</div>
	</section>

	<!-- Información necesaria: encabezado 5 + lista 7 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5 flow" style="--flow:15px">
					<h2>¿Identificaste una posible falla?</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Comunícate con TAQTO y cuéntanos qué ocurrió. Para
							revisar el caso necesitaremos información que nos
							permita identificar el producto y conocer claramente
							la incidencia.
						</p>

						<p>
							Toma las imágenes con buena iluminación, sin filtros
							y desde diferentes ángulos. Incluye una fotografía
							completa del producto y acercamientos de la zona que
							deseas reportar.
						</p>
					</div>
				</div>

				<div class="c7 flow" style="--flow:20px">
					<p class="strong-line">Información recomendada:</p>

					<ul class="list list--cols">
						{informacion.map((item) => <li>{item}</li>)}
					</ul>

					<div class="actions">
						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn--primary"
						>
							Solicitar evaluación por WhatsApp
						</a>
					</div>

					<p class="note">
						Enviar información completa nos ayudará a comprender
						mejor el caso.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Cuidados esenciales -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c4 flow" style="--flow:15px">
					<h2>Cuidados esenciales para tu pieza</h2>

					<p class="lede measure-tight">
						Conservar el producto correctamente ayuda a que la
						garantía no tenga que intervenir.
					</p>

					<div class="actions">
						<a href={cuidados} class="sp-btn sp-btn--ghost">
							Ver guía de cuidados
						</a>
					</div>
				</div>

				<div class="c8">
					<ul class="list list--cols">
						{
							cuidadosEsenciales.map((item) => (
								<li>
									<strong class="strong-line">
										{item.label}
									</strong>{" "}
									{item.text}
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Preguntas frecuentes -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c4 flow" style="--flow:14px">
					<span class="card__icon">
						<CircleQuestionMark
							aria-hidden="true"
							size={20}
							stroke-width={1.75}
						/>
					</span>

					<h2>Preguntas frecuentes sobre la garantía</h2>
				</div>

				<div class="c8">
					<div class="faq">
						{
							faqs.map((item) => (
								<details>
									<summary>{item.q}</summary>

									<div class="faq__answer">
										<p>{item.a}</p>
									</div>
								</details>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA final -->
	<section class="sect sect--last">
		<div class="wrap">
			<div class="page-cta page-cta--split">
				<div class="page-cta__text">
					<p class="eyebrow">Estamos para revisar tu caso</p>

					<h2>Cuéntanos qué ocurrió con tu producto</h2>

					<p class="measure">
						Envíanos la información de tu pedido, una descripción de
						la incidencia y fotografías claras de la pieza.
						Revisaremos el caso y te orientaremos sobre los
						siguientes pasos.
					</p>

					<p class="note">
						La evaluación se realiza considerando las
						características del producto, su uso y el estado de la
						pieza.
					</p>
				</div>

				<div class="actions">
					<a
						href={wa}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn--primary"
					>
						Solicitar evaluación por WhatsApp
					</a>

					<a href={cuidados} class="sp-btn sp-btn--ghost">
						Ver cuidados del producto
					</a>
				</div>
			</div>
		</div>
	</section>
</PageLayout>
