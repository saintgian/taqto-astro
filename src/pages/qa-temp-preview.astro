---
import BaseLayout from "../layouts/BaseLayout.astro";
import CampaignBanner from "../components/CampaignBanner.astro";
import WoodGuide from "../components/WoodGuide.astro";

const mockProduct = {
	_id: "mock-1",
	title: "Tabla parrillera Mara",
	slug: "tabla-parrillera-mara",
	productMode: "wood",
	saleStart: null,
	saleEnd: null,
	gallery: [
		{
			_key: "img1",
			alt: "Tabla parrillera Mara",
			asset: {
				_ref: "image-Tb9Ew8CXIwaY6R1kjPjqoU3E-1600x1280-webp",
				_type: "reference",
			},
		},
	],
	category: { title: "Parrilla", slug: "parrilla" },
	subcategory: { title: "Tablas parrilleras", slug: "tablas-parrilleras" },
	uniqueProduct: {
		price: 89,
		salePrice: null,
		stockQuantity: 10,
		available: true,
	},
	variants: [],
};
---

<BaseLayout title="QA temporal">
	<div style="padding-top: 24px;">
		<div style="width:min(calc(100% - 48px),1440px);margin-inline:auto;border-radius:24px;overflow:hidden;">
			<CampaignBanner
				eyebrow="Nueva colección"
				title="Piezas de madera con grabado láser personalizado."
				description="Diseños hechos a mano, listos para regalar o personalizar con tu propio mensaje."
				buttonText="Explorar colección"
				layoutMode="productSpotlight"
				featuredProduct={mockProduct}
				imageUrl="https://picsum.photos/1400/700"
				mobileImageUrl="https://picsum.photos/900/700"
				imageAlt="Foto de prueba"
			/>
		</div>
	</div>

	<div style="width:min(calc(100% - 48px),1440px);margin-inline:auto;margin-top:24px;border-radius:24px;overflow:hidden;">
		<CampaignBanner
			eyebrow="Editorial sin producto"
			title="Modo editorial de prueba"
			description="Verifica que sin featuredProduct no se reserve espacio para el dock."
			buttonText="Ver más"
			layoutMode="productSpotlight"
			imageUrl="https://picsum.photos/1400/701"
			imageAlt="Foto de prueba 2"
		/>
	</div>

	<WoodGuide />
</BaseLayout>
