---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ProductCard from "../../components/ProductCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { PortableText } from "astro-portabletext";
import {
	sanityClient,
	urlForImage,
} from "../../lib/sanity";

import { productDetailQuery } from "../../lib/productDetailQuery";
import {
	PenLine,
	ArrowRight,
	Truck,
	Sparkles,
	Ruler,
	TreePine,
} from "@lucide/astro";

interface Wood {
	title?: string;
	slug?: string;
	image?: unknown;
}

interface ProductSize {
	title?: string;
	slug?: string;
	dimensionsLabel?: string;
}

interface Variant {
	_key?: string;
	sku?: string;
	price?: number;
	salePrice?: number;
	stockQuantity?: number;
	active?: boolean;
	wood?: Wood;
	size?: ProductSize;
}

interface ProductImage {
	_key?: string;
	alt?: string;
	caption?: string;
	asset?: unknown;
}

interface EditorialImage {
	alt?: string;
	caption?: string;
	asset?: {
		metadata?: {
			dimensions?: {
				width?: number;
				height?: number;
			};
		};
	};
	crop?: unknown;
	hotspot?: unknown;
}

interface Product {
	_id: string;
	title: string;
	slug: string;
	sku?: string;
	dimensions?: string;
	shortDescription?: any[];
	description?: any[];
	productMode?: string;
	gallery?: ProductImage[];
	longDescriptionImage?: EditorialImage;
	materials?: string[];
	careInstructions?: string;
	saleStart?: string;
	saleEnd?: string;
	engravingIncluded?: boolean;
	engravingTypes?: string[];
	engravingMaxCharacters?: number;
	personalizationNotes?: string;
	corporateEligible?: boolean;
	metaTitle?: string;
	metaDescription?: string;

	category?: {
		title?: string;
		slug?: string;
	};

	subcategory?: {
		title?: string;
		slug?: string;
	};

	uniqueProduct?: {
		sku?: string;
		price?: number;
		salePrice?: number;
		stockQuantity?: number;
		available?: boolean;
		wood?: Wood;
		size?: ProductSize;
	};

	variants?: Variant[];
}

export async function getStaticPaths() {
	const products =
		await sanityClient.fetch<Product[]>(
			productDetailQuery,
		);

	return products.map((product) => {
		const crossSell = products
			.filter(
				(candidate) =>
					candidate.slug !== product.slug &&
					candidate.category?.slug ===
						product.category?.slug,
			)
			.slice(0, 4);

		return {
			params: {
				slug: product.slug,
			},

			props: {
				product,
				crossSell,
			},
		};
	});
}

const { product, crossSell } = Astro.props as {
	product: Product;
	crossSell: Product[];
};

const base = import.meta.env.BASE_URL;

const categoryHref = product.category?.slug
	? `${base}categorias/${product.category.slug}/`
	: `${base}categorias/`;

const breadcrumbItems = [
	{ label: "Inicio", href: base },
	{
		label: product.category?.title || "Tienda",
		href: categoryHref,
	},
	{ label: product.title },
];

const activeVariants = (product.variants || []).filter(
	(variant) => variant.active !== false,
);

const uniqueWoods = Array.from(
	new Map(
		activeVariants
			.filter((variant) => variant.wood?.slug)
			.map((variant) => [
				variant.wood?.slug,
				variant.wood,
			]),
	).values(),
).filter(Boolean) as Wood[];

const uniqueSizes = Array.from(
	new Map(
		activeVariants
			.filter((variant) => variant.size?.slug)
			.map((variant) => [
				variant.size?.slug,
				variant.size,
			]),
	).values(),
).filter(Boolean) as ProductSize[];

const hasWoodSelector =
	product.productMode === "wood" ||
	product.productMode === "woodSize";

const hasSizeSelector =
	product.productMode === "size" ||
	product.productMode === "woodSize";

const saleIsActive = (
	saleStart?: string,
	saleEnd?: string,
) => {
	const now = Date.now();

	if (
		saleStart &&
		now < new Date(saleStart).getTime()
	) {
		return false;
	}

	if (
		saleEnd &&
		now > new Date(saleEnd).getTime()
	) {
		return false;
	}

	return true;
};

const currentSaleIsActive = saleIsActive(
	product.saleStart,
	product.saleEnd,
);

const firstVariant =
	product.productMode === "unique"
		? product.uniqueProduct
		: activeVariants[0];

const initialRegularPrice =
	firstVariant?.price ?? 0;

const initialSalePrice =
	currentSaleIsActive
		? firstVariant?.salePrice
		: undefined;

const initialVisiblePrice =
	typeof initialSalePrice === "number"
		? initialSalePrice
		: initialRegularPrice;

const initialStock =
	firstVariant?.stockQuantity ?? 0;

const initialSku =
	product.productMode === "unique"
		? product.sku
		: (firstVariant as Variant)?.sku || product.sku;

const initialDimensions =
	product.dimensions ||
	firstVariant?.size?.dimensionsLabel ||
	"";

const initialWoodTitle =
	firstVariant?.wood?.title || "";

const benefitRows = [
	product.engravingIncluded && {
		icon: PenLine,
		text: "Grabado láser personalizado sin costo adicional.",
	},
	{
		icon: Truck,
		text: "Entrega estimada: 2 días hábiles en Lima Metropolitana. Envíos a provincias por agencia.",
	},
].filter(Boolean) as { icon: typeof PenLine; text: string }[];

const formatPrice = (value: number) =>
	new Intl.NumberFormat("es-PE", {
		style: "currency",
		currency: "PEN",
		minimumFractionDigits: 2,
	}).format(value);

const mainImage = product.gallery?.[0];

const mainImageUrl = mainImage
	? urlForImage(mainImage)
			.width(1600)
			.height(2000)
			.fit("crop")
			.auto("format")
			.url()
	: "";

const mainImageAlt =
	mainImage?.alt ||
	`${product.title} de TAQTO`;

const editorialImage = product.longDescriptionImage;

const hasEditorialImage = Boolean(editorialImage?.asset);

const editorialImageWidth = 1200;

const editorialSourceDimensions =
	editorialImage?.asset?.metadata?.dimensions;

const editorialImageHeight =
	editorialSourceDimensions?.width &&
	editorialSourceDimensions?.height
		? Math.round(
				editorialImageWidth *
					(editorialSourceDimensions.height /
						editorialSourceDimensions.width),
			)
		: Math.round(editorialImageWidth * (5 / 4));

const editorialImageAspectRatio = `${editorialImageWidth} / ${editorialImageHeight}`;

const editorialImageUrl = hasEditorialImage
	? urlForImage(editorialImage as EditorialImage)
			.width(editorialImageWidth)
			.fit("max")
			.auto("format")
			.url()
	: "";

const plainTextFromBlocks = (
	blocks?: any[],
): string =>
	(blocks || [])
		.filter((block) => block._type === "block")
		.map((block) =>
			(block.children || [])
				.map((child: any) => child.text || "")
				.join(""),
		)
		.join(" ")
		.trim();

const descriptionBlocks = Array.isArray(product.description)
	? product.description
	: [];

const editorialRows = [
	{
		title: "Material y fabricación",
		icon: TreePine,
		kind: "portableText" as const,
		content: descriptionBlocks,
	},
	{
		title: "Personalización",
		icon: PenLine,
		kind: "text" as const,
		content: product.personalizationNotes,
	},
	{
		title: "Uso y cuidado",
		icon: Sparkles,
		kind: "text" as const,
		content: product.careInstructions,
	},
].filter((row) =>
	row.kind === "portableText"
		? row.content.length > 0
		: Boolean(row.content),
);

const isColumnEligible = (row: (typeof editorialRows)[number]) =>
	row.kind === "portableText" &&
	plainTextFromBlocks(row.content).length > 480;

const truncateText = (
	text: string,
	max: number,
): string => {
	if (!text || text.length <= max) return text || "";

	const cut = text.slice(0, max);
	const lastSpace = cut.lastIndexOf(" ");

	return `${cut.slice(0, lastSpace > 40 ? lastSpace : max)}…`;
};

const careSummary = truncateText(
	product.careInstructions || "",
	130,
);

const pageTitle =
	product.metaTitle ||
	`${product.title} | TAQTO`;

const pageDescription =
	product.metaDescription ||
	plainTextFromBlocks(product.shortDescription) ||
	`Conoce ${product.title} de TAQTO.`;

const engravingLabels: Record<string, string> = {
	name: "Nombre",
	phrase: "Frase",
	date: "Fecha",
	logo: "Logotipo",
};

const variantData = activeVariants.map((variant) => ({
	key: variant._key || "",
	woodSlug: variant.wood?.slug || "",
	woodTitle: variant.wood?.title || "",
	sizeSlug: variant.size?.slug || "",
	sizeTitle: variant.size?.title || "",
	dimensions: variant.size?.dimensionsLabel || "",
	sku: variant.sku || product.sku || "",
	price: variant.price || 0,
	salePrice:
		typeof variant.salePrice === "number"
			? variant.salePrice
			: null,
	stock: variant.stockQuantity || 0,
}));

const uniqueProductData =
	product.productMode === "unique"
		? {
				sku:
					product.uniqueProduct?.sku ||
					product.sku ||
					"",
				price: product.uniqueProduct?.price || 0,
				salePrice:
					typeof product.uniqueProduct
						?.salePrice === "number"
						? product.uniqueProduct.salePrice
						: null,
				stock:
					product.uniqueProduct
						?.stockQuantity || 0,
				woodSlug:
					product.uniqueProduct?.wood?.slug ||
					"",
				woodTitle:
					product.uniqueProduct?.wood?.title ||
					"",
				sizeSlug:
					product.uniqueProduct?.size?.slug ||
					"",
				sizeTitle:
					product.uniqueProduct?.size?.title ||
					"",
				dimensions:
					product.uniqueProduct?.size
						?.dimensionsLabel || "",
			}
		: null;

const safeVariantJson = JSON.stringify({
	variants: variantData,
	saleActive: currentSaleIsActive,
	productMode: product.productMode || "unique",
	uniqueProduct: uniqueProductData,
	product: {
		id: product._id,
		slug: product.slug,
		title: product.title,
		image: mainImageUrl,
	},
}).replace(/</g, "\\u003c");
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
>
	<Header />

	<main class="product-page">
		<Breadcrumbs items={breadcrumbItems} />

		<section class="product-hero">
			<div class="product-gallery">
				{
					product.gallery &&
					product.gallery.length > 1 && (
						<div
							class="product-thumbnails"
							aria-label="Galería del producto"
						>
							{product.gallery.map(
								(image, index) => {
									const thumbnailUrl =
										urlForImage(image)
											.width(160)
											.height(200)
											.fit("crop")
											.auto("format")
											.url();

									const largeUrl =
										urlForImage(image)
											.width(1600)
											.height(2000)
											.fit("crop")
											.auto("format")
											.url();

									return (
										<button
											class:list={[
												"product-thumbnail",
												{
													"is-active":
														index === 0,
												},
											]}
											type="button"
											data-product-thumbnail
											data-large-image={largeUrl}
											data-image-alt={
												image.alt ||
												product.title
											}
											aria-label={`Ver imagen ${
												index + 1
											}`}
										>
											<img
												src={thumbnailUrl}
												alt=""
												width="160"
												height="200"
												loading="lazy"
											/>
										</button>
									);
								},
							)}
						</div>
					)
				}

				<div class="product-main-image">
					{
						mainImageUrl ? (
							<img
								id="product-main-image"
								src={mainImageUrl}
								alt={mainImageAlt}
								width="1600"
								height="2000"
								loading="eager"
								decoding="async"
							/>
						) : (
							<div class="product-image-placeholder">
								<span>TAQTO</span>
							</div>
						)
					}
				</div>
			</div>

			<div class="product-information">
				<p class="product-category">
					{product.category?.title || "TAQTO"}
				</p>

				<h1>{product.title}</h1>

				<div class="product-price-wrapper">
					<p
						class="product-price"
						id="product-price"
					>
						{formatPrice(initialVisiblePrice)}
					</p>

					<p
						class:list={[
							"product-regular-price",
							{
								"is-hidden":
									typeof initialSalePrice !==
									"number",
							},
						]}
						id="product-regular-price"
					>
						{formatPrice(initialRegularPrice)}
					</p>
				</div>

				<div class="product-short-description">
					{
						Array.isArray(
							product.shortDescription,
						) &&
							product.shortDescription.length >
								0 && (
								<PortableText
									value={
										product.shortDescription
									}
								/>
							)
					}
				</div>

				{
					benefitRows.length > 0 && (
						<div class="product-benefits">
							{benefitRows.map((benefit) => {
								const BenefitIcon = benefit.icon;

								return (
									<div class="product-benefits__row">
										<BenefitIcon
											aria-hidden="true"
											size={15}
											stroke-width={1.75}
										/>

										<span>{benefit.text}</span>
									</div>
								);
							})}
						</div>
					)
				}

				<div class="product-status">
					<span
						class:list={[
							"product-status__dot",
							{
								"is-out":
									initialStock <= 0,
							},
						]}
						id="product-stock-dot"
					></span>

					<span id="product-stock-label">
						{
							initialStock > 0
								? `${initialStock} unidades disponibles`
								: "Temporalmente agotado"
						}
					</span>
				</div>

				{
					(initialDimensions || initialWoodTitle) && (
						<dl class="product-specs">
							{initialDimensions && (
								<div class="product-specs__row">
									<dt>
										<Ruler
											aria-hidden="true"
											size={16}
											stroke-width={1.75}
										/>
										Dimensiones
									</dt>
									<dd id="product-spec-dimensions">
										{initialDimensions}
									</dd>
								</div>
							)}

							{initialWoodTitle && (
								<div class="product-specs__row">
									<dt>
										<TreePine
											aria-hidden="true"
											size={16}
											stroke-width={1.75}
										/>
										Madera
									</dt>
									<dd id="product-spec-wood">
										{initialWoodTitle}
									</dd>
								</div>
							)}
						</dl>
					)
				}

				<div class="product-meta">
					<div class="product-meta__row">
						<span>SKU</span>
						<strong id="product-sku">
							{initialSku || "Sin SKU"}
						</strong>
					</div>
				</div>

				{
					hasWoodSelector &&
						uniqueWoods.length > 0 && (
							<fieldset class="product-option-group">
								<legend>Elige la madera</legend>

								<div class="product-option-list">
									{uniqueWoods.map(
										(wood, index) => (
											<button
												class:list={[
													"product-option",
													{
														"is-selected":
															index === 0,
													},
												]}
												type="button"
												data-option-wood
												data-value={wood.slug}
												aria-pressed={
													index === 0
														? "true"
														: "false"
												}
											>
												{wood.title}
											</button>
										),
									)}
								</div>
							</fieldset>
						)
				}

				{
					hasSizeSelector &&
						uniqueSizes.length > 0 && (
							<fieldset class="product-option-group">
								<legend>Elige el tamaño</legend>

								<div class="product-option-list">
									{uniqueSizes.map(
										(size, index) => (
											<button
												class:list={[
													"product-option",
													{
														"is-selected":
															index === 0,
													},
												]}
												type="button"
												data-option-size
												data-value={size.slug}
												aria-pressed={
													index === 0
														? "true"
														: "false"
												}
											>
												<strong>
													{size.title}
												</strong>

												{size.dimensionsLabel && (
													<small>
														{
															size.dimensionsLabel
														}
													</small>
												)}
											</button>
										),
									)}
								</div>
							</fieldset>
						)
				}

				<p
					class="product-variation-message"
					id="product-variation-message"
					aria-live="polite"
				></p>

				{
					product.engravingIncluded && (
						<div class="product-personalization">
							<div class="product-personalization__header">
								<div class="product-personalization__icon">
									<PenLine aria-hidden="true" stroke-width={1.75} />
								</div>

								<div>
									<strong>
										Personalización (grabado
										láser)
									</strong>

									<p>
										{
											product.personalizationNotes ||
												"Personaliza tu pieza sin costo adicional."
										}
									</p>
								</div>
							</div>

							<div class="product-engraving">
								<label for="product-engraving-text">
									<span>
										Texto para grabar
										(opcional)
									</span>

									{product.engravingMaxCharacters && (
										<span
											class="product-engraving__counter"
											id="product-engraving-counter"
										>
											0/
											{
												product.engravingMaxCharacters
											}
										</span>
									)}
								</label>

								<input
									type="text"
									id="product-engraving-text"
									name="engravingText"
									class="product-engraving__input"
									placeholder="Ej: Familia García"
									maxlength={
										product.engravingMaxCharacters ||
										undefined
									}
								/>

								{
									product.engravingTypes &&
										product.engravingTypes
											.length > 0 && (
											<p class="product-engraving__hint">
												Disponible en:{" "}
												{product.engravingTypes
													.map(
														(type) =>
															engravingLabels[
																type
															] || type,
													)
													.join(", ")}
												.
											</p>
										)
								}
							</div>
						</div>
					)
				}

				<div class="product-quantity-row">
					<div
						class="product-quantity"
						role="group"
						aria-label="Cantidad"
					>
						<button
							type="button"
							class="product-quantity__button"
							data-quantity-decrease
							aria-label="Reducir cantidad"
						>
							−
						</button>

						<input
							type="number"
							class="product-quantity__input"
							id="product-quantity-input"
							min="1"
							max={initialStock > 0 ? initialStock : 1}
							step="1"
							value="1"
							inputmode="numeric"
							aria-label="Cantidad"
						/>

						<button
							type="button"
							class="product-quantity__button"
							data-quantity-increase
							aria-label="Aumentar cantidad"
							disabled={initialStock <= 1}
							aria-disabled={initialStock <= 1 ? "true" : "false"}
						>
							+
						</button>
					</div>

					<button
						type="button"
						class:list={[
							"btn",
							"btn--primary",
							"product-add-to-cart",
							{
								"is-disabled":
									initialStock <= 0,
							},
						]}
						id="product-add-to-cart"
						disabled={initialStock <= 0}
						aria-disabled={initialStock <= 0 ? "true" : "false"}
					>
						<span class="product-add-to-cart__labels">
							<span
								id="product-add-to-cart-label"
								class="product-add-to-cart__label product-add-to-cart__label--default"
							>
								Agregar al carrito
							</span>

							<span
								class="product-add-to-cart__label product-add-to-cart__label--confirm"
								aria-hidden="true"
							>
								Agregado ✓
							</span>
						</span>
					</button>
				</div>

				<p
					id="product-add-to-cart-status"
					class="product-add-to-cart__status"
					role="status"
					aria-live="polite"
				></p>

				{
					product.careInstructions && (
						<div class="product-secondary">
							<Sparkles
								aria-hidden="true"
								size={16}
								stroke-width={1.75}
							/>

							<div class="product-secondary__body">
								<strong>Cuidados</strong>

								<p>
									{careSummary}{" "}
									<a href={`${base}cuidados/`}>
										Ver más
									</a>
								</p>
							</div>
						</div>
					)
				}
			</div>
		</section>

		{
			editorialRows.length > 0 && (
				<section class="product-longdesc">
					<h2 class="product-longdesc__title">
						Descripción
					</h2>

					{
						hasEditorialImage && (
							<figure class="product-longdesc__figure">
								<img
									src={editorialImageUrl}
									alt={editorialImage?.alt || ""}
									width={editorialImageWidth}
									height={editorialImageHeight}
									style={`aspect-ratio: ${editorialImageAspectRatio};`}
									loading="lazy"
									decoding="async"
								/>

								{editorialImage?.caption && (
									<figcaption>
										{editorialImage.caption}
									</figcaption>
								)}
							</figure>
						)
					}

					<div class="product-longdesc__rows">
						{editorialRows.map((row) => {
							const RowIcon = row.icon;

							return (
								<article
									class:list={[
										"product-longdesc__row",
										{
											"product-longdesc__row--columns":
												isColumnEligible(row),
										},
									]}
								>
									<div class="product-longdesc__row-head">
										<RowIcon
											aria-hidden="true"
											size={18}
											stroke-width={1.75}
										/>

										<h3 class="product-longdesc__row-title">
											{row.title}
										</h3>
									</div>

									<div class="product-longdesc__row-text">
										{row.kind === "portableText" ? (
											<PortableText
												value={row.content}
											/>
										) : (
											<p>{row.content}</p>
										)}
									</div>
								</article>
							);
						})}
					</div>

					{product.materials &&
						product.materials.length > 0 && (
							<div class="product-materials product-longdesc__materials">
								<ul>
									{product.materials.map(
										(material) => (
											<li>{material}</li>
										),
									)}
								</ul>
							</div>
						)}
				</section>
			)
		}

		{
			crossSell.length > 0 && (
				<section class="product-crosssell">
					<div class="product-crosssell__heading">
						<h2>Completa tu kit</h2>

						<a href={categoryHref}>
							Ver toda la categoría
							<ArrowRight aria-hidden="true" size={16} stroke-width={1.75} />
						</a>
					</div>

					<div class="product-crosssell__grid">
						{crossSell.map((related) => (
							<ProductCard
								product={related}
								hoverGallery
							/>
						))}
					</div>
				</section>
			)
		}

		<script
			id="product-variant-data"
			type="application/json"
			set:html={safeVariantJson}
		></script>
	</main>
</BaseLayout>

<script>
	import { addItem } from "../../lib/cart";

	const initializeProductPage = () => {
		const dataElement =
			document.querySelector<HTMLScriptElement>(
				"#product-variant-data",
			);

		if (!dataElement) return;

		const parsedData = JSON.parse(
			dataElement.textContent || "{}",
		);

		const variants = parsedData.variants || [];
		const saleActive =
			parsedData.saleActive === true;
		const productMode =
			parsedData.productMode || "unique";
		const uniqueProductInfo =
			parsedData.uniqueProduct || null;
		const productInfo = parsedData.product || {};

		const woodButtons = Array.from(
			document.querySelectorAll<HTMLButtonElement>(
				"[data-option-wood]",
			),
		);

		const sizeButtons = Array.from(
			document.querySelectorAll<HTMLButtonElement>(
				"[data-option-size]",
			),
		);

		const priceElement =
			document.querySelector<HTMLElement>(
				"#product-price",
			);

		const regularPriceElement =
			document.querySelector<HTMLElement>(
				"#product-regular-price",
			);

		const skuElement =
			document.querySelector<HTMLElement>(
				"#product-sku",
			);

		const specDimensionsElement =
			document.querySelector<HTMLElement>(
				"#product-spec-dimensions",
			);

		const specWoodElement =
			document.querySelector<HTMLElement>(
				"#product-spec-wood",
			);

		const stockLabel =
			document.querySelector<HTMLElement>(
				"#product-stock-label",
			);

		const stockDot =
			document.querySelector<HTMLElement>(
				"#product-stock-dot",
			);

		const messageElement =
			document.querySelector<HTMLElement>(
				"#product-variation-message",
			);

		const addToCartButton =
			document.querySelector<HTMLButtonElement>(
				"#product-add-to-cart",
			);

		const addToCartStatus =
			document.querySelector<HTMLElement>(
				"#product-add-to-cart-status",
			);

		let addToCartConfirmTimer: number | undefined;

		const showAddedConfirmation = () => {
			if (!addToCartButton) return;

			if (addToCartConfirmTimer !== undefined) {
				window.clearTimeout(addToCartConfirmTimer);
			}

			addToCartButton.classList.add("is-confirmed");

			if (addToCartStatus) {
				// Se vacia primero para que lectores de pantalla vuelvan
				// a anunciar el mensaje aunque sea identico al anterior
				// (altas consecutivas del mismo producto).
				addToCartStatus.textContent = "";

				window.requestAnimationFrame(() => {
					addToCartStatus.textContent =
						"Producto añadido al carrito";
				});
			}

			addToCartConfirmTimer = window.setTimeout(() => {
				addToCartButton.classList.remove(
					"is-confirmed",
				);
				addToCartConfirmTimer = undefined;
			}, 1300);
		};

		const quantityInput =
			document.querySelector<HTMLInputElement>(
				"#product-quantity-input",
			);

		const quantityDecrease =
			document.querySelector<HTMLButtonElement>(
				"[data-quantity-decrease]",
			);

		const quantityIncrease =
			document.querySelector<HTMLButtonElement>(
				"[data-quantity-increase]",
			);

		const engravingInput =
			document.querySelector<HTMLInputElement>(
				"#product-engraving-text",
			);

		const engravingCounter =
			document.querySelector<HTMLElement>(
				"#product-engraving-counter",
			);

		const updateEngravingCounter = () => {
			if (!engravingInput || !engravingCounter) return;

			const max = engravingInput.maxLength;
			const length = engravingInput.value.length;

			engravingCounter.textContent =
				max > 0 ? `${length}/${max}` : String(length);
		};

		engravingInput?.addEventListener(
			"input",
			updateEngravingCounter,
		);

		updateEngravingCounter();

		let selectedWood =
			woodButtons.find((button) =>
				button.classList.contains("is-selected"),
			)?.dataset.value || "";

		let selectedSize =
			sizeButtons.find((button) =>
				button.classList.contains("is-selected"),
			)?.dataset.value || "";

		const formatPrice = (value: number) =>
			new Intl.NumberFormat("es-PE", {
				style: "currency",
				currency: "PEN",
				minimumFractionDigits: 2,
			}).format(value);

		const findVariant = () =>
			variants.find((variant: any) => {
				const woodMatches =
					!woodButtons.length ||
					variant.woodSlug === selectedWood;

				const sizeMatches =
					!sizeButtons.length ||
					variant.sizeSlug === selectedSize;

				return woodMatches && sizeMatches;
			});

		const getCurrentSelection = () => {
			if (productMode === "unique") {
				if (!uniqueProductInfo) return null;

				return {
					sku: uniqueProductInfo.sku || "",
					price: uniqueProductInfo.price || 0,
					salePrice:
						uniqueProductInfo.salePrice,
					stock: uniqueProductInfo.stock || 0,
					woodTitle:
						uniqueProductInfo.woodTitle || "",
					woodSlug:
						uniqueProductInfo.woodSlug || "",
					sizeTitle:
						uniqueProductInfo.sizeTitle || "",
					sizeSlug:
						uniqueProductInfo.sizeSlug || "",
					dimensions:
						uniqueProductInfo.dimensions || "",
				};
			}

			const variant = findVariant();
			if (!variant) return null;

			return {
				sku: variant.sku || "",
				price: variant.price || 0,
				salePrice: variant.salePrice,
				stock: variant.stock || 0,
				woodTitle: variant.woodTitle || "",
				woodSlug: variant.woodSlug || "",
				sizeTitle: variant.sizeTitle || "",
				sizeSlug: variant.sizeSlug || "",
				dimensions: variant.dimensions || "",
			};
		};

		const updateInterface = () => {
			if (!variants.length) return;

			const variant = findVariant();

			if (!variant) {
				if (messageElement) {
					messageElement.textContent =
						"Esta combinación no está disponible.";
				}

				addToCartButton?.classList.add(
					"is-disabled",
				);

				if (addToCartButton) {
					addToCartButton.disabled = true;
					addToCartButton.setAttribute(
						"aria-disabled",
						"true",
					);
				}

				return;
			}

			if (messageElement) {
				messageElement.textContent = "";
			}

			const hasSale =
				saleActive &&
				typeof variant.salePrice === "number";

			if (priceElement) {
				priceElement.textContent = formatPrice(
					hasSale
						? variant.salePrice
						: variant.price,
				);
			}

			if (regularPriceElement) {
				regularPriceElement.textContent =
					formatPrice(variant.price);

				regularPriceElement.classList.toggle(
					"is-hidden",
					!hasSale,
				);
			}

			if (skuElement) {
				skuElement.textContent =
					variant.sku || "Sin SKU";
			}

			if (specDimensionsElement && variant.dimensions) {
				specDimensionsElement.textContent =
					variant.dimensions;
			}

			if (specWoodElement && variant.woodTitle) {
				specWoodElement.textContent =
					variant.woodTitle;
			}

			const stock = Number(variant.stock || 0);

			if (stockLabel) {
				stockLabel.textContent =
					stock > 0
						? `${stock} unidades disponibles`
						: "Temporalmente agotado";
			}

			stockDot?.classList.toggle(
				"is-out",
				stock <= 0,
			);

			addToCartButton?.classList.toggle(
				"is-disabled",
				stock <= 0,
			);

			if (addToCartButton) {
				addToCartButton.disabled = stock <= 0;
				addToCartButton.setAttribute(
					"aria-disabled",
					stock <= 0 ? "true" : "false",
				);
			}

			// La variante pudo cambiar a una con menos stock: se
			// re-acota la cantidad elegida y el boton "+" al nuevo limite.
			setQuantity(getQuantity());
		};

		const selectButton = (
			button: HTMLButtonElement,
			buttons: HTMLButtonElement[],
		) => {
			buttons.forEach((currentButton) => {
				const selected =
					currentButton === button;

				currentButton.classList.toggle(
					"is-selected",
					selected,
				);

				currentButton.setAttribute(
					"aria-pressed",
					String(selected),
				);
			});
		};

		woodButtons.forEach((button) => {
			button.addEventListener("click", () => {
				selectButton(button, woodButtons);

				selectedWood =
					button.dataset.value || "";

				updateInterface();
			});
		});

		sizeButtons.forEach((button) => {
			button.addEventListener("click", () => {
				selectButton(button, sizeButtons);

				selectedSize =
					button.dataset.value || "";

				updateInterface();
			});
		});

		const getStockLimit = () => {
			const selection = getCurrentSelection();
			return selection
				? Math.max(0, Number(selection.stock) || 0)
				: 0;
		};

		const getQuantity = () => {
			const value = Number(
				quantityInput?.value || 1,
			);

			if (!Number.isFinite(value) || value < 1) {
				return 1;
			}

			return Math.floor(value);
		};

		let stockLimitTimer: number | undefined;

		const announceStockLimit = (limit: number) => {
			if (!messageElement) return;

			if (stockLimitTimer !== undefined) {
				window.clearTimeout(stockLimitTimer);
			}

			messageElement.textContent = "";

			window.requestAnimationFrame(() => {
				messageElement.textContent =
					limit > 0
						? `Alcanzaste el máximo disponible: ${limit} unidad${limit === 1 ? "" : "es"}.`
						: "Esta combinación no tiene stock disponible.";
			});

			stockLimitTimer = window.setTimeout(() => {
				if (messageElement.textContent) {
					messageElement.textContent = "";
				}

				stockLimitTimer = undefined;
			}, 3000);
		};

		const setQuantity = (value: number) => {
			if (!quantityInput) return;

			const limit = getStockLimit();
			const safeValue = Number.isFinite(value)
				? Math.floor(value)
				: 1;

			const clamped =
				limit > 0
					? Math.min(Math.max(1, safeValue), limit)
					: 1;

			quantityInput.value = String(clamped);
			quantityInput.max = String(limit > 0 ? limit : 1);

			const atMax = limit <= 0 || clamped >= limit;

			if (quantityIncrease) {
				quantityIncrease.disabled = atMax;
				quantityIncrease.setAttribute(
					"aria-disabled",
					String(atMax),
				);
			}
		};

		quantityDecrease?.addEventListener(
			"click",
			() => {
				setQuantity(getQuantity() - 1);
			},
		);

		quantityIncrease?.addEventListener(
			"click",
			() => {
				const limit = getStockLimit();
				const next = getQuantity() + 1;

				if (limit > 0 && next > limit) {
					announceStockLimit(limit);
					return;
				}

				setQuantity(next);
			},
		);

		quantityInput?.addEventListener(
			"change",
			() => {
				const limit = getStockLimit();
				const requested = getQuantity();

				if (limit > 0 && requested > limit) {
					announceStockLimit(limit);
				}

				setQuantity(requested);
			},
		);

		addToCartButton?.addEventListener(
			"click",
			() => {
				if (
					addToCartButton.disabled ||
					addToCartButton.classList.contains(
						"is-disabled",
					)
				) {
					return;
				}

				const selection =
					getCurrentSelection();

				if (!selection) {
					if (messageElement) {
						messageElement.textContent =
							"Elige una combinación disponible antes de agregar al carrito.";
					}

					return;
				}

				const stockLimit = Math.max(
					0,
					Number(selection.stock) || 0,
				);

				if (stockLimit <= 0) {
					announceStockLimit(0);
					return;
				}

				const hasSale =
					saleActive &&
					typeof selection.salePrice ===
						"number";

				const unitPrice = hasSale
					? selection.salePrice
					: selection.price;

				const engravingText =
					engravingInput?.value.trim() || "";

				const cartId = [
					productInfo.slug,
					selection.woodTitle,
					selection.sizeTitle,
					engravingText,
				]
					.filter(Boolean)
					.join("__");

				const requestedQuantity = Math.min(
					getQuantity(),
					stockLimit,
				);

				let result;

				try {
					result = addItem({
						id: cartId || productInfo.slug,
						productId: productInfo.id,
						slug: productInfo.slug,
						title: productInfo.title,
						image: productInfo.image || "",
						sku: selection.sku,
						woodTitle:
							selection.woodTitle ||
							undefined,
						woodSlug:
							selection.woodSlug ||
							undefined,
						sizeTitle:
							selection.sizeTitle ||
							undefined,
						sizeSlug:
							selection.sizeSlug ||
							undefined,
						dimensionsLabel:
							selection.dimensions ||
							undefined,
						engravingText:
							engravingText || undefined,
						unitPrice,
						quantity: requestedQuantity,
						stock: stockLimit,
					});
				} catch {
					return;
				}

				setQuantity(1);

				if (result?.capped) {
					announceStockLimit(result.quantity);
				} else {
					showAddedConfirmation();
				}
			},
		);

		const mainImage =
			document.querySelector<HTMLImageElement>(
				"#product-main-image",
			);

		const thumbnailButtons = Array.from(
			document.querySelectorAll<HTMLButtonElement>(
				"[data-product-thumbnail]",
			),
		);

		thumbnailButtons.forEach((button) => {
			button.addEventListener("click", () => {
				if (!mainImage) return;

				mainImage.src =
					button.dataset.largeImage || "";

				mainImage.alt =
					button.dataset.imageAlt || "";

				thumbnailButtons.forEach(
					(currentButton) => {
						currentButton.classList.toggle(
							"is-active",
							currentButton === button,
						);
					},
				);
			});
		});

		updateInterface();
	};

	initializeProductPage();

	document.addEventListener(
		"astro:page-load",
		initializeProductPage,
	);
</script>

