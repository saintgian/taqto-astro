---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import HeroSlider from "../components/HeroSlider.astro";
import CampaignBanner from "../components/CampaignBanner.astro";
import CategoriesTeaser from "../components/CategoriesTeaser.astro";
import OriginStats from "../components/OriginStats.astro";
import ProductCarousel from "../components/ProductCarousel.astro";
import FeaturedProducts from "../components/FeaturedProducts.astro";
import PersonalizationSteps from "../components/PersonalizationSteps.astro";
import LifestyleGallery from "../components/LifestyleGallery.astro";
import WoodGuide from "../components/WoodGuide.astro";
import PurchaseProcess from "../components/PurchaseProcess.astro";
import CustomerProof from "../components/CustomerProof.astro";
import BusinessGateway from "../components/BusinessGateway.astro";
import { sanityClient, urlForImage } from "../lib/sanity";
import { homeCampaignQuery } from "../lib/homeCampaignQuery";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

interface HomeCampaign {
	enabled?: boolean;
	eyebrow?: string;
	title?: string;
	description?: string;
	ctaLabel?: string;
	ctaLink?: string;
	alt?: string;
	theme?: "light" | "dark";
	layoutMode?: "editorial" | "productSpotlight";
	contentPosition?: "left" | "center" | "right";
	overlayStrength?: "soft" | "medium" | "strong";
	desktopImage?: unknown;
	mobileImage?: unknown;
	featuredProduct?: Record<string, unknown> | null;
}

let homeCampaign: HomeCampaign | null = null;

try {
	homeCampaign = await sanityClient.fetch<HomeCampaign | null>(
		homeCampaignQuery,
	);
} catch (error) {
	// Sin conexión a Sanity (por ejemplo, build sin variables de entorno):
	// la portada conserva el contenido de respaldo de CampaignBanner.
	homeCampaign = null;
}

const campaignHasContent = Boolean(
	homeCampaign?.title || homeCampaign?.description,
);

const campaignIsUsable =
	Boolean(homeCampaign?.enabled) && campaignHasContent;

// Si el documento existe y fue desactivado explícitamente, no se muestra
// la sección (sin espacio vacío). Si no existe documento, se conserva el
// contenido de respaldo de CampaignBanner.
const isCampaignExplicitlyDisabled =
	homeCampaign !== null && homeCampaign?.enabled === false;

const showCampaignSection = !isCampaignExplicitlyDisabled;

const resolveCampaignLink = (link?: string) => {
	if (!link) return undefined;
	if (/^https?:\/\//i.test(link)) return link;

	const cleanLink = link.replace(/^\/+/, "");
	return `${base}${cleanLink}${cleanLink.endsWith("/") ? "" : "/"}`;
};

const campaignDesktopImageUrl =
	campaignIsUsable && homeCampaign?.desktopImage
		? urlForImage(homeCampaign.desktopImage)
				.width(1400)
				.height(700)
				.fit("crop")
				.auto("format")
				.url()
		: undefined;

const campaignMobileImageUrl =
	campaignIsUsable && homeCampaign?.mobileImage
		? urlForImage(homeCampaign.mobileImage)
				.width(900)
				.height(700)
				.fit("crop")
				.auto("format")
				.url()
		: undefined;

// El campo "Texto del botón" en Sanity contiene actualmente "WHSTASPP"
// (contenido mal definido por el equipo de contenido). Mientras se corrige
// en el Studio, se usa un texto temporal en su lugar.
const rawCtaLabel = homeCampaign?.ctaLabel?.trim();
const ctaLabel =
	rawCtaLabel && rawCtaLabel.toUpperCase() !== "WHSTASPP"
		? rawCtaLabel
		: "Ver campaña";

const campaignProps = campaignIsUsable
	? {
			eyebrow: homeCampaign?.eyebrow,
			title: homeCampaign?.title,
			description: homeCampaign?.description,
			buttonText: ctaLabel,
			buttonHref: resolveCampaignLink(homeCampaign?.ctaLink),
			imageUrl: campaignDesktopImageUrl,
			mobileImageUrl: campaignMobileImageUrl,
			imageAlt: homeCampaign?.alt,
			theme: homeCampaign?.theme || undefined,
			layoutMode: homeCampaign?.layoutMode || undefined,
			contentPosition: homeCampaign?.contentPosition || undefined,
			overlayStrength: homeCampaign?.overlayStrength || undefined,
			featuredProduct: homeCampaign?.featuredProduct || undefined,
		}
	: {};

function getHomeImagePath(...segments: string[]): string | undefined {
	const absolutePath = resolve(
		process.cwd(),
		"public",
		"images",
		"home",
		...segments,
	);

	return existsSync(absolutePath)
		? `${base}images/home/${segments.join("/")}`
		: undefined;
}

const lifestyleItems = [
	{
		label: "Parrilla",
		title: "Encuentros alrededor del fuego",
		description:
			"Piezas resistentes para preparar, servir y compartir.",
		href: `${base}categorias/parrilla/`,
	},
	{
		label: "Oficina",
		title: "Orden y precisión en tu escritorio",
		description:
			"Accesorios de madera que organizan y acompañan tu jornada.",
		href: `${base}categorias/oficina/`,
	},
	{
		label: "Cocina y mesa",
		title: "Piezas para servir y compartir",
		description:
			"Funcionales y contemporáneas, listas para la mesa.",
		href: `${base}categorias/cocina-y-mesa/`,
	},
];

// Todas las especies confirmadas y activas en Sanity (studio/schemaTypes/woodType.ts).
const woodGuideItems = [
	{ id: "huayruro", name: "Huayruro" },
	{ id: "pumaquiro", name: "Pumaquiro" },
	{ id: "shihuahuaco", name: "Shihuahuaco" },
	{ id: "cachimbo", name: "Cachimbo" },
	{ id: "teca", name: "Teca" },
];

const purchaseLinks = [
	{ label: "Envíos", href: `${base}envios/` },
	{ label: "Cuidados", href: `${base}cuidados/` },
	{ label: "Garantía", href: `${base}garantia/` },
	{
		label: "Preguntas frecuentes",
		href: `${base}preguntas-frecuentes/`,
	},
];

const businessImageSrc = getHomeImagePath(
	"empresas-regalos-corporativos.webp",
);

const businessImage = businessImageSrc
	? {
			src: businessImageSrc,
			alt: "Piezas de madera TAQTO personalizadas para regalos corporativos",
			width: 1200,
			height: 1500,
		}
	: undefined;

const siteUrl = Astro.site
	? new URL(base, Astro.site).toString()
	: undefined;

// Datos reales publicados en /contactanos/: WhatsApp, correo, redes y la
// ubicacion general del taller (sin direccion exacta ni horario de
// atencion presencial, porque TAQTO no los publica).
const organizationJsonLd = siteUrl
	? {
			"@context": "https://schema.org",
			"@type": "Organization",
			name: "TAQTO",
			url: siteUrl,
			logo: new URL(
				`${base}brand/imagotipo/imagotipo-colorprincipal01.svg`,
				Astro.site,
			).toString(),
			email: "ventas@taqto.com.pe",
			telephone: "+51977600400",
			sameAs: [
				"https://www.instagram.com/taqto.pe/",
				"https://www.facebook.com/taqto.pe",
				"https://www.tiktok.com/@taqto.pe",
			],
			address: {
				"@type": "PostalAddress",
				addressLocality: "San Juan de Miraflores",
				addressRegion: "Lima",
				addressCountry: "PE",
			},
		}
	: null;

const websiteJsonLd = siteUrl
	? {
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: "TAQTO",
			description:
				"Tienda de productos de madera para cocina, parrilla, mesa y hogar, con personalización mediante grabado láser.",
			url: siteUrl,
		}
	: null;

const homeJsonLd = [organizationJsonLd, websiteJsonLd].filter(
	(schema): schema is Record<string, unknown> => Boolean(schema),
);

const customerProofProjects = (
	["proyecto-01.webp", "proyecto-02.webp", "proyecto-03.webp"] as const
)
	.map((file) => {
		const src = getHomeImagePath("clientes", file);

		if (!src) return null;

		return {
			type: "project" as const,
			image: {
				src,
				alt: "Pieza TAQTO elaborada para un cliente",
				width: 1000,
				height: 1250,
			},
		};
	})
	.filter((item): item is NonNullable<typeof item> => item !== null);
---

<BaseLayout
	title="TAQTO | Productos de madera para cocina, parrilla y hogar"
	description="Tablas y productos de madera para cocina, parrilla, mesa y hogar. Diseños funcionales, opciones personalizadas y regalos para personas y empresas."
	jsonLd={homeJsonLd}
>
	<Header />

	<main>
		<HeroSlider />

		{
			showCampaignSection && (
				<section class="campaign-section">
					<div class="campaign-section__container">
						<CampaignBanner {...campaignProps} />
					</div>
				</section>
			)
		}

		<CategoriesTeaser />

		<FeaturedProducts />

		<PersonalizationSteps
			imageAlt="Detalle cercano de una pieza TAQTO personalizada mediante grabado láser"
			ctaHref={`${base}categorias/`}
		/>

		<LifestyleGallery items={lifestyleItems} />

		<WoodGuide woods={woodGuideItems} />

		<OriginStats />

		<PurchaseProcess links={purchaseLinks} />

		<CustomerProof
			mode="projects"
			items={customerProofProjects}
		/>

		<BusinessGateway
			image={businessImage}
			mainHref={`${base}categorias/empresas/`}
			corporateGiftsHref={`${base}categorias/empresas/regalos-corporativos/`}
			wholesaleHref={`${base}categorias/empresas/ventas-al-por-mayor/`}
			theme="dark"
		/>

		<ProductCarousel />
	</main>
</BaseLayout>

<style>
	/*
	 * Tokens locales de la portada. Escalan la tipografia y el ritmo
	 * vertical de las secciones comerciales (categorias, productos,
	 * pasos, maderas, galeria, prueba social, origen) sin tocar los
	 * tokens globales de BaseLayout.astro, que siguen intactos para
	 * Header, Footer, tienda y ficha de producto.
	 */
	main {
		--home-eyebrow: clamp(0.7rem, 0.66rem + 0.2vw, 0.78rem);
		--home-title: clamp(1.75rem, 1.43rem + 1.48vw, 2.35rem);
		--home-intro: clamp(1rem, 0.94rem + 0.18vw, 1.06rem);
		--home-card-title: clamp(1.03rem, 0.96rem + 0.33vw, 1.22rem);
		--home-card-body: clamp(0.94rem, 0.9rem + 0.18vw, 1rem);
		--home-section-py: clamp(40px, 4.5vw, 64px);
		--home-header-gap: clamp(14px, 1.6vw, 22px);
		--home-gap: clamp(16px, 1.8vw, 24px);
	}

	@media (max-width: 640px) {
		main {
			--home-title: clamp(1.4rem, 1.17rem + 2.7vw, 1.67rem);
			--home-intro: clamp(0.94rem, 0.9rem + 0.6vw, 1rem);
			--home-card-title: clamp(0.99rem, 0.92rem + 0.85vw, 1.15rem);
			--home-card-body: clamp(0.92rem, 0.88rem + 0.5vw, 1rem);
			--home-eyebrow: clamp(0.68rem, 0.64rem + 0.4vw, 0.74rem);
			--home-section-py: clamp(48px, 10vw, 64px);
			--home-header-gap: 14px;
			--home-gap: 16px;
		}
	}

	.campaign-section {
		padding-block: var(--section-py);
		padding-inline: var(--container-gutter);
		background: var(--surface);
	}

	.campaign-section__container {
		width: min(100%, var(--container-comercial));
		margin-inline: auto;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	@media (max-width: 760px) {
		.campaign-section__container {
			border-radius: var(--radius-md);
		}
	}
	main {
	margin-top: -136px; 
}
</style>