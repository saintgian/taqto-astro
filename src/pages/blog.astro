		agenda: "Principalmente oficina",
		taza: "Hogar y oficina",
		madera: "Depende de la pieza",
	},
	{
		criterio: "Percepción de objeto seleccionado",
		agenda: "Variable",
		taza: "Variable",
		madera: "Alta cuando está bien diseñado",
	},
	{
		criterio: "Posibilidad de co-branding",
		agenda: "Sí",
