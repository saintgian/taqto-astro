	"Presupuesto referencial, cuando se encuentre definido.",
	"Necesidades de empaque o presentación.",
];

const tabla = [
	{
		criterio: "Distribución masiva",
		agenda: "Alta",
		taza: "Alta",
		madera: "Depende del producto",
	},
	{
		criterio: "Personalización individual",
		agenda: "Posible",
		taza: "Posible",
