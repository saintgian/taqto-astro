---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import ProductCard from "../../../components/ProductCard.astro";
import CategoryHeroBanner from "../../../components/CategoryHeroBanner.astro";
import { ArrowLeft } from "@lucide/astro";

import {
	sanityClient,
} from "../../../lib/sanity";

import {
	productsForSubcategoryQuery,
	subcategoryPathsQuery,
} from "../../../lib/subcategoryQueries";
import { buildBreadcrumbJsonLd } from "../../../lib/seo";

interface Category {
	_id?: string;
	title?: string;
	slug?: string;
	eyebrow?: string;
	description?: string;
}

interface Subcategory {
	_id?: string;
	title?: string;
	slug?: string;
	description?: string;
	order?: number;
	category?: Category;
}

interface Product {
	_id: string;
	title: string;
	slug: string;
	[key: string]: unknown;
}

export async function getStaticPaths() {
	const subcategories =
		await sanityClient.fetch<Subcategory[]>(
			subcategoryPathsQuery,
		);

	const paths = await Promise.all(
		subcategories
			.filter(
				(subcategory) =>
					subcategory.slug &&
					subcategory.category?.slug,
			)
			.map(async (subcategory) => {
				const categorySlug =
					subcategory.category!.slug!;

				const subcategorySlug =
					subcategory.slug!;

				const products =
					await sanityClient.fetch<Product[]>(
						productsForSubcategoryQuery,
						{
							categorySlug,
							subcategorySlug,
						},
					);

				return {
					params: {
						categoria: categorySlug,
						subcategoria: subcategorySlug,
					},

					props: {
						category:
							subcategory.category,
						subcategory,
						products,
					},
				};
			}),
	);

	return paths;
}

const {
	category,
	subcategory,
	products,
} = Astro.props as {
	category: Category;
	subcategory: Subcategory;
	products: Product[];
};

const base =
	import.meta.env.BASE_URL;

const categoryHref =
	`${base}categorias/${category.slug}/`;

const homeHref = base;

const pageTitle =
	`${subcategory.title} | ${category.title} | TAQTO`;

const pageDescription =
	subcategory.description ||
	`Descubre ${subcategory.title} de TAQTO, piezas de madera creadas con precisión y personalización láser gratuita.`;

const subcategoryUrl = Astro.site
	? new URL(
			`${base}categorias/${category.slug}/${subcategory.slug}/`,
			Astro.site,
		).toString()
	: undefined;

const subcategoryBreadcrumbJsonLd = buildBreadcrumbJsonLd(
	[
		{ label: "Inicio", href: homeHref },
		{ label: category.title || "", href: categoryHref },
		{ label: subcategory.title || "" },
	],
	Astro.site,
	subcategoryUrl,
);

const subcategoryJsonLd = subcategoryBreadcrumbJsonLd
	? [subcategoryBreadcrumbJsonLd]
	: [];
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	jsonLd={subcategoryJsonLd}
>
	<Header />

	<main class="subcategory-page">
		<nav
			class="subcategory-breadcrumbs"
			aria-label="Migas de pan"
		>
			<a href={homeHref}>Inicio</a>
			<span aria-hidden="true">/</span>

			<a href={categoryHref}>
				{category.title}
			</a>

			<span aria-hidden="true">/</span>

			<span>{subcategory.title}</span>
		</nav>

		<CategoryHeroBanner
			categorySlug={category.slug || ""}
			eyebrow={category.eyebrow || category.title}
			title={subcategory.title || ""}
			description={
				subcategory.description ||
					`Explora la colección ${subcategory.title} de TAQTO.`
			}
			count={products.length}
			countLabel={
				products.length === 1
					? "pieza disponible"
					: "piezas disponibles"
			}
		/>

		<div class="subcategory-divider"></div>

		{
			products.length > 0 ? (
				<section
					class="product-grid"
					aria-label={`Productos de ${subcategory.title}`}
				>
					{
						products.map((product) => (
							<ProductCard
								product={product}
								hoverGallery
							/>
						))
					}
				</section>
			) : (
				<section class="subcategory-empty">
					<p class="subcategory-empty__eyebrow">
						Colección en preparación
					</p>

					<h2>
						Aún no hay productos publicados.
					</h2>

					<p>
						Estamos preparando nuevas piezas para
						esta categoría.
					</p>

					<a href={categoryHref}>
						<ArrowLeft aria-hidden="true" size={16} stroke-width={1.75} />
						Volver a {category.title}
					</a>
				</section>
			)
		}
	</main>
</BaseLayout>

<style>
	.subcategory-page {
		min-height: 100vh;
		padding:
			clamp(24px, 3vw, 40px)
			clamp(20px, 5vw, 82px)
			clamp(80px, 9vw, 135px);
		background: #ffffff;
		color: #141414;
	}

	.subcategory-breadcrumbs,
	.subcategory-divider,
	.product-grid,
	.subcategory-empty {
		width: min(100%, var(--container-comercial, 1520px));
		margin-inline: auto;
	}

	.subcategory-breadcrumbs {
		margin-bottom: 28px;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 9px;
		color: rgba(20, 20, 20, 0.5);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.subcategory-breadcrumbs a {
		color: inherit;
		text-decoration: none;
	}

	.subcategory-breadcrumbs a:hover {
		color: #141414;
	}

	.subcategory-divider {
		height: 1px;
		margin-top: clamp(36px, 4vw, 48px);
		margin-bottom: clamp(24px, 3vw, 36px);
		background: rgba(20, 20, 20, 0.11);
	}

	.product-grid {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: clamp(20px, 2vw, 26px);
}

	.subcategory-empty {
		padding: clamp(50px, 7vw, 90px) 25px;
		border: 1px solid
			rgba(20, 20, 20, 0.1);
		border-radius: 24px;
		text-align: center;
	}

	.subcategory-empty__eyebrow {
		margin: 0 0 12px;
		color: #ff4d2a;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.subcategory-empty h2 {
		margin: 0;
		font-size: clamp(28.8px, 4.73vw, 51.5px);
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.subcategory-empty > p:not(
			.subcategory-empty__eyebrow
		) {
		margin: 16px 0 0;
		color: rgba(20, 20, 20, 0.6);
	}

	.subcategory-empty a {
		margin-top: 25px;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: #141414;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	@media (max-width: 1100px) {
	.product-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
}

	@media (max-width: 800px) {
		.product-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 700px) {
		.subcategory-page {
			padding:
				20px 14px
				75px;
		}
	}

	@media (max-width: 480px) {
		.product-grid {
			grid-template-columns: 1fr;
			gap: 20px;
		}
	}
</style>