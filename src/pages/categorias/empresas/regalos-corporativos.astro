---
import PageLayout from "../../../layouts/PageLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import InfoCard from "../../../components/InfoCard.astro";
import ProcessSteps from "../../../components/ProcessSteps.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { WHATSAPP_NUMBER } from "../../../lib/constants";
import {
	ScanLine,
	BadgeCheck,
	PenLine,
	Gift,
	Users,
	Handshake,
	Building2,
	TreePine,
} from "@lucide/astro";

const base = import.meta.env.BASE_URL;

const empresasHref = `${base}categorias/empresas/`;
const mayoreoHref = `${base}categorias/empresas/ventas-al-por-mayor/`;
const catalogHref = `${base}categorias/`;

const whatsappMessage = encodeURIComponent(
	"Hola TAQTO, quisiera cotizar regalos corporativos con co-branding para mi empresa.",
);

const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${whatsappMessage}`;

const claves = [
	{
		icon: ScanLine,
		label: "Personalización",
		value: "Grabado láser",
		hint: "Un logo o imagen y una frase o nombre.",
	},
	{
		icon: BadgeCheck,
		label: "Marca",
		value: "Co-branding",
		hint: "No trabajamos con marca blanca.",
	},
	{
		icon: PenLine,
		label: "Ubicación del sello",
		value: "Al reverso",
		hint: "Según el producto, en la base o una esquina.",
	},
];

const usos = [
	{
		icon: Gift,
		title: "Fin de año",
		text: "Regalos de fin de año para colaboradores.",
	},
	{
		icon: Users,
		title: "Bienvenida",
		text: "Detalles de bienvenida para nuevos integrantes.",
	},
	{
		icon: Handshake,
		title: "Clientes y aliados",
		text: "Obsequios para clientes o aliados estratégicos.",
	},
	{
		icon: Building2,
		title: "Oficina",
		text: "Piezas de oficina co-brandeadas para escritorios y salas de reuniones.",
	},
];

const proceso = [
	{
		title: "Cuéntanos tu proyecto",
		text: "Escríbenos por WhatsApp con la pieza que te interesa, la cantidad y el logo o imagen que quieres grabar.",
	},
	{
		title: "Revisamos el co-branding",
		text: "Confirmamos contigo la ubicación del grabado y la viabilidad técnica de tu logo o marca sobre la pieza.",
	},
	{
		title: "Aprobación y producción",
		text: "Una vez aprobado el detalle final, coordinamos producción, grabado y entrega a nivel nacional.",
	},
];

const paraCotizar = [
	"La pieza o colección que te interesa.",
	"La cantidad aproximada de unidades.",
	"El logo, imagen o frase que quieres grabar.",
	"La ciudad o región de entrega.",
];
---

<PageLayout
	title="Regalos corporativos con co-branding | TAQTO"
	description="Regalos corporativos de madera y cuero con grabado láser y co-branding: el sello TAQTO permanece visible junto a la marca de tu empresa."
>
	<PageHero
		eyebrow="Empresas"
		title="Regalos corporativos"
		lede="Diseñamos regalos corporativos de madera y cuero para clientes, colaboradores y aliados de tu empresa, con grabado láser y co-branding: tu marca y el sello TAQTO conviven en la misma pieza."
		split="7-5"
	>
		<Breadcrumbs
			slot="before"
			items={[
				{ label: "Inicio", href: base },
				{ label: "Categorías", href: `${base}categorias/` },
				{ label: "Empresas", href: empresasHref },
				{ label: "Regalos corporativos" },
			]}
		/>

		<div class="actions">
			<a
				href={whatsappHref}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn--primary"
			>
				Cotizar por WhatsApp
			</a>

			<a href={catalogHref} class="sp-btn sp-btn--ghost">
				Ver piezas TAQTO
			</a>
		</div>

		<div slot="aside">
			<p class="facts-caption">Cómo trabajamos la pieza</p>

			<ul class="facts">
				{
					claves.map((item) => {
						const Icon = item.icon;

						return (
							<li>
								<Icon
									class="facts__icon"
									aria-hidden="true"
									size={20}
									stroke-width={1.75}
								/>

								<div>
									<p class="facts__label">{item.label}</p>
									<p class="facts__value">{item.value}</p>
									<p class="facts__hint">{item.hint}</p>
								</div>
							</li>
						);
					})
				}
			</ul>
		</div>
	</PageHero>

	<!-- Usos corporativos: cuatro tarjetas de 3 columnas -->
	<section class="sect sect--tint">
		<div class="wrap">
			<div class="sect__head">
				<h2>Usos corporativos</h2>

				<p class="lede measure-lede">
					Piezas de nuestras colecciones de parrilla, cocina y mesa,
					oficina, y kits y regalos pueden personalizarse como
					regalo corporativo, entre ellas:
				</p>
			</div>

			<ul class="cards" style="--cols:4">
				{
					usos.map((item) => (
						<li>
							<InfoCard
								icon={item.icon}
								title={item.title}
								compactTitle
							>
								<p>{item.text}</p>
							</InfoCard>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Personalización: introducción de 5 columnas + detalle de 7 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5 flow" style="--flow:16px">
					<h2>Personalización</h2>

					<p class="lede measure-tight">
						Trabajamos con co-branding, no con marca blanca.
					</p>
				</div>

				<ul class="cards c7" style="--cols:2">
					<li>
						<InfoCard
							icon={ScanLine}
							title="Grabado incluido"
							variant="plain"
							compactTitle
						>
							<p>
								Cada pieza incluye grabado láser de un logo o
								imagen y una frase o nombre, sujeto a
								viabilidad técnica y a las condiciones
								vigentes al momento del pedido.
							</p>
						</InfoCard>
					</li>

					<li>
						<InfoCard
							icon={TreePine}
							title="Variación natural"
							variant="plain"
							compactTitle
						>
							<p>
								La veta, el tono y la textura de la madera
								varían de forma natural entre piezas; nuestras
								fotos son referenciales y conservamos la
								forma, proporción y acabado real de cada
								producto.
							</p>
						</InfoCard>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- Proceso de solicitud y aprobación -->
	<section class="sect">
		<div class="wrap">
			<div class="sect__head">
				<h2>Proceso de solicitud y aprobación</h2>
			</div>

			<ProcessSteps steps={proceso} cols={3} />
		</div>
	</section>

	<!-- Información para cotizar: encabezado de 5 columnas + lista de 7 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5 flow" style="--flow:16px">
					<h2>Información necesaria para cotizar</h2>

					<p class="lede measure-tight">
						Para preparar tu cotización, cuéntanos:
					</p>
				</div>

				<div class="c7 flow" style="--flow:20px">
					<ul class="list list--cols">
						{paraCotizar.map((item) => <li>{item}</li>)}
					</ul>

					<p class="note measure">
						¿Buscas además reponer stock o comprar en volumen?
						Revisa también nuestras{" "}
						<a href={mayoreoHref}>ventas al por mayor</a>.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA final -->
	<section class="sect sect--last">
		<div class="wrap">
			<div class="page-cta page-cta--split">
				<div class="page-cta__text">
					<p class="eyebrow">Cotiza tu regalo corporativo</p>

					<h2>Diseñemos tu co-branding</h2>

					<p class="measure">
						Escríbenos por WhatsApp y cuéntanos qué pieza,
						cantidad y logo necesitas para tu regalo corporativo.
					</p>
				</div>

				<div class="actions">
					<a
						href={whatsappHref}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn--primary"
					>
						Cotizar por WhatsApp
					</a>

					<a href={catalogHref} class="sp-btn sp-btn--ghost">
						Ver piezas TAQTO
					</a>
				</div>
			</div>
		</div>
	</section>
</PageLayout>
