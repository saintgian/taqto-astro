---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CategoryCard from "../../components/CategoryCard.astro";

import { sanityClient } from "../../lib/sanity";
import { categoryPathsQuery } from "../../lib/categoryQueries";
import { buildBreadcrumbJsonLd } from "../../lib/seo";

interface Category {
	_id: string;
	title: string;
	description?: string;
	slug: string;
}

const base = import.meta.env.BASE_URL;

// Mismas fotos ya usadas en la portada (CategoriesTeaser) y en el
// hero de cada categoria; "kits-y-regalos" aun no tiene foto propia.
const categoryImageFiles: Record<string, string> = {
	parrilla: "parrilla.webp",
	"cocina-y-mesa": "cocina-mesa.webp",
	oficina: "oficina.webp",
};

function getCategoryImageSrc(slug: string): string | undefined {
	const fileName = categoryImageFiles[slug];
	if (!fileName) return undefined;

	const absolutePath = resolve(
		process.cwd(),
		"public",
		"images",
		"home",
		"categorias",
		fileName,
	);

	if (!existsSync(absolutePath)) return undefined;

	return `${base}images/home/categorias/${fileName}`;
}

const productCategories = (
	await sanityClient.fetch<Category[]>(categoryPathsQuery)
).map((category) => ({
	...category,
	imageSrc: getCategoryImageSrc(category.slug),
}));

const categoriesUrl = Astro.site
	? new URL(`${base}categorias/`, Astro.site).toString()
	: undefined;

const categoriesBreadcrumbJsonLd = buildBreadcrumbJsonLd(
	[
		{ label: "Inicio", href: base },
		{ label: "Categorías" },
	],
	Astro.site,
	categoriesUrl,
);

const categoriesJsonLd = categoriesBreadcrumbJsonLd
	? [categoriesBreadcrumbJsonLd]
	: [];
---

<BaseLayout
	title="Categorías | TAQTO"
	description="Explora las colecciones de parrilla, cocina, oficina, regalos y soluciones para empresas de TAQTO."
	jsonLd={categoriesJsonLd}
>
	<Header />

	<main>
		<section class="category-hero">
			<div class="container">
				<Breadcrumbs
					items={[
						{ label: "Inicio", href: base },
						{ label: "Categorías" },
					]}
				/>

				<div class="category-hero__content">
					<p class="category-hero__eyebrow">
						Colecciones TAQTO
					</p>

					<h1>Diseño para cada espacio y momento.</h1>

					<p class="category-hero__description">
						Explora nuestras categorías de piezas de madera y cuero,
						con personalización láser gratuita.
					</p>
				</div>
			</div>
		</section>

		<section class="categories">
			<div class="container categories__grid">
				{
					productCategories.map((category, index) => (
						<CategoryCard
							title={category.title}
							description={category.description}
							href={`${base}categorias/${category.slug}/`}
							index={index + 1}
							imageSrc={category.imageSrc}
						/>
					))
				}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.category-hero {
		padding: clamp(20px, 3vw, 32px) 0 clamp(40px, 5vw, 70px);
	}

	.category-hero__content {
		max-width: 980px;
	}

	.category-hero__eyebrow {
		margin: 0 0 24px;
		color: var(--color-brown);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.category-hero h1 {
		max-width: 940px;
		margin: 0;
		font-size: clamp(29.75px, 5.1vw, 61.2px);
		line-height: 0.98;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.category-hero__description {
		max-width: 620px;
		margin: 18px 0 0;
		font-size: clamp(15px, 1.06vw, 17.28px);
		line-height: 1.55;
		opacity: 0.7;
	}

	.categories {
		padding-bottom: clamp(80px, 10vw, 150px);
	}

	.categories__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.categories__grid > :last-child:nth-child(odd) {
		grid-column: 1 / -1;
	}

	@media (max-width: 760px) {
		.categories__grid {
			grid-template-columns: 1fr;
		}

		.categories__grid > :last-child:nth-child(odd) {
			grid-column: auto;
		}
	}
</style>