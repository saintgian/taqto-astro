	}

	.admin-hbar-row__fill[data-status="payment_verified"],
	.admin-hbar-row__fill[data-status="mockup_sent"],
	.admin-hbar-row__fill[data-status="in_production"] {
		background: #2f7de1;
	}

	.admin-hbar-row__value {
		min-width: 22px;
		text-align: right;
		font-size: 12.5px;
		font-variant-numeric: tabular-nums;
		color: var(--color-black);
	}

	.admin-panel {
		padding: clamp(16px, 2vw, 20px);
		border-radius: var(--radius-md);
	}

	.admin-panel__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 12px;
	}

	.admin-panel__head h3 {
		margin: 0;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: var(--admin-label-tracking);
		color: var(--ink-55);
	}

	.admin-panel__loading,
	.admin-panel__empty {
		margin: 0;
		padding: 8px 0;
		color: var(--ink-55);
		font-size: var(--text-sm);
	}

	.admin-panel__empty--compact {
		padding-top: 4px;
		font-size: 11.5px;
	}

	.admin-mini-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}

	.admin-mini-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 10px 0;
		border-bottom: 1px solid var(--ink-08);
	}

	.admin-mini-row:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.admin-mini-row__main {
		min-width: 0;
	}

	.admin-mini-row__title {
		margin: 0;
		font-weight: 600;
		font-size: var(--text-sm);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.admin-mini-row__meta {
		margin: 2px 0 0;
		font-size: var(--text-xs);
		color: var(--ink-55);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.admin-mini-row__side {
		display: flex;
		align-items: center;
		gap: 10px;
		flex: 0 0 auto;
	}

	.admin-mini-row__total {
		font-size: var(--text-sm);
		font-weight: 600;
		white-space: nowrap;
	}

	/* ---------- Metrics ---------- */

	.admin-metrics-row {
		display: grid;
		gap: var(--admin-gap-md, 12px);
	}

	.admin-metric-cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--admin-gap-md, 12px);
	}

	.admin-metric-card {
		display: block;
		width: 100%;
		min-height: 120px;
		padding: 16px;
		border: 1px solid var(--ink-08);
		border-radius: var(--radius-md);
		background: var(--color-white);
		box-shadow: var(--shadow-sm);
		text-align: left;
		font: inherit;
		color: inherit;
		cursor: default;
		transition:
			transform 160ms var(--ease-out, ease),
			box-shadow 160ms var(--ease-out, ease),
			border-color 160ms var(--ease-out, ease);
	}

	button.admin-metric-card {
		cursor: pointer;
		border: 1px solid var(--ink-08);
	}

	button.admin-metric-card:hover,
	button.admin-metric-card:focus-visible {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		border-color: var(--ink-15);
	}

	button.admin-metric-card:focus-visible {
		outline: none;
		box-shadow: var(--focus-ring), var(--shadow-md);
	}

	button.admin-metric-card:active {
		transform: translateY(-1px);
	}

	.admin-metric-card--warn .admin-metric-card__value {
		color: #8a5a00;
	}

	.admin-metric-card--danger .admin-metric-card__value {
		color: #a8331a;
	}

	.admin-metric-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		margin-bottom: 8px;
		border-radius: 8px;
		background: var(--ink-08);
		color: var(--ink-70);
	}

	.admin-metric-card__icon svg {
		width: 15px;
		height: 15px;
	}

	.admin-metric-card--warn .admin-metric-card__icon {
		background: rgba(255, 179, 0, 0.16);
		color: #8a5a00;
	}

	.admin-metric-card__label {
		margin: 0 0 4px;
		font-size: 10.5px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--admin-label-tracking);
		color: var(--ink-55);
	}

	.admin-metric-card__value {
		margin: 0;
		font-size: clamp(26px, 2.4vw, 30px);
		font-weight: 600;
		line-height: 1.15;
	}

	.admin-metric-card__hint {
		margin: 4px 0 0;
		font-size: 11.5px;
		color: var(--ink-55);
	}

	.admin-stat-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.admin-stat-chip {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px;
		border-radius: var(--radius-full);
		background: var(--surface-warm);
		font-size: var(--text-xs);
		color: var(--ink-70);
	}

	.admin-stat-chip strong {
		font-size: var(--text-sm);
		color: var(--color-black);
	}

	.admin-status-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 8px;
		margin: 14px 0 0;
		padding: 0;
		list-style: none;
	}

	.admin-status-chip {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 8px 12px;
		border-radius: var(--radius-sm);
		background: var(--color-white);
		font-size: var(--text-xs);
		color: var(--ink-70);
	}

	.admin-status-chip strong {
		font-size: var(--text-sm);
		color: var(--color-black);
	}

	.admin-metrics__error {
		margin: 0;
		color: #a8331a;
		font-size: var(--text-sm);
	}

	/* ---------- Filters ---------- */

	.admin-filters {
		padding: 14px clamp(14px, 2.4vw, 22px);
		border-radius: var(--radius-md);
	}

	.admin-filters__toggle {
		display: none;
		width: 100%;
		min-height: 42px;
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-sm);
		background: var(--surface);
		font-weight: 600;
	}

	.admin-filters__panel {
		display: grid;
		gap: 12px;
	}

	.admin-filters__row--search {
		display: grid;
	}

	/*
	 * Segunda fila: Estado | Pago | Entrega | Desde | Hasta | Limpiar.
	 * Las columnas de fecha llevan mas ancho minimo (165px) para que el
	 * icono nativo del <input type="date"> nunca quede recortado ni
	 * superpuesto con el valor.
	 */
	.admin-filters__row--grid {
		display: grid;
		grid-template-columns:
			minmax(140px, 0.8fr) minmax(140px, 0.8fr) minmax(150px, 1fr)
			minmax(165px, 0.9fr) minmax(165px, 0.9fr) auto;
		gap: 12px;
		align-items: end;
	}

	/* Panel de filtros del inventario: no tiene filas separadas
		(busqueda + 2 selects + limpiar caben juntos), asi que conserva un
		grid auto-fit propio en vez del de dos filas de Pedidos. */
	.admin-filters__panel--static {
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		align-items: end;
	}

	.admin-filters__field {
		display: grid;
		gap: 4px;
		min-width: 0;
	}

	.admin-filters__field--search {
		grid-column: 1 / -1;
	}

	.admin-filters__field label {
		font-size: 11.5px;
		font-weight: 600;
		color: var(--ink-55);
	}

	.admin-filters__field input,
	.admin-filters__field select {
		min-height: 41px;
		padding: 8px 12px;
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-sm);
		font-size: 13px;
		background: var(--surface);
	}

	.admin-filters__field input[type="date"] {
		padding-right: 8px;
	}

	.admin-filters__field input:focus-visible,
	.admin-filters__field select:focus-visible {
		outline: none;
		border-color: var(--color-orange);
		box-shadow: var(--focus-ring);
	}

	.admin-filters__clear {
		align-self: end;
		min-height: 41px;
		white-space: nowrap;
	}

	/* ---------- Table ---------- */

	.admin-table-wrap {
		max-height: 72vh;
		overflow-x: auto;
		overflow-y: auto;
		border-radius: var(--radius-md);
	}

	.admin-table {
		width: 100%;
		min-width: 920px;
		border-collapse: collapse;
		font-size: 12.5px;
		font-variant-numeric: tabular-nums;
	}

	.admin-table thead th {
		position: sticky;
		top: 0;
		z-index: 2;
		padding: 10px 12px;
		border-bottom: 1px solid var(--ink-15);
		background: var(--color-white);
		text-align: left;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-55);
		white-space: nowrap;
	}

	.admin-table td {
		padding: 10px 12px;
		border-bottom: 1px solid var(--ink-08);
		white-space: nowrap;
		vertical-align: middle;
	}

	.admin-table tbody tr.admin-table__row:hover {
		background: var(--ink-04, rgba(20, 20, 20, 0.025));
	}

	.admin-table__num,
	th.admin-table__num {
		text-align: right;
	}

	.admin-table__total {
		font-weight: 600;
	}

	.admin-cell__main {
		display: block;
		font-weight: 600;
		color: var(--color-black);
	}

	.admin-cell__meta {
		display: block;
		margin-top: 2px;
		font-size: 11px;
		color: var(--ink-55);
	}

	.admin-product-summary {
		white-space: normal;
		max-width: 220px;
	}

	.admin-product-summary__main {
		display: block;
		font-weight: 600;
		color: var(--color-black);
	}

	.admin-product-summary__variant,
	.admin-product-summary__extra {
		display: block;
		margin-top: 2px;
		font-size: 11px;
		color: var(--ink-55);
	}

	.admin-product-summary__extra {
		color: var(--color-orange);
		font-weight: 600;
	}

	.admin-table__toggle-cell {
		width: 32px;
		padding-inline: 6px;
	}

	.admin-table__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border: 1px solid transparent;
		border-radius: 8px;
		background: transparent;
		color: var(--ink-55);
		cursor: pointer;
		transition:
			background 140ms ease,
			transform 200ms ease;
	}

	.admin-table__toggle:hover {
		background: var(--ink-08);
		color: var(--ink-70);
	}

	.admin-table__toggle:focus-visible {
		outline: none;
		box-shadow: var(--focus-ring);
	}

	.admin-table__toggle[aria-expanded="true"] .admin-table__toggle-icon {
		transform: rotate(180deg);
	}

	.admin-table__toggle-icon {
		transition: transform 200ms ease;
	}

	.admin-table__detail-row td {
		padding: 0;
		background: var(--surface-warm);
	}

	.admin-expanded {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 14px;
		padding: 12px 16px;
		white-space: normal;
	}

	.admin-expanded__title {
		margin: 0 0 4px;
		font-size: 10.5px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--ink-55);
	}

	.admin-expanded__col p {
		margin: 0 0 2px;
		font-size: 12px;
		color: var(--ink-70);
	}

	.admin-expanded__items {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 12px;
		color: var(--ink-70);
	}

	.admin-expanded__extra,
	.admin-expanded__empty {
		color: var(--ink-55);
	}

	.admin-view-button {
		min-height: 34px;
		padding-inline: 12px;
		font-size: 12px;
	}

	.admin-price-strike {
		color: var(--ink-35);
		text-decoration: line-through;
		margin-right: 4px;
	}

	/*
	 * Antes chips con fondo de color solido. La referencia Stitch marca el
	 * estado con un punto de color + texto en mayusculas espaciadas, sin
	 * pildora de fondo: se conserva el color por estado (redundante con el
	 * punto, no es el unico portador de significado) pero la superficie
	 * vuelve a ser plana.
	 */
	.admin-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 2px 0;
		border-radius: 0;
		background: transparent;
		color: var(--ink-70);
		font-size: 10.5px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--admin-label-tracking);
		white-space: nowrap;
	}

	.admin-badge::before {
		content: "";
		flex: 0 0 auto;
		width: 6px;
		height: 6px;
		border-radius: var(--radius-full);
		background: var(--ink-35);
	}

	.admin-badge--outline {
		padding: 3px 10px;
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-full);
	}

	.admin-badge[data-status="delivered"],
	.admin-badge[data-status="shipped"],
	.admin-badge[data-status="ready_to_ship"],
	.admin-badge[data-status="mockup_approved"],
	.admin-badge[data-payment-status="verified"],
	.admin-badge[data-stock-status="available"] {
		color: #1c7a2f;
	}

	.admin-badge[data-status="delivered"]::before,
	.admin-badge[data-status="shipped"]::before,
	.admin-badge[data-status="ready_to_ship"]::before,
	.admin-badge[data-status="mockup_approved"]::before,
	.admin-badge[data-payment-status="verified"]::before,
	.admin-badge[data-stock-status="available"]::before {
		background: #1c7a2f;
	}

	.admin-badge[data-status="cancelled"],
	.admin-badge[data-payment-status="rejected"],
	.admin-badge[data-stock-status="out"] {
		color: #a8331a;
	}

	.admin-badge[data-status="cancelled"]::before,
	.admin-badge[data-payment-status="rejected"]::before,
	.admin-badge[data-stock-status="out"]::before {
		background: #a8331a;
	}

	.admin-badge[data-status="payment_pending"],
	.admin-badge[data-status="mockup_pending"],
	.admin-badge[data-payment-status="pending"],
	.admin-badge[data-payment-status="reported"],
	.admin-badge[data-stock-status="low"] {
		color: #8a5a00;
	}

	.admin-badge[data-status="payment_pending"]::before,
	.admin-badge[data-status="mockup_pending"]::before,
	.admin-badge[data-payment-status="pending"]::before,
	.admin-badge[data-payment-status="reported"]::before,
	.admin-badge[data-stock-status="low"]::before {
		background: #8a5a00;
	}

	.admin-engraving-flag {
		color: var(--color-orange);
	}

	.admin-table__empty,
	.admin-table__error {
		margin: 0;
		padding: 28px 16px;
		text-align: center;
		color: var(--ink-55);
	}

	.admin-table__error {
		color: #a8331a;
	}

	/* ---------- Pagination ---------- */

	.admin-pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		font-size: var(--text-sm);
		color: var(--ink-70);
	}

	/* ---------- Drawer ---------- */

	/*
	 * Detalle del pedido: modal centrado y opaco (no drawer lateral).
	 * Sin blur ni backdrop-filter: la superficie es 100% solida.
	 */

	.admin-drawer-backdrop {
		position: fixed;
		inset: 0;
		z-index: 500;
		background: rgba(20, 20, 20, 0.55);
	}

	.admin-drawer {
		position: fixed;
		inset: 0;
		margin: auto;
		z-index: 501;
		width: min(92vw, 1000px);
		height: fit-content;
		max-height: 88vh;
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-md);
		border: 1px solid var(--ink-15);
		background: var(--color-white);
		box-shadow: var(--shadow-dark-lg);
		transform: scale(0.98);
		opacity: 0;
		animation: admin-drawer-in var(--dur-panel, 220ms)
			var(--ease-panel, ease) forwards;
	}

	@keyframes admin-drawer-in {
		from {
			opacity: 0;
			transform: scale(0.98);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	.admin-drawer__head {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding: 18px 20px;
		border-bottom: 1px solid var(--ink-15);
		flex-wrap: wrap;
	}

	.admin-drawer__head-main {
		flex: 1 1 220px;
		min-width: 0;
		display: grid;
		gap: 4px;
	}

	.admin-drawer__head h2 {
		margin: 0;
		font-size: var(--text-lg);
		overflow-wrap: anywhere;
	}

	.admin-drawer__subtitle {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--ink-55);
	}

	.admin-drawer__chips {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		padding-top: 2px;
	}

	.admin-drawer__close {
		flex: 0 0 auto;
		margin-left: auto;
	}

	.admin-drawer__body {
		flex: 1;
		overflow-y: auto;
		padding: 20px;
		display: grid;
		gap: 20px;
	}

	.admin-drawer__summary {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		background: var(--ink-15);
		border: 1px solid var(--ink-15);
		border-radius: var(--radius-sm);
		overflow: hidden;
	}

	.admin-drawer__summary-item {
		display: grid;
		gap: 4px;
		padding: 12px 14px;
		background: var(--surface-warm);
	}

	.admin-drawer__summary-label {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--ink-55);
	}

	.admin-drawer__summary-value {
		font-size: var(--text-md);
		font-weight: 700;
		overflow-wrap: anywhere;
	}

	.admin-drawer__columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
		gap: 24px;
		align-items: start;
	}

	.admin-drawer__col-main,
	.admin-drawer__col-side {
		display: grid;
		gap: 20px;
		min-width: 0;
	}

	.admin-drawer__section h3 {
		margin: 0 0 8px;
		font-size: var(--text-sm);
		color: var(--ink-55);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.admin-drawer__section p {
		margin: 0 0 4px;
	}

	.admin-drawer__items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 12px;
	}

	.admin-drawer__item {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding: 10px 0;
		border-bottom: 1px solid var(--ink-08);
	}

	.admin-drawer__item-name {
		margin: 0;
		font-weight: 600;
	}

	.admin-drawer__item-meta,
	.admin-drawer__item-engraving,
	.admin-drawer__item-notes {
		margin: 2px 0 0;
		font-size: var(--text-xs);
		color: var(--ink-55);
	}

	.admin-drawer__item-nums {
		display: grid;
		text-align: right;
		gap: 4px;
		flex: 0 0 auto;
		font-size: var(--text-sm);
	}

	.admin-drawer__totals p {
		display: flex;
		justify-content: space-between;
		font-size: var(--text-sm);
	}

	.admin-drawer__total-final {
		margin-top: 6px;
		padding-top: 6px;
		border-top: 1px solid var(--ink-15);
		font-weight: 700;
		font-size: var(--text-base);
	}

	.admin-drawer__history {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}

	.admin-drawer__history-item {
		display: grid;
		gap: 2px;
		font-size: var(--text-sm);
	}

	.admin-drawer__history-date {
		font-size: var(--text-xs);
		color: var(--ink-55);
	}

	.admin-drawer__history-note {
		font-size: var(--text-xs);
		color: var(--ink-55);
	}

	.admin-drawer__history-empty,
	.admin-drawer__loading,
	.admin-drawer__error {
		color: var(--ink-55);
		font-size: var(--text-sm);
	}

	/* ---------- Gestión del pedido ---------- */

	.admin-manage {
