	interface StatusCountRow {
		status: string;
		count: number;
	}

	// Forma exacta del jsonb que devuelve admin_dashboard_summary_v4()
	// (ver supabase/admin_dashboard_summary_v4_production.sql). Una sola
	// llamada reemplaza, solo para el Resumen, a admin_orders_metrics +
	// admin_inventory_metrics + admin_dashboard_analytics. Contrato plano
	// (sin objeto "inventory" anidado) para que un campo faltante o mal
	// tipado sea facil de detectar. inventory_error viene poblado solo
	// cuando el catalogo no se pudo leer; en ese caso los inventory_* de
	// arriba vienen en 0, pero el resto del resumen (pedidos/dinero) sigue
	// siendo valido.
	interface DashboardSummaryV4 {
		active_orders_value: number;
		active_orders_count: number;
		confirmed_sales_value: number;
		confirmed_sales_count: number;
		orders_today: number;
		orders_total: number;
