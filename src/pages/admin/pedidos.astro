---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	LogOut,
	RefreshCw,
	X,
	AlertTriangle,
	Loader2,
	Menu,
	LayoutGrid,
	ClipboardList,
	Package,
	Wallet,
	CalendarDays,
	PackageX,
	ChevronDown,
} from "@lucide/astro";
---

<BaseLayout
	title="Panel administrativo | TAQTO"
	description="Panel administrativo interno de TAQTO."
	robots="noindex, nofollow"
>
	<main class="admin-orders" data-admin-orders>
		<!-- No hay datos administrativos en este HTML: todo el contenido del
			panel se rellena en el navegador via RPC autenticados, despues
			de confirmar que la sesion es de un administrador. -->

		<section class="admin-config-error" data-admin-config-error hidden>
			<p>
				El panel no esta disponible: falta configuracion de Supabase
				en este entorno.
			</p>
		</section>

		<section class="admin-login" data-admin-login hidden>
			<div class="admin-login__card admin-glass">
				<p class="admin-login__eyebrow">TAQTO</p>
				<h1 class="admin-login__title">Panel administrativo</h1>
				<p class="admin-login__subtitle">
					Acceso exclusivo para administradores.
				</p>

				<form
					class="admin-login__form"
					data-admin-login-form
					novalidate
				>
					<label class="admin-login__label" for="admin-email"
						>Correo</label
					>
					<input
						class="admin-login__input"
						type="email"
						id="admin-email"
						name="email"
						autocomplete="username"
						required
					/>

					<label class="admin-login__label" for="admin-password"
						>Contraseña</label
					>
					<input
						class="admin-login__input"
						type="password"
						id="admin-password"
						name="password"
						autocomplete="current-password"
						required
					/>

					<p
						class="admin-login__error"
						data-admin-login-error
						role="alert"
						hidden
					>
					</p>

					<button
						class="btn btn--primary btn--full admin-login__submit"
						type="submit"
						data-admin-login-submit
					>
						<Loader2
							class="admin-login__spinner"
							aria-hidden="true"
							data-admin-login-spinner
							hidden
						/>
						<span data-admin-login-submit-label
							>Iniciar sesión</span
						>
					</button>
				</form>
			</div>
		</section>

		<section class="admin-forbidden" data-admin-forbidden hidden>
			<div class="admin-forbidden__card admin-glass">
				<AlertTriangle aria-hidden="true" />
				<p>No tienes autorización para acceder.</p>
				<button
					class="btn btn--secondary"
					type="button"
					data-admin-forbidden-back
				>
					Volver a iniciar sesión
				</button>
			</div>
		</section>

		<div class="admin-shell" data-admin-dashboard hidden>
			<div
				class="admin-sidebar-backdrop"
				data-admin-sidebar-backdrop
				hidden
			>
			</div>

			<nav
				class="admin-sidebar admin-glass"
				id="admin-sidebar"
				data-admin-sidebar
				aria-label="Navegación administrativa"
			>
				<div class="admin-sidebar__brand">
					<p class="admin-sidebar__brand-mark">TAQTO</p>
					<p class="admin-sidebar__brand-sub">
						Panel administrativo
					</p>
				</div>

				<ul class="admin-sidebar__nav">
					<li>
						<a
							class="admin-sidebar__link"
							href="#resumen"
							data-admin-nav="resumen"
						>
							<LayoutGrid aria-hidden="true" />
							<span>Resumen</span>
						</a>
					</li>
					<li>
						<a
							class="admin-sidebar__link"
							href="#pedidos"
							data-admin-nav="pedidos"
						>
							<ClipboardList aria-hidden="true" />
							<span>Pedidos</span>
						</a>
					</li>
					<li>
						<a
							class="admin-sidebar__link"
							href="#inventario"
							data-admin-nav="inventario"
						>
							<Package aria-hidden="true" />
							<span>Inventario</span>
						</a>
					</li>
				</ul>

				<div class="admin-sidebar__footer">
					<div class="admin-sidebar__profile">
						<div
							class="admin-sidebar__profile-avatar"
							data-admin-sidebar-avatar
							aria-hidden="true"
						>
						</div>
						<p
							class="admin-sidebar__profile-name"
							data-admin-sidebar-name
						>
							Administrador
						</p>
					</div>

					<button
						class="admin-sidebar__logout"
						type="button"
						data-admin-logout
					>
						<LogOut aria-hidden="true" />
						<span>Cerrar sesión</span>
					</button>
				</div>
			</nav>

			<div class="admin-main">
				<header class="admin-topbar admin-glass" data-admin-topbar>
					<button
						class="admin-menu-toggle"
						type="button"
						data-admin-menu-toggle
						aria-label="Abrir menú"
						aria-expanded="false"
						aria-controls="admin-sidebar"
					>
						<Menu aria-hidden="true" />
					</button>

					<div class="admin-topbar__welcome">
						<h1 class="admin-topbar__title" data-admin-topbar-title
							>Resumen</h1
						>
						<p
							class="admin-topbar__subtitle"
							data-admin-topbar-subtitle
						>
							Bienvenido, <strong data-admin-user-name
								>Administrador</strong
							>. Aquí tienes el resumen de TAQTO.
						</p>
					</div>

					<div class="admin-topbar__meta">
						<p class="admin-topbar__updated" data-admin-updated>
						</p>
						<button
							class="btn btn--secondary admin-topbar__refresh"
							type="button"
							data-admin-refresh
						>
							<RefreshCw
								aria-hidden="true"
								data-admin-refresh-icon
							/>
							<span>Actualizar</span>
						</button>
						<div
							class="admin-avatar"
							data-admin-avatar
							aria-hidden="true"
						>
						</div>
					</div>
				</header>

				<section
					class="admin-view"
					data-admin-panel="resumen"
					aria-labelledby="admin-view-resumen-title"
				>
					<h2 class="sr-only" id="admin-view-resumen-title"
						>Resumen</h2
					>

					<div class="admin-metrics-row" data-admin-resumen-metrics>
					</div>

					<p
						class="admin-panel__error"
						data-admin-resumen-error
						role="alert"
						hidden
					>
					</p>

					<div class="admin-charts-grid" data-admin-resumen-charts>
					</div>

					<div class="admin-resumen-grid">
						<section
							class="admin-panel admin-glass"
							aria-labelledby="admin-recent-orders-title"
						>
							<div class="admin-panel__head">
								<h3 id="admin-recent-orders-title"
									>Pedidos recientes</h3
								>
								<button
									class="btn btn--tertiary"
									type="button"
									data-admin-goto="pedidos"
								>
									Ver todos los pedidos
								</button>
							</div>
							<div data-admin-recent-orders>
								<p class="admin-panel__loading"
									>Cargando…</p
								>
							</div>
						</section>

						<section
							class="admin-panel admin-glass"
							aria-labelledby="admin-low-stock-title"
						>
							<div class="admin-panel__head">
								<h3 id="admin-low-stock-title"
									>Stock que requiere atención</h3
								>
								<button
									class="btn btn--tertiary"
									type="button"
									data-admin-goto="inventario"
								>
									Ver inventario
								</button>
							</div>
							<div data-admin-low-stock>
								<p class="admin-panel__loading"
									>Cargando…</p
								>
							</div>
						</section>
					</div>
				</section>

				<section
					class="admin-view"
					data-admin-panel="pedidos"
					hidden
					aria-labelledby="admin-view-pedidos-title"
				>
					<h2 class="sr-only" id="admin-view-pedidos-title"
						>Pedidos</h2
					>

					<section
						class="admin-metrics admin-glass"
						aria-label="Métricas de pedidos"
						data-admin-metrics
					>
					</section>

					<section class="admin-filters admin-glass" data-admin-filters>
						<button
							class="admin-filters__toggle"
							type="button"
							data-admin-filters-toggle
							aria-expanded="false"
							aria-controls="admin-filters-panel"
						>
							Filtros
						</button>

						<div
							class="admin-filters__panel"
							id="admin-filters-panel"
							data-admin-filters-panel
						>
							<div class="admin-filters__row admin-filters__row--search">
								<div class="admin-filters__field admin-filters__field--search">
									<label for="admin-filter-search">Buscar</label>
									<input
										type="search"
										id="admin-filter-search"
										data-admin-filter="search"
										placeholder="Número, nombre, email o teléfono"
										autocomplete="off"
									/>
								</div>
							</div>

							<div class="admin-filters__row admin-filters__row--grid">
								<div class="admin-filters__field">
									<label for="admin-filter-status">Estado</label>
									<select id="admin-filter-status" data-admin-filter="status">
										<option value="">Todos</option>
										<option value="received">Recibido</option>
										<option value="payment_pending">Pago pendiente</option>
										<option value="payment_verified">Pago verificado</option>
										<option value="mockup_pending">Boceto pendiente</option>
										<option value="mockup_sent">Boceto enviado</option>
										<option value="mockup_approved">Boceto aprobado</option>
										<option value="in_production">En producción</option>
										<option value="ready_to_ship">Listo para enviar</option>
										<option value="shipped">Enviado</option>
										<option value="delivered">Entregado</option>
										<option value="cancelled">Cancelado</option>
									</select>
								</div>

								<div class="admin-filters__field">
									<label for="admin-filter-payment">Pago</label>
									<select id="admin-filter-payment" data-admin-filter="payment">
										<option value="">Todos</option>
										<option value="yape">Yape</option>
										<option value="plin">Plin</option>
										<option value="bank_transfer">Transferencia bancaria</option>
										<option value="card">Tarjeta</option>
										<option value="cash_on_delivery">Contra entrega</option>
									</select>
								</div>

								<div class="admin-filters__field">
									<label for="admin-filter-delivery">Entrega</label>
									<select id="admin-filter-delivery" data-admin-filter="delivery">
										<option value="">Todas</option>
										<option value="lima_delivery">Delivery Lima</option>
										<option value="province_agency">Agencia (provincia)</option>
										<option value="store_pickup">Recojo en tienda</option>
									</select>
								</div>

								<div class="admin-filters__field">
									<label for="admin-filter-from">Desde</label>
									<input type="date" id="admin-filter-from" data-admin-filter="from" />
								</div>

								<div class="admin-filters__field">
									<label for="admin-filter-to">Hasta</label>
									<input type="date" id="admin-filter-to" data-admin-filter="to" />
								</div>

								<button
									class="btn btn--tertiary admin-filters__clear"
									type="button"
									data-admin-filters-clear
								>
									Limpiar filtros
								</button>
							</div>
						</div>
					</section>

					<section class="admin-table-wrap admin-glass" data-admin-table-wrap>
						<table class="admin-table" data-admin-table>
							<thead>
								<tr>
									<th scope="col"><span class="sr-only">Expandir</span></th>
									<th scope="col">Pedido</th>
									<th scope="col">Cliente</th>
									<th scope="col">Producto</th>
									<th scope="col">Distrito / Entrega</th>
									<th scope="col">Pago</th>
									<th scope="col">Estado</th>
									<th scope="col" class="admin-table__num">Unidades</th>
									<th scope="col" class="admin-table__num">Total</th>
									<th scope="col"><span class="sr-only">Acción</span></th>
								</tr>
							</thead>
							<tbody data-admin-table-body></tbody>
						</table>

						<p class="admin-table__empty" data-admin-empty hidden>
							No se encontraron pedidos con estos filtros.
						</p>

						<p class="admin-table__error" data-admin-error role="alert" hidden>
						</p>
					</section>

					<nav
						class="admin-pagination"
						data-admin-pagination
						aria-label="Paginación de pedidos"
					>
						<button
							class="btn btn--secondary"
							type="button"
							data-admin-prev
							disabled
						>
							Anterior
						</button>
						<span data-admin-page-info aria-live="polite"></span>
						<button
							class="btn btn--secondary"
							type="button"
							data-admin-next
							disabled
						>
							Siguiente
						</button>
					</nav>
				</section>

				<section
					class="admin-view"
					data-admin-panel="inventario"
					hidden
					aria-labelledby="admin-view-inventario-title"
				>
					<h2 class="sr-only" id="admin-view-inventario-title"
						>Inventario</h2
					>

					<section class="admin-filters admin-glass" data-admin-inv-filters>
						<div class="admin-filters__panel admin-filters__panel--static">
							<div class="admin-filters__field admin-filters__field--search">
								<label for="admin-inv-search">Buscar</label>
								<input
									type="search"
									id="admin-inv-search"
									data-admin-inv-filter="search"
									placeholder="Producto, SKU, madera o tamaño"
									autocomplete="off"
								/>
							</div>

							<div class="admin-filters__field">
								<label for="admin-inv-stock">Estado de stock</label>
								<select id="admin-inv-stock" data-admin-inv-filter="stock">
									<option value="">Todos</option>
									<option value="available">Disponible</option>
									<option value="low">Stock bajo</option>
									<option value="out">Sin stock</option>
								</select>
							</div>

							<div class="admin-filters__field">
								<label for="admin-inv-active">Producto</label>
								<select id="admin-inv-active" data-admin-inv-filter="active">
									<option value="">Todos</option>
									<option value="true">Activo</option>
									<option value="false">Inactivo</option>
								</select>
							</div>

							<button
								class="btn btn--tertiary admin-filters__clear"
								type="button"
								data-admin-inv-clear
							>
								Limpiar filtros
							</button>
						</div>
					</section>

					<section class="admin-table-wrap admin-glass" data-admin-inv-table-wrap>
						<table class="admin-table admin-table--inventory" data-admin-inv-table>
							<thead>
								<tr>
									<th scope="col">Producto</th>
									<th scope="col">Variante</th>
									<th scope="col">SKU</th>
									<th scope="col">Estado</th>
									<th scope="col">Stock</th>
									<th scope="col">Precio</th>
									<th scope="col">Estado de stock</th>
								</tr>
							</thead>
							<tbody data-admin-inv-table-body></tbody>
						</table>

						<p class="admin-table__empty" data-admin-inv-empty hidden>
							No se encontraron variantes con estos filtros.
						</p>

						<p class="admin-table__error" data-admin-inv-error role="alert" hidden>
						</p>
					</section>

					<nav
						class="admin-pagination"
						data-admin-inv-pagination
						aria-label="Paginación de inventario"
					>
						<button
							class="btn btn--secondary"
							type="button"
							data-admin-inv-prev
							disabled
						>
							Anterior
						</button>
						<span data-admin-inv-page-info aria-live="polite"></span>
						<button
							class="btn btn--secondary"
							type="button"
							data-admin-inv-next
							disabled
						>
							Siguiente
						</button>
					</nav>
				</section>
			</div>
		</div>

		<div
			class="admin-drawer-backdrop"
			data-admin-drawer-backdrop
			hidden
		>
		</div>

		<div
			class="admin-drawer"
			id="admin-order-drawer"
			data-admin-drawer
			role="dialog"
			aria-modal="true"
			aria-labelledby="admin-drawer-title"
			aria-describedby="admin-drawer-subtitle"
			hidden
		>
			<div class="admin-drawer__head">
				<div class="admin-drawer__head-main">
					<h2 id="admin-drawer-title" data-admin-drawer-title>
						Detalle del pedido
					</h2>
					<p
						id="admin-drawer-subtitle"
						class="admin-drawer__subtitle"
						data-admin-drawer-subtitle
					>
					</p>
				</div>
				<div class="admin-drawer__chips" data-admin-drawer-chips>
				</div>
				<button
					class="btn btn--icon admin-drawer__close"
					type="button"
					data-admin-drawer-close
					aria-label="Cerrar detalle del pedido"
				>
					<X aria-hidden="true" />
				</button>
			</div>
			<div class="admin-drawer__body" data-admin-drawer-body></div>
		</div>

		<!-- Etiqueta del paquete. Vive fuera del drawer (no dentro) para
			poder imprimirla sin arrastrar el scroll ni los estilos del
			panel, y se vacia al cerrarse para que nunca conserve datos
			del pedido anterior. -->
		<div
			class="admin-label-backdrop"
			data-admin-label-backdrop
			hidden
		>
		</div>

		<div
			class="admin-label-modal"
			data-admin-label-modal
			role="dialog"
			aria-modal="true"
			aria-labelledby="admin-label-modal-title"
			hidden
		>
			<div class="admin-label-modal__head">
				<h2 id="admin-label-modal-title">Etiqueta del pedido</h2>
				<button
					class="btn btn--icon"
					type="button"
					data-admin-label-close
					aria-label="Cerrar etiqueta"
				>
					<X aria-hidden="true" />
				</button>
			</div>

			<div class="admin-label-modal__scroll">
				<div class="admin-label" data-admin-label-sheet></div>
			</div>

			<p
				class="admin-label-modal__feedback"
				data-admin-label-feedback
				role="status"
				hidden
			>
			</p>

			<div class="admin-label-modal__actions">
				<button
					class="btn btn--primary"
					type="button"
					data-admin-label-copy
				>
					Copiar texto
				</button>
				<button
					class="btn btn--secondary"
					type="button"
					data-admin-label-print
				>
					Imprimir etiqueta
				</button>
				<button
					class="btn btn--tertiary"
					type="button"
					data-admin-label-close
				>
					Cerrar
				</button>
			</div>
		</div>
	</main>
</BaseLayout>

<script>
	import { supabase } from "../../lib/supabase";
	import { openOverlay, closeOverlay } from "../../lib/overlay";
	import type { AuthChangeEvent, Session } from "@supabase/supabase-js";

	const ORDER_STATUS_LABELS: Record<string, string> = {
		received: "Recibido",
		payment_pending: "Pago pendiente",
		payment_verified: "Pago verificado",
		mockup_pending: "Boceto pendiente",
		mockup_sent: "Boceto enviado",
		mockup_approved: "Boceto aprobado",
		in_production: "En producción",
		ready_to_ship: "Listo para enviar",
		shipped: "Enviado",
		delivered: "Entregado",
		cancelled: "Cancelado",
	};

	const PAYMENT_METHOD_LABELS: Record<string, string> = {
		yape: "Yape",
		plin: "Plin",
		bank_transfer: "Transferencia bancaria",
		card: "Tarjeta",
		cash_on_delivery: "Contra entrega",
	};

	const DELIVERY_METHOD_LABELS: Record<string, string> = {
		lima_delivery: "Delivery Lima",
		province_agency: "Agencia (provincia)",
		store_pickup: "Recojo en tienda",
	};

	const PAYMENT_STATUS_LABELS: Record<string, string> = {
		pending: "Pendiente",
		reported: "Reportado",
		verified: "Verificado",
		rejected: "Rechazado",
		refunded: "Reembolsado",
	};

	const STOCK_STATUS_LABELS: Record<string, string> = {
		available: "Disponible",
		low: "Stock bajo",
		out: "Sin stock",
	};

	const PAGE_SIZE = 20;
	const INVENTORY_PAGE_SIZE = 20;
	const AUTO_REFRESH_MS = 60_000;
	// Umbral de stock bajo del panel. Ninguna regla comercial lo fija
	// todavia (ver admin_inventory_dashboard_production.sql): 5 es el
	// mismo default que usa el RPC, centralizado aqui para no repetirlo.
	const LOW_STOCK_THRESHOLD = 5;
	// Cuanto tiempo se considera "reciente" la ultima carga de una vista
	// para no repetir la llamada al solo cambiar de pestana.
	const VIEW_FRESH_MS = 20_000;

	const VALID_VIEWS = new Set(["resumen", "pedidos", "inventario"]);
	type ViewName = "resumen" | "pedidos" | "inventario";

	const currencyFormatter = new Intl.NumberFormat("es-PE", {
		style: "currency",
		currency: "PEN",
	});

	const dateTimeFormatter = new Intl.DateTimeFormat("es-PE", {
		timeZone: "America/Lima",
		dateStyle: "medium",
		timeStyle: "short",
	});

	const updatedAtFormatter = new Intl.DateTimeFormat("es-PE", {
		timeZone: "America/Lima",
		dateStyle: "short",
		timeStyle: "medium",
	});

	const limaDateFormatter = new Intl.DateTimeFormat("en-CA", {
		timeZone: "America/Lima",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	});

	function escapeHtml(value: unknown): string {
		if (value === null || value === undefined) return "";
		return String(value)
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#39;");
	}

	function formatDate(value: string | null | undefined): string {
		if (!value) return "—";
		const date = new Date(value);
		if (Number.isNaN(date.getTime())) return "—";
		return dateTimeFormatter.format(date);
	}

	function formatMoney(value: number | string | null | undefined): string {
		const num = Number(value ?? 0);
		return currencyFormatter.format(Number.isFinite(num) ? num : 0);
	}

	function limaTodayISO(): string {
		return limaDateFormatter.format(new Date());
	}

	const dayShortFormatter = new Intl.DateTimeFormat("es-PE", {
		timeZone: "America/Lima",
		day: "2-digit",
		month: "2-digit",
	});

	// Etiqueta corta ("lun 04") para el eje del grafico de ventas de 7 dias.
	function dayLabel(isoDate: string): string {
		// Mediodia UTC evita que el corrimiento de zona horaria mueva la
		// fecha al dia anterior al formatear en America/Lima.
		const date = new Date(`${isoDate}T12:00:00Z`);
		if (Number.isNaN(date.getTime())) return isoDate;
		return dayShortFormatter.format(date);
	}

	/*
	 * Mismo criterio de "venta confirmada" que admin_orders_metrics
	 * (admin_dashboard_summary_v3_production.sql, sin cambios): pedidos
	 * no-COD con order_status >= payment_verified en el flujo real, o
	 * pedidos COD ya delivered. cancelled nunca cuenta. Se reutiliza aqui
	 * solo para mostrar una etiqueta derivada de "etapa de pago" en la
	 * tabla, sin inventar un campo de estado de pago que no existe en el
	 * esquema.
	 */
	const ORDER_FLOW = [
		"received",
		"payment_pending",
		"payment_verified",
		"mockup_pending",
		"mockup_sent",
		"mockup_approved",
		"in_production",
		"ready_to_ship",
		"shipped",
		"delivered",
	];

	function isConfirmedSale(paymentMethod: string, orderStatus: string): boolean {
		if (orderStatus === "cancelled") return false;
		if (paymentMethod === "cash_on_delivery") return orderStatus === "delivered";
		return ORDER_FLOW.indexOf(orderStatus) >= ORDER_FLOW.indexOf("payment_verified");
	}

	function paymentStageLabel(paymentMethod: string, orderStatus: string): string {
		if (orderStatus === "cancelled") return "Cancelado";
		return isConfirmedSale(paymentMethod, orderStatus)
			? "Pago confirmado"
			: "Pago pendiente";
	}

