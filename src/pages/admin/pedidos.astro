		// vez de repetir "resumen de TAQTO" en todas partes.
		const VIEW_TOPBAR: Record<
			ViewName,
			{ title: string; subtitle: (name: string) => string }
		> = {
			resumen: {
				title: "Resumen",
				subtitle: (name) =>
					`Bienvenido, <strong>${escapeHtml(name)}</strong>. Aquí tienes el resumen de TAQTO.`,
			},
			pedidos: {
				title: "Pedidos",
				subtitle: () => "Gestiona y revisa los pedidos de TAQTO.",
			},
			inventario: {
				title: "Inventario",
				subtitle: () =>
					"Consulta el estado del inventario y el stock de TAQTO.",
			},
		};

		let currentDisplayName = "Administrador";

		function updateTopbarContext(view: ViewName) {
			const cfg = VIEW_TOPBAR[view];
			topbarTitleEl.textContent = cfg.title;
			topbarSubtitleEl.innerHTML = cfg.subtitle(currentDisplayName);
		}

		function updateWelcome(session: Session) {
			// El nombre se usa unicamente para presentacion (saludo y
			// avatar): la autorizacion real siempre pasa por is_admin() en
			// el servidor, nunca por este metadata del cliente.
			const name = resolveDisplayName(session);
			currentDisplayName = name;
			const initials = initialsFrom(name);
			avatarEl.textContent = initials;
			avatarEl.title = session.user.email ?? "";
			sidebarAvatarEl.textContent = initials;
			sidebarNameEl.textContent = name;
			sidebarNameEl.title = session.user.email ?? "";
			updateTopbarContext(activeView);
		}

		function updateLastRefreshed() {
			updatedEl.textContent = `Actualizado: ${updatedAtFormatter.format(new Date())}`;
		}

		async function forceSignOutForbidden() {
			stopAutoRefresh();
			await supabase!.auth.signOut();
			showOnly(forbiddenView);
		}

		// ---------- Navegación entre vistas ----------

		function setNavActive(name: ViewName) {
			navLinks.forEach((link) => {
				const match = link.dataset.adminNav === name;
				link.classList.toggle("is-active", match);
				if (match) {
					link.setAttribute("aria-current", "page");
				} else {
					link.removeAttribute("aria-current");
				}
			});
		}

		function activateView(name: ViewName) {
			activeView = name;
			viewSections.forEach((el, key) => {
				el.hidden = key !== name;
			});
			setNavActive(name);
			updateTopbarContext(name);
			closeSidebarDrawer();

			const force = forceNextLoad;
			forceNextLoad = false;
			void ensureView(name, force);
		}

		function handleHashChange() {
			const raw = location.hash.replace(/^#/, "");
			const name: ViewName = VALID_VIEWS.has(raw)
				? (raw as ViewName)
				: "resumen";
			if (name !== raw) {
				history.replaceState(null, "", `#${name}`);
			}
			activateView(name);
		}

		/*
		 * Actualiza el hash sin depender del evento nativo `hashchange`:
		 * el <ClientRouter/> de Astro intercepta el click de los enlaces
		 * internos del sidebar (aunque sean solo de hash) y navega via
		 * History API, que NO dispara `hashchange`. `history.pushState`
		 * deja la URL correcta (recargar conserva la vista) y esta misma
		 * funcion invoca `activateView` directamente, sin esperar un
		 * evento que en ese camino nunca llega. `hashchange` se sigue
		 * escuchando aparte para atras/adelante del navegador y URLs
		 * escritas a mano.
		 */
		function goToView(name: ViewName) {
			const target = `#${name}`;
			if (location.hash !== target) {
				history.pushState(null, "", target);
			}
			activateView(name);
		}

		/**
		 * Navega a una vista aplicando (opcionalmente) un ajuste de
		 * filtros antes de cargarla, para las tarjetas de metricas que
		 * "navegan de verdad" en vez de ser decorativas.
		 */
		function navigateTo(name: ViewName, setup?: () => void) {
			if (setup) setup();
			forceNextLoad = true;
			goToView(name);
		}

		async function ensureView(name: ViewName, force: boolean) {
			const fresh =
				!force && Date.now() - viewLoadedAt[name] < VIEW_FRESH_MS;
			if (fresh) return;

			if (name === "resumen") await loadResumen();
			else if (name === "pedidos") await loadPedidosView();
			else await loadInventoryView();

			updateLastRefreshed();
		}

		// ---------- Sidebar móvil ----------

		function openSidebarDrawer() {
			sidebar.classList.add("is-open");
			sidebarBackdrop.hidden = false;
			menuToggle.setAttribute("aria-expanded", "true");
			openOverlay({
				id: SIDEBAR_OVERLAY_ID,
				container: sidebar,
				trigger: menuToggle,
				close: closeSidebarDrawer,
			});
		}

		function closeSidebarDrawer() {
			if (!sidebar.classList.contains("is-open")) return;
			sidebar.classList.remove("is-open");
			sidebarBackdrop.hidden = true;
			menuToggle.setAttribute("aria-expanded", "false");
			closeOverlay(SIDEBAR_OVERLAY_ID);
		}

		menuToggle.addEventListener("click", () => {
			if (sidebar.classList.contains("is-open")) {
				closeSidebarDrawer();
			} else {
				openSidebarDrawer();
			}
		});

		sidebarBackdrop.addEventListener("click", closeSidebarDrawer);

		/*
		 * `href="#resumen"` etc. se conserva en el markup para que el
		 * enlace siga siendo un enlace de verdad (clic central/nuevo
		 * separador, sin JS). Pero un clic normal se resuelve aqui
		 * mismo con `goToView` en vez de dejarlo en manos de la
		 * navegacion nativa: el <ClientRouter/> de Astro intercepta el
		 * click y navega via History API, que no dispara `hashchange`.
		 */
		navLinks.forEach((link) => {
			link.addEventListener("click", (event) => {
				if (
					event.defaultPrevented ||
					event.button !== 0 ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey
				) {
					return;
				}
				event.preventDefault();
				event.stopPropagation();
				const name = link.dataset.adminNav as ViewName;
				goToView(name);
			});
		});

		gotoButtons.forEach((button) => {
			button.addEventListener("click", () => {
				const target = button.dataset.adminGoto as ViewName;
				navigateTo(target);
			});
		});

		// =====================================================
		// ---------- Resumen ----------
		// =====================================================

		// numeric de Postgres puede llegar como string por el driver: se
		// fuerza siempre a Number antes de formatear/mostrar. Un campo
		// valido pero vacio (null/undefined/NaN) se muestra como 0, nunca
		// como guion: el guion queda reservado para cuando el RPC completo
		// fallo (summary === null).
		function asNumber(value: unknown): number {
			const num = Number(value);
			return Number.isFinite(num) ? num : 0;
		}

		/*
		 * Cuatro tarjetas fijas: valor de pedidos activos, ventas
		 * confirmadas, total de pedidos y stock bajo. "Activos" y
		 * "confirmadas" son cifras DISTINTAS a proposito (ver
		 * admin_dashboard_summary_v4_production.sql): activos suma todo
		 * pedido no cancelado (incluye "Recibido"), confirmadas solo
		 * pagos ya verificados/entregados o con evidencia real en
		 * order_payments. No se presenta un pedido apenas recibido como
		 * dinero ya cobrado.
		 */
		function renderResumenMetrics(summary: DashboardSummaryV4 | null) {
			const stockHint = !summary
				? "—"
				: summary.inventory_error
					? "No se pudo consultar el inventario"
					: `${asNumber(summary.inventory_out_of_stock)} sin stock`;

			resumenMetricsEl.innerHTML = `
				<div class="admin-metric-cards">
					<button class="admin-metric-card admin-glass" type="button" data-admin-card="active-value">
						<span class="admin-metric-card__icon" aria-hidden="true">${CLIPBOARD_ICON}</span>
						<p class="admin-metric-card__label">Valor de pedidos activos</p>
						<p class="admin-metric-card__value">${summary ? escapeHtml(formatMoney(asNumber(summary.active_orders_value))) : "—"}</p>
						<p class="admin-metric-card__hint">Incluye todos los pedidos no cancelados</p>
					</button>
					<button class="admin-metric-card admin-glass" type="button" data-admin-card="sales-confirmed">
						<span class="admin-metric-card__icon" aria-hidden="true">${WALLET_ICON}</span>
						<p class="admin-metric-card__label">Ventas confirmadas</p>
						<p class="admin-metric-card__value">${summary ? escapeHtml(formatMoney(asNumber(summary.confirmed_sales_value))) : "—"}</p>
						<p class="admin-metric-card__hint">${summary ? escapeHtml(asNumber(summary.confirmed_sales_count)) : "—"} pedido(s) confirmado(s)</p>
					</button>
					<button class="admin-metric-card admin-glass" type="button" data-admin-card="orders-total">
						<span class="admin-metric-card__icon" aria-hidden="true">${CALENDAR_ICON}</span>
						<p class="admin-metric-card__label">Total de pedidos</p>
						<p class="admin-metric-card__value">${summary ? escapeHtml(asNumber(summary.orders_total)) : "—"}</p>
						<p class="admin-metric-card__hint">${summary ? escapeHtml(asNumber(summary.orders_today)) : "—"} hoy</p>
					</button>
					<button class="admin-metric-card admin-glass admin-metric-card--warn" type="button" data-admin-card="stock-low">
						<span class="admin-metric-card__icon" aria-hidden="true">${PACKAGE_X_ICON}</span>
						<p class="admin-metric-card__label">Stock bajo</p>
						<p class="admin-metric-card__value">${summary ? escapeHtml(asNumber(summary.inventory_low_stock)) : "—"}</p>
						<p class="admin-metric-card__hint">${escapeHtml(stockHint)}</p>
					</button>
				</div>
			`;
		}

		resumenMetricsEl.addEventListener("click", (event) => {
			const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
				"[data-admin-card]",
			);
			if (!button) return;

			switch (button.dataset.adminCard) {
				case "active-value":
				case "orders-total":
					navigateTo("pedidos", clearOrderFilters);
					break;
				case "sales-confirmed":
					// El listado de pedidos (admin_list_orders / v2) no
					// expone un filtro de "confirmado" (solo un
					// order_status exacto a la vez), asi que no se puede
					// filtrar a varios estados del flujo a la vez: se
					// navega a Pedidos sin filtro exacto y se explica en
					// el resumen (ver hint de la tarjeta).
					navigateTo("pedidos", clearOrderFilters);
					break;
				case "stock-low":
					navigateTo("inventario", () => {
						clearInventoryFilters();
						invFilters.stock = "low";
						syncInventoryFilterInputs();
					});
					break;
			}
		});

		function renderRecentOrders(rows: OrderRow[]) {
			if (rows.length === 0) {
				recentOrdersEl.innerHTML =
					'<p class="admin-panel__empty">Todavía no hay pedidos.</p>';
				return;
			}

			recentOrdersEl.innerHTML = `
				<ul class="admin-mini-list">
					${rows
						.map((row) => {
							const statusLabelText =
								ORDER_STATUS_LABELS[row.order_status] ??
								row.order_status;
							return `
								<li class="admin-mini-row">
									<div class="admin-mini-row__main">
										<p class="admin-mini-row__title">${escapeHtml(row.order_number)}</p>
										<p class="admin-mini-row__meta">${escapeHtml(row.customer_full_name)} · ${escapeHtml(formatDate(row.created_at))}</p>
									</div>
									<div class="admin-mini-row__side">
										<span class="admin-badge" data-status="${escapeHtml(row.order_status)}">${escapeHtml(statusLabelText)}</span>
										<span class="admin-mini-row__total">${escapeHtml(formatMoney(row.total))}</span>
										<button class="btn btn--secondary admin-view-button" type="button" data-admin-view data-order-id="${escapeHtml(row.id)}">Ver</button>
									</div>
								</li>
							`;
						})
						.join("")}
				</ul>
			`;

			recentOrdersEl
				.querySelectorAll<HTMLButtonElement>("[data-admin-view]")
				.forEach((button) => {
					button.addEventListener("click", () => {
						const orderId = button.dataset.orderId;
						if (orderId) void openOrderDetail(orderId, button);
					});
				});
		}

		function renderLowStock(rows: InventoryRow[]) {
			const attention = rows
				.filter((row) => row.stock_status !== "available")
				.slice(0, 5);

			if (attention.length === 0) {
				lowStockEl.innerHTML =
					'<p class="admin-panel__empty">Todo el inventario tiene stock disponible</p>';
				return;
			}

			lowStockEl.innerHTML = `
				<ul class="admin-mini-list">
					${attention
						.map((row) => {
							const variant = [row.wood_title, row.size_title]
								.filter(Boolean)
								.map(escapeHtml)
								.join(" · ");
							return `
								<li class="admin-mini-row">
									<div class="admin-mini-row__main">
										<p class="admin-mini-row__title">${escapeHtml(row.product_title)}</p>
										<p class="admin-mini-row__meta">${variant ? variant + " · " : ""}SKU ${escapeHtml(row.sku)}</p>
									</div>
									<div class="admin-mini-row__side">
										<span class="admin-badge" data-stock-status="${escapeHtml(row.stock_status)}">${escapeHtml(STOCK_STATUS_LABELS[row.stock_status] ?? row.stock_status)}</span>
										<span class="admin-mini-row__total">${escapeHtml(row.stock_quantity)} u.</span>
									</div>
								</li>
							`;
						})
						.join("")}
				</ul>
			`;
		}

		/*
		 * Grafico de barras (HTML/CSS puro, sin canvas ni libreria) del
		 * valor de pedidos ACTIVOS (no cancelados, incluye "received") de
		 * los ultimos 7 dias. `daily_active_orders` ya viene ordenado
		 * ascendente y sin huecos (RPC admin_dashboard_summary_v4).
		 * Cada barra se escala contra el maximo real de la serie; si todos
		 * los dias estan en cero se muestra la barra "vacia" igual, con su
		 * valor de S/ 0.00 como texto (nunca solo decorativo).
		 */
		function renderSalesChart(days: ActiveOrdersDayRow[]): string {
			// Las 7 fechas siempre vienen del backend (generate_series sin
			// huecos): un array vacio solo pasa si la llamada fallo, no si
			// los 7 dias estan en cero. Aun con todo en cero se dibujan
			// las 7 barras (altura minima) para no dejar un panel vacio.
			if (!days.length) {
				return '<p class="admin-panel__empty">Sin datos de los últimos 7 días.</p>';
			}

			const max = Math.max(1, ...days.map((d) => Number(d.amount) || 0));
			const allZero = days.every((d) => (Number(d.amount) || 0) === 0);

			const cols = days
				.map((d) => {
					const value = Number(d.amount) || 0;
					const count = Number(d.orders_count) || 0;
					const pct = Math.max(2, Math.round((value / max) * 100));
					const title = `${formatMoney(value)} · ${count} pedido(s)`;
					return `
						<div class="admin-bar-chart__col" title="${escapeHtml(title)}">
							<span class="admin-bar-chart__value">${escapeHtml(formatMoney(value))}</span>
							<div class="admin-bar-chart__track">
								<div class="admin-bar-chart__bar" style="height:${pct}%"></div>
							</div>
							<span class="admin-bar-chart__label">${escapeHtml(dayLabel(d.date))}</span>
						</div>
					`;
				})
				.join("");

			return `
				<div class="admin-bar-chart" role="img" aria-label="Valor de pedidos activos por día, últimos 7 días">
					${cols}
				</div>
				${allZero ? '<p class="admin-panel__empty admin-panel__empty--compact">Sin pedidos en los últimos 7 días.</p>' : ""}
			`;
		}

		/*
		 * Barras horizontales (HTML/CSS) de pedidos por estado, en el
		 * orden real del flujo (el mismo orden de declaracion de
		 * ORDER_STATUS_LABELS), no alfabetico. `breakdown` viene completo
		 * (11 claves, con 0 en las que no tienen pedidos) desde
		 * admin_orders_metrics().
		 */
		function renderStatusHBars(breakdown: Record<string, number> | null): string {
			if (!breakdown) {
				return '<p class="admin-panel__empty">Sin datos de pedidos por estado.</p>';
			}

			const entries = Object.entries(ORDER_STATUS_LABELS).map(
				([status, label]) => [status, label, breakdown[status] ?? 0] as const,
			);
			const max = Math.max(1, ...entries.map(([, , count]) => count));

			const rows = entries
				.map(([status, label, count]) => {
					const pct = count > 0 ? Math.max(2, Math.round((count / max) * 100)) : 0;
					return `
						<li class="admin-hbar-row">
							<span class="admin-hbar-row__label">${escapeHtml(label)}</span>
							<div class="admin-hbar-row__track">
								<div class="admin-hbar-row__fill" data-status="${escapeHtml(status)}" style="width:${pct}%"></div>
							</div>
							<strong class="admin-hbar-row__value">${escapeHtml(count)}</strong>
						</li>
					`;
				})
				.join("");

			return `<ul class="admin-hbar-list">${rows}</ul>`;
		}

		// status_counts llega como arreglo [{status,count}] desde
		// admin_dashboard_summary_v4(): renderStatusHBars sigue esperando
		// un Record por estado (mas simple de indexar contra
		// ORDER_STATUS_LABELS), asi que se convierte aqui una sola vez.
		function statusCountsToRecord(
			rows: StatusCountRow[] | null | undefined,
		): Record<string, number> | null {
			if (!rows) return null;
			const record: Record<string, number> = {};
			for (const row of rows) {
				record[row.status] = asNumber(row.count);
			}
			return record;
		}

		function renderResumenCharts(summary: DashboardSummaryV4 | null) {
			resumenChartsEl.innerHTML = `
				<section class="admin-panel admin-glass admin-panel--chart-7d" aria-labelledby="admin-sales-chart-title">
					<div class="admin-panel__head">
						<h3 id="admin-sales-chart-title">Valor de pedidos activos — últimos 7 días</h3>
					</div>
					${renderSalesChart(summary?.daily_active_orders ?? [])}
				</section>
				<section class="admin-panel admin-glass admin-panel--chart-status" aria-labelledby="admin-status-chart-title">
					<div class="admin-panel__head">
						<h3 id="admin-status-chart-title">Pedidos por estado</h3>
					</div>
					${renderStatusHBars(statusCountsToRecord(summary?.status_counts))}
				</section>
			`;
		}

		/*
		 * admin_dashboard_summary_v4 devuelve jsonb (no SETOF/TABLE), asi
		 * que supabase-js normalmente ya entrega `data` como el objeto
		 * directamente. Se normaliza igual por si el driver alguna vez lo
		 * envuelve en un arreglo de una fila, y se valida que el contenido
		 * tenga forma de resumen antes de darlo por bueno: un objeto vacio
		 * o sin las claves esperadas se trata como fallo, no como "0 en
		 * todo".
		 */
		function normalizeSummary(raw: unknown): DashboardSummaryV4 | null {
			const candidate = Array.isArray(raw) ? raw[0] : raw;
			if (!candidate || typeof candidate !== "object") return null;
			if (!("active_orders_value" in candidate)) return null;
			return candidate as DashboardSummaryV4;
		}

		/*
		 * Una sola llamada (admin_dashboard_summary_v4) trae dinero,
		 * pedidos, 7 dias e inventario juntos: si falla, es el unico
		 * fallo "critico" que amerita el aviso general del Resumen. Los
		 * otros dos RPC (recientes / stock critico) ya tienen su propio
		 * mensaje de reemplazo en su propia tarjeta y no deben apagar
		 * cifras que si cargaron.
		 */
		async function loadResumen() {
			if (isLoadingResumen) return;
			isLoadingResumen = true;
			resumenErrorEl.hidden = true;

			try {
				const [summaryRes, recentRes, lowStockRes] =
					await Promise.allSettled([
						supabase!.rpc("admin_dashboard_summary_v4"),
						supabase!.rpc("admin_list_orders", {
							p_search: null,
							p_status: null,
							p_payment_method: null,
							p_delivery_method: null,
							p_date_from: null,
							p_date_to: null,
							p_limit: 5,
							p_offset: 0,
						}),
						supabase!.rpc("admin_list_inventory", {
							p_search: null,
							p_stock_filter: null,
							p_active_only: true,
							p_low_stock_threshold: LOW_STOCK_THRESHOLD,
							p_limit: 8,
							p_offset: 0,
						}),
					]);

				for (const result of [summaryRes, recentRes, lowStockRes]) {
					if (
						result.status === "fulfilled" &&
						result.value.error &&
						isForbiddenError(result.value.error)
					) {
						await forceSignOutForbidden();
						return;
					}
				}

				const normalizedSummary =
					summaryRes.status === "fulfilled" && !summaryRes.value.error
						? normalizeSummary(summaryRes.value.data)
						: null;
				const summaryFailed =
					summaryRes.status === "rejected" ||
					!!summaryRes.value.error ||
					!normalizedSummary;

				if (!summaryFailed) {
					lastDashboardSummary = normalizedSummary;
				}

				renderResumenMetrics(lastDashboardSummary);
				renderResumenCharts(lastDashboardSummary);

				if (recentRes.status === "fulfilled" && !recentRes.value.error) {
					renderRecentOrders((recentRes.value.data ?? []) as OrderRow[]);
				} else {
					recentOrdersEl.innerHTML =
						'<p class="admin-panel__empty">No se pudieron cargar los pedidos recientes.</p>';
				}

				if (
					lowStockRes.status === "fulfilled" &&
					!lowStockRes.value.error
				) {
					renderLowStock(
						(lowStockRes.value.data ?? []) as InventoryRow[],
					);
				} else {
					lowStockEl.innerHTML =
						'<p class="admin-panel__empty">No se pudo consultar el inventario.</p>';
				}

				// Solo el fallo del resumen principal (dinero/pedidos/7
				// dias/inventario en una sola cifra) apaga las tarjetas a
				// "—" y amerita el aviso general: los otros dos paneles ya
				// muestran su propio mensaje sin tocar las tarjetas.
				if (summaryFailed) {
					resumenErrorEl.textContent =
						"No se pudieron cargar las métricas del resumen. Intenta actualizar de nuevo.";
					resumenErrorEl.hidden = false;
				}

				viewLoadedAt.resumen = Date.now();
			} catch {
				resumenErrorEl.textContent =
					"No se pudo cargar el resumen. Intenta de nuevo.";
				resumenErrorEl.hidden = false;
			} finally {
				isLoadingResumen = false;
			}
		}

		// =====================================================
		// ---------- Pedidos ----------
		// =====================================================

		function clearOrderFilters() {
			filters.search = "";
			filters.status = "";
			filters.payment = "";
			filters.delivery = "";
			filters.from = "";
			filters.to = "";
			currentPage = 0;
		}

		function syncOrderFilterInputs() {
			filterInputs.forEach((input) => {
				const key = input.dataset.adminFilter as keyof OrderFilters;
				input.value = filters[key] ?? "";
			});
		}

		function renderStatusBreakdown(
			breakdown: Record<string, number> | null,
		): string {
			if (!breakdown) return "";

			const chips = Object.entries(ORDER_STATUS_LABELS)
				.map(([status, label]) => {
					const count = breakdown[status] ?? 0;
					return `<li class="admin-status-chip" data-status="${escapeHtml(status)}"><span>${escapeHtml(label)}</span><strong>${escapeHtml(count)}</strong></li>`;
				})
				.join("");

			return `<ul class="admin-status-grid">${chips}</ul>`;
		}

		function renderMetrics(row: MetricsRow | undefined) {
			if (!row) {
				metricsEl.innerHTML = "";
				return;
			}

			metricsEl.innerHTML = `
				<div class="admin-metric-cards">
					<div class="admin-metric-card">
						<p class="admin-metric-card__label">Total de pedidos</p>
						<p class="admin-metric-card__value">${escapeHtml(row.total_orders)}</p>
					</div>
					<div class="admin-metric-card">
						<p class="admin-metric-card__label">Pedidos de hoy</p>
						<p class="admin-metric-card__value">${escapeHtml(row.orders_today)}</p>
					</div>
					<div class="admin-metric-card">
						<p class="admin-metric-card__label">Ventas confirmadas</p>
						<p class="admin-metric-card__value">${escapeHtml(formatMoney(row.confirmed_sales_total))}</p>
						<p class="admin-metric-card__hint">${escapeHtml(row.confirmed_sales_count)} pedido(s) con pago confirmado</p>
					</div>
				</div>
				${renderStatusBreakdown(row.orders_by_status)}
			`;
		}

		// Fila expandida actualmente en la tabla de Pedidos (una sola a la
		// vez). No dispara ninguna carga: el detalle expandido se arma con
		// los datos que la propia fila ya trae de admin_list_orders_v2.
		let expandedOrderRowId: string | null = null;

		function productSummary(row: OrderRow): string {
			const name = row.first_item_product_name;
			if (!name) return "—";

			const qty = row.first_item_quantity ?? 1;
			const variant = row.first_item_variant_label;
			const extra = row.items_extra_count ?? 0;

			const main = `${escapeHtml(name)} ×${escapeHtml(qty)}`;
			const variantHtml = variant
				? `<span class="admin-product-summary__variant">${escapeHtml(variant)}</span>`
				: "";
			const extraHtml =
				extra > 0
					? `<span class="admin-product-summary__extra">+ ${escapeHtml(extra)} producto(s) más</span>`
					: "";

			return `
				<span class="admin-product-summary__main">${main}</span>
				${variantHtml}
				${extraHtml}
			`;
		}

		function renderExpandedRow(row: OrderRow): string {
			const name = row.first_item_product_name;
			const qty = row.first_item_quantity ?? 1;
			const variant = row.first_item_variant_label;
			const extra = row.items_extra_count ?? 0;

			const itemLine = name
				? `<li>${escapeHtml(qty)} × ${escapeHtml(name)}${variant ? " — " + escapeHtml(variant) : ""}</li>`
				: '<li class="admin-expanded__empty">Sin artículos cargados.</li>';
			const extraLine =
				extra > 0
					? `<li class="admin-expanded__extra">+ ${escapeHtml(extra)} producto(s) más — usa "Ver detalle" para verlos todos</li>`
					: "";

			return `
				<div class="admin-expanded">
					<div class="admin-expanded__col">
						<p class="admin-expanded__title">Productos</p>
						<ul class="admin-expanded__items">${itemLine}${extraLine}</ul>
					</div>
					<div class="admin-expanded__col">
						<p class="admin-expanded__title">Contacto</p>
						<p>${escapeHtml(row.customer_email || "—")}</p>
						<p>${escapeHtml(row.customer_phone || "—")}</p>
					</div>
					<div class="admin-expanded__col">
						<p class="admin-expanded__title">Entrega</p>
						<p>${escapeHtml(DELIVERY_METHOD_LABELS[row.delivery_method] ?? row.delivery_method)}</p>
						<p>${escapeHtml(row.delivery_district || "—")}</p>
					</div>
				</div>
			`;
		}

		function renderOrderRows(rows: OrderRow[]) {
			if (rows.length === 0) {
				tableBody.innerHTML = "";
				emptyEl.hidden = false;
				return;
			}

			// La fila expandida solo se conserva si sigue presente en la
			// pagina actual (cambiar de pagina o filtro la cierra sola).
			if (!rows.some((row) => row.id === expandedOrderRowId)) {
				expandedOrderRowId = null;
			}

			emptyEl.hidden = true;

			tableBody.innerHTML = rows
				.map((row) => {
					const statusLabelText =
						ORDER_STATUS_LABELS[row.order_status] ??
						row.order_status;
					const paymentLabel =
						PAYMENT_METHOD_LABELS[row.payment_method] ??
						row.payment_method;
					const deliveryLabel =
						DELIVERY_METHOD_LABELS[row.delivery_method] ??
						row.delivery_method;
					const stageLabel = paymentStageLabel(
						row.payment_method,
						row.order_status,
					);
					const isExpanded = row.id === expandedOrderRowId;

					return `
						<tr class="admin-table__row" data-order-row="${escapeHtml(row.id)}">
							<td data-label="" class="admin-table__toggle-cell">
								<button
									class="admin-table__toggle"
									type="button"
									data-admin-row-toggle
									data-order-id="${escapeHtml(row.id)}"
									aria-expanded="${isExpanded ? "true" : "false"}"
									aria-label="${isExpanded ? "Ocultar detalles" : "Ver más detalles"} del pedido ${escapeHtml(row.order_number)}"
								>${CHEVRON_DOWN_ICON}</button>
							</td>
							<td data-label="Pedido">
								<span class="admin-cell__main">${escapeHtml(row.order_number)}</span>
								<span class="admin-cell__meta">${escapeHtml(formatDate(row.created_at))}</span>
							</td>
							<td data-label="Cliente">
								<span class="admin-cell__main">${escapeHtml(row.customer_full_name)}</span>
								<span class="admin-cell__meta">${escapeHtml(row.customer_phone || "—")}</span>
							</td>
							<td data-label="Producto" class="admin-product-summary">${productSummary(row)}</td>
							<td data-label="Distrito / Entrega">
								<span class="admin-cell__main">${escapeHtml(row.delivery_district || "—")}</span>
								<span class="admin-cell__meta">${escapeHtml(deliveryLabel)}</span>
							</td>
							<td data-label="Pago">
								<span class="admin-cell__main">${escapeHtml(paymentLabel)}</span>
								<span class="admin-cell__meta">${escapeHtml(stageLabel)}</span>
							</td>
							<td data-label="Estado">
								<span class="admin-badge" data-status="${escapeHtml(row.order_status)}">${escapeHtml(statusLabelText)}</span>
							</td>
							<td data-label="Unidades" class="admin-table__num">${escapeHtml(row.unit_count)}${row.has_engraving ? ' <span class="admin-engraving-flag" title="Incluye grabado o personalización">✎</span>' : ""}</td>
							<td data-label="Total" class="admin-table__num admin-table__total">${escapeHtml(formatMoney(row.total))}</td>
							<td data-label="Acción">
								<button class="btn btn--secondary admin-view-button" type="button" data-admin-view data-order-id="${escapeHtml(row.id)}">Ver detalle</button>
							</td>
						</tr>
						<tr class="admin-table__detail-row" data-order-detail-row="${escapeHtml(row.id)}"${isExpanded ? "" : " hidden"}>
							<td colspan="10">${renderExpandedRow(row)}</td>
						</tr>
					`;
				})
				.join("");

			tableBody
				.querySelectorAll<HTMLButtonElement>("[data-admin-view]")
				.forEach((button) => {
					button.addEventListener("click", () => {
						const orderId = button.dataset.orderId;
						if (orderId) void openOrderDetail(orderId, button);
					});
				});

			// Un solo toggle a la vez: expandir uno colapsa cualquier otro.
			// Botones normales (Enter/Espacio funcionan de forma nativa),
			// sin re-fetch: todo el marcado ya esta en el DOM.
			tableBody
				.querySelectorAll<HTMLButtonElement>("[data-admin-row-toggle]")
				.forEach((button) => {
					button.addEventListener("click", () => {
						const orderId = button.dataset.orderId ?? null;
						expandedOrderRowId =
							expandedOrderRowId === orderId ? null : orderId;
						renderOrderRows(rows);
					});
				});
		}

		function updatePagination() {
			const totalPages = Math.max(
				1,
				Math.ceil(totalCount / PAGE_SIZE),
			);
			const page = currentPage + 1;

			pageInfoEl.textContent =
				totalCount === 0
					? "Sin resultados"
					: `Página ${page} de ${totalPages} · ${totalCount} pedido(s)`;

			prevButton.disabled = currentPage === 0;
			nextButton.disabled = (currentPage + 1) * PAGE_SIZE >= totalCount;
		}

		async function loadOrders() {
			if (isLoadingList) return;
			isLoadingList = true;
			tableWrap.setAttribute("aria-busy", "true");
			errorEl.hidden = true;

			try {
				// admin_list_orders_v2: mismos filtros/paginacion que v1
				// (admin_list_orders), mas resumen del primer articulo y
				// conteo de articulos adicionales para la columna
				// "Producto" de la tabla, sin consultas por fila. v1 sigue
				// intacta y en uso solo en el listado de "Pedidos
				// recientes" del Resumen.
				const { data, error } = await supabase!.rpc(
					"admin_list_orders_v2",
					{
						p_search: filters.search || null,
						p_status: filters.status || null,
						p_payment_method: filters.payment || null,
						p_delivery_method: filters.delivery || null,
						p_date_from: filters.from || null,
						p_date_to: filters.to || null,
						p_limit: PAGE_SIZE,
						p_offset: currentPage * PAGE_SIZE,
					},
				);

				if (error) {
					if (isForbiddenError(error)) {
						await forceSignOutForbidden();
						return;
					}
					throw error;
				}

				const rows = (data ?? []) as OrderRow[];
				totalCount = rows[0]?.total_count ?? 0;
				renderOrderRows(rows);
				updatePagination();
			} catch {
				tableBody.innerHTML = "";
				errorEl.textContent =
					"No se pudieron cargar los pedidos. Intenta de nuevo.";
				errorEl.hidden = false;
			} finally {
				isLoadingList = false;
				tableWrap.removeAttribute("aria-busy");
			}
		}

		async function loadMetrics(): Promise<boolean> {
			if (isLoadingMetrics) return true;
			isLoadingMetrics = true;

			try {
				const { data, error } = await supabase!.rpc(
					"admin_orders_metrics",
				);

				if (error) {
					if (isForbiddenError(error)) {
						await forceSignOutForbidden();
						return false;
					}
					throw error;
				}

				const rows = (data ?? []) as MetricsRow[];
				lastOrdersMetrics = rows[0] ?? null;
				renderMetrics(rows[0]);
				return true;
			} catch {
				metricsEl.innerHTML =
					'<p class="admin-metrics__error">No se pudieron cargar las métricas.</p>';
				return true;
			} finally {
				isLoadingMetrics = false;
			}
		}

		async function loadPedidosView() {
			const authorized = await loadMetrics();
			if (!authorized) return;
			await loadOrders();
			viewLoadedAt.pedidos = Date.now();
		}

		function statusLabel(value: unknown): string {
			const key = String(value ?? "");
			return ORDER_STATUS_LABELS[key] ?? key;
		}

		/*
		 * Un unico origen para la lista de estados: ORDER_STATUS_LABELS,
		 * el mismo mapa que usan metricas, tabla, detalle y etiqueta. El
		 * orden de sus claves es el orden logico del flujo y se conserva
		 * aqui tal cual.
		 */
		function renderStatusOptions(current: string): string {
			return Object.entries(ORDER_STATUS_LABELS)
				.map(
					([value, label]) =>
						`<option value="${escapeHtml(value)}"${value === current ? " selected" : ""}>${escapeHtml(label)}</option>`,
				)
				.join("");
		}

