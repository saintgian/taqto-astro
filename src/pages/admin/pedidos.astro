		function renderDrawerChips(o: Record<string, any>): string {
			return `
				<span class="admin-badge" data-status="${escapeHtml(o.order_status)}">${escapeHtml(ORDER_STATUS_LABELS[o.order_status] ?? o.order_status)}</span>
				<span class="admin-badge admin-badge--outline" data-payment-status="${escapeHtml(o.payment_status)}">Pago: ${escapeHtml(PAYMENT_STATUS_LABELS[o.payment_status] ?? o.payment_status)}</span>
			`;
		}

		function renderOrderDetail(payload: OrderDetail): string {
			const o = payload.order;
			const items = payload.items ?? [];
			const unitCount = items.reduce(
				(sum, item) => sum + Number(item.quantity ?? 0),
				0,
			);
			// El RPC devuelve el historial cronologico ascendente; en
			// pantalla interesa lo ultimo que paso primero.
			const history = [...(payload.history ?? [])].reverse();

			const itemsHtml = items.length
				? items
						.map((item) => {
							const variant = [
								item.wood_name,
								item.size_name,
								item.dimensions_label,
							]
								.filter(Boolean)
								.map(escapeHtml)
								.join(" · ");

							const engraving = item.engraving_requested
								? `<p class="admin-drawer__item-engraving">Grabado${item.engraving_type ? " (" + escapeHtml(item.engraving_type) + ")" : ""}${item.engraving_text ? `: "${escapeHtml(item.engraving_text)}"` : ""}</p>`
								: "";

							const notes = item.personalization_notes
								? `<p class="admin-drawer__item-notes">Notas: ${escapeHtml(item.personalization_notes)}</p>`
								: "";

							return `
								<li class="admin-drawer__item">
									<div class="admin-drawer__item-main">
										<p class="admin-drawer__item-name">${escapeHtml(item.product_name)}</p>
										<p class="admin-drawer__item-meta">SKU ${escapeHtml(item.product_sku)}${variant ? " · " + variant : ""}</p>
										${engraving}
										${notes}
									</div>
									<div class="admin-drawer__item-nums">
										<span>${escapeHtml(item.quantity)} × ${escapeHtml(formatMoney(item.unit_price))}</span>
										<strong>${escapeHtml(formatMoney(item.line_total))}</strong>
									</div>
								</li>
							`;
						})
						.join("")
				: '<li class="admin-drawer__history-empty">Sin artículos.</li>';

			const historyHtml = history.length
				? history
						.map((h) => {
							const prev = h.previous_status
								? `${escapeHtml(ORDER_STATUS_LABELS[h.previous_status] ?? h.previous_status)} → `
								: "";
							const note = h.note
								? `<span class="admin-drawer__history-note">${escapeHtml(h.note)}</span>`
								: "";

							return `
								<li class="admin-drawer__history-item">
									<span class="admin-drawer__history-date">${escapeHtml(formatDate(h.created_at))}</span>
									<span class="admin-drawer__history-change">${prev}${escapeHtml(ORDER_STATUS_LABELS[h.new_status] ?? h.new_status)}</span>
									${note}
								</li>
							`;
						})
						.join("")
				: '<li class="admin-drawer__history-empty">Sin historial de estados registrado.</li>';

			const phoneDigits = String(o.customer_phone ?? "").replace(
				/\D/g,
				"",
			);
			const whatsappDigits = phoneDigits
				? phoneDigits.startsWith("51")
					? phoneDigits
					: `51${phoneDigits}`
				: "";

			const location = [
				o.delivery_district,
				o.delivery_province,
				o.delivery_department,
			]
				.filter(Boolean)
				.map(escapeHtml)
				.join(", ");

			const discountRow =
				Number(o.discount_total) > 0
					? `<p><span>Descuento</span><span>-${escapeHtml(formatMoney(o.discount_total))}</span></p>`
					: "";

			return `
				<div class="admin-drawer__summary">
					<div class="admin-drawer__summary-item">
						<span class="admin-drawer__summary-label">Total</span>
						<span class="admin-drawer__summary-value">${escapeHtml(formatMoney(o.total))}</span>
					</div>
					<div class="admin-drawer__summary-item">
						<span class="admin-drawer__summary-label">Unidades</span>
						<span class="admin-drawer__summary-value">${escapeHtml(unitCount)}</span>
					</div>
					<div class="admin-drawer__summary-item">
						<span class="admin-drawer__summary-label">Entrega</span>
						<span class="admin-drawer__summary-value">${escapeHtml(DELIVERY_METHOD_LABELS[o.delivery_method] ?? o.delivery_method)}</span>
					</div>
					<div class="admin-drawer__summary-item">
						<span class="admin-drawer__summary-label">Pago</span>
						<span class="admin-drawer__summary-value">${escapeHtml(PAYMENT_METHOD_LABELS[o.payment_method] ?? o.payment_method)}</span>
					</div>
				</div>

				<div class="admin-drawer__columns">
					<div class="admin-drawer__col-main">
						<div class="admin-drawer__section">
							<h3>Cliente</h3>
							<p>${escapeHtml(o.customer_first_name)} ${escapeHtml(o.customer_last_name)}</p>
							<p><a href="mailto:${escapeHtml(o.customer_email)}">${escapeHtml(o.customer_email)}</a></p>
							<p>
								${phoneDigits ? `<a href="tel:+${escapeHtml(phoneDigits)}">${escapeHtml(o.customer_phone)}</a>` : escapeHtml(o.customer_phone)}
								${whatsappDigits ? ` · <a href="https://wa.me/${escapeHtml(whatsappDigits)}" target="_blank" rel="noopener noreferrer">WhatsApp</a>` : ""}
							</p>
							${o.customer_document_number ? `<p>${escapeHtml(o.customer_document_type || "Doc.")}: ${escapeHtml(o.customer_document_number)}</p>` : ""}
						</div>

						<div class="admin-drawer__section">
							<h3>Entrega</h3>
							<p>${escapeHtml(DELIVERY_METHOD_LABELS[o.delivery_method] ?? o.delivery_method)}</p>
							${o.delivery_address ? `<p>${escapeHtml(o.delivery_address)}</p>` : ""}
							${location ? `<p>${location}</p>` : ""}
							${o.delivery_reference ? `<p>Referencia: ${escapeHtml(o.delivery_reference)}</p>` : ""}
							${o.agency_name ? `<p>Agencia: ${escapeHtml(o.agency_name)}</p>` : ""}
						</div>

						${o.customer_notes ? `<div class="admin-drawer__section"><h3>Notas del cliente</h3><p>${escapeHtml(o.customer_notes)}</p></div>` : ""}
						${o.internal_notes ? `<div class="admin-drawer__section"><h3>Notas internas</h3><p>${escapeHtml(o.internal_notes)}</p></div>` : ""}

						<div class="admin-drawer__section">
							<h3>Productos</h3>
							<ul class="admin-drawer__items">${itemsHtml}</ul>
						</div>

						<div class="admin-drawer__section admin-drawer__totals">
							<p><span>Subtotal</span><span>${escapeHtml(formatMoney(o.subtotal))}</span></p>
							<p><span>Envío</span><span>${escapeHtml(formatMoney(o.delivery_cost))}</span></p>
							${discountRow}
							<p class="admin-drawer__total-final"><span>Total</span><span>${escapeHtml(formatMoney(o.total))}</span></p>
						</div>
					</div>

					<div class="admin-drawer__col-side">
						${renderManageSection(o)}

						<div class="admin-drawer__section">
							<h3>Historial de estados</h3>
							<ul class="admin-drawer__history">${historyHtml}</ul>
						</div>
					</div>
				</div>
			`;
		}

		function openDrawer(trigger: HTMLElement) {
			drawer.hidden = false;
			drawerBackdrop.hidden = false;

			openOverlay({
				id: DRAWER_OVERLAY_ID,
				container: drawer,
				trigger,
				close: closeDrawer,
			});
		}

		function closeDrawer() {
			closeLabelModal();
			drawer.hidden = true;
			drawerBackdrop.hidden = true;
			currentOrderId = null;
			currentOrderStatus = null;
			currentOrderDetail = null;
			pendingStatusConfirm = null;
			drawerBody.innerHTML = "";
			drawerSubtitle.textContent = "";
			drawerChips.innerHTML = "";
			closeOverlay(DRAWER_OVERLAY_ID);
		}

		function setStatusFeedback(
			message: string,
			tone: "ok" | "error" | "warn",
		) {
			const el = drawerBody.querySelector<HTMLElement>(
				"[data-admin-status-feedback]",
			);
			if (!el) return;
			el.textContent = message;
			el.dataset.tone = tone;
			el.hidden = false;
		}

		function clearStatusFeedback() {
			const el = drawerBody.querySelector<HTMLElement>(
				"[data-admin-status-feedback]",
			);
			if (!el) return;
			el.hidden = true;
			el.textContent = "";
		}

		/*
		 * Rellena el drawer con el detalle del pedido. `feedback` permite
		 * conservar un mensaje (exito o conflicto) despues de repintar,
		 * porque el repintado destruye el nodo anterior.
		 */
		async function loadOrderDetail(
			orderId: string,
			feedback?: { message: string; tone: "ok" | "error" | "warn" },
		) {
			try {
				const { data, error } = await supabase!.rpc(
					"admin_get_order_detail",
					{ p_order_id: orderId },
				);

				if (error) {
					if (isForbiddenError(error)) {
						closeDrawer();
						await forceSignOutForbidden();
						return;
					}
					if (isNotFoundError(error)) {
						currentOrderId = null;
						currentOrderStatus = null;
						currentOrderDetail = null;
						drawerTitle.textContent = "Pedido no encontrado";
						drawerSubtitle.textContent = "";
						drawerChips.innerHTML = "";
						drawerBody.innerHTML =
							'<p class="admin-drawer__error">Este pedido ya no está disponible.</p>';
						return;
					}
					throw error;
				}

				const detail = data as OrderDetail;
				currentOrderId = orderId;
				currentOrderDetail = detail;
				currentOrderStatus = String(detail.order.order_status ?? "");
				pendingStatusConfirm = null;

				drawerTitle.textContent = detail.order.order_number;
				drawerSubtitle.textContent = formatDate(
					detail.order.created_at,
				);
				drawerChips.innerHTML = renderDrawerChips(detail.order);
				drawerBody.innerHTML = renderOrderDetail(detail);

				if (feedback) {
					setStatusFeedback(feedback.message, feedback.tone);
				}
			} catch {
				drawerTitle.textContent = "Error";
				drawerSubtitle.textContent = "";
				drawerChips.innerHTML = "";
				drawerBody.innerHTML =
					'<p class="admin-drawer__error">No se pudo cargar el detalle. Intenta de nuevo.</p>';
			}
		}

		async function openOrderDetail(orderId: string, trigger: HTMLElement) {
			drawerTitle.textContent = "Cargando pedido…";
			drawerSubtitle.textContent = "";
			drawerChips.innerHTML = "";
			drawerBody.innerHTML =
				'<p class="admin-drawer__loading">Cargando detalle…</p>';
			openDrawer(trigger);
			await loadOrderDetail(orderId);
		}

		// ---------- Cambio de estado ----------

		function syncStatusSubmitState() {
			const select = drawerBody.querySelector<HTMLSelectElement>(
				"[data-admin-status-select]",
			);
			const submit = drawerBody.querySelector<HTMLButtonElement>(
				"[data-admin-status-submit]",
			);
			if (!select || !submit) return;

			submit.disabled =
				isSavingStatus ||
				!currentOrderStatus ||
				select.value === currentOrderStatus;
		}

		function hideStatusConfirm() {
			pendingStatusConfirm = null;
			const box = drawerBody.querySelector<HTMLElement>(
				"[data-admin-status-confirm]",
			);
			if (box) box.hidden = true;
		}

		function confirmMessageFor(target: string): string | null {
			if (target === "cancelled") {
				return "¿Confirmas que deseas cancelar este pedido?";
			}
			if (
				currentOrderStatus === "delivered" ||
				currentOrderStatus === "cancelled"
			) {
				return `Este pedido ya figura como ${statusLabel(currentOrderStatus)}. Cambiarlo de nuevo es una corrección administrativa y quedará registrada en el historial. ¿Deseas continuar?`;
			}
			return null;
		}

		function requestStatusChange() {
			const select = drawerBody.querySelector<HTMLSelectElement>(
				"[data-admin-status-select]",
			);
			if (!select || !currentOrderId || !currentOrderStatus) return;

			const target = select.value;

			// El selector solo contiene claves de ORDER_STATUS_LABELS, pero
			// se revalida antes de mandar nada al servidor.
			if (!target || !(target in ORDER_STATUS_LABELS)) {
				setStatusFeedback("Selecciona un estado válido.", "error");
				return;
			}

			if (target === currentOrderStatus) return;

			const message = confirmMessageFor(target);

			if (message && pendingStatusConfirm !== target) {
				pendingStatusConfirm = target;
				const box = drawerBody.querySelector<HTMLElement>(
					"[data-admin-status-confirm]",
				);
				const text = drawerBody.querySelector<HTMLElement>(
					"[data-admin-status-confirm-text]",
				);
				if (box && text) {
					text.textContent = message;
					box.hidden = false;
					drawerBody
						.querySelector<HTMLButtonElement>(
							"[data-admin-status-confirm-yes]",
						)
						?.focus();
				}
				return;
			}

			hideStatusConfirm();
			void performStatusUpdate(target);
		}

		async function performStatusUpdate(target: string) {
			const orderId = currentOrderId;
			const expected = currentOrderStatus;
			if (!orderId || !expected) return;

			const submit = drawerBody.querySelector<HTMLButtonElement>(
				"[data-admin-status-submit]",
			);
			const noteEl = drawerBody.querySelector<HTMLTextAreaElement>(
				"[data-admin-status-note]",
			);
			const note = noteEl?.value.trim() ?? "";

			isSavingStatus = true;
			clearStatusFeedback();
			if (submit) {
				submit.disabled = true;
				submit.textContent = "Actualizando…";
			}

			try {
				const { error } = await supabase!.rpc(
					"admin_update_order_status",
					{
						p_order_id: orderId,
						p_expected_status: expected,
						p_new_status: target,
						p_note: note || null,
					},
				);

				if (error) {
					if (isForbiddenError(error)) {
						closeDrawer();
						await forceSignOutForbidden();
						return;
					}

					if (hasSignal(error, "ORDER_STATUS_CONFLICT")) {
						await loadOrderDetail(orderId, {
							message:
								"El pedido fue actualizado en otra sesión. Recargamos su estado actual.",
							tone: "warn",
						});
						return;
					}

					if (isNotFoundError(error)) {
						setStatusFeedback(
							"Este pedido ya no está disponible.",
							"error",
						);
						return;
					}

					if (hasSignal(error, "ORDER_STATUS_UNCHANGED")) {
						setStatusFeedback(
							"El pedido ya tiene ese estado.",
							"warn",
						);
						return;
					}

					if (hasSignal(error, "ORDER_STATUS_CANCELLED_FINAL")) {
						await loadOrderDetail(orderId, {
							message:
								"Este pedido ya fue cancelado y no puede cambiar de estado.",
							tone: "warn",
						});
						return;
					}

					// El segundo caso es el que devuelve Postgres si el valor
					// no pertenece al enum: se traduce igual, sin mostrar el
					// texto crudo del error.
					if (
						hasSignal(error, "INVALID_ORDER_STATUS") ||
						hasSignal(error, "invalid input value for enum")
					) {
						setStatusFeedback("Estado no válido.", "error");
						return;
					}

					// Sesion caducada: el listener de auth ya devuelve al
					// login; aqui solo se evita un mensaje enganoso.
					const { data: sessionData } =
						await supabase!.auth.getSession();
					if (!sessionData.session) {
						setStatusFeedback(
							"Tu sesión expiró. Vuelve a iniciar sesión.",
							"error",
						);
						return;
					}

					throw error;
				}

				// Exito: se recarga el detalle (estado, insignia e
				// historial salen del servidor, no de una suposicion
				// local) y se refrescan metricas y listado.
				await loadOrderDetail(orderId, {
					message: "Estado actualizado correctamente",
					tone: "ok",
				});
				viewLoadedAt.pedidos = 0;
				viewLoadedAt.resumen = 0;
				if (activeView === "pedidos") void loadPedidosView();
				else if (activeView === "resumen") void loadResumen();
			} catch {
				setStatusFeedback(
					"No se pudo actualizar el estado. Intenta de nuevo.",
					"error",
				);
			} finally {
				isSavingStatus = false;
				const currentSubmit =
					drawerBody.querySelector<HTMLButtonElement>(
						"[data-admin-status-submit]",
					);
				if (currentSubmit) {
					currentSubmit.textContent = "Actualizar estado";
				}
				syncStatusSubmitState();
			}
		}

		// ---------- Etiqueta del paquete ----------

		const LABEL_BODY_CLASS = "admin-label-open";

		function labelLines(): string[] {
			const detail = currentOrderDetail;
			if (!detail) return [];

			const o = detail.order;
			const items = detail.items ?? [];
			const lines: string[] = [];

			const push = (label: string, value: unknown) => {
				const text = String(value ?? "").trim();
				if (!text) return;
				lines.push(`${label}: ${text}`);
			};

			lines.push(`TAQTO — PEDIDO #${String(o.order_number ?? "").trim()}`);
			lines.push("");

			push("Fecha", formatDate(o.created_at));
			push(
				"Cliente",
				`${o.customer_first_name ?? ""} ${o.customer_last_name ?? ""}`.trim(),
			);
			push("Teléfono", o.customer_phone);
			push("Entrega", DELIVERY_METHOD_LABELS[o.delivery_method] ?? "");
			push("Distrito", o.delivery_district);
			push("Dirección", o.delivery_address);
			push("Referencia", o.delivery_reference);
			push("Agencia", o.agency_name);

			if (items.length) {
				lines.push("");
				lines.push("PRODUCTOS");

				items.forEach((item) => {
					const variant = [
						item.wood_name,
						item.size_name,
						item.dimensions_label,
					]
						.filter(Boolean)
						.join(" · ");

					lines.push(
						`• ${item.quantity} × ${String(item.product_name ?? "").trim()}${variant ? ` — ${variant}` : ""}`,
					);

					if (item.engraving_requested && item.engraving_text) {
						lines.push(`  Grabado: “${item.engraving_text}”`);
					} else if (item.engraving_requested) {
						lines.push("  Incluye grabado");
					}

					if (item.personalization_notes) {
						lines.push(`  Nota: ${item.personalization_notes}`);
					}
				});
			}

			if (o.customer_notes || o.internal_notes) {
				lines.push("");
				push("Nota del cliente", o.customer_notes);
				push("Nota interna", o.internal_notes);
			}

			lines.push("");
			push("Estado", statusLabel(o.order_status));

			return lines;
		}

		function renderLabelSheet(): string {
			const detail = currentOrderDetail;
			if (!detail) return "";

			const o = detail.order;
			const items = detail.items ?? [];

			const row = (label: string, value: unknown) => {
				const text = String(value ?? "").trim();
				if (!text) return "";
				return `<p class="admin-label__row"><span>${escapeHtml(label)}</span><strong>${escapeHtml(text)}</strong></p>`;
			};

			const itemsHtml = items
				.map((item) => {
					const variant = [
						item.wood_name,
						item.size_name,
						item.dimensions_label,
					]
						.filter(Boolean)
						.map(escapeHtml)
						.join(" · ");

					const engraving = item.engraving_requested
						? `<p class="admin-label__item-extra">${
								item.engraving_text
									? `Grabado: “${escapeHtml(item.engraving_text)}”`
									: "Incluye grabado"
							}</p>`
						: "";

					const notes = item.personalization_notes
						? `<p class="admin-label__item-extra">Nota: ${escapeHtml(item.personalization_notes)}</p>`
						: "";

					return `
						<li class="admin-label__item">
							<p class="admin-label__item-main">${escapeHtml(item.quantity)} × ${escapeHtml(item.product_name)}${variant ? ` — ${variant}` : ""}</p>
							${engraving}
							${notes}
						</li>
					`;
				})
				.join("");

			const notesHtml = [
				o.customer_notes
					? `<p class="admin-label__note">Nota del cliente: ${escapeHtml(o.customer_notes)}</p>`
					: "",
				o.internal_notes
					? `<p class="admin-label__note">Nota interna: ${escapeHtml(o.internal_notes)}</p>`
					: "",
			].join("");

			return `
				<div class="admin-label__head">
					<p class="admin-label__brand">TAQTO</p>
					<p class="admin-label__number">#${escapeHtml(o.order_number)}</p>
					<p class="admin-label__date">${escapeHtml(formatDate(o.created_at))}</p>
				</div>

				<p class="admin-label__status">
					<span class="admin-badge" data-status="${escapeHtml(o.order_status)}">${escapeHtml(statusLabel(o.order_status))}</span>
				</p>

				<div class="admin-label__block">
					${row("Cliente", `${o.customer_first_name ?? ""} ${o.customer_last_name ?? ""}`.trim())}
					${row("Teléfono", o.customer_phone)}
					${row("Entrega", DELIVERY_METHOD_LABELS[o.delivery_method] ?? "")}
					${row("Distrito", o.delivery_district)}
					${row("Dirección", o.delivery_address)}
					${row("Referencia", o.delivery_reference)}
					${row("Agencia", o.agency_name)}
				</div>

				<div class="admin-label__block">
					<p class="admin-label__block-title">Productos</p>
					<ul class="admin-label__items">${itemsHtml}</ul>
					${notesHtml}
				</div>
			`;
		}

		function setLabelFeedback(message: string) {
			window.clearTimeout(labelFeedbackTimer);
			labelFeedbackEl.textContent = message;
			labelFeedbackEl.hidden = false;
			labelFeedbackTimer = window.setTimeout(() => {
				labelFeedbackEl.hidden = true;
				labelFeedbackEl.textContent = "";
			}, 4000);
		}

		function labelFocusables(): HTMLElement[] {
			return Array.from(
				labelModal.querySelectorAll<HTMLElement>(
					'button:not([disabled]), [tabindex]:not([tabindex="-1"])',
				),
			).filter(
				(el) => el.offsetWidth + el.offsetHeight > 0,
			);
		}

		function openLabelModal(trigger: HTMLElement) {
			if (!currentOrderDetail) return;

			labelTrigger = trigger;
			labelSheet.innerHTML = renderLabelSheet();
			labelBackdrop.hidden = false;
			labelModal.hidden = false;
			document.body.classList.add(LABEL_BODY_CLASS);

			/*
			 * El drawer ya bloqueo el scroll y registro su propio manejador
			 * de teclado en `document` (capture). Este se registra en
			 * `window`, que en fase de captura corre ANTES, y detiene la
			 * propagacion de Escape/Tab: asi la etiqueta se cierra sola sin
			 * cerrar tambien el drawer que hay debajo.
			 */
			labelKeydownHandler = (event: KeyboardEvent) => {
				if (event.key === "Escape") {
					event.preventDefault();
					event.stopPropagation();
					closeLabelModal();
					return;
				}

				if (event.key !== "Tab") return;

				const focusables = labelFocusables();
				if (focusables.length === 0) return;

				const first = focusables[0];
				const last = focusables[focusables.length - 1];
				const current = document.activeElement;

				event.stopPropagation();

				if (
					event.shiftKey &&
					(current === first || !labelModal.contains(current))
				) {
					event.preventDefault();
					last.focus();
				} else if (!event.shiftKey && current === last) {
					event.preventDefault();
					first.focus();
				}
			};

			window.addEventListener("keydown", labelKeydownHandler, true);

			window.requestAnimationFrame(() => {
				labelFocusables()[0]?.focus();
			});
		}

		function closeLabelModal() {
			if (labelModal.hidden) return;

			if (labelKeydownHandler) {
				window.removeEventListener(
					"keydown",
					labelKeydownHandler,
					true,
				);
				labelKeydownHandler = null;
			}

			window.clearTimeout(labelFeedbackTimer);
			labelFeedbackEl.hidden = true;
			labelFeedbackEl.textContent = "";

			labelModal.hidden = true;
			labelBackdrop.hidden = true;
			document.body.classList.remove(LABEL_BODY_CLASS);
			// Se vacia siempre: ninguna etiqueta debe conservar datos del
			// pedido anterior.
			labelSheet.innerHTML = "";

			const trigger = labelTrigger;
			labelTrigger = null;
			trigger?.focus();
		}

		async function copyLabelText() {
			const text = labelLines().join("\n");
			if (!text) return;

			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(text);
				} else {
					// Fallback ligero para navegadores sin Clipboard API o
					// sin contexto seguro.
					const area = document.createElement("textarea");
					area.value = text;
					area.setAttribute("readonly", "");
					area.style.position = "fixed";
					area.style.opacity = "0";
					document.body.appendChild(area);
					area.select();
					document.execCommand("copy");
					area.remove();
				}
				setLabelFeedback("Texto de la etiqueta copiado");
			} catch {
				setLabelFeedback(
					"No se pudo copiar. Selecciona el texto manualmente.",
				);
			}
		}

		// Delegacion: el cuerpo del drawer se repinta entero en cada carga,
		// asi que los controles no pueden tener listeners propios (se
		// acumularian). Estos tres se registran una sola vez.
		drawerBody.addEventListener("click", (event) => {
			const target = event.target as HTMLElement | null;
			if (!target) return;

			if (target.closest("[data-admin-status-submit]")) {
				requestStatusChange();
				return;
			}

			if (target.closest("[data-admin-status-confirm-yes]")) {
				const pending = pendingStatusConfirm;
				hideStatusConfirm();
				if (pending) void performStatusUpdate(pending);
				return;
			}

			if (target.closest("[data-admin-status-confirm-no]")) {
				hideStatusConfirm();
				drawerBody
					.querySelector<HTMLButtonElement>(
						"[data-admin-status-submit]",
					)
					?.focus();
				return;
			}

			const labelButton = target.closest<HTMLElement>(
				"[data-admin-label-open]",
			);
			if (labelButton) {
				openLabelModal(labelButton);
			}
		});

		drawerBody.addEventListener("change", (event) => {
			const target = event.target as HTMLElement | null;
			if (target?.matches("[data-admin-status-select]")) {
				hideStatusConfirm();
				clearStatusFeedback();
				syncStatusSubmitState();
			}
		});

		labelCopyButton.addEventListener("click", () => {
			void copyLabelText();
		});

		labelPrintButton.addEventListener("click", () => {
			window.print();
		});

		labelCloseButtons.forEach((button) => {
			button.addEventListener("click", closeLabelModal);
		});

		labelBackdrop.addEventListener("click", closeLabelModal);

		drawerCloseButton.addEventListener("click", closeDrawer);
		drawerBackdrop.addEventListener("click", closeDrawer);

		filtersToggle.addEventListener("click", () => {
			const isOpen = filtersPanel.classList.toggle("is-open");
			filtersToggle.setAttribute(
				"aria-expanded",
				isOpen ? "true" : "false",
			);
		});

		function applyFiltersFromInputs() {
			filterInputs.forEach((input) => {
				const key = input.dataset.adminFilter as keyof OrderFilters;
				filters[key] = input.value.trim();
			});
			currentPage = 0;
			void loadOrders();
		}

		filterInputs.forEach((input) => {
			const key = input.dataset.adminFilter;

			if (key === "search") {
				input.addEventListener("input", () => {
					window.clearTimeout(searchDebounceTimer);
					searchDebounceTimer = window.setTimeout(() => {
						applyFiltersFromInputs();
					}, 300);
				});
			} else {
				input.addEventListener("change", applyFiltersFromInputs);
			}
		});

		filtersClearButton.addEventListener("click", () => {
			clearOrderFilters();
			syncOrderFilterInputs();
			void loadOrders();
		});

		prevButton.addEventListener("click", () => {
			if (currentPage === 0) return;
			currentPage -= 1;
			void loadOrders();
		});

		nextButton.addEventListener("click", () => {
			if ((currentPage + 1) * PAGE_SIZE >= totalCount) return;
			currentPage += 1;
			void loadOrders();
		});

		// =====================================================
		// ---------- Inventario ----------
		// =====================================================

		function clearInventoryFilters() {
			invFilters.search = "";
			invFilters.stock = "";
			invFilters.active = "";
			invCurrentPage = 0;
		}

		function syncInventoryFilterInputs() {
			invFilterInputs.forEach((input) => {
				const key = input.dataset.adminInvFilter as keyof InventoryFilters;
				input.value = invFilters[key] ?? "";
			});
		}

		function variantLabel(row: InventoryRow): string {
			return (
				[row.wood_title, row.size_title, row.dimensions_label]
					.filter(Boolean)
					.join(" · ") || "—"
			);
		}

		function renderInventoryRows(rows: InventoryRow[]) {
			if (rows.length === 0) {
				invTableBody.innerHTML = "";
				invEmptyEl.hidden = false;
				return;
			}

			invEmptyEl.hidden = true;

			invTableBody.innerHTML = rows
				.map((row) => {
					const stockStatusLabel =
						STOCK_STATUS_LABELS[row.stock_status] ?? row.stock_status;
					const priceHtml =
						row.sale_price !== null &&
						row.effective_price === row.sale_price
							? `<span class="admin-price-strike">${escapeHtml(formatMoney(row.price))}</span> ${escapeHtml(formatMoney(row.effective_price))}`
							: escapeHtml(formatMoney(row.effective_price));

					return `
						<tr>
							<td data-label="Producto">${escapeHtml(row.product_title)}</td>
							<td data-label="Variante">${escapeHtml(variantLabel(row))}</td>
							<td data-label="SKU">${escapeHtml(row.sku)}</td>
							<td data-label="Estado">
								<span class="admin-badge admin-badge--outline">${row.product_active ? "Activo" : "Inactivo"}</span>
							</td>
							<td data-label="Stock">${escapeHtml(row.stock_quantity)}</td>
							<td data-label="Precio">${priceHtml}</td>
							<td data-label="Estado de stock">
								<span class="admin-badge" data-stock-status="${escapeHtml(row.stock_status)}">${escapeHtml(stockStatusLabel)}</span>
							</td>
						</tr>
					`;
				})
				.join("");
		}

		function updateInventoryPagination() {
			const totalPages = Math.max(
				1,
				Math.ceil(invTotalCount / INVENTORY_PAGE_SIZE),
			);
			const page = invCurrentPage + 1;

			invPageInfoEl.textContent =
				invTotalCount === 0
					? "Sin resultados"
					: `Página ${page} de ${totalPages} · ${invTotalCount} variante(s)`;

			invPrevButton.disabled = invCurrentPage === 0;
			invNextButton.disabled =
				(invCurrentPage + 1) * INVENTORY_PAGE_SIZE >= invTotalCount;
		}

		async function loadInventory() {
			if (isLoadingInventory) return;
			isLoadingInventory = true;
			invTableWrap.setAttribute("aria-busy", "true");
			invErrorEl.hidden = true;

			try {
				const { data, error } = await supabase!.rpc(
					"admin_list_inventory",
					{
						p_search: invFilters.search || null,
						p_stock_filter: invFilters.stock || null,
						p_active_only:
							invFilters.active === ""
								? null
								: invFilters.active === "true",
						p_low_stock_threshold: LOW_STOCK_THRESHOLD,
						p_limit: INVENTORY_PAGE_SIZE,
						p_offset: invCurrentPage * INVENTORY_PAGE_SIZE,
					},
				);

				if (error) {
					if (isForbiddenError(error)) {
						await forceSignOutForbidden();
						return;
					}
					throw error;
				}

				const rows = (data ?? []) as InventoryRow[];
				invTotalCount = rows[0]?.total_count ?? 0;
				renderInventoryRows(rows);
				updateInventoryPagination();
			} catch {
				invTableBody.innerHTML = "";
				invErrorEl.textContent =
					"No se pudo cargar el inventario. Intenta de nuevo.";
				invErrorEl.hidden = false;
			} finally {
				isLoadingInventory = false;
				invTableWrap.removeAttribute("aria-busy");
			}
		}

		async function loadInventoryView() {
			await loadInventory();
			viewLoadedAt.inventario = Date.now();
		}

		function applyInventoryFiltersFromInputs() {
			invFilterInputs.forEach((input) => {
				const key = input.dataset.adminInvFilter as keyof InventoryFilters;
				invFilters[key] = input.value.trim();
			});
			invCurrentPage = 0;
			void loadInventory();
		}

		invFilterInputs.forEach((input) => {
			const key = input.dataset.adminInvFilter;

			if (key === "search") {
				input.addEventListener("input", () => {
					window.clearTimeout(invSearchDebounceTimer);
					invSearchDebounceTimer = window.setTimeout(() => {
						applyInventoryFiltersFromInputs();
					}, 300);
				});
			} else {
				input.addEventListener(
					"change",
					applyInventoryFiltersFromInputs,
				);
			}
		});

		invClearButton.addEventListener("click", () => {
			clearInventoryFilters();
			syncInventoryFilterInputs();
			void loadInventory();
		});

		invPrevButton.addEventListener("click", () => {
			if (invCurrentPage === 0) return;
			invCurrentPage -= 1;
			void loadInventory();
		});

		invNextButton.addEventListener("click", () => {
			if ((invCurrentPage + 1) * INVENTORY_PAGE_SIZE >= invTotalCount)
				return;
			invCurrentPage += 1;
			void loadInventory();
		});

		// =====================================================
		// ---------- Auth / ciclo de vida ----------
		// =====================================================

		refreshButton.addEventListener("click", () => {
			refreshIcon.classList.add("is-spinning");
			void ensureView(activeView, true).finally(() => {
				refreshIcon.classList.remove("is-spinning");
			});
		});

		logoutButton.addEventListener("click", async () => {
			stopAutoRefresh();
			await supabase!.auth.signOut();
		});

		forbiddenBackButton.addEventListener("click", () => {
			showOnly(loginView);
		});

		loginForm.addEventListener("submit", async (event) => {
			event.preventDefault();
			clearLoginError();
			setLoginLoading(true);

			const { error } = await supabase!.auth.signInWithPassword({
				email: loginEmailInput.value.trim(),
				password: loginPasswordInput.value,
			});

			if (error) {
				showLoginError(
					"Credenciales inválidas o error al iniciar sesión.",
				);
				setLoginLoading(false);
				return;
			}

			// onAuthStateChange se encarga del resto (verificar
			// is_admin() y mostrar el panel o el aviso de "no
			// autorizado"). No se limpia setLoginLoading aqui a
			// proposito: handleAuthenticated lo hace al terminar, para
			// que el boton siga bloqueado mientras se verifica.
			loginPasswordInput.value = "";
		});

		async function handleAuthenticated(session: Session) {
			setLoginLoading(true);

			try {
				const authorized = await loadMetrics();
				if (!authorized) return;

				updateWelcome(session);
				showOnly(shellView);
				resetFiltersKeepingSession();
				handleHashChange();
				startAutoRefresh();
			} finally {
				setLoginLoading(false);
			}
		}

		function resetFiltersKeepingSession() {
			currentPage = 0;
			clearOrderFilters();
			syncOrderFilterInputs();
			invCurrentPage = 0;
			clearInventoryFilters();
			syncInventoryFilterInputs();
		}

		window.addEventListener("hashchange", handleHashChange);

		const { data: authListener } = supabase.auth.onAuthStateChange(
			(event: AuthChangeEvent, session: Session | null) => {
				if (event === "SIGNED_OUT" || !session) {
					stopAutoRefresh();
					resetDashboardState();
					clearLoginError();
					setLoginLoading(false);
					showOnly(loginView);
					return;
				}

				if (event === "SIGNED_IN") {
					void handleAuthenticated(session);
				}

				// TOKEN_REFRESHED / USER_UPDATED / INITIAL_SESSION con
				// sesion ya vigente: no hay que re-disparar el flujo
				// completo (perderia pagina/filtros actuales).
			},
		);

		authSubscription = authListener.subscription;

		void supabase.auth.getSession().then(({ data }) => {
			if (data.session) {
				void handleAuthenticated(data.session);
			} else {
				showOnly(loginView);
			}
		});

		(root as any)._adminDispose = () => {
			stopAutoRefresh();
			authSubscription?.unsubscribe();
			authSubscription = null;
			window.removeEventListener("hashchange", handleHashChange);
			// Cierra la etiqueta si quedo abierta: quita su listener de
			// teclado en window, la clase de impresion del body y el
			// temporizador del aviso de copiado.
			closeLabelModal();
			window.clearTimeout(labelFeedbackTimer);
			document.body.classList.remove(LABEL_BODY_CLASS);
			closeOverlay(DRAWER_OVERLAY_ID);
			closeOverlay(SIDEBAR_OVERLAY_ID);
			root.dataset.adminReady = "false";
		};
	};

	initAdminDashboard();
	document.addEventListener("astro:page-load", initAdminDashboard);

	document.addEventListener("astro:before-swap", () => {
		const root = document.querySelector<HTMLElement>(
			"[data-admin-orders]",
		);
		(root as any)?._adminDispose?.();
	});
</script>

