	function isForbiddenError(error: { message?: string } | null): boolean {
		return !!error?.message && error.message.includes("ADMIN_FORBIDDEN");
	}

	function isNotFoundError(error: { message?: string } | null): boolean {
		return !!error?.message && error.message.includes("ORDER_NOT_FOUND");
	}

	function hasSignal(
		error: { message?: string } | null,
		signal: string,
	): boolean {
		return !!error?.message && error.message.includes(signal);
	}

