---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import InfoCard from "../components/InfoCard.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import {
	Droplets,
	Wind,
	Sun,
	CircleOff,
	Ban,
	Flame,
	Archive,
	Brush,
	CircleQuestionMark,
	RefreshCw,
} from "@lucide/astro";

const base = import.meta.env.BASE_URL;
const productos = `${base}categorias/`;
const garantia = `${base}garantia/`;

const wa = "https://wa.me/51977600400";

const esenciales = [
	{
		icon: Droplets,
		title: "Lava a mano",
		text: "Cuando el producto sea apto para lavado, límpialo manualmente y evita métodos agresivos.",
	},
	{
		icon: Wind,
		title: "Seca inmediatamente",
		text: "Retira el exceso de humedad después de la limpieza y permite que la pieza termine de secarse correctamente.",
	},
	{
		icon: CircleOff,
		title: "Evita el remojo",
		text: "No dejes los productos de madera sumergidos ni en contacto prolongado con agua.",
	},
	{
		icon: Sun,
		title: "Protégelos del calor",
		text: "No expongas las piezas durante periodos prolongados al sol directo ni a fuentes intensas de calor.",
	},
];

const antesDeUsar = [
	"Retira cuidadosamente el embalaje.",
	"Revisa la pieza completa.",
	"Identifica si es apta para contacto con alimentos.",
	"Consulta las indicaciones específicas de su ficha.",
	"Limpia únicamente cuando el tipo de producto lo requiera.",
	"No apliques aceites, ceras, limpiadores ni tratamientos sin confirmar su compatibilidad con el acabado.",
];

const rutinaTabla = [
	{
		title: "Retira los residuos",
		text: "Elimina restos de alimentos sin utilizar objetos que dañen innecesariamente la superficie.",
	},
	{
		title: "Lava a mano",
		text: "Cuando corresponda, limpia la tabla manualmente con agua, una esponja suave y una pequeña cantidad de limpiador neutro (sujeto a la validación del acabado).",
	},
	{
		title: "Evita el remojo",
		text: "No dejes la tabla dentro del lavadero, sumergida en agua ni bajo un flujo constante durante periodos prolongados.",
	},
	{
		title: "Seca inmediatamente",
		text: "Retira la humedad con un paño limpio después del lavado.",
	},
	{
		title: "Permite que termine de secarse",
		text: "Coloca la tabla en una posición que permita la circulación de aire por sus diferentes caras.",
	},
];

const secado = [
	"Retira el exceso de agua con un paño.",
	"Deja que ambas caras reciban ventilación.",
	"No seques la pieza bajo sol directo.",
	"No la coloques junto a hornos, cocinas o fuentes intensas de calor.",
	"No utilices secadores de cabello ni aire caliente.",
	"Guárdala únicamente cuando se encuentre seca.",
];

const mesa = [
	"Retira derrames tan pronto como sea posible.",
	"Utiliza un paño suave.",
	"Evita productos abrasivos.",
	"No dejes vasos o recipientes húmedos durante periodos innecesariamente largos.",
	"No sumerjas el producto, salvo que su ficha indique expresamente que puede lavarse.",
	"Seca la pieza después de limpiarla.",
	"Evita guardar productos húmedos uno encima de otro.",
];

const oficina = [
	"Retira el polvo con un paño suave y seco.",
	"Para marcas superficiales, utiliza un paño ligeramente humedecido.",
	"Seca la superficie inmediatamente.",
	"Evita pulverizar limpiadores directamente sobre la madera.",
	"No utilices alcohol, lejía ni productos abrasivos sin confirmar su compatibilidad.",
	"Evita apoyar recipientes húmedos sobre la pieza.",
	"Mantén el producto alejado de ventanas con sol directo prolongado.",
	"No lo coloques junto a equipos que emitan calor excesivo.",
];

const cuero = [
	"Retira el polvo con un paño suave y seco.",
	"Si necesitas limpiar una marca, utiliza un paño apenas humedecido.",
	"No sumerjas el cuero.",
	"Evita frotar con fuerza.",
	"No utilices alcohol, lejía ni limpiadores domésticos agresivos.",
	"No lo expongas durante periodos prolongados al sol directo.",
	"Mantén el producto alejado de fuentes intensas de calor.",
	"Deja que seque de manera natural si entra en contacto con humedad.",
	"No apliques cremas, aceites o acondicionadores sin confirmar que sean adecuados para el tipo de cuero y acabado.",
];

const mixtos = [
	"Utiliza paños distintos para cada material.",
	"No arrastres humedad desde la madera hacia el cuero.",
	"No apliques productos para madera sobre el cuero.",
	"No utilices acondicionadores de cuero sobre las superficies de madera.",
	"Consulta a TAQTO antes de aplicar cualquier tratamiento de mantenimiento.",
];

const evitar = [
	{
		icon: CircleOff,
		title: "Lavavajillas",
		text: "El calor, los detergentes y la humedad prolongada pueden afectar la madera, las uniones y el acabado.",
	},
	{
		icon: Droplets,
		title: "Remojo prolongado",
		text: "Mantener una pieza sumergida puede producir cambios en su forma, superficie o estabilidad.",
	},
	{
		icon: Sun,
		title: "Sol directo",
		text: "La exposición continua puede modificar el tono, resecar el material y afectar el acabado.",
	},
	{
		icon: Flame,
		title: "Fuentes intensas de calor",
		text: "Hornos, cocinas, parrillas calientes, radiadores y otros equipos pueden generar cambios bruscos en la madera o el cuero.",
	},
	{
		icon: Brush,
		title: "Productos abrasivos",
		text: "Las esponjas metálicas, polvos limpiadores y químicos agresivos pueden rayar o alterar la superficie.",
	},
	{
		icon: Archive,
		title: "Guardado con humedad",
		text: "Almacenar una pieza antes de que termine de secarse puede afectar su conservación.",
	},
	{
		icon: Ban,
		title: "Usos distintos a su función",
		text: "Golpes, sobrecarga o utilización para tareas no previstas pueden causar daños que no corresponden al comportamiento normal del producto.",
	},
];

const tratamientoDepende = [
	"La especie de madera.",
	"El acabado aplicado.",
	"El uso del producto.",
	"El contacto o no con alimentos.",
	"El estado actual de la superficie.",
];

const envejecimiento = [
	"Cambios graduales de tono.",
	"Marcas superficiales de uso.",
	"Mayor contraste en ciertas vetas.",
	"Variaciones de textura.",
	"Pátina en el cuero.",
	"Pequeñas diferencias entre zonas de una misma pieza.",
];

const consultar = [
	"Una alteración que afecta la funcionalidad.",
	"Una separación o falla que parece provenir de la fabricación.",
	"Un cambio significativo que apareció sin exposición inadecuada.",
	"Una incidencia relacionada con el acabado o la estructura.",
	"Una duda sobre si el producto puede continuar utilizándose.",
];

const faqs = [
	{
		q: "¿Puedo colocar una tabla TAQTO en el lavavajillas?",
		a: "No. Las piezas de madera no deben colocarse en el lavavajillas. El calor, la humedad y los detergentes pueden afectar el material y el acabado.",
	},
	{
		q: "¿Puedo dejar una tabla en remojo?",
		a: "No. Evita dejarla sumergida o en contacto prolongado con agua.",
	},
	{
		q: "¿Cómo debo secar una tabla de madera?",
		a: "Retira inmediatamente el exceso de humedad con un paño y deja que termine de secarse en una posición que permita la circulación de aire.",
	},
	{
		q: "¿Puedo secarla bajo el sol?",
		a: "No es recomendable. El sol directo y el calor intenso pueden alterar el tono, el acabado o la estabilidad de la madera.",
	},
	{
		q: "¿Todos los productos TAQTO pueden lavarse?",
		a: "No. La forma de limpieza depende de la función, el material y el acabado. Los productos de oficina y algunas piezas de mesa pueden requerir únicamente un paño suave.",
	},
	{
		q: "¿Puedo utilizar alcohol para limpiar la madera?",
		a: "No recomendamos aplicar alcohol ni otros productos químicos sin confirmar previamente su compatibilidad con el acabado.",
	},
	{
		q: "¿Puedo utilizar aceite de cocina en una tabla?",
		a: "No recomendamos aplicar aceites de cocina. Antes de utilizar un tratamiento, consulta qué producto es compatible con la pieza y su acabado.",
	},
	{
		q: "¿Cuándo debo realizar mantenimiento?",
		a: "Cuando la superficie presente cambios de apariencia o resequedad, consulta con TAQTO antes de aplicar aceites, ceras o productos de renovación.",
	},
	{
		q: "¿Las marcas de cuchillo son normales?",
		a: "En tablas utilizadas para cortar alimentos pueden aparecer marcas superficiales como consecuencia del uso. Su intensidad dependerá de la frecuencia, los utensilios y la manera de utilizar la pieza.",
	},
	{
		q: "¿La madera puede cambiar de color?",
		a: "Sí. La madera puede desarrollar cambios graduales de tono por el uso, la luz y el paso del tiempo.",
	},
	{
		q: "¿Cómo limpio un organizador de escritorio?",
		a: "Retira el polvo con un paño seco. Para una marca superficial, utiliza un paño ligeramente humedecido y seca inmediatamente.",
	},
	{
		q: "¿Cómo limpio una pieza de cuero?",
		a: "Utiliza un paño suave y evita empapar el material. No apliques limpiadores, aceites o acondicionadores sin comprobar su compatibilidad.",
	},
	{
		q: "¿Qué hago si mi producto se deformó?",
		a: "Deja de exponerlo al agua o al calor y comunícate con TAQTO. Envíanos fotografías y una descripción del uso para orientarte.",
	},
	{
		q: "¿El daño por lavavajillas está cubierto por la garantía?",
		a: "La garantía comercial no cubre daños causados por exposición inadecuada, incluyendo el uso de lavavajillas.",
	},
	{
		q: "¿Dónde encuentro los cuidados específicos de mi producto?",
		a: "Revisa la ficha correspondiente o comunícate con TAQTO indicando el nombre del producto.",
	},
];
---

<PageLayout
	title="Cómo cuidar productos de madera | TAQTO"
	description="Aprende a limpiar, secar, guardar y conservar correctamente tus productos TAQTO de madera y cuero. Evita el lavavajillas, el remojo y el sol directo."
>
	<PageHero
		eyebrow="Uso y mantenimiento"
		title="Cuidados para tus productos TAQTO"
		lede="La madera y el cuero son materiales naturales que cambian con el uso y el paso del tiempo."
		split="7-5"
	>
		<p class="lede measure-lede" style="margin-top:14px">
			Con una limpieza adecuada, un secado inmediato y una buena forma
			de guardarlos, tus productos pueden conservar mejor su
			funcionalidad, acabado y apariencia.
		</p>

		<div class="actions">
			<a href="#resumen" class="btn btn--primary">
				Ver cuidados esenciales
			</a>

			<a
				href={wa}
				target="_blank"
				rel="noopener noreferrer"
				class="sp-btn sp-btn--ghost"
			>
				Consultar sobre mi producto
			</a>
		</div>

		<p class="note">
			Los cuidados pueden variar según el material, el acabado y la
			función de cada pieza.
		</p>

		<div slot="aside">
			<p class="facts-caption">La regla que nunca cambia</p>

			<div class="card card--avoid">
				<span class="card__icon">
					<CircleOff
						aria-hidden="true"
						size={20}
						stroke-width={1.75}
					/>
				</span>

				<p class="card__title">
					Nunca coloques una pieza de madera TAQTO en el lavavajillas.
				</p>

				<div class="card__body">
					<p>
						El calor, la humedad y los detergentes pueden afectar
						el material y el acabado.
					</p>
				</div>
			</div>
		</div>
	</PageHero>

	<!-- Resumen: cuatro cuidados de 3 columnas -->
	<section class="sect sect--tint" id="resumen">
		<div class="wrap">
			<div class="sect__head">
				<h2>Cuatro cuidados que hacen la diferencia</h2>

				<p class="lede measure-lede">
					Si solo recuerdas cuatro cosas, que sean estas.
				</p>
			</div>

			<ul class="cards" style="--cols:4">
				{
					esenciales.map((item) => (
						<li>
							<InfoCard
								icon={item.icon}
								title={item.title}
								variant="do"
								compactTitle
							>
								<p>{item.text}</p>
							</InfoCard>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Por qué importa: relato 7 + cita 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<h2>Un material natural responde a su entorno</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							La madera puede absorber y liberar humedad. También
							puede reaccionar frente al calor, el sol directo,
							los cambios de temperatura y una limpieza
							inadecuada.
						</p>

						<p>
							El cuero, por su parte, puede cambiar de tono,
							adquirir marcas y desarrollar una apariencia propia
							con el uso.
						</p>

						<p>
							Estas transformaciones no siempre representan un
							defecto. Muchas forman parte del comportamiento
							natural del material.
						</p>

						<p>
							El cuidado adecuado ayuda a reducir cambios
							bruscos, conservar el acabado y prolongar la vida
							útil del producto.
						</p>
					</div>
				</div>

				<div class="c5">
					<p class="pull">
						Cuidar una pieza no significa mantenerla intacta para
						siempre. Significa permitir que envejezca de manera
						adecuada.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Primer contacto: encabezado 5 + lista 7 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5 flow" style="--flow:15px">
					<p class="eyebrow">Primer contacto</p>

					<h2>Revisa tu producto antes de utilizarlo</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Cuando recibas una pieza TAQTO, observa sus
							características y revisa las indicaciones
							correspondientes al producto.
						</p>

						<p>
							La veta, el tono y algunos detalles naturales
							pueden variar respecto de las fotografías de
							referencia. Estas diferencias forman parte de la
							madera o el cuero utilizados.
						</p>
					</div>
				</div>

				<div class="c7 flow" style="--flow:16px">
					<p class="strong-line">Antes de usarla:</p>

					<ul class="list list--cols">
						{antesDeUsar.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Rutina de limpieza en pasos -->
	<section class="sect">
		<div class="wrap">
			<div class="sect__head">
				<p class="eyebrow">Limpieza cotidiana</p>

				<h2>Cómo cuidar una tabla de madera</h2>

				<p class="lede measure-lede">
					Las tablas destinadas a parrilla, cocina o servicio de
					alimentos deben limpiarse después de cada uso, evitando que
					permanezcan húmedas durante periodos prolongados.
				</p>
			</div>

			<ProcessSteps steps={rutinaTabla} cols={3} />

			<p class="pull" style="margin-top:clamp(28px,3vw,40px)">
				Lavar rápido y secar bien es más seguro para la madera que
				dejarla sumergida.
			</p>
		</div>
	</section>

	<!-- Secado: relato 6 + lista 6 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c6 flow" style="--flow:15px">
					<h2>El secado también forma parte de la limpieza</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Después del lavado, no dejes la pieza completamente
							apoyada sobre una superficie mientras continúa
							húmeda.
						</p>

						<p>
							La circulación de aire ayuda a que la humedad no
							permanezca concentrada en una sola cara.
						</p>
					</div>

					<p class="pull">
						El calor intenso no acelera un secado adecuado: puede
						afectar la estabilidad y el acabado de la madera.
					</p>
				</div>

				<div class="c6">
					<ul class="list">
						{secado.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Cuidados por tipo de pieza: cuatro bloques de 6 columnas -->
	<section class="sect sect--tint">
		<div class="wrap">
			<div class="g12">
				<section class="c6 flow" style="--flow:15px">
					<p class="eyebrow">Uso cotidiano</p>

					<h2>Bandejas, posavasos y productos de mesa</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Las bandejas, posavasos, posatazas y piezas de
							servicio pueden requerir una limpieza diferente
							según su función y acabado.
						</p>

						<p>
							Cuando exista contacto con líquidos o alimentos,
							limpia la superficie sin dejar humedad acumulada.
						</p>
					</div>

					<ul class="list">
						{mesa.map((item) => <li>{item}</li>)}
					</ul>

					<p class="note measure-tight">
						Cuando la pieza no necesite lavado, puede ser
						suficiente retirar el polvo y limpiar su superficie con
						un paño suave ligeramente humedecido.
					</p>
				</section>

				<section class="c6 flow" style="--flow:15px">
					<p class="eyebrow">Madera en espacios interiores</p>

					<h2>Cómo cuidar organizadores y soportes</h2>

					<p class="measure-tight">
						Los organizadores, soportes para celular, bases para
						laptop y accesorios de escritorio no deben lavarse como
						una tabla de cocina.
					</p>

					<ul class="list">
						{oficina.map((item) => <li>{item}</li>)}
					</ul>

					<p class="note measure-tight">
						En productos con ranuras o cavidades, retira el polvo
						con un paño, brocha suave o aire manual controlado. No
						viertas agua dentro de los compartimentos.
					</p>
				</section>

				<section class="c6 flow" style="--flow:15px">
					<p class="eyebrow">Cuidado del cuero</p>

					<h2>Permite que el material envejezca correctamente</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							El cuero es un material natural que puede
							desarrollar cambios de tono, marcas y una pátina
							propia con el uso.
						</p>

						<p>
							Estas transformaciones forman parte de su
							evolución, siempre que no sean resultado de humedad
							excesiva, productos agresivos o una exposición
							inadecuada.
						</p>
					</div>

					<ul class="list">
						{cuero.map((item) => <li>{item}</li>)}
					</ul>

					<p class="pull">
						El cuero no permanece visualmente idéntico: adquiere
						carácter a medida que acompaña el uso.
					</p>
				</section>

				<section class="c6 flow" style="--flow:15px">
					<p class="eyebrow">Piezas combinadas</p>

					<h2>Productos que combinan madera y cuero</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Cuando un producto combina madera y cuero, la
							limpieza debe respetar las necesidades de ambos
							materiales.
						</p>

						<p>
							Evita sumergir la pieza o aplicar agua de manera
							abundante. Limpia cada zona por separado y seca
							inmediatamente cualquier humedad.
						</p>
					</div>

					<ul class="list">
						{mixtos.map((item) => <li>{item}</li>)}
					</ul>
				</section>
			</div>
		</div>
	</section>

	<!-- Qué evitar -->
	<section class="sect">
		<div class="wrap">
			<div class="sect__head">
				<p class="eyebrow">Protege tu pieza</p>

				<h2>Prácticas que pueden afectar el material</h2>
			</div>

			<ul class="cards" style="--cols:4">
				{
					evitar.map((item) => (
						<li>
							<InfoCard
								icon={item.icon}
								title={item.title}
								variant="avoid"
								compactTitle
							>
								<p>{item.text}</p>
							</InfoCard>
						</li>
					))
				}
			</ul>

			<p class="pull" style="margin-top:clamp(28px,3vw,40px)">
				La mayoría de los daños evitables ocurre por exceso de agua,
				calor intenso o métodos de limpieza inadecuados.
			</p>
		</div>
	</section>

	<!-- Mantenimiento: relato 6 + lista 6 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c6 flow" style="--flow:15px">
					<p class="eyebrow">Cuidado a largo plazo</p>

					<h2>¿Cuándo necesita mantenimiento una pieza?</h2>

					<p class="measure-tight">
						Con el tiempo, algunas superficies pueden verse más
						secas, opacas o diferentes respecto de su apariencia
						inicial. Esto no significa que cualquier aceite o cera
						sea adecuado.
					</p>
				</div>

				<div class="c6 flow" style="--flow:16px">
					<div class="card">
						<span class="card__icon">
							<RefreshCw
								aria-hidden="true"
								size={20}
								stroke-width={1.75}
							/>
						</span>

						<h3 class="card__title card__title--sm">
							El tratamiento correcto depende de:
						</h3>

						<ul class="list">
							{tratamientoDepende.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<p class="measure-tight">
						Antes de aplicar un producto de mantenimiento, consulta
						con TAQTO e indica el nombre de la pieza y, cuando sea
						posible, envía fotografías claras.
					</p>

					<div class="actions">
						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="sp-btn sp-btn--ghost"
						>
							Consultar mantenimiento
						</a>
					</div>

					<p class="note">
						No apliques aceites de cocina, barnices domésticos ni
						productos no identificados.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Cambios naturales: relato 7 + lista 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<h2>La apariencia también evoluciona</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							La veta y el tono pueden cambiar gradualmente con el
							uso, la luz y el paso del tiempo.
						</p>

						<p>
							Las tablas de cocina o parrilla también pueden
							desarrollar marcas superficiales relacionadas con el
							corte y la preparación de alimentos. En el cuero
							pueden aparecer cambios de tono, pliegues y marcas
							propias del contacto cotidiano.
						</p>

						<p class="pull">
							Una pieza natural no permanece inmóvil: conserva la
							historia de cómo fue utilizada.
						</p>
					</div>
				</div>

				<div class="c5 flow" style="--flow:16px">
					<p class="strong-line">
						Pueden formar parte del envejecimiento natural:
					</p>

					<ul class="list">
						{envejecimiento.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Cuidado o garantía -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5 flow" style="--flow:15px">
					<h2>¿Cuidado o garantía?</h2>

					<p class="lede measure-tight">
						Algunos cambios corresponden al uso normal del producto.
						Otros pueden requerir una evaluación.
					</p>
				</div>

				<div class="c7 flow" style="--flow:20px">
					<p class="strong-line">Consulta a TAQTO cuando identifiques:</p>

					<ul class="list list--cols">
						{consultar.map((item) => <li>{item}</li>)}
					</ul>

					<div class="actions">
						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn--primary"
						>
							Solicitar evaluación
						</a>

						<a href={garantia} class="sp-btn sp-btn--ghost">
							Ver condiciones de garantía
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Preguntas frecuentes -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c4 flow" style="--flow:14px">
					<span class="card__icon">
						<CircleQuestionMark
							aria-hidden="true"
							size={20}
							stroke-width={1.75}
						/>
					</span>

					<h2>Preguntas frecuentes sobre cuidados</h2>
				</div>

				<div class="c8">
					<div class="faq">
						{
							faqs.map((item) => (
								<details>
									<summary>{item.q}</summary>

									<div class="faq__answer">
										<p>{item.a}</p>
									</div>
								</details>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA final -->
	<section class="sect sect--last">
		<div class="wrap">
			<div class="page-cta page-cta--split">
				<div class="page-cta__text">
					<p class="eyebrow">Cuida la historia de tu pieza</p>

					<h2>
						Un cuidado sencillo puede acompañarla durante más tiempo
					</h2>

					<p class="measure">
						Limpia según su función, evita el exceso de agua y
						protege el material del sol y el calor intenso. Cuando
						tengas dudas sobre el lavado, el acabado o el
						mantenimiento, consulta antes de aplicar un
						tratamiento.
					</p>

					<p class="note">
						Indícanos el nombre del producto y envíanos una
						fotografía para orientarte con mayor precisión.
					</p>
				</div>

				<div class="actions">
					<a
						href={wa}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn--primary"
					>
						Consultar cuidados por WhatsApp
					</a>

					<a href={productos} class="sp-btn sp-btn--ghost">
						Explorar productos TAQTO
					</a>
				</div>
			</div>
		</div>
	</section>
</PageLayout>
