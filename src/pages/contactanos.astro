---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import { buildFaqJsonLd } from "../lib/seo";
import InfoCard from "../components/InfoCard.astro";
import {
	MessageCircle,
	Mail,
	MapPin,
	Package,
	PenLine,
	Truck,
	Building2,
	ShieldCheck,
	CircleQuestionMark,
	ArrowRight,
} from "@lucide/astro";

const base = import.meta.env.BASE_URL;
const productos = `${base}categorias/`;
const envios = `${base}envios/`;

const wa = "https://wa.me/51977600400";
const mail = "mailto:ventas@taqto.com.pe";
const ig = "https://www.instagram.com/taqto.pe/";
const fb = "https://www.facebook.com/taqto.pe";
const tt = "https://www.tiktok.com/@taqto.pe";

/*
 * TAQTO no tiene formulario con backend: los canales reales son
 * WhatsApp, correo y redes. Por eso la página presenta canales
 * accionables y no simula un envío.
 */
const canales = [
	{
		icon: MessageCircle,
		label: "WhatsApp",
		value: "+51 977 600 400",
		hint: "El canal más directo.",
	},
	{
		icon: Mail,
		label: "Correo comercial",
		value: "ventas@taqto.com.pe",
		hint: "Para cotizaciones y empresas.",
	},
	{
		icon: MapPin,
		label: "Taller",
		value: "San Juan de Miraflores",
		hint: "Lima, Perú. Sin atención presencial.",
	},
];

const redes = [
	{
		href: ig,
		icon: "contacto-instagram.svg",
		title: "Instagram · @taqto.pe",
		text: "Descubre nuestras piezas, personalizaciones, materiales, procesos y formas de integrar TAQTO en la parrilla, la mesa, el hogar y la oficina.",
		cta: "Ver Instagram",
	},
	{
		href: fb,
		icon: "contacto-facebook.svg",
		title: "Facebook · TAQTO Perú",
		text: "Encuentra novedades, productos, publicaciones de la marca e información para comunicarte con TAQTO Perú.",
		cta: "Ver Facebook",
	},
	{
		href: tt,
		icon: "contacto-tiktok.svg",
		title: "TikTok · @taqto.pe",
		text: "Conoce el proceso detrás de las piezas, detalles de fabricación, personalizaciones y contenido de uso cotidiano.",
		cta: "Ver TikTok",
	},
];

const ubicacion = [
	{
		label: "Ubicación general:",
		text: "San Juan de Miraflores, Lima, Perú.",
	},
	{
		label: "Modalidad de atención:",
		text: "WhatsApp, correo electrónico y redes sociales.",
	},
	{
		label: "Tienda física:",
		text: "actualmente no contamos con una tienda física abierta al público.",
	},
	{
		label: "Atención presencial:",
		text: "no ofrecemos atención presencial permanente.",
	},
];

const motivos = [
	{
		icon: Package,
		title: "Consulta sobre un producto",
		text: "Para conocer medidas, materiales, acabados, disponibilidad, cuidados o variantes de una pieza.",
	},
	{
		icon: PenLine,
		title: "Personalización",
		text: "Para consultar la aplicación de un nombre, frase, imagen o logo mediante grabado láser.",
	},
	{
		icon: Truck,
		title: "Envíos",
		text: "Para conocer el costo y la modalidad de entrega en Lima Metropolitana o provincias.",
	},
	{
		icon: Building2,
		title: "Empresas y pedidos por volumen",
		text: "Para regalos corporativos, productos para restaurantes, hoteles, cafeterías o pedidos desde 12 unidades.",
	},
	{
		icon: ShieldCheck,
		title: "Garantía o incidencia",
		text: "Para solicitar la evaluación de una posible falla o informar una incidencia relacionada con el producto o la entrega.",
	},
];

const faqs = [
	{
		q: "¿Cuál es el WhatsApp de TAQTO?",
		a: "Puedes comunicarte con TAQTO al +51 977 600 400.",
	},
	{
		q: "¿Cuál es el correo de TAQTO?",
		a: "El correo comercial es ventas@taqto.com.pe.",
	},
	{
		q: "¿Cuáles son las redes sociales oficiales de TAQTO?",
		a: "Puedes encontrarnos en Instagram y TikTok como @taqto.pe, y en Facebook como TAQTO Perú.",
	},
	{
		q: "¿TAQTO tiene una tienda física?",
		a: "Actualmente no contamos con una tienda física abierta al público. Funcionamos como taller de diseño y producción.",
	},
	{
		q: "¿Dónde se encuentra el taller?",
		a: "Nuestro taller se encuentra en San Juan de Miraflores, Lima. La ubicación exacta no se publica como un punto de atención comercial abierto.",
	},
	{
		q: "¿Puedo visitar el taller?",
		a: "Actualmente no ofrecemos atención presencial permanente. Las consultas y coordinaciones se realizan mediante WhatsApp, correo o redes sociales.",
	},
	{
		q: "¿Puedo recoger un pedido en el taller?",
		a: "La disponibilidad de recojo debe consultarse previamente por WhatsApp. No debe asumirse que el taller funciona como un punto de recojo permanente.",
	},
	{
		q: "¿Puedo consultar precios por WhatsApp?",
		a: "Sí. Envíanos el nombre, enlace o captura del producto para revisar sus características y condiciones.",
	},
	{
		q: "¿Qué canal debo utilizar para una cotización empresarial?",
		a: "Para cotizaciones con información detallada puedes escribir a ventas@taqto.com.pe. También puedes iniciar la consulta por WhatsApp.",
	},
	{
		q: "¿Atienden pedidos personalizados?",
		a: "Sí. Puedes consultar la viabilidad de personalizar una pieza con un nombre, frase, imagen o logo mediante grabado láser.",
	},
	{
		q: "¿Realizan envíos a provincias?",
		a: "Sí. Los envíos a provincias se coordinan mediante la agencia elegida por el cliente.",
	},
	{
		q: "¿Dónde puedo reportar una incidencia?",
		a: "Puedes escribir al WhatsApp +51 977 600 400 indicando el producto, la fecha de entrega, una descripción del caso y fotografías claras.",
	},
];

const faqJsonLd = buildFaqJsonLd(faqs);
const contactPageJsonLd = faqJsonLd ? [faqJsonLd] : [];
---

<PageLayout
	title="Contáctanos | WhatsApp y redes de TAQTO Perú"
	description="Contacta a TAQTO Perú por WhatsApp, correo o redes sociales. Consulta productos, personalizaciones, envíos y pedidos empresariales desde nuestro taller en Lima."
	jsonLd={contactPageJsonLd}
>
	<PageHero
		eyebrow="Contáctanos"
		title="Conversemos sobre tu próxima pieza"
		lede="¿Tienes una consulta sobre un producto, una personalización o un envío?"
		split="7-5"
	>
		<p class="lede measure-lede" style="margin-top:14px">
			Escríbenos y cuéntanos qué necesitas. Te ayudaremos a revisar las
			opciones disponibles, las características de la pieza y las
			condiciones de tu pedido.
		</p>

		<div class="actions">
			<a
				href={wa}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn--primary"
			>
				Escribir por WhatsApp
			</a>

			<a href={mail} class="sp-btn sp-btn--ghost">Enviar un correo</a>
		</div>

		<p class="note">
			Atención digital desde nuestro taller en San Juan de Miraflores,
			Lima.
		</p>

		<div slot="aside">
			<p class="facts-caption">Canales oficiales</p>

			<ul class="facts">
				{
					canales.map((item) => {
						const Icon = item.icon;

						return (
							<li>
								<Icon
									class="facts__icon"
									aria-hidden="true"
									size={20}
									stroke-width={1.75}
								/>

								<div>
									<p class="facts__label">{item.label}</p>
									<p class="facts__value">{item.value}</p>
									<p class="facts__hint">{item.hint}</p>
								</div>
							</li>
						);
					})
				}
			</ul>
		</div>
	</PageHero>

	<!-- Canales: dos directos + tres redes -->
	<section class="sect">
		<div class="wrap">
			<div class="sect__head">
				<h2>Elige cómo deseas comunicarte</h2>
			</div>

			<ul class="cards channels" style="--cols:2">
				<li>
					<InfoCard icon={MessageCircle} title="WhatsApp">
						<p>
							El canal más directo para consultar productos,
							medidas, personalizaciones, disponibilidad, envíos
							e incidencias.
						</p>

						<p class="strong-line">+51 977 600 400</p>

						<div class="actions">
							<a
								href={wa}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn--primary"
							>
								Conversar por WhatsApp
							</a>
						</div>

						<p class="note">
							Envíanos el nombre, enlace o captura del producto
							para ayudarte con mayor precisión.
						</p>
					</InfoCard>
				</li>

				<li>
					<InfoCard icon={Mail} title="Correo comercial">
						<p>
							Utiliza el correo para solicitudes empresariales,
							cotizaciones por volumen, propuestas comerciales o
							consultas que requieran enviar información más
							detallada.
						</p>

						<p class="strong-line">ventas@taqto.com.pe</p>

						<div class="actions">
							<a href={mail} class="sp-btn sp-btn--ghost">
								Enviar correo
							</a>
						</div>

						<p class="note">
							Incluye el producto, la cantidad aproximada, la
							ciudad de entrega y la fecha requerida.
						</p>
					</InfoCard>
				</li>
			</ul>

			<ul
				class="cards"
				style="--cols:3;margin-top:clamp(14px,1.5vw,20px)"
			>
				{
					redes.map((red) => (
						<li>
							<a
								class="card card--link"
								href={red.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="card__icon">
									<img
										src={`${base}icons/${red.icon}`}
										alt=""
										width="20"
										height="20"
										loading="lazy"
										decoding="async"
									/>
								</span>

								<h3 class="card__title card__title--sm">
									{red.title}
								</h3>

								<div class="card__body">
									<p>{red.text}</p>
								</div>

								<span class="card__cta">
									{red.cta}
									<ArrowRight
										aria-hidden="true"
										size={15}
										stroke-width={1.75}
									/>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Cómo trabajamos: relato 7 + aclaración 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<p class="eyebrow">Cómo trabajamos</p>

					<h2>Un taller de diseño y producción</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							TAQTO funciona como un taller donde diseñamos,
							fabricamos, personalizamos y preparamos piezas de
							madera y cuero.
						</p>

						<p>
							Nuestro espacio está organizado para trabajar cada
							producto y pedido, por lo que actualmente no
							contamos con una tienda física abierta al público
							ni con atención presencial permanente.
						</p>

						<p>
							Puedes conocer nuestras piezas a través de la web y
							nuestras redes sociales. Para consultas, pedidos y
							coordinaciones, puedes escribirnos directamente por
							WhatsApp o correo.
						</p>
					</div>

					<div class="actions">
						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="sp-btn sp-btn--ghost"
						>
							Consultar un producto
						</a>

						<a href={productos} class="sp-btn sp-btn--ghost">
							Explorar productos
						</a>
					</div>
				</div>

				<div class="c5">
					<p class="pull">
						Somos un taller de producción, no una tienda física. La
						atención y coordinación de pedidos se realiza mediante
						nuestros canales digitales.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Ubicación: relato 6 + datos 6 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c6 flow" style="--flow:15px">
					<p class="eyebrow">Desde Lima</p>

					<h2>
						Nuestro taller se encuentra en San Juan de Miraflores
					</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Diseñamos y preparamos nuestras piezas desde un
							taller ubicado en San Juan de Miraflores, Lima.
						</p>

						<p>
							Desde aquí coordinamos pedidos para Lima
							Metropolitana y envíos a provincias mediante la
							modalidad acordada con cada cliente.
						</p>

						<p>
							Debido a que se trata de un espacio de producción y
							no de una tienda abierta al público, no publicamos
							la dirección exacta como un punto de atención
							comercial.
						</p>
					</div>
				</div>

				<div class="c6 flow" style="--flow:18px">
					<div class="card">
						<span class="card__icon">
							<MapPin
								aria-hidden="true"
								size={20}
								stroke-width={1.75}
							/>
						</span>

						<ul class="list">
							{
								ubicacion.map((item) => (
									<li>
										<strong class="strong-line">
											{item.label}
										</strong>{" "}
										{item.text}
									</li>
								))
							}
						</ul>
					</div>

					<div class="actions">
						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="sp-btn sp-btn--ghost"
						>
							Consultar modalidad de entrega
						</a>

						<a href={envios} class="sp-btn sp-btn--ghost">
							Ver información de envíos
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Motivos de consulta -->
	<section class="sect sect--tint">
		<div class="wrap">
			<div class="sect__head">
				<h2>Elige el motivo de tu consulta</h2>

				<p class="lede measure-lede">
					Cuéntanos desde el inicio qué necesitas y te respondemos con
					la información correcta.
				</p>
			</div>

			<ul class="cards" style="--cols:3">
				{
					motivos.map((item) => (
						<li>
							<InfoCard
								icon={item.icon}
								title={item.title}
								compactTitle
							>
								<p>{item.text}</p>
							</InfoCard>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Empresas: relato 7 + acción 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<p class="eyebrow">Empresas</p>

					<h2>Regalos corporativos y pedidos por volumen</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							Desarrollamos piezas personalizadas para empresas,
							restaurantes, hoteles, cafeterías y otros espacios
							profesionales.
						</p>

						<p>
							Podemos ayudarte a revisar el producto, la
							cantidad, las medidas, la personalización, el
							empaque y las condiciones comerciales del pedido.
						</p>

						<p>
							En pedidos corporativos trabajamos mediante
							co-branding: la identidad del cliente convive con
							el sello TAQTO.
						</p>
					</div>
				</div>

				<div class="c5 flow" style="--flow:16px">
					<div class="actions">
						<a href={mail} class="btn btn--primary">
							Escribir a ventas@taqto.com.pe
						</a>

						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="sp-btn sp-btn--ghost"
						>
							Cotizar por WhatsApp
						</a>
					</div>

					<p class="note">
						Para cotizaciones detalladas, recomendamos utilizar el
						correo comercial.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Preguntas frecuentes -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c4 flow" style="--flow:14px">
					<span class="card__icon">
						<CircleQuestionMark
							aria-hidden="true"
							size={20}
							stroke-width={1.75}
						/>
					</span>

					<h2>Preguntas frecuentes de contacto</h2>
				</div>

				<div class="c8">
					<div class="faq">
						{
							faqs.map((item) => (
								<details>
									<summary>{item.q}</summary>

									<div class="faq__answer">
										<p>{item.a}</p>
									</div>
								</details>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA final -->
	<section class="sect sect--last">
		<div class="wrap">
			<div class="page-cta page-cta--split">
				<div class="page-cta__text">
					<p class="eyebrow">Hablemos de tu pedido</p>

					<h2>Cuéntanos qué pieza estás buscando</h2>

					<p class="measure">
						Envíanos el producto que te interesa, la cantidad y tu
						ciudad o distrito. Te ayudaremos a revisar las opciones
						disponibles, la personalización y las condiciones de
						entrega.
					</p>

					<p class="note">
						También estamos en{" "}
						<a
							href={ig}
							target="_blank"
							rel="noopener noreferrer">Instagram</a
						>,{" "}
						<a
							href={fb}
							target="_blank"
							rel="noopener noreferrer">Facebook</a
						>{" "}
						y{" "}
						<a
							href={tt}
							target="_blank"
							rel="noopener noreferrer">TikTok</a
						>.
					</p>
				</div>

				<div class="actions">
					<a
						href={wa}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn--primary"
					>
						Escribir al +51 977 600 400
					</a>

					<a href={mail} class="sp-btn sp-btn--ghost">
						Enviar correo a ventas
					</a>
				</div>
			</div>
		</div>
	</section>
</PageLayout>

<style>
	/* Los dos canales directos ocupan más aire que las redes */
	.channels :global(.card) {
		padding: clamp(24px, 2.4vw, 32px);
	}

	.channels :global(.card__body) {
		max-inline-size: 44ch;
	}
</style>
