---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductCard from "../../components/ProductCard.astro";

import { sanityClient } from "../../lib/sanity";
import { catalogQuery } from "../../lib/catalogQuery";
import { getProductPriceRange, formatPEN } from "../../lib/productPricing";
import { buildBreadcrumbJsonLd } from "../../lib/seo";
import { SlidersHorizontal, X } from "@lucide/astro";

interface WoodRef {
	title?: string;
	slug?: string;
}

interface SizeRef {
	title?: string;
	slug?: string;
	dimensionsLabel?: string;
}

interface VariantSource {
	price?: number;
	salePrice?: number;
	active?: boolean;
	wood?: WoodRef;
	size?: SizeRef;
}

interface Product {
	_id: string;
	_createdAt: string;
	title: string;
	slug: string;
	productMode?: string;
	featured?: boolean;
	saleStart?: string;
	saleEnd?: string;
	engravingIncluded?: boolean;
	category?: { title: string; slug: string };
	subcategory?: { title: string; slug: string };
	uniqueProduct?: VariantSource;
	variants?: VariantSource[];
	[key: string]: unknown;
}

const base = import.meta.env.BASE_URL;

const products = await sanityClient.fetch<Product[]>(catalogQuery);

function collectWoodsAndSizes(product: Product) {
	const woods = new Set<string>();
	const sizes = new Set<string>();

	if (product.productMode === "unique") {
		if (product.uniqueProduct?.wood?.title) {
			woods.add(product.uniqueProduct.wood.title);
		}

		if (product.uniqueProduct?.size?.title) {
			sizes.add(product.uniqueProduct.size.title);
		}
	} else {
		(product.variants || [])
			.filter((variant) => variant.active !== false)
			.forEach((variant) => {
				if (variant.wood?.title) woods.add(variant.wood.title);
				if (variant.size?.title) sizes.add(variant.size.title);
			});
	}

	return {
		woods: Array.from(woods),
		sizes: Array.from(sizes),
	};
}

// Indice compacto usado por el filtro en cliente. El mismo orden que el
// grid renderizado abajo, para poder emparejar por posicion sin repetir
// descripciones ni imagenes en el JSON.
const catalogEntries = products.map((product) => {
	const priceRange = getProductPriceRange(product);
	const { woods, sizes } = collectWoodsAndSizes(product);

	return {
		id: product._id,
		category: product.category?.slug || "",
		categoryTitle: product.category?.title || "",
		woods,
		sizes,
		priceMin: priceRange.minimum,
		personalizable: Boolean(product.engravingIncluded),
		featured: Boolean(product.featured),
		createdAt: product._createdAt,
	};
});

const totalCount = catalogEntries.length;

// --- Categoria ---
const categoryOptions = Array.from(
	new Map(
		catalogEntries
			.filter((entry) => entry.category)
			.map((entry) => [entry.category, entry.categoryTitle]),
	).entries(),
)
	.map(([slug, title]) => ({ slug, title }))
	.sort((a, b) => a.title.localeCompare(b.title, "es"));

// --- Madera ---
const woodOptions = Array.from(
	new Set(catalogEntries.flatMap((entry) => entry.woods)),
).sort((a, b) => a.localeCompare(b, "es"));

// --- Tamaño ---
const sizeOptions = Array.from(
	new Set(catalogEntries.flatMap((entry) => entry.sizes)),
).sort((a, b) => a.localeCompare(b, "es"));

// --- Personalización ---
// Solo tiene sentido como filtro si el catalogo mezcla productos con y
// sin grabado incluido; si todos comparten el mismo valor, el filtro no
// aportaria nada.
const personalizableCount = catalogEntries.filter(
	(entry) => entry.personalizable,
).length;

const showPersonalizationFilter =
	personalizableCount > 0 && personalizableCount < totalCount;

// --- Precio ---
// Rangos calculados a partir de los precios reales del catalogo (tercios),
// en vez de valores arbitrarios o un slider fragil.
const sortedPrices = catalogEntries
	.map((entry) => entry.priceMin)
	.filter((price) => price > 0)
	.sort((a, b) => a - b);

function quantile(values: number[], q: number): number {
	if (values.length === 0) return 0;
	const position = (values.length - 1) * q;
	const lower = Math.floor(position);
	const upper = Math.ceil(position);
	if (lower === upper) return values[lower];
	return (
		values[lower] + (values[upper] - values[lower]) * (position - lower)
	);
}

const roundToTen = (value: number) => Math.max(10, Math.round(value / 10) * 10);

const distinctPrices = Array.from(new Set(sortedPrices));

interface PriceBucket {
	id: string;
	label: string;
	min?: number;
	max?: number;
}

let priceBuckets: PriceBucket[] = [];

if (distinctPrices.length >= 3) {
	const q1 = roundToTen(quantile(sortedPrices, 0.33));
	const q2 = roundToTen(quantile(sortedPrices, 0.66));

	if (q1 < q2) {
		priceBuckets = [
			{ id: "p1", label: `Hasta ${formatPEN(q1)}`, max: q1 },
			{
				id: "p2",
				label: `${formatPEN(q1)} – ${formatPEN(q2)}`,
				min: q1,
				max: q2,
			},
			{ id: "p3", label: `Desde ${formatPEN(q2)}`, min: q2 },
		];
	}
} else if (distinctPrices.length === 2) {
	const mid = roundToTen((distinctPrices[0] + distinctPrices[1]) / 2);

	priceBuckets = [
		{ id: "p1", label: `Hasta ${formatPEN(mid)}`, max: mid },
		{ id: "p2", label: `Desde ${formatPEN(mid)}`, min: mid },
	];
}

const filterData = {
	entries: catalogEntries.map((entry) => ({
		id: entry.id,
		category: entry.category,
		woods: entry.woods,
		sizes: entry.sizes,
		priceMin: entry.priceMin,
		personalizable: entry.personalizable,
		featured: entry.featured,
		createdAt: entry.createdAt,
	})),
	priceBuckets,
};

const pageTitle = "Productos de madera para cocina, parrilla y hogar | TAQTO";
const pageDescription =
	"Explora tablas y productos de madera para cocinar, servir, compartir, organizar y regalar. Revisa medidas, maderas disponibles y opciones de personalización.";

const storeUrl = Astro.site
	? new URL(`${base}tienda/`, Astro.site).toString()
	: undefined;

const storeBreadcrumbJsonLd = buildBreadcrumbJsonLd(
	[
		{ label: "Inicio", href: base },
		{ label: "Tienda" },
	],
	Astro.site,
	storeUrl,
);

const storeJsonLd = storeBreadcrumbJsonLd ? [storeBreadcrumbJsonLd] : [];
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	jsonLd={storeJsonLd}
>
	<Header />

	<main class="store-page">
		<Breadcrumbs
			items={[
				{ label: "Inicio", href: base },
				{ label: "Tienda" },
			]}
		/>

		<div class="store-header">
			<p class="section-label">Catálogo completo</p>
			<h1>Todas las piezas TAQTO</h1>
		</div>

		<button
			type="button"
			class="filters-trigger"
			data-filters-open
			aria-haspopup="dialog"
			aria-controls="catalog-filters"
			aria-expanded="false"
		>
			<SlidersHorizontal aria-hidden="true" stroke-width={1.75} />

			<span>Filtros</span>

			<span
				class="filters-trigger__badge"
				data-active-filter-count
				hidden
			>0</span>
		</button>

		<div class="store-layout">
			<div
				class="filters-backdrop"
				data-filters-backdrop
			></div>

			<aside
				class="catalog-filters"
				id="catalog-filters"
				data-catalog-filters
				aria-label="Filtrar piezas"
			>
				<div class="catalog-filters__scroll">
					<div class="catalog-filters__header">
						<div>
							<p class="catalog-filters__eyebrow">
								Filtrar piezas
							</p>

							<p class="catalog-filters__count">
								<span data-filter-result-count>
									{totalCount}
								</span>
								{" "}resultados
							</p>
						</div>

						<button
							type="button"
							class="catalog-filters__close"
							data-filters-close
							aria-label="Cerrar filtros"
						>
							<X aria-hidden="true" stroke-width={1.75} />
						</button>
					</div>

					<div
						class="catalog-filters__active"
						data-filter-chips
						hidden
					></div>

					<button
						type="button"
						class="catalog-filters__clear"
						data-filter-clear
					>
						Limpiar filtros
					</button>

					{
						priceBuckets.length > 0 && (
							<div class="catalog-filters__section">
								<p class="catalog-filters__section-title">
									<span>01</span> Precio
								</p>

								<div class="catalog-filters__options">
									{priceBuckets.map((bucket) => (
										<label class="catalog-filters__option">
											<input
												type="checkbox"
												name="precio"
												value={bucket.id}
												data-filter-input="price"
											/>
											<span>{bucket.label}</span>
										</label>
									))}
								</div>
							</div>
						)
					}

					{
						categoryOptions.length > 0 && (
							<div class="catalog-filters__section">
								<p class="catalog-filters__section-title">
									<span>
										{priceBuckets.length > 0 ? "02" : "01"}
									</span>{" "}
									Categoría
								</p>

								<div class="catalog-filters__options">
									{categoryOptions.map((category) => (
										<label class="catalog-filters__option">
											<input
												type="checkbox"
												name="categoria"
												value={category.slug}
												data-filter-input="category"
											/>
											<span>{category.title}</span>
										</label>
									))}
								</div>
							</div>
						)
					}

					{
						woodOptions.length > 0 && (
							<div class="catalog-filters__section">
								<p class="catalog-filters__section-title">
									<span>
										{
											[
												priceBuckets.length > 0,
												categoryOptions.length > 0,
											].filter(Boolean).length + 1
										}
									</span>{" "}
									Madera
								</p>

								<div class="catalog-filters__options">
									{woodOptions.map((wood) => (
										<label class="catalog-filters__option">
											<input
												type="checkbox"
												name="madera"
												value={wood}
												data-filter-input="wood"
											/>
											<span>{wood}</span>
										</label>
									))}
								</div>
							</div>
						)
					}

					{
						sizeOptions.length > 0 && (
							<div class="catalog-filters__section">
								<p class="catalog-filters__section-title">
									<span>
										{
											[
												priceBuckets.length > 0,
												categoryOptions.length > 0,
												woodOptions.length > 0,
											].filter(Boolean).length + 1
										}
									</span>{" "}
									Tamaño
								</p>

								<div class="catalog-filters__options">
									{sizeOptions.map((size) => (
										<label class="catalog-filters__option">
											<input
												type="checkbox"
												name="tamano"
												value={size}
												data-filter-input="size"
											/>
											<span>{size}</span>
										</label>
									))}
								</div>
							</div>
						)
					}

					{
						showPersonalizationFilter && (
							<div class="catalog-filters__section">
								<p class="catalog-filters__section-title">
									<span>
										{
											[
												priceBuckets.length > 0,
												categoryOptions.length > 0,
												woodOptions.length > 0,
												sizeOptions.length > 0,
											].filter(Boolean).length + 1
										}
									</span>{" "}
									Personalización
								</p>

								<div class="catalog-filters__options">
									<label class="catalog-filters__option">
										<input
											type="checkbox"
											name="personalizado"
											value="1"
											data-filter-input="personalizable"
										/>
										<span>Con grabado incluido</span>
									</label>
								</div>
							</div>
						)
					}
				</div>

				<div class="catalog-filters__footer">
					<button
						type="button"
						class="catalog-filters__apply"
						data-filters-apply
					>
						Ver <span data-filter-result-count-apply>
							{totalCount}
						</span> piezas
					</button>
				</div>
			</aside>

			<section class="store-results">
				<div class="store-results__toolbar">
					<p class="store-results__count">
						<strong data-visible-count>{totalCount}</strong>
						{" "}
						{totalCount === 1 ? "pieza" : "piezas"}
					</p>

					<label class="store-results__sort">
						<span>Ordenar por</span>

						<select data-catalog-sort>
							<option value="featured">Destacados</option>
							<option value="price-asc">
								Precio: menor a mayor
							</option>
							<option value="price-desc">
								Precio: mayor a menor
							</option>
							<option value="newest">Más recientes</option>
						</select>
					</label>
				</div>

				<div
					class="product-grid"
					data-catalog-grid
				>
					{
						products.map((product, index) => (
							<div
								class="catalog-grid__item"
								data-catalog-item
								data-catalog-index={index}
							>
								<ProductCard
									product={product}
									hoverGallery
								/>
							</div>
						))
					}
				</div>

				<div class="catalog-empty" data-catalog-empty hidden>
					<h3>Sin resultados</h3>
					<p>
						Ningún producto coincide con los filtros
						seleccionados.
					</p>

					<button type="button" data-filter-clear>
						Limpiar filtros
					</button>
				</div>
			</section>
		</div>
	</main>
</BaseLayout>

<script
	type="application/json"
	id="catalog-filter-data"
	set:html={JSON.stringify(filterData)}
/>

<script>
	import { openOverlay, closeOverlay } from "../../lib/overlay";

	interface CatalogEntry {
		id: string;
		category: string;
		woods: string[];
		sizes: string[];
		priceMin: number;
		personalizable: boolean;
		featured: boolean;
		createdAt: string;
	}

	interface PriceBucket {
		id: string;
		label: string;
		min?: number;
		max?: number;
	}

	interface FilterData {
		entries: CatalogEntry[];
		priceBuckets: PriceBucket[];
	}

	const dataNode = document.getElementById("catalog-filter-data");

	if (dataNode?.textContent) {
		const data: FilterData = JSON.parse(dataNode.textContent);

		const grid = document.querySelector<HTMLElement>(
			"[data-catalog-grid]",
		);

		const items = Array.from(
			document.querySelectorAll<HTMLElement>("[data-catalog-item]"),
		);

		const emptyState = document.querySelector<HTMLElement>(
			"[data-catalog-empty]",
		);

		const filtersPanel = document.querySelector<HTMLElement>(
			"[data-catalog-filters]",
		);

		const filtersBackdrop = document.querySelector<HTMLElement>(
			"[data-filters-backdrop]",
		);

		const filtersOpenButton = document.querySelector<HTMLButtonElement>(
			"[data-filters-open]",
		);

		const activeFilterBadge = document.querySelector<HTMLElement>(
			"[data-active-filter-count]",
		);

		const chipsContainer = document.querySelector<HTMLElement>(
			"[data-filter-chips]",
		);

		const sortSelect = document.querySelector<HTMLSelectElement>(
			"[data-catalog-sort]",
		);

		const filterInputs = Array.from(
			document.querySelectorAll<HTMLInputElement>(
				"[data-filter-input]",
			),
		);

		const priceBucketById = new Map(
			data.priceBuckets.map((bucket) => [bucket.id, bucket]),
		);

		const entryById = new Map(
			data.entries.map((entry) => [entry.id, entry]),
		);

		if (grid && items.length === data.entries.length) {
			type FilterState = {
				price: Set<string>;
				category: Set<string>;
				wood: Set<string>;
				size: Set<string>;
				personalizable: boolean;
				sort: string;
			};

			const params = new URLSearchParams(window.location.search);

			const readList = (key: string) => {
				const value = params.get(key);
				return value
					? new Set(value.split(",").filter(Boolean))
					: new Set<string>();
			};

			const state: FilterState = {
				price: readList("precio"),
				category: readList("categoria"),
				wood: readList("madera"),
				size: readList("tamano"),
				personalizable: params.get("personalizado") === "1",
				sort: params.get("orden") || "featured",
			};

			filterInputs.forEach((input) => {
				const type = input.dataset.filterInput;

				if (type === "price") {
					input.checked = state.price.has(input.value);
				} else if (type === "category") {
					input.checked = state.category.has(input.value);
				} else if (type === "wood") {
					input.checked = state.wood.has(input.value);
				} else if (type === "size") {
					input.checked = state.size.has(input.value);
				} else if (type === "personalizable") {
					input.checked = state.personalizable;
				}
			});

			if (sortSelect) sortSelect.value = state.sort;

			const matchesPrice = (entry: CatalogEntry) => {
				if (state.price.size === 0) return true;

				for (const bucketId of state.price) {
					const bucket = priceBucketById.get(bucketId);
					if (!bucket) continue;

					const aboveMin =
						bucket.min === undefined || entry.priceMin > bucket.min;
					const belowMax =
						bucket.max === undefined || entry.priceMin <= bucket.max;

					if (aboveMin && belowMax) return true;
				}

				return false;
			};

			const matchesEntry = (entry: CatalogEntry) => {
				if (
					state.category.size > 0 &&
					!state.category.has(entry.category)
				) {
					return false;
				}

				if (
					state.wood.size > 0 &&
					!entry.woods.some((wood) => state.wood.has(wood))
				) {
					return false;
				}

				if (
					state.size.size > 0 &&
					!entry.sizes.some((size) => state.size.has(size))
				) {
					return false;
				}

				if (state.personalizable && !entry.personalizable) {
					return false;
				}

				if (!matchesPrice(entry)) return false;

				return true;
			};

			const sortItems = () => {
				const withEntries = items
					.map((item) => {
						const id = item.dataset.catalogIndex;
						const entry = id ? data.entries[Number(id)] : undefined;
						return { item, entry };
					})
					.filter(
						(value): value is {
							item: HTMLElement;
							entry: CatalogEntry;
						} => Boolean(value.entry),
					);

				const compare: Record<
					string,
					(a: CatalogEntry, b: CatalogEntry) => number
				> = {
					featured: (a, b) => Number(b.featured) - Number(a.featured),
					"price-asc": (a, b) => a.priceMin - b.priceMin,
					"price-desc": (a, b) => b.priceMin - a.priceMin,
					newest: (a, b) =>
						new Date(b.createdAt).getTime() -
						new Date(a.createdAt).getTime(),
				};

				const comparator = compare[state.sort] || compare.featured;

				withEntries.sort((a, b) => comparator(a.entry, b.entry));

				withEntries.forEach(({ item }) => {
					grid.appendChild(item);
				});
			};

			const chipLabel = (
				type: string,
				value: string,
			): string => {
				if (type === "price") {
					return priceBucketById.get(value)?.label || value;
				}

				if (type === "category") {
					const input = filterInputs.find(
						(candidate) =>
							candidate.dataset.filterInput === "category" &&
							candidate.value === value,
					);

					return (
						input
							?.closest(".catalog-filters__option")
							?.querySelector("span")?.textContent || value
					);
				}

				return value;
			};

			const renderChips = () => {
				if (!chipsContainer) return;

				const chips: { type: string; value: string }[] = [];

				state.price.forEach((value) =>
					chips.push({ type: "price", value }),
				);
				state.category.forEach((value) =>
					chips.push({ type: "category", value }),
				);
				state.wood.forEach((value) =>
					chips.push({ type: "wood", value }),
				);
				state.size.forEach((value) =>
					chips.push({ type: "size", value }),
				);

				if (state.personalizable) {
					chips.push({ type: "personalizable", value: "1" });
				}

				chipsContainer.innerHTML = "";
				chipsContainer.hidden = chips.length === 0;

				chips.forEach(({ type, value }) => {
					const chip = document.createElement("button");
					chip.type = "button";
					chip.className = "catalog-chip";

					chip.textContent =
						type === "personalizable"
							? "Con grabado incluido"
							: chipLabel(type, value);

					const remove = document.createElement("span");
					remove.setAttribute("aria-hidden", "true");
					remove.textContent = " ×";
					chip.appendChild(remove);

					chip.addEventListener("click", () => {
						if (type === "price") state.price.delete(value);
						else if (type === "category")
							state.category.delete(value);
						else if (type === "wood") state.wood.delete(value);
						else if (type === "size") state.size.delete(value);
						else if (type === "personalizable")
							state.personalizable = false;

						syncInputsFromState();
						apply();
					});

					chipsContainer.appendChild(chip);
				});
			};

			const syncInputsFromState = () => {
				filterInputs.forEach((input) => {
					const type = input.dataset.filterInput;

					if (type === "price") {
						input.checked = state.price.has(input.value);
					} else if (type === "category") {
						input.checked = state.category.has(input.value);
					} else if (type === "wood") {
						input.checked = state.wood.has(input.value);
					} else if (type === "size") {
						input.checked = state.size.has(input.value);
					} else if (type === "personalizable") {
						input.checked = state.personalizable;
					}
				});
			};

			const updateUrl = () => {
				const next = new URLSearchParams();

				if (state.price.size) {
					next.set("precio", Array.from(state.price).join(","));
				}
				if (state.category.size) {
					next.set(
						"categoria",
						Array.from(state.category).join(","),
					);
				}
				if (state.wood.size) {
					next.set("madera", Array.from(state.wood).join(","));
				}
				if (state.size.size) {
					next.set("tamano", Array.from(state.size).join(","));
				}
				if (state.personalizable) {
					next.set("personalizado", "1");
				}
				if (state.sort !== "featured") {
					next.set("orden", state.sort);
				}

				const query = next.toString();
				const newUrl =
					window.location.pathname + (query ? `?${query}` : "");

				window.history.replaceState(null, "", newUrl);
			};

			const activeFilterCount = () =>
				state.price.size +
				state.category.size +
				state.wood.size +
				state.size.size +
				(state.personalizable ? 1 : 0);

			const apply = () => {
				let visibleCount = 0;

				items.forEach((item) => {
					const index = Number(item.dataset.catalogIndex);
					const entry = data.entries[index];
					const visible = entry ? matchesEntry(entry) : true;

					item.hidden = !visible;
					if (visible) visibleCount += 1;
				});

				sortItems();

				document
					.querySelectorAll<HTMLElement>(
						"[data-filter-result-count], [data-filter-result-count-apply]",
					)
					.forEach((node) => {
						node.textContent = String(visibleCount);
					});

				const visibleCountLabel = document.querySelector<HTMLElement>(
					"[data-visible-count]",
				);
				if (visibleCountLabel) {
					visibleCountLabel.textContent = String(visibleCount);
				}

				if (emptyState) emptyState.hidden = visibleCount !== 0;
				if (grid) grid.hidden = visibleCount === 0;

				const count = activeFilterCount();

				if (activeFilterBadge) {
					activeFilterBadge.textContent = String(count);
					activeFilterBadge.hidden = count === 0;
				}

				renderChips();
				updateUrl();
			};

			filterInputs.forEach((input) => {
				input.addEventListener("change", () => {
					const type = input.dataset.filterInput;

					if (type === "price") {
						input.checked
							? state.price.add(input.value)
							: state.price.delete(input.value);
					} else if (type === "category") {
						input.checked
							? state.category.add(input.value)
							: state.category.delete(input.value);
					} else if (type === "wood") {
						input.checked
							? state.wood.add(input.value)
							: state.wood.delete(input.value);
					} else if (type === "size") {
						input.checked
							? state.size.add(input.value)
							: state.size.delete(input.value);
					} else if (type === "personalizable") {
						state.personalizable = input.checked;
					}

					apply();
				});
			});

			sortSelect?.addEventListener("change", () => {
				state.sort = sortSelect.value;
				apply();
			});

			document
				.querySelectorAll<HTMLButtonElement>("[data-filter-clear]")
				.forEach((button) => {
					button.addEventListener("click", () => {
						state.price.clear();
						state.category.clear();
						state.wood.clear();
						state.size.clear();
						state.personalizable = false;
						state.sort = "featured";

						syncInputsFromState();
						if (sortSelect) sortSelect.value = "featured";

						apply();
					});
				});

			apply();
		}

		// --- Drawer móvil ---
		if (filtersPanel && filtersOpenButton) {
			const closeButtons = document.querySelectorAll<HTMLElement>(
				"[data-filters-close], [data-filters-apply]",
			);

			const DRAWER_OVERLAY_ID = "catalog-filters";

			/*
			 * Bloqueo de scroll, focus trap, Escape y devolucion del
			 * foco al boton que abrio el drawer los resuelve overlay.ts
			 * (la misma pieza que usan el minicarrito y el buscador), en
			 * vez de reimplementarlos aqui. Tambien garantiza que este
			 * drawer nunca coexista abierto con otro overlay modal.
			 */
			const closeDrawer = () => {
				filtersPanel.classList.remove("is-open");
				filtersBackdrop?.classList.remove("is-open");
				filtersPanel.removeAttribute("role");
				filtersPanel.removeAttribute("aria-modal");
				filtersOpenButton.setAttribute("aria-expanded", "false");

				closeOverlay(DRAWER_OVERLAY_ID);
			};

			const openDrawer = () => {
				filtersPanel.classList.add("is-open");
				filtersBackdrop?.classList.add("is-open");
				filtersPanel.setAttribute("role", "dialog");
				filtersPanel.setAttribute("aria-modal", "true");
				filtersOpenButton.setAttribute("aria-expanded", "true");

				openOverlay({
					id: DRAWER_OVERLAY_ID,
					container: filtersPanel,
					trigger: filtersOpenButton,
					close: closeDrawer,
				});
			};

			filtersOpenButton.addEventListener("click", openDrawer);
			filtersBackdrop?.addEventListener("click", closeDrawer);

			closeButtons.forEach((button) => {
				button.addEventListener("click", closeDrawer);
			});
		}
	}
</script>

