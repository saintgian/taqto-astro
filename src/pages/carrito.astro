	.stepper__name {
		color: var(--ink-55);
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: var(--leading-snug);
		/* Un nombre largo parte dentro de su columna, nunca la desborda. */
		overflow-wrap: break-word;
		transition: color 180ms var(--ease-step);
	}

	/* Activo en naranja, completado en tinta, pendiente en gris. El
	   estado nunca depende solo del color: el icono cambia a `Check` y
	   hay texto para lector de pantalla. */
	.stepper__step.is-active {
		color: var(--color-orange);
	}

	.stepper__step.is-active .stepper__name {
		color: var(--color-black);
		font-weight: 600;
	}

	.stepper__step.is-complete {
		color: var(--color-black);
	}

	.stepper__step.is-complete .stepper__name {
		color: var(--ink-70);
	}

	.stepper__state {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.cart-step {
		display: none;
	}

	.cart-step.is-active {
		display: block;
	}

	/*
	 * Transicion entre pasos: la seccion saliente se desvanece y se
