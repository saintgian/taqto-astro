---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import WhatsAppIcon from "../components/icons/WhatsAppIcon.astro";
import { YAPE_NAME, YAPE_NUMBER_DISPLAY } from "../lib/constants";
import {
	ShoppingBag,
	MapPin,
	CreditCard,
	Check,
	Trash2,
	Minus,
	Plus,
	Truck,
	PackageCheck,
	ReceiptText,
	ArrowLeft,
	UserRound,
	FileText,
	LockKeyhole,
} from "@lucide/astro";

const base = import.meta.env.BASE_URL;
const catalogHref = `${base}categorias/`;
const yapeQr = `${base}pagos/qr-yape_1.webp`;
const yapeLogo = `${base}icons/Yape_peru_logotype.svg`;
---

<BaseLayout
	title="Carrito | TAQTO"
	description="Revisa tu carrito y completa tu pedido con TAQTO."
	robots="noindex, nofollow"
>
	<Header />

	<main class="cart-page">
		<nav class="cart-breadcrumbs" aria-label="Migas de pan">
			<a href={base}>Inicio</a>
			<span aria-hidden="true">/</span>
			<span>Carrito</span>
		</nav>

		<div class="checkout-shell">
			<h1 class="checkout-title">Finaliza tu compra</h1>

			<!--
				Stepper minimalista: la barra de progreso va separada de la
				fila de labels, asi ninguna linea atraviesa iconos ni texto.
			-->
			<nav class="stepper" aria-label="Progreso de compra">
				<div class="stepper__track" aria-hidden="true">
					<span
						class="stepper__progress"
						data-step-progress
					></span>
				</div>

				<ol class="stepper__list">
					<li
						class="stepper__step is-active"
						data-step-indicator="1"
						aria-current="step"
					>
						<span class="stepper__icon-slot">
							<ShoppingBag
								class="stepper__icon"
								aria-hidden="true"
								stroke-width={1.75}
							/>

							<Check
								class="stepper__icon stepper__icon--check"
								aria-hidden="true"
								stroke-width={1.75}
								hidden
							/>
						</span>

						<span class="stepper__text">
							<span class="stepper__number">Paso 1</span>
							<span class="stepper__name">Carrito</span>
						</span>

						<span class="stepper__state" data-step-state></span>
					</li>

					<li class="stepper__step" data-step-indicator="2">
						<span class="stepper__icon-slot">
							<MapPin
								class="stepper__icon"
								aria-hidden="true"
								stroke-width={1.75}
							/>

							<Check
								class="stepper__icon stepper__icon--check"
								aria-hidden="true"
								stroke-width={1.75}
								hidden
							/>
						</span>

						<span class="stepper__text">
							<span class="stepper__number">Paso 2</span>
							<span class="stepper__name">Datos de envío</span>
						</span>

						<span class="stepper__state" data-step-state></span>
					</li>

					<li class="stepper__step" data-step-indicator="3">
						<span class="stepper__icon-slot">
							<CreditCard
								class="stepper__icon"
								aria-hidden="true"
								stroke-width={1.75}
							/>

							<Check
								class="stepper__icon stepper__icon--check"
								aria-hidden="true"
								stroke-width={1.75}
								hidden
							/>
						</span>

						<span class="stepper__text">
							<span class="stepper__number">Paso 3</span>
							<span class="stepper__name">Pago</span>
						</span>

						<span class="stepper__state" data-step-state></span>
					</li>
				</ol>
			</nav>

			<!-- PASO 1: CARRITO -->
			<section class="cart-step is-active" data-step="1">
				<div class="checkout-grid">
					<div class="checkout-grid__main">
						<div class="cart-items" id="cart-items" data-cart-items>
						</div>

						<p
							class="cart-stock-note"
							id="cart-stock-note"
							role="status"
							aria-live="polite"
						></p>

						<div class="cart-empty" id="cart-empty" hidden>
							<ShoppingBag
								class="cart-empty__icon"
								aria-hidden="true"
								stroke-width={1.75}
							/>

							<p class="cart-empty__title">
								Tu carrito está vacío
							</p>

							<p class="cart-empty__text">
								Añade una pieza del catálogo para continuar
								con tu pedido.
							</p>

							<a class="btn btn--primary cart-empty__link" href={catalogHref}>
								Ver catálogo
							</a>
						</div>
					</div>

					<aside class="checkout-aside">
						<div class="checkout-aside__panel">
							<p class="checkout-aside__label">
								<PackageCheck aria-hidden="true" stroke-width={1.75} />
								Resumen
							</p>

							<div class="cart-summary">
								<div class="cart-summary__row">
									<span>Subtotal</span>
									<strong id="cart-subtotal">S/ 0.00</strong>
								</div>

								<p class="cart-summary__note">
									<Truck aria-hidden="true" stroke-width={1.75} />
									El costo de envío se calcula en el
									siguiente paso.
								</p>
							</div>
						</div>

						<div class="cart-step-actions">
							<button
								type="button"
								class="btn btn--primary btn--full cart-primary-button"
								id="go-to-step-2"
								disabled
							>
								Continuar con mis datos
							</button>

							<a
								class="btn btn--secondary btn--full cart-secondary-button"
								href={catalogHref}
							>
								<ArrowLeft aria-hidden="true" stroke-width={1.75} />
								Seguir comprando
							</a>
						</div>
					</aside>
				</div>
			</section>

			<!-- PASO 2: DATOS DE ENVIO -->
			<section class="cart-step" data-step="2" hidden>
				<div class="checkout-grid">
					<form
					class="shipping-form"
					id="shipping-form"
					data-astro-reload
				>
						<h2 class="form-group-title">
							<UserRound aria-hidden="true" stroke-width={1.75} />
							Datos personales y dirección
						</h2>

						<div class="shipping-form__grid">
							<label class="shipping-field">
								<span>Nombres</span>
								<input
									type="text"
									name="firstName"
									required
									autocomplete="given-name"
								/>
							</label>

							<label class="shipping-field">
								<span>Apellidos</span>
								<input
									type="text"
									name="lastName"
									required
									autocomplete="family-name"
								/>
							</label>

							<label class="shipping-field">
								<span>Correo</span>
								<input
									type="email"
									name="email"
									required
									autocomplete="email"
								/>
							</label>

							<label class="shipping-field">
								<span>Número</span>
								<div class="phone-input">
									<span class="phone-input__prefix">
										<svg
											class="phone-input__flag"
											viewBox="0 0 3 2"
											aria-hidden="true"
										>
											<rect
												width="3"
												height="2"
												fill="#fff"></rect>
											<rect
												width="1"
												height="2"
												fill="#D91023"></rect>
											<rect
												x="2"
												width="1"
												height="2"
												fill="#D91023"></rect>
										</svg>
										+51
									</span>

									<input
										type="tel"
										name="phone"
										required
										pattern="9[0-9]{8}"
										maxlength="9"
										inputmode="numeric"
										placeholder="9XXXXXXXX"
										title="Número de celular peruano: 9 dígitos, empieza con 9."
										autocomplete="tel-national"
									/>
								</div>
							</label>

							<label class="shipping-field">
								<span>Departamento</span>
								<select
									id="select-departamento"
									name="departamento"
									required
								></select>
							</label>

							<label class="shipping-field">
								<span>Provincia</span>
								<select
									id="select-provincia"
									name="provincia"
									required
									disabled
								></select>
							</label>

							<label class="shipping-field">
								<span>Distrito</span>
								<select
									id="select-distrito"
									name="distrito"
									required
									disabled
								></select>
							</label>

							<label class="shipping-field shipping-field--full">
								<span>Dirección</span>
								<input
									type="text"
									name="direccion"
									required
									placeholder="Av./Jr./Calle, número, urbanización"
									autocomplete="street-address"
								/>
							</label>

							<label class="shipping-field shipping-field--full">
								<span>Referencia (opcional)</span>
								<input
									type="text"
									name="referencia"
									placeholder="Ej: frente al parque, edificio azul"
								/>
							</label>
						</div>

						<p
							class="shipping-method-preview"
							id="shipping-method-preview"
						>
							<Truck aria-hidden="true" stroke-width={1.75} />
							Elige tu departamento para ver el método y costo
							de envío.
						</p>

						<h2 class="form-group-title form-group-title--spaced">
							<FileText aria-hidden="true" stroke-width={1.75} />
							Personalización del envío
						</h2>

						<label class="shipping-field shipping-field--full">
							<span>Mensaje para la tarjeta de regalo (opcional)</span>
							<textarea
								name="giftMessage"
								rows="3"
								placeholder="Escribe aquí el mensaje que quieres incluir en la tarjeta de regalo"
							></textarea>
						</label>
					</form>

					<!--
						Resumen y acciones forman una sola unidad en el
						aside: en desktop viajan juntos al hacerse sticky y
						en movil caen en el orden aprobado (formulario,
						resumen, CTA, retroceso) sin duplicar nada.
					-->
					<aside class="checkout-aside">
						<div class="checkout-aside__panel">
							<p class="checkout-aside__label">
								<PackageCheck aria-hidden="true" stroke-width={1.75} />
								Tu pedido
							</p>

							<div
								class="order-aside__products"
								id="mini-products-summary"
							></div>

							<div class="order-aside__totals">
								<div class="order-summary__row">
									<span>Subtotal</span>
									<strong id="mini-subtotal">S/ 0.00</strong>
								</div>

								<div class="order-summary__row">
									<span id="mini-shipping-label">Envío</span>
									<strong id="mini-shipping-amount">—</strong>
								</div>

								<div
									class="order-summary__row order-summary__row--total"
								>
									<span>Total</span>
									<strong id="mini-total">S/ 0.00</strong>
								</div>
							</div>
						</div>

						<div class="cart-step-actions">
							<button
								type="button"
								class="btn btn--primary btn--full cart-primary-button"
								id="go-to-step-3"
							>
								Continuar al pago
							</button>

							<button
								type="button"
								class="btn btn--secondary btn--full cart-secondary-button"
								data-go-step="1"
							>
								<ArrowLeft aria-hidden="true" stroke-width={1.75} />
								Volver al carrito
							</button>
						</div>
					</aside>
				</div>
			</section>

			<!-- PASO 3: PAGO -->
			<section class="cart-step" data-step="3" hidden>
				<div class="checkout-grid checkout-grid--payment">
					<div class="order-summary">
						<div class="order-summary__block">
							<p class="order-summary__label">
								<UserRound aria-hidden="true" stroke-width={1.75} />
								Datos del cliente
							</p>
							<dl
								class="order-summary__list"
								id="order-customer-summary"
							></dl>
						</div>

						<div class="order-summary__block">
							<p class="order-summary__label">
								<PackageCheck aria-hidden="true" stroke-width={1.75} />
								Productos
							</p>
							<div
								class="order-summary__products"
								id="order-products-summary"
							></div>
						</div>

						<div class="order-summary__totals" id="order-totals">
							<p class="order-summary__label">
								<ReceiptText aria-hidden="true" stroke-width={1.75} />
								Total a pagar
							</p>

							<div class="order-summary__row">
								<span>Subtotal</span>
								<strong id="order-subtotal">S/ 0.00</strong>
							</div>

							<div class="order-summary__row">
								<span id="order-shipping-label">Envío</span>
								<strong id="order-shipping-amount">S/ 0.00</strong>
							</div>

							<div
								class="order-summary__row order-summary__row--total"
							>
								<span>Total</span>
								<strong id="order-total">S/ 0.00</strong>
							</div>
						</div>
					</div>

					<aside class="payment-aside">
						<div class="payment-panel">
							<h2
								class="payment-panel__title"
								id="payment-panel-title"
							>
								<CreditCard aria-hidden="true" stroke-width={1.75} />
								Elige cómo pagar
							</h2>

							<p class="payment-panel__hint">
								Al elegir un método, registramos tu
								pedido en nuestro sistema y te damos un
								código para confirmar el pago.
							</p>

							<div
								class="payment-options"
								role="radiogroup"
								aria-labelledby="payment-panel-title"
							>
								<label class="payment-option">
									<input
										class="payment-option__input"
										type="radio"
										name="paymentMethod"
										value="whatsapp"
										data-payment-method
									/>

									<span class="payment-option__logo">
										<WhatsAppIcon width={34} height={34} />
									</span>

									<span class="payment-option__body">
										<span class="payment-option__name">
											Pedir por WhatsApp
										</span>
										<span class="payment-option__text">
											Te confirmamos tu pedido por chat
											y coordinamos la entrega contigo.
										</span>
									</span>

									<span
										class="payment-option__check"
										aria-hidden="true"
									>
										<Check stroke-width={1.75} />
									</span>
								</label>

								<label class="payment-option">
									<input
										class="payment-option__input"
										type="radio"
										name="paymentMethod"
										value="yape"
										data-payment-method
									/>

									<span class="payment-option__logo">
										<img
											class="payment-option__yape-logo"
											src={yapeLogo}
											alt=""
											width="62"
											height="34"
										/>
									</span>

									<span class="payment-option__body">
										<span class="payment-option__name">
											Pagar con Yape
										</span>
										<span class="payment-option__text">
											Yapea al número de TAQTO y
											envíanos tu comprobante.
										</span>
									</span>

									<span
										class="payment-option__check"
										aria-hidden="true"
									>
										<Check stroke-width={1.75} />
									</span>
								</label>
							</div>

							<div class="cart-step-actions">
								<button
									type="button"
									class="btn btn--primary btn--full cart-primary-button"
									id="confirm-payment"
									disabled
								>
									<LockKeyhole aria-hidden="true" stroke-width={1.75} />
									Confirmar método de pago
								</button>

								<button
									type="button"
									class="btn btn--secondary btn--full cart-secondary-button"
									data-go-step="2"
								>
									<ArrowLeft aria-hidden="true" stroke-width={1.75} />
									Volver a datos de envío
								</button>
							</div>
						</div>

						<p
							class="order-confirm__error"
							id="order-confirm-error"
							role="alert"
							hidden
						></p>

						<div
							class="order-created"
							id="order-created-block"
							hidden
						>
							<p class="order-created__label">
								¡Pedido creado!
							</p>

							<p
								class="order-created__code"
								id="order-created-code"
							></p>

							<p class="order-created__hint">
								Guarda este código: lo vas a usar para
								confirmar tu pago.
							</p>
						</div>

						<div class="yape-panel" id="yape-panel" hidden>
							<img
								class="yape-panel__logo"
								src={yapeLogo}
								alt="Yape"
								width="72"
								height="38"
							/>

							<div class="yape-panel__details">
								<p>
									<span>Nombre</span>
									{YAPE_NAME}
								</p>
								<p>
									<span>Número</span>
									{YAPE_NUMBER_DISPLAY}
								</p>
							</div>

							<div class="yape-panel__qr-frame">
								<img
									class="yape-panel__qr"
									src={yapeQr}
									alt="Código QR de Yape para pagar"
									width="180"
									height="180"
								/>
							</div>

							<a
								class="btn btn--primary btn--full cart-primary-button"
								id="yape-send-proof"
								target="_blank"
								rel="noopener noreferrer"
							>
								Enviar comprobante
							</a>
						</div>
					</aside>
				</div>
			</section>
		</div>
	</main>

	<!-- Plantilla de linea de carrito con iconos Lucide reales. -->
	<template data-cart-item-template>
		<li class="cart-item">
			<span class="cart-item__media">
				<img data-role="image" alt="" loading="lazy" />
				<span class="cart-item__placeholder" data-role="placeholder">
					TAQTO
				</span>
			</span>

			<div class="cart-item__content">
				<p class="cart-item__title" data-role="title"></p>
				<p class="cart-item__variant" data-role="variant"></p>
				<p class="cart-item__engraving" data-role="engraving"></p>
				<p
					class="cart-item__availability"
					data-role="availability"
					hidden
				>
					Temporalmente agotado
				</p>
				<p class="cart-item__price" data-role="unit-price"></p>
			</div>

			<div class="cart-item__qty" data-role="quantity">
				<button type="button" data-role="decrease">
					<Minus aria-hidden="true" stroke-width={1.75} />
				</button>

				<span data-role="quantity-value">1</span>

				<button type="button" data-role="increase">
					<Plus aria-hidden="true" stroke-width={1.75} />
				</button>
			</div>

			<p class="cart-item__line-total" data-role="line-total"></p>

			<button type="button" class="btn btn--danger cart-item__remove" data-role="remove">
				<Trash2 aria-hidden="true" stroke-width={1.75} />
				<span>Quitar</span>
			</button>
		</li>
	</template>
</BaseLayout>

<script>
	import {
		getCart,
		updateQuantity,
		removeItem,
		clearCart,
		onCartUpdated,
		getDistinctProductIds,
		applyAvailability,
		type CartItem,
	} from "../lib/cart";

	import { formatPEN } from "../lib/productPricing";

	import {
		getDepartamentos,
		getProvincias,
		getDistritos,
		getDepartamentoName,
		getProvinciaName,
		getDistritoName,
		isLimaMetropolitana,
		type UbigeoOption,
	} from "../lib/peruUbigeo";

	import {
		WHATSAPP_NUMBER,
		SHIPPING_COST,
	} from "../lib/constants";

	// Cliente sin sesion a proposito: si el checkout usara el cliente
	// persistente compartido con /admin/, en el navegador del administrador
	// logueado las llamadas irian como `authenticated` y create_order_v2
	// (concedido solo a `anon`) fallaria.
	import { supabasePublic as supabase } from "../lib/supabase";

	let disposeCheckout: (() => void) | null = null;

	/*
	 * Todo el checkout se enlaza aqui dentro y se vuelve a enlazar en cada
	 * `astro:page-load`. Antes el script corria una sola vez, al evaluarse el
	 * modulo: al volver a /carrito/ con el ClientRouter el modulo ya estaba en
	 * el registro del navegador, no se re-ejecutaba, y la pagina nueva se
	 * quedaba sin render ni listeners (carrito vacio y S/ 0.00 hasta recargar
	 * a mano).
	 */
	const initCheckout = () => {
		const checkoutShell =
			document.querySelector<HTMLElement>(".checkout-shell");

		// Otra pagina (el evento es global) o este mismo DOM ya enlazado.
		if (!checkoutShell || checkoutShell.dataset.checkoutReady === "true") {
			return;
		}

		checkoutShell.dataset.checkoutReady = "true";

		// Suscripciones de la visita anterior: se sueltan antes de crear las
		// nuevas para no acumular consumidores de cart:updated.
		disposeCheckout?.();
		disposeCheckout = null;

		const steps = Array.from(
			document.querySelectorAll<HTMLElement>(
				"[data-step]",
			),
		);

		const stepIndicators = Array.from(
			document.querySelectorAll<HTMLElement>(
				"[data-step-indicator]",
			),
		);

		const stepProgress = document.querySelector<HTMLElement>(
			"[data-step-progress]",
		);

		/*
		 * Pulso del icono al activarse un paso. La clase se quita al
		 * terminar para que un cambio rapido de paso vuelva a lanzarla en
		 * vez de quedarse a medias. El temporizador es el respaldo de
		 * `animationend`, que no llega si la pestaña queda oculta a mitad
		 * de la animacion ni con movimiento reducido (donde no hay
		 * animacion que termine). 340ms es la duracion en el CSS.
		 */
		const STEP_POP_FALLBACK_MS = 340 + 120;

		const playStepIconPop = (indicator: HTMLElement) => {
			const slot = indicator.querySelector<HTMLElement>(
				".stepper__icon-slot",
			);

			if (!slot) return;

			slot.classList.remove("is-popping");

			// Reflow forzado: reinicia la animacion aunque la clase se
			// quite y se vuelva a poner en el mismo tick.
			void slot.offsetWidth;

			const stopPop = () => {
				window.clearTimeout(popTimer);
				slot.removeEventListener("animationend", stopPop);
				slot.classList.remove("is-popping");
			};

			const popTimer = window.setTimeout(
				stopPop,
				STEP_POP_FALLBACK_MS,
			);

			slot.addEventListener("animationend", stopPop);
			slot.classList.add("is-popping");
		};

		// `animate` solo llega desde `goToStep`: el render inicial pinta el
		// paso 1 sin pulso ni barrido de la barra.
		const renderStepper = (
			stepNumber: number,
			animate = false,
		) => {
			// Paso 1: 0%. Paso 2: 50%. Paso 3: 100%.
			const progressRatio =
				(stepNumber - 1) / (stepIndicators.length - 1 || 1);

			if (stepProgress) {
				stepProgress.style.transform = `scaleX(${progressRatio})`;
			}

			stepIndicators.forEach((indicator) => {
				const stepValue = Number(
					indicator.dataset.stepIndicator,
				);

				const isActive = stepValue === stepNumber;
				const isComplete = stepValue < stepNumber;
				const wasActive =
					indicator.classList.contains("is-active");

				if (animate && isActive && !wasActive) {
					playStepIconPop(indicator);
				}

				indicator.classList.toggle("is-active", isActive);
				indicator.classList.toggle("is-complete", isComplete);

				if (isActive) {
					indicator.setAttribute("aria-current", "step");
				} else {
					indicator.removeAttribute("aria-current");
				}

				// El icono del paso se sustituye por un check cuando ya se
				// completo: el estado no depende solo del color.
				const stepIcon = indicator.querySelector<HTMLElement>(
					".stepper__icon:not(.stepper__icon--check)",
				);

				const checkIcon = indicator.querySelector<HTMLElement>(
					".stepper__icon--check",
				);

				if (stepIcon) stepIcon.hidden = isComplete;
				if (checkIcon) checkIcon.hidden = !isComplete;

				const stateLabel = indicator.querySelector<HTMLElement>(
					"[data-step-state]",
				);

				if (stateLabel) {
					stateLabel.textContent = isComplete
						? " (completado)"
						: isActive
							? " (paso actual)"
							: " (pendiente)";
				}
			});
		};

		const unsubscribeFromCart: Array<() => void> = [];

		let currentStep = 1;
		let isStepTransitioning = false;
		let stepTransitionTimer: number | undefined;

		const clearStepTransitionTimer = () => {
			if (stepTransitionTimer !== undefined) {
				window.clearTimeout(stepTransitionTimer);
				stepTransitionTimer = undefined;
			}
		};

		// Solo salta si el bloque no esta ya razonablemente visible: evita
		// mover la pagina cuando el usuario ya ve el stepper y el formulario.
		const ensureCheckoutVisible = () => {
			const rect = checkoutShell.getBoundingClientRect();
			const alreadyVisible = rect.top >= -8 && rect.top <= 96;

			if (!alreadyVisible) {
				window.scrollTo({
					top: window.scrollY + rect.top - 24,
					behavior: "auto",
				});
			}
		};

		// Deben coincidir con las duraciones de `.cart-step--*` en el CSS:
		// son el respaldo por si `transitionend` no llega.
		const STEP_EXIT_MS = 130;
		const STEP_ENTER_MS = 300;

		const goToStep = (stepNumber: number) => {
			if (isStepTransitioning || stepNumber === currentStep) return;

			const outgoing = steps.find(
				(section) => section.dataset.step === String(currentStep),
			);

			const incoming = steps.find(
				(section) => section.dataset.step === String(stepNumber),
			);

			if (!outgoing || !incoming) return;

			const isForward = stepNumber > currentStep;

			currentStep = stepNumber;
			isStepTransitioning = true;

			renderStepper(stepNumber, true);
			ensureCheckoutVisible();

			clearStepTransitionTimer();

			let hasStartedEnter = false;

			const startEnter = () => {
				if (hasStartedEnter) return;
				hasStartedEnter = true;

				clearStepTransitionTimer();

				incoming.classList.remove(
					"cart-step--entering",
					"cart-step--entering-back",
				);
				incoming.classList.add("cart-step--enter-active");

				const finishEnter = () => {
					incoming.removeEventListener(
						"transitionend",
						onEnterEnd,
					);
					clearStepTransitionTimer();
					incoming.classList.remove("cart-step--enter-active");
					isStepTransitioning = false;
				};

				const onEnterEnd = (event: TransitionEvent) => {
					if (
						event.target !== incoming ||
						event.propertyName !== "opacity"
					) {
						return;
					}

					finishEnter();
				};

				incoming.addEventListener("transitionend", onEnterEnd);
				stepTransitionTimer = window.setTimeout(
					finishEnter,
					STEP_ENTER_MS + 120,
				);
			};

			const finishExit = () => {
				outgoing.removeEventListener("transitionend", onExitEnd);
				clearStepTransitionTimer();

				outgoing.classList.remove("cart-step--leaving");
				outgoing.classList.remove("is-active");
				outgoing.hidden = true;

				incoming.classList.add(
					"is-active",
					isForward
						? "cart-step--entering"
						: "cart-step--entering-back",
				);
				incoming.hidden = false;

				/*
				 * El frame de espera es lo que hace que el navegador vea el
				 * estado inicial y anime hacia el final. Si la pestaña esta
				 * oculta no hay frames, asi que el temporizador es el que
				 * remata la entrada: sin el, el paso entrante se quedaria en
				 * opacidad 0 y `isStepTransitioning` bloquearia el resto de
				 * la navegacion entre pasos.
				 */
				window.requestAnimationFrame(startEnter);
				stepTransitionTimer = window.setTimeout(startEnter, 80);
			};

			const onExitEnd = (event: TransitionEvent) => {
				if (
					event.target !== outgoing ||
					event.propertyName !== "opacity"
				) {
					return;
				}

				finishExit();
			};

			outgoing.addEventListener("transitionend", onExitEnd);
			outgoing.classList.add("cart-step--leaving");
			stepTransitionTimer = window.setTimeout(
				finishExit,
				STEP_EXIT_MS + 80,
			);
		};

		renderStepper(1);

		document
			.querySelectorAll<HTMLButtonElement>(
				"[data-go-step]",
			)
			.forEach((button) => {
				button.addEventListener("click", () => {
					goToStep(
						Number(button.dataset.goStep),
					);
				});
			});

		// ---------- PASO 1: CARRITO ----------

		const cartItemsContainer =
			document.querySelector<HTMLElement>(
				"#cart-items",
			)!;

		const cartEmptyState =
			document.querySelector<HTMLElement>(
				"#cart-empty",
			)!;

		const cartSubtotalLabel =
			document.querySelector<HTMLElement>(
				"#cart-subtotal",
			)!;

		const cartStockNote =
			document.querySelector<HTMLElement>(
				"#cart-stock-note",
			)!;

		let cartStockNoteTimer: number | undefined;

		const announceCartStockLimit = (
			title: string,
			limit: number,
		) => {
			if (cartStockNoteTimer !== undefined) {
				window.clearTimeout(cartStockNoteTimer);
			}

			cartStockNote.textContent = "";

			window.requestAnimationFrame(() => {
				cartStockNote.textContent = `${title}: alcanzaste el máximo disponible (${limit} unidad${limit === 1 ? "" : "es"}).`;
			});

			cartStockNoteTimer = window.setTimeout(() => {
				cartStockNote.textContent = "";
				cartStockNoteTimer = undefined;
			}, 3000);
		};

		// ---------- Disponibilidad real (public_variant_availability) ----------

		// Se consulta una sola vez por carga de /carrito/ (ver
		// refreshCartAvailability mas abajo); estos estados solo gatean el
		// CTA "Continuar" mientras esa unica consulta esta en vuelo o si deja
		// algun item en 0.
		let isCheckingAvailability = false;

		const setPersistentStockNote = (text: string) => {
			if (cartStockNoteTimer !== undefined) {
				window.clearTimeout(cartStockNoteTimer);
				cartStockNoteTimer = undefined;
			}

			cartStockNote.textContent = text;
		};

		const goToStep2Button =
			document.querySelector<HTMLButtonElement>(
				"#go-to-step-2",
			)!;

		const getCartSubtotal = (items: CartItem[]) =>
			items.reduce(
				(total, item) =>
					total + item.unitPrice * item.quantity,
				0,
			);

		const variantLabelOf = (item: CartItem) =>
			[item.woodTitle, item.sizeTitle]
				.filter(Boolean)
				.join(" · ");

		const cartItemTemplate =
			document.querySelector<HTMLTemplateElement>(
				"[data-cart-item-template]",
			)!;

		const buildCartRow = (item: CartItem) => {
			const row =
				cartItemTemplate.content.firstElementChild!.cloneNode(
					true,
				) as HTMLElement;

			const pick = <T extends HTMLElement>(role: string) =>
				row.querySelector<T>(`[data-role="${role}"]`);

			const image = pick<HTMLImageElement>("image");
			const placeholder = pick("placeholder");

			if (item.image && image) {
				image.src = item.image;
				image.alt = item.title;
				placeholder?.remove();
			} else {
				image?.remove();
			}

			const title = pick("title");
			if (title) title.textContent = item.title;

			const variantLabel = variantLabelOf(item);
			const variant = pick("variant");

			if (variant) {
				if (variantLabel) {
					variant.textContent = variantLabel;
				} else {
					variant.remove();
				}
			}

			const engraving = pick("engraving");

			if (engraving) {
				if (item.engravingText) {
					engraving.textContent = `Grabado: “${item.engravingText}”`;
				} else {
					engraving.remove();
				}
			}

			const isOutOfStock =
				typeof item.stock === "number" && item.stock <= 0;

			row.classList.toggle("is-out-of-stock", isOutOfStock);

			const availability = pick("availability");

			if (availability) {
				if (isOutOfStock) {
					availability.hidden = false;
				} else {
					availability.remove();
				}
			}

			const unitPrice = pick("unit-price");

			if (unitPrice) {
				unitPrice.textContent = `${formatPEN(item.unitPrice)} c/u`;
			}

			pick("quantity")?.setAttribute(
				"aria-label",
				`Cantidad de ${item.title}`,
			);

			const quantityValue = pick("quantity-value");

			if (quantityValue) {
				quantityValue.textContent = String(item.quantity);
			}

			const decrease = pick<HTMLButtonElement>("decrease");

			if (decrease) {
				decrease.setAttribute(
					"aria-label",
					`Disminuir cantidad de ${item.title}`,
				);
				decrease.disabled = item.quantity <= 1;
				decrease.addEventListener("click", () => {
					updateQuantity(item.id, item.quantity - 1);
				});
			}

			const increase = pick<HTMLButtonElement>("increase");

			if (increase) {
				const stockLimit =
					typeof item.stock === "number"
						? Math.max(0, Math.floor(item.stock))
						: undefined;

				const atMax =
					typeof stockLimit === "number" &&
					item.quantity >= stockLimit;

				increase.disabled = atMax;
				increase.setAttribute(
					"aria-disabled",
					String(atMax),
				);

				increase.setAttribute(
					"aria-label",
					`Aumentar cantidad de ${item.title}`,
				);
				increase.addEventListener("click", () => {
					if (atMax) {
						announceCartStockLimit(
							item.title,
							stockLimit as number,
						);
						return;
					}

					updateQuantity(item.id, item.quantity + 1);
				});
			}

			const lineTotal = pick("line-total");

			if (lineTotal) {
				lineTotal.textContent = formatPEN(
					item.unitPrice * item.quantity,
				);
			}

			const remove = pick<HTMLButtonElement>("remove");

			if (remove) {
				remove.setAttribute(
					"aria-label",
					`Quitar ${item.title} del carrito`,
				);
				remove.addEventListener("click", () => {
					removeItem(item.id);
				});
			}

			return row;
		};

		const renderCartItems = () => {
			const items = getCart();
			const isEmpty = items.length === 0;

			const hasOutOfStockItem = items.some(
				(item) =>
					typeof item.stock === "number" && item.stock <= 0,
			);

			cartItemsContainer.replaceChildren();
			cartEmptyState.hidden = !isEmpty;
			goToStep2Button.disabled =
				isEmpty || isCheckingAvailability || hasOutOfStockItem;

			if (!isEmpty) {
				const list = document.createElement("ul");
				list.className = "cart-lines";

				items.forEach((item) => {
					list.appendChild(buildCartRow(item));
				});

				cartItemsContainer.appendChild(list);
			}

			cartSubtotalLabel.textContent = formatPEN(
				getCartSubtotal(items),
			);
		};

		renderCartItems();
		unsubscribeFromCart.push(onCartUpdated(renderCartItems));

		/*
		 * Una sola pasada por carga de /carrito/: como mucho una llamada a
		 * public_variant_availability por producto distinto (nunca por
		 * item/variante). `applyAvailability` escribe en localStorage y
		 * dispara `cart:updated`, asi que `renderCartItems` ya se vuelve a
		 * ejecutar sola con los stocks nuevos; aqui solo se anuncia el
		 * resultado.
		 */
		const refreshCartAvailability = async () => {
			const items = getCart();
			if (items.length === 0) return;

			if (!supabase) {
				// Sin cliente publico no hay como consultar: se deja el
				// carrito tal cual, create_order_v2 sigue siendo la
				// autoridad final al confirmar.
				return;
			}

			const productIds = getDistinctProductIds();

			isCheckingAvailability = true;
			setPersistentStockNote("Comprobando disponibilidad…");
			renderCartItems();

			const settled = await Promise.allSettled(
				productIds.map(async (productId) => {
					const { data, error } = await supabase!.rpc(
						"public_variant_availability",
						{ p_sanity_product_id: productId },
					);

					if (error) throw error;

					return {
						productId,
						rows:
							(data as Array<{
								sku: string;
								stock_quantity: number;
							}>) ?? [],
					};
				}),
			);

			isCheckingAvailability = false;

			const bySku = new Map<string, number>();
			const queriedProductIds = new Set<string>();

			settled.forEach((result) => {
				if (result.status !== "fulfilled") return;

				queriedProductIds.add(result.value.productId);
				result.value.rows.forEach((row) => {
					bySku.set(row.sku, row.stock_quantity);
				});
			});

			const someFailed = queriedProductIds.size < productIds.length;

			if (queriedProductIds.size === 0) {
				// Ninguna consulta se pudo completar: no se toca ninguna
				// cantidad, se muestra el respaldo y se deja avanzar.
				setPersistentStockNote(
					"Disponibilidad se confirmará al finalizar tu compra.",
				);
				renderCartItems();
				return;
			}

			const { adjusted } = applyAvailability(
				bySku,
				queriedProductIds,
			);

			if (adjusted.length > 0) {
				const [first] = adjusted;

				const message =
					adjusted.length === 1
						? `${first.title}: la cantidad se ajustó a ${first.to} por disponibilidad.`
						: `Ajustamos ${adjusted.length} productos de tu carrito por disponibilidad.`;

				setPersistentStockNote(message);

				cartStockNoteTimer = window.setTimeout(() => {
					cartStockNote.textContent = "";
					cartStockNoteTimer = undefined;
				}, 4000);
			} else if (someFailed) {
				setPersistentStockNote(
					"Disponibilidad se confirmará al finalizar tu compra.",
				);
			} else {
				setPersistentStockNote("");
			}

			// `applyAvailability` ya disparo `cart:updated` si cambio algo;
			// esto solo cubre el caso sin cambios, donde nadie mas vuelve a
			// pintar el boton "Continuar" tras salir de isCheckingAvailability.
			renderCartItems();
		};

		void refreshCartAvailability();

		goToStep2Button.addEventListener("click", () => {
			if (goToStep2Button.disabled) return;
			goToStep(2);
		});

		// ---------- MINI RESUMEN (PASO 2) ----------

		const miniProductsSummary =
			document.querySelector<HTMLElement>(
				"#mini-products-summary",
			)!;

		const miniSubtotalLabel =
			document.querySelector<HTMLElement>(
				"#mini-subtotal",
			)!;

		const miniShippingLabelEl =
			document.querySelector<HTMLElement>(
				"#mini-shipping-label",
			)!;

		const miniShippingAmountLabel =
			document.querySelector<HTMLElement>(
				"#mini-shipping-amount",
			)!;

		const miniTotalLabel =
			document.querySelector<HTMLElement>(
				"#mini-total",
			)!;

		const renderProductLines = (
			container: HTMLElement,
			items: CartItem[],
		) => {
			container.replaceChildren();

			items.forEach((item) => {
				const variant = variantLabelOf(item);

				const row = document.createElement("div");
				row.className = "order-summary__product";

				const label = document.createElement("span");

				label.appendChild(
					document.createTextNode(
						`${item.title}${variant ? ` — ${variant}` : ""} × ${item.quantity}`,
					),
				);

				if (item.engravingText) {
					label.appendChild(document.createElement("br"));

					const small = document.createElement("small");
					small.textContent = `Grabado: “${item.engravingText}”`;
					label.appendChild(small);
				}

				const price = document.createElement("strong");
				price.textContent = formatPEN(
					item.unitPrice * item.quantity,
				);

				row.append(label, price);
				container.appendChild(row);
			});
		};

		const renderMiniSummary = () => {
			const items = getCart();
			const subtotal = getCartSubtotal(items);

			renderProductLines(miniProductsSummary, items);
			miniSubtotalLabel.textContent = formatPEN(subtotal);

			const departamentoValue =
				departamentoSelect.value;

			if (!departamentoValue) {
				miniShippingLabelEl.textContent = "Envío";
				miniShippingAmountLabel.textContent = "—";
				miniTotalLabel.textContent = formatPEN(subtotal);
				return;
			}

			const isLima = isLimaMetropolitana(
				departamentoValue,
			);

			miniShippingLabelEl.textContent = isLima
				? "Delivery (Lima)"
				: "Envío a agencia";

			miniShippingAmountLabel.textContent =
				formatPEN(SHIPPING_COST);

			miniTotalLabel.textContent = formatPEN(
				subtotal + SHIPPING_COST,
			);
		};

		// ---------- PASO 2: DATOS DE ENVIO ----------

		const shippingForm =
			document.querySelector<HTMLFormElement>(
				"#shipping-form",
			)!;

		const departamentoSelect =
			document.querySelector<HTMLSelectElement>(
				"#select-departamento",
			)!;

		const provinciaSelect =
			document.querySelector<HTMLSelectElement>(
				"#select-provincia",
			)!;

		const distritoSelect =
			document.querySelector<HTMLSelectElement>(
				"#select-distrito",
			)!;

		const shippingMethodPreview =
			document.querySelector<HTMLElement>(
				"#shipping-method-preview",
			)!;

		const populateSelect = (
			select: HTMLSelectElement,
			options: UbigeoOption[],
			placeholder: string,
		) => {
			select.innerHTML = "";

			const placeholderOption =
				document.createElement("option");

			placeholderOption.value = "";
			placeholderOption.textContent = placeholder;
			placeholderOption.disabled = true;
			placeholderOption.selected = true;

			select.appendChild(placeholderOption);

			options.forEach((option) => {
				const optionEl =
					document.createElement("option");

				optionEl.value = option.id;
				optionEl.textContent = option.name;
				select.appendChild(optionEl);
			});
		};

		const getShippingLabel = () => {
			if (!departamentoSelect.value) {
				return "Elige tu departamento para ver el método y costo de envío.";
			}

			const isLima = isLimaMetropolitana(
				departamentoSelect.value,
			);

			return isLima
				? `Delivery a domicilio (Lima Metropolitana) — ${formatPEN(SHIPPING_COST)}`
				: `Envío a agencia en tu ciudad — ${formatPEN(SHIPPING_COST)}`;
		};

		const updateShippingPreview = () => {
			shippingMethodPreview.textContent =
				getShippingLabel();

			renderMiniSummary();
		};

		populateSelect(
			departamentoSelect,
			getDepartamentos(),
			"Selecciona un departamento",
		);

		departamentoSelect.addEventListener(
			"change",
			() => {
				const provincias = getProvincias(
					departamentoSelect.value,
				);

				populateSelect(
					provinciaSelect,
					provincias,
					"Selecciona una provincia",
				);

				provinciaSelect.disabled =
					provincias.length === 0;

				populateSelect(
					distritoSelect,
					[],
					"Selecciona una provincia primero",
				);

				distritoSelect.disabled = true;

				updateShippingPreview();
			},
		);

		provinciaSelect.addEventListener("change", () => {
			const distritos = getDistritos(
				provinciaSelect.value,
			);

			populateSelect(
				distritoSelect,
				distritos,
				"Selecciona un distrito",
			);

			distritoSelect.disabled =
				distritos.length === 0;
		});

		unsubscribeFromCart.push(onCartUpdated(renderMiniSummary));
		renderMiniSummary();

		const goToStep3Button =
			document.querySelector<HTMLButtonElement>(
				"#go-to-step-3",
			)!;

		goToStep3Button.addEventListener("click", () => {
			if (!shippingForm.reportValidity()) return;

			buildOrderSummary();
			goToStep(3);
		});

		// ---------- PASO 3: PAGO ----------

		const orderCustomerSummary =
			document.querySelector<HTMLElement>(
				"#order-customer-summary",
			)!;

		const orderProductsSummary =
			document.querySelector<HTMLElement>(
				"#order-products-summary",
			)!;

		const orderSubtotalLabel =
			document.querySelector<HTMLElement>(
				"#order-subtotal",
			)!;

		const orderShippingLabelEl =
			document.querySelector<HTMLElement>(
				"#order-shipping-label",
			)!;

		const orderShippingAmountLabel =
			document.querySelector<HTMLElement>(
				"#order-shipping-amount",
			)!;

		const orderTotalLabel =
			document.querySelector<HTMLElement>(
				"#order-total",
			)!;

		const getCustomerData = () => {
			const formData = new FormData(shippingForm);

			const departamentoId = String(
				formData.get("departamento") || "",
			);

			const provinciaId = String(
				formData.get("provincia") || "",
			);

			const distritoId = String(
				formData.get("distrito") || "",
			);

			return {
				firstName: String(
					formData.get("firstName") || "",
				),
				lastName: String(
					formData.get("lastName") || "",
				),
				email: String(formData.get("email") || ""),
				phone: `+51 ${String(formData.get("phone") || "")}`,
				departamento:
					getDepartamentoName(departamentoId),
				provincia: getProvinciaName(provinciaId),
				distrito: getDistritoName(distritoId),
				direccion: String(
					formData.get("direccion") || "",
				),
				referencia: String(
					formData.get("referencia") || "",
				),
				giftMessage: String(
					formData.get("giftMessage") || "",
				),
				isLima: isLimaMetropolitana(departamentoId),
			};
		};

		const buildOrderSummary = () => {
			const customer = getCustomerData();
			const items = getCart();
			const subtotal = getCartSubtotal(items);
			const total = subtotal + SHIPPING_COST;

			const shippingLabel = customer.isLima
				? "Delivery a domicilio (Lima Metropolitana)"
				: "Envío a agencia en tu ciudad";

			orderCustomerSummary.replaceChildren();

			const addSummaryRow = (label: string, value: string) => {
				const row = document.createElement("div");
				const dt = document.createElement("dt");
				dt.textContent = label;

				const dd = document.createElement("dd");
				dd.textContent = value;

				row.append(dt, dd);
				orderCustomerSummary.appendChild(row);
			};

			addSummaryRow(
				"Nombre",
				`${customer.firstName} ${customer.lastName}`,
			);
			addSummaryRow("Correo", customer.email);
			addSummaryRow("Teléfono", customer.phone);
			addSummaryRow(
				"Dirección",
				customer.referencia
					? `${customer.direccion} (${customer.referencia})`
					: customer.direccion,
			);
			addSummaryRow(
				"Ubicación",
				`${customer.distrito}, ${customer.provincia}, ${customer.departamento}`,
			);

			if (customer.giftMessage) {
				addSummaryRow(
					"Tarjeta de regalo",
					customer.giftMessage,
				);
			}

			renderProductLines(orderProductsSummary, items);

			orderSubtotalLabel.textContent =
				formatPEN(subtotal);

			orderShippingLabelEl.textContent = shippingLabel;
			orderShippingAmountLabel.textContent =
				formatPEN(SHIPPING_COST);

			orderTotalLabel.textContent = formatPEN(total);
		};

		const buildWhatsAppOrderMessage = (
			orderCode: string,
		) =>
			`Hola TAQTO, acabo de registrar el pedido ${orderCode}. Quisiera confirmar el pago y la personalización.`;

		const buildWhatsAppReceiptMessage = (
			orderCode: string,
		) =>
			`Hola TAQTO, ya yapeé el pedido ${orderCode}. Adjunto la captura del comprobante.`;

		// ---------- CREAR PEDIDO EN SUPABASE ----------

		let createdOrderCode: string | null = null;
		let createdOrderSignature: string | null = null;
		let orderCreationInFlight = false;

		const ORDER_REQUEST_ID_STORAGE_KEY =
			"taqto_order_request";

		const generateRequestId = (): string => {
			if (
				typeof crypto !== "undefined" &&
				typeof crypto.randomUUID === "function"
			) {
				return crypto.randomUUID();
			}

			// Respaldo minimo si crypto.randomUUID no esta disponible
			// (contexto no seguro / navegador muy antiguo). Solo se usa
			// como clave de idempotencia por intento, no con fines
			// criptograficos.
			return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
		};

		const buildOrderSignature = (
			items: CartItem[],
			customer: ReturnType<typeof getCustomerData>,
			paymentMethod: string,
		) =>
			JSON.stringify({
				items: items.map((item) => ({
					id: item.id,
					quantity: item.quantity,
					unitPrice: item.unitPrice,
				})),
				customer,
				paymentMethod,
			});

		/*
		 * El id de idempotencia se guarda en sessionStorage junto con la
		 * firma del intento (carrito + datos + metodo de pago) para que un
		 * recargo de pagina en medio de la creacion del pedido reutilice el
		 * mismo id: si la insercion en Supabase ya se habia completado, el
		 * RPC devuelve el pedido existente en vez de duplicarlo.
		 */
		const getClientRequestId = (signature: string): string => {
			if (typeof window !== "undefined") {
				try {
					const raw = window.sessionStorage.getItem(
						ORDER_REQUEST_ID_STORAGE_KEY,
					);

					if (raw) {
						const stored = JSON.parse(raw) as {
							signature?: string;
							requestId?: string;
						};

						if (
							stored.signature === signature &&
							stored.requestId
						) {
							return stored.requestId;
						}
					}
				} catch {
					// Se ignora: si sessionStorage falla, se genera un id
					// nuevo valido solo en memoria para este intento.
				}
			}

			const requestId = generateRequestId();

			if (typeof window !== "undefined") {
				try {
					window.sessionStorage.setItem(
						ORDER_REQUEST_ID_STORAGE_KEY,
						JSON.stringify({ signature, requestId }),
					);
				} catch {
					// Almacenamiento no disponible; el id sigue siendo
					// valido en memoria para este intento.
				}
			}

			return requestId;
		};

		const clearClientRequestId = () => {
			if (typeof window === "undefined") return;

			try {
				window.sessionStorage.removeItem(
					ORDER_REQUEST_ID_STORAGE_KEY,
				);
			} catch {
				// Nada que limpiar si sessionStorage no esta disponible.
			}
		};

		const orderConfirmError =
			document.querySelector<HTMLElement>(
				"#order-confirm-error",
			)!;

		const orderCreatedBlock =
			document.querySelector<HTMLElement>(
				"#order-created-block",
			)!;

		const orderCreatedCode =
			document.querySelector<HTMLElement>(
				"#order-created-code",
			)!;

		const paymentMethodInputs = Array.from(
			document.querySelectorAll<HTMLInputElement>(
				"[data-payment-method]",
			),
		);

		const confirmPaymentButton =
			document.querySelector<HTMLButtonElement>(
				"#confirm-payment",
			)!;

		const yapePanel =
			document.querySelector<HTMLElement>(
				"#yape-panel",
			)!;

		const yapeSendProofLink =
			document.querySelector<HTMLAnchorElement>(
				"#yape-send-proof",
			)!;

		/*
		 * sanityProductId + productSku son las claves que create_order_v2
		 * usa para buscar precio y stock reales en catalog_variants: son las
		 * unicas dos que el RPC realmente confia. El resto (productName,
		 * wood*, size*, dimensionsLabel, unitPrice) viaja solo como
		 * respaldo/depuracion; el RPC los ignora como autoridad y usa lo que
		 * encuentra en el catalogo para armar el pedido.
		 */
		const buildOrderItemsPayload = (items: CartItem[]) =>
			items.map((item) => ({
				sanityProductId: item.productId,
				sanityProductSlug: item.slug,
				productName: item.title,
				productSku: item.sku,
				woodName: item.woodTitle || null,
				woodSlug: item.woodSlug || null,
				sizeName: item.sizeTitle || null,
				sizeSlug: item.sizeSlug || null,
				dimensionsLabel: item.dimensionsLabel || null,
				engravingText: item.engravingText || null,
				quantity: item.quantity,
				unitPrice: item.unitPrice,
			}));

		const ensureOrderCreated = async (
			paymentMethod: "yape" | "cash_on_delivery",
		): Promise<string | null> => {
			if (orderCreationInFlight) return null;

			const items = getCart();

			if (items.length === 0) {
				// El carrito puede estar vacio porque el pedido ya se creo
				// con exito y se limpio despues: se reutiliza ese codigo en
				// vez de tratarlo como "no hay nada que ordenar".
				return createdOrderCode;
			}

			const customer = getCustomerData();

			const signature = buildOrderSignature(
				items,
				customer,
				paymentMethod,
			);

			// Carrito y datos identicos al pedido ya creado: se reutiliza
			// sin volver a llamar al RPC (doble click, Enter repetido,
			// volver de un paso y regresar sin cambiar nada).
			if (
				createdOrderCode &&
				createdOrderSignature === signature
			) {
				return createdOrderCode;
			}

			if (!supabase) {
				orderConfirmError.textContent =
					"El registro de pedidos no está disponible en este momento. Escríbenos directo por WhatsApp para completar tu compra.";

				orderConfirmError.hidden = false;
				return null;
			}

			const clientRequestId = getClientRequestId(signature);

			const payload = {
				p_payment_method: paymentMethod,
				p_delivery_method: customer.isLima
					? "lima_delivery"
					: "province_agency",
				p_customer_first_name: customer.firstName,
				p_customer_last_name: customer.lastName,
				p_customer_email: customer.email,
				p_customer_phone: customer.phone,
				p_delivery_department: customer.departamento,
				p_delivery_province: customer.provincia,
				p_delivery_district: customer.distrito,
				p_delivery_address: customer.direccion,
				p_delivery_reference:
					customer.referencia || null,
				p_customer_notes: customer.giftMessage
					? `Mensaje para la tarjeta de regalo: ${customer.giftMessage}`
					: null,
				// Ya no se envian p_subtotal/p_delivery_cost/p_total: el RPC
				// endurecido los calcula el mismo desde el catalogo, no
				// desde lo que mande el navegador.
				p_items: buildOrderItemsPayload(items),
				p_client_request_id: clientRequestId,
			};

			orderCreationInFlight = true;
			orderConfirmError.hidden = true;

			confirmPaymentButton.disabled = true;
			confirmPaymentButton.classList.add("is-loading");

			/*
			 * Unica via de escritura: create_order_v2 (ver
			 * supabase/harden_create_order.sql). A diferencia de la version
			 * anterior de este archivo, ya NO hay reintento contra el RPC
			 * viejo si este falla: degradar en silencio a una version sin
			 * validacion de catalogo ni idempotencia real seria exactamente
			 * el problema que se esta corrigiendo.
			 */
			const { data, error } = await supabase.rpc(
				"create_order_v2",
				payload,
			);

			orderCreationInFlight = false;
			confirmPaymentButton.classList.remove("is-loading");
			renderPaymentSelection();

			if (error || !data) {
				if (
					error?.code === "PGRST202" ||
					error?.code === "PGRST203" ||
					error?.code === "42883"
				) {
					// La funcion create_order_v2 todavia no existe o no se
					// puede resolver sin ambiguedad en el proyecto remoto:
					// falta correr supabase/catalog_mirror.sql,
					// harden_create_order.sql y harden_permissions.sql. No
					// hay una ruta de compra alternativa mientras tanto.
					orderConfirmError.textContent =
						"El checkout seguro todavía no está activo en este servidor. Escríbenos directo por WhatsApp para completar tu compra.";
				} else if (
					error?.message?.startsWith("IDEMPOTENCY_MISMATCH")
				) {
					// La clave de este intento ya se uso con otros datos: se
					// descarta para que el proximo click genere una clave
					// nueva en vez de volver a chocar con la misma.
					clearClientRequestId();

					orderConfirmError.textContent =
						"Tu pedido cambió antes de confirmarse. Revisa el resumen e intenta de nuevo.";
				} else if (error?.message) {
					// Mensajes propios del RPC (stock insuficiente, producto
					// ya no disponible, datos incompletos): ya estan escritos
					// para mostrarse tal cual, sin detalle tecnico.
					orderConfirmError.textContent = error.message;
				} else {
					orderConfirmError.textContent =
						"No pudimos registrar tu pedido. Intenta de nuevo o escríbenos directo por WhatsApp.";
				}

				orderConfirmError.hidden = false;
				return null;
			}

			createdOrderCode = data as string;
			createdOrderSignature = signature;
			orderCreatedBlock.hidden = false;
			orderCreatedCode.textContent = createdOrderCode;

			// El pedido ya quedo confirmado en Supabase: se vacia el
			// carrito para que ni un recargo de pagina ni un nuevo intento
			// de confirmar puedan volver a enviarlo.
			clearCart();
			clearClientRequestId();

			return createdOrderCode;
		};

		// El pedido y su integracion no cambian: solo se separa "elegir
		// metodo" de "confirmar", como pide la nueva composicion del paso 3.
		const payWithWhatsApp = async () => {
			const code = await ensureOrderCreated(
				"cash_on_delivery",
			);

			if (!code) return;

			const message = encodeURIComponent(
				buildWhatsAppOrderMessage(code),
			);

			window.open(
				`https://wa.me/${WHATSAPP_NUMBER}?text=${message}`,
				"_blank",
				"noopener,noreferrer",
			);

			orderCreatedBlock.scrollIntoView({
				behavior: "smooth",
				block: "center",
			});
		};

		const payWithYape = async () => {
			const code = await ensureOrderCreated("yape");

			if (!code) return;

			yapePanel.hidden = false;

			const message = encodeURIComponent(
				buildWhatsAppReceiptMessage(code),
			);

			yapeSendProofLink.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${message}`;

			yapePanel.scrollIntoView({
				behavior: "smooth",
				block: "center",
			});
		};

		const selectedPaymentMethod = () =>
			paymentMethodInputs.find((input) => input.checked)?.value ?? null;

		const renderPaymentSelection = () => {
			paymentMethodInputs.forEach((input) => {
				input
					.closest(".payment-option")
					?.classList.toggle("is-selected", input.checked);
			});

			confirmPaymentButton.disabled = !selectedPaymentMethod();
		};

		paymentMethodInputs.forEach((input) => {
			input.addEventListener("change", renderPaymentSelection);

			input.addEventListener("focus", () => {
				input
					.closest(".payment-option")
					?.classList.toggle(
						"is-focused",
						input.matches(":focus-visible"),
					);
			});

			input.addEventListener("blur", () => {
				input
					.closest(".payment-option")
					?.classList.remove("is-focused");
			});
		});

		renderPaymentSelection();

		confirmPaymentButton.addEventListener("click", () => {
			const method = selectedPaymentMethod();

			if (method === "whatsapp") {
				void payWithWhatsApp();
			} else if (method === "yape") {
				void payWithYape();
			}
		});

		disposeCheckout = () => {
			unsubscribeFromCart.forEach((unsubscribe) => unsubscribe());
			unsubscribeFromCart.length = 0;
			disposeCheckout = null;
		};
	};

	initCheckout();
	document.addEventListener("astro:page-load", initCheckout);

	// Al salir de /carrito/ el DOM desaparece: sus suscripciones tambien.
	document.addEventListener("astro:before-swap", () => {
		disposeCheckout?.();
	});
</script>

<style is:global>
	.cart-page {
		padding-block: clamp(28px, 4vw, 48px) clamp(48px, 6vw, 72px);
		background: var(--surface);
		color: var(--color-black);
	}

	.cart-breadcrumbs {
		width: min(calc(100% - 40px), 1360px);
		margin: 0 auto 20px;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		color: var(--ink-55);
		font-size: var(--text-xs);
	}

	.cart-breadcrumbs a {
		color: inherit;
		text-decoration: none;
	}

	.cart-breadcrumbs a:hover {
		color: var(--color-black);
		text-decoration: underline;
	}

	.checkout-shell {
		width: min(calc(100% - 40px), 1360px);
		margin-inline: auto;

		/*
		 * Curva compartida por el cambio de paso: arranque rapido y
		 * frenada larga, sin rebote.
		 */
		--ease-step: cubic-bezier(0.22, 1, 0.36, 1);

		/* Tintes del naranja de marca (#ff4d2a) para el paso activo. */
		--step-accent-soft: rgba(255, 77, 42, 0.1);
		--step-accent-ring: rgba(255, 77, 42, 0.3);
	}

	.checkout-title {
		margin: 0 0 clamp(24px, 3vw, 34px);
		font-size: var(--text-2xl);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: var(--leading-tight);
	}

	/* ---------- Stepper ---------- */

	.stepper {
		margin: 0 0 clamp(30px, 4vw, 44px);
	}

	/* Barra de progreso: no atraviesa iconos, texto ni nodos. */
	.stepper__track {
		height: 4px;
		overflow: hidden;
		border-radius: var(--radius-full);
		background: var(--ink-08);
	}

	.stepper__progress {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: inherit;
		background: var(--color-orange);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 380ms var(--ease-step);
	}

	.stepper__list {
		margin: 14px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
		list-style: none;
	}

	/*
	 * `min-width: 0` es lo que impide que un paso desborde su columna: sin
	 * el, un item de grid conserva `min-width: auto` y una etiqueta mas
	 * ancha que la pista (fuente de respaldo, texto del sistema mas grande)
	 * se sale del contenedor arrastrando al Paso 3 fuera del viewport.
	 */
	.stepper__step {
		min-width: 0;
		display: flex;
		align-items: flex-start;
		gap: 9px;
		color: var(--ink-35);
		transition: color 180ms var(--ease-step);
	}

	.stepper__icon-slot {
		flex: 0 0 26px;
		width: 26px;
		height: 26px;
		display: grid;
		place-items: center;
		border-radius: var(--radius-full);
		background: transparent;
		box-shadow: inset 0 0 0 1px transparent;
		transition:
			background-color 240ms var(--ease-step),
			box-shadow 240ms var(--ease-step);
	}

	/* El paso activo se acentua con un disco tenue y un aro del naranja. */
	.stepper__step.is-active .stepper__icon-slot {
		background: var(--step-accent-soft);
		box-shadow: inset 0 0 0 1px var(--step-accent-ring);
	}

	.stepper__step.is-complete .stepper__icon-slot {
		background: var(--ink-08);
	}

	.stepper__icon-slot.is-popping {
		animation: stepper-icon-pop 340ms var(--ease-step);
	}

	/* 1 -> 1.08 -> 1: se nota el cambio de paso sin rebotar. */
	@keyframes stepper-icon-pop {
		0% {
			transform: scale(1);
		}

		45% {
			transform: scale(1.08);
		}

		100% {
			transform: scale(1);
		}
	}

	.stepper__icon {
		width: 18px;
		height: 18px;
	}

	.stepper__text {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	/*
	 * El naranja de marca lo lleva el icono (contraste no textual, 3.31:1
