---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import {
	ShoppingBag,
	MapPin,
	CreditCard,
	Check,
	Trash2,
	Minus,
	Plus,
	Truck,
	PackageCheck,
	ReceiptText,
	ArrowLeft,
	UserRound,
	FileText,
	LockKeyhole,
} from "@lucide/astro";

const base = import.meta.env.BASE_URL;
const catalogHref = `${base}categorias/`;
const yapeQr = `${base}pagos/qr-yape_1.webp`;
const yapeLogo = `${base}icons/Yape_peru_logotype.svg`;
const whatsappIcon = `${base}icons/icon-whastapp.svg`;
---

<BaseLayout
	title="Carrito | TAQTO"
	description="Revisa tu carrito y completa tu pedido con TAQTO."
>
	<Header />

	<main class="cart-page">
		<nav class="cart-breadcrumbs" aria-label="Migas de pan">
			<a href={base}>Inicio</a>
			<span aria-hidden="true">/</span>
			<span>Carrito</span>
		</nav>

		<div class="checkout-shell">
			<h1 class="checkout-title">Finaliza tu compra</h1>

			<!--
				Stepper minimalista: la barra de progreso va separada de la
				fila de labels, asi ninguna linea atraviesa iconos ni texto.
			-->
			<nav class="stepper" aria-label="Progreso de compra">
				<div class="stepper__track" aria-hidden="true">
					<span
						class="stepper__progress"
						data-step-progress
					></span>
				</div>

				<ol class="stepper__list">
					<li
						class="stepper__step is-active"
						data-step-indicator="1"
						aria-current="step"
					>
						<span class="stepper__icon-slot">
							<ShoppingBag
								class="stepper__icon"
								aria-hidden="true"
								stroke-width={1.75}
							/>

							<Check
								class="stepper__icon stepper__icon--check"
								aria-hidden="true"
								stroke-width={1.75}
								hidden
							/>
						</span>

						<span class="stepper__text">
							<span class="stepper__number">Paso 1</span>
							<span class="stepper__name">Carrito</span>
						</span>

						<span class="stepper__state" data-step-state></span>
					</li>

					<li class="stepper__step" data-step-indicator="2">
						<span class="stepper__icon-slot">
							<MapPin
								class="stepper__icon"
								aria-hidden="true"
								stroke-width={1.75}
							/>

							<Check
								class="stepper__icon stepper__icon--check"
								aria-hidden="true"
								stroke-width={1.75}
								hidden
							/>
						</span>

						<span class="stepper__text">
							<span class="stepper__number">Paso 2</span>
							<span class="stepper__name">Datos de envío</span>
						</span>

						<span class="stepper__state" data-step-state></span>
					</li>

					<li class="stepper__step" data-step-indicator="3">
						<span class="stepper__icon-slot">
							<CreditCard
								class="stepper__icon"
								aria-hidden="true"
								stroke-width={1.75}
							/>

							<Check
								class="stepper__icon stepper__icon--check"
								aria-hidden="true"
								stroke-width={1.75}
								hidden
							/>
						</span>

						<span class="stepper__text">
							<span class="stepper__number">Paso 3</span>
							<span class="stepper__name">Pago</span>
						</span>

						<span class="stepper__state" data-step-state></span>
					</li>
				</ol>
			</nav>

			<!-- PASO 1: CARRITO -->
			<section class="cart-step is-active" data-step="1">
				<div class="checkout-grid">
					<div class="checkout-grid__main">
						<div class="cart-items" id="cart-items" data-cart-items>
						</div>

						<div class="cart-empty" id="cart-empty" hidden>
							<ShoppingBag
								class="cart-empty__icon"
								aria-hidden="true"
								stroke-width={1.75}
							/>

							<p class="cart-empty__title">
								Tu carrito está vacío
							</p>

							<p class="cart-empty__text">
								Añade una pieza del catálogo para continuar
								con tu pedido.
							</p>

							<a class="btn btn--primary cart-empty__link" href={catalogHref}>
								Ver catálogo
							</a>
						</div>
					</div>

					<aside class="checkout-aside">
						<div class="checkout-aside__panel">
							<p class="checkout-aside__label">
								<PackageCheck aria-hidden="true" stroke-width={1.75} />
								Resumen
							</p>

							<div class="cart-summary">
								<div class="cart-summary__row">
									<span>Subtotal</span>
									<strong id="cart-subtotal">S/ 0.00</strong>
								</div>

								<p class="cart-summary__note">
									<Truck aria-hidden="true" stroke-width={1.75} />
									El costo de envío se calcula en el
									siguiente paso.
								</p>
							</div>
						</div>

						<div class="cart-step-actions">
							<button
								type="button"
								class="btn btn--primary btn--full cart-primary-button"
								id="go-to-step-2"
								disabled
							>
								Continuar con mis datos
							</button>

							<a
								class="btn btn--secondary btn--full cart-secondary-button"
								href={catalogHref}
							>
								<ArrowLeft aria-hidden="true" stroke-width={1.75} />
								Seguir comprando
							</a>
						</div>
					</aside>
				</div>
			</section>

			<!-- PASO 2: DATOS DE ENVIO -->
			<section class="cart-step" data-step="2" hidden>
				<div class="checkout-grid">
					<form class="shipping-form" id="shipping-form">
						<h2 class="form-group-title">
							<UserRound aria-hidden="true" stroke-width={1.75} />
							Datos personales y dirección
						</h2>

						<div class="shipping-form__grid">
							<label class="shipping-field">
								<span>Nombres</span>
								<input
									type="text"
									name="firstName"
									required
									autocomplete="given-name"
								/>
							</label>

							<label class="shipping-field">
								<span>Apellidos</span>
								<input
									type="text"
									name="lastName"
									required
									autocomplete="family-name"
								/>
							</label>

							<label class="shipping-field">
								<span>Correo</span>
								<input
									type="email"
									name="email"
									required
									autocomplete="email"
								/>
							</label>

							<label class="shipping-field">
								<span>Número</span>
								<div class="phone-input">
									<span class="phone-input__prefix">
										<svg
											class="phone-input__flag"
											viewBox="0 0 3 2"
											aria-hidden="true"
										>
											<rect
												width="3"
												height="2"
												fill="#fff"></rect>
											<rect
												width="1"
												height="2"
												fill="#D91023"></rect>
											<rect
												x="2"
												width="1"
												height="2"
												fill="#D91023"></rect>
										</svg>
										+51
									</span>

									<input
										type="tel"
										name="phone"
										required
										pattern="9[0-9]{8}"
										maxlength="9"
										inputmode="numeric"
										placeholder="9XXXXXXXX"
										title="Número de celular peruano: 9 dígitos, empieza con 9."
										autocomplete="tel-national"
									/>
								</div>
							</label>

							<label class="shipping-field">
								<span>Departamento</span>
								<select
									id="select-departamento"
									name="departamento"
									required
								></select>
							</label>

							<label class="shipping-field">
								<span>Provincia</span>
								<select
									id="select-provincia"
									name="provincia"
									required
									disabled
								></select>
							</label>

							<label class="shipping-field">
								<span>Distrito</span>
								<select
									id="select-distrito"
									name="distrito"
									required
									disabled
								></select>
							</label>

							<label class="shipping-field shipping-field--full">
								<span>Dirección</span>
								<input
									type="text"
									name="direccion"
									required
									placeholder="Av./Jr./Calle, número, urbanización"
									autocomplete="street-address"
								/>
							</label>

							<label class="shipping-field shipping-field--full">
								<span>Referencia (opcional)</span>
								<input
									type="text"
									name="referencia"
									placeholder="Ej: frente al parque, edificio azul"
								/>
							</label>
						</div>

						<p
							class="shipping-method-preview"
							id="shipping-method-preview"
						>
							<Truck aria-hidden="true" stroke-width={1.75} />
							Elige tu departamento para ver el método y costo
							de envío.
						</p>

						<h2 class="form-group-title form-group-title--spaced">
							<FileText aria-hidden="true" stroke-width={1.75} />
							Personalización del envío
						</h2>

						<label class="shipping-field shipping-field--full">
							<span>Mensaje para la tarjeta de regalo (opcional)</span>
							<textarea
								name="giftMessage"
								rows="3"
								placeholder="Escribe aquí el mensaje que quieres incluir en la tarjeta de regalo"
							></textarea>
						</label>
					</form>

					<!--
						Resumen y acciones forman una sola unidad en el
						aside: en desktop viajan juntos al hacerse sticky y
						en movil caen en el orden aprobado (formulario,
						resumen, CTA, retroceso) sin duplicar nada.
					-->
					<aside class="checkout-aside">
						<div class="checkout-aside__panel">
							<p class="checkout-aside__label">
								<PackageCheck aria-hidden="true" stroke-width={1.75} />
								Tu pedido
							</p>

							<div
								class="order-aside__products"
								id="mini-products-summary"
							></div>

							<div class="order-aside__totals">
								<div class="order-summary__row">
									<span>Subtotal</span>
									<strong id="mini-subtotal">S/ 0.00</strong>
								</div>

								<div class="order-summary__row">
									<span id="mini-shipping-label">Envío</span>
									<strong id="mini-shipping-amount">—</strong>
								</div>

								<div
									class="order-summary__row order-summary__row--total"
								>
									<span>Total</span>
									<strong id="mini-total">S/ 0.00</strong>
								</div>
							</div>
						</div>

						<div class="cart-step-actions">
							<button
								type="button"
								class="btn btn--primary btn--full cart-primary-button"
								id="go-to-step-3"
							>
								Continuar al pago
							</button>

							<button
								type="button"
								class="btn btn--secondary btn--full cart-secondary-button"
								data-go-step="1"
							>
								<ArrowLeft aria-hidden="true" stroke-width={1.75} />
								Volver al carrito
							</button>
						</div>
					</aside>
				</div>
			</section>

			<!-- PASO 3: PAGO -->
			<section class="cart-step" data-step="3" hidden>
				<div class="checkout-grid checkout-grid--payment">
					<div class="order-summary">
						<div class="order-summary__block">
							<p class="order-summary__label">
								<UserRound aria-hidden="true" stroke-width={1.75} />
								Datos del cliente
							</p>
							<dl
								class="order-summary__list"
								id="order-customer-summary"
							></dl>
						</div>

						<div class="order-summary__block">
							<p class="order-summary__label">
								<PackageCheck aria-hidden="true" stroke-width={1.75} />
								Productos
							</p>
							<div
								class="order-summary__products"
								id="order-products-summary"
							></div>
						</div>

						<div class="order-summary__totals" id="order-totals">
							<p class="order-summary__label">
								<ReceiptText aria-hidden="true" stroke-width={1.75} />
								Total a pagar
							</p>

							<div class="order-summary__row">
								<span>Subtotal</span>
								<strong id="order-subtotal">S/ 0.00</strong>
							</div>

							<div class="order-summary__row">
								<span id="order-shipping-label">Envío</span>
								<strong id="order-shipping-amount">S/ 0.00</strong>
							</div>

							<div
								class="order-summary__row order-summary__row--total"
							>
								<span>Total</span>
								<strong id="order-total">S/ 0.00</strong>
							</div>
						</div>
					</div>

					<aside class="payment-aside">
						<div class="payment-panel">
							<h2
								class="payment-panel__title"
								id="payment-panel-title"
							>
								<CreditCard aria-hidden="true" stroke-width={1.75} />
								Elige cómo pagar
							</h2>

							<p class="payment-panel__hint">
								Al elegir un método, registramos tu
								pedido en nuestro sistema y te damos un
								código para confirmar el pago.
							</p>

							<div
								class="payment-options"
								role="radiogroup"
								aria-labelledby="payment-panel-title"
							>
								<label class="payment-option">
									<input
										class="payment-option__input"
										type="radio"
										name="paymentMethod"
										value="whatsapp"
										data-payment-method
									/>

									<span class="payment-option__logo">
										<img
											src={whatsappIcon}
											alt=""
											width="34"
											height="34"
										/>
									</span>

									<span class="payment-option__body">
										<span class="payment-option__name">
											Pedir por WhatsApp
										</span>
										<span class="payment-option__text">
											Te confirmamos tu pedido por chat
											y coordinamos la entrega contigo.
										</span>
									</span>

									<span
										class="payment-option__check"
										aria-hidden="true"
									>
										<Check stroke-width={1.75} />
									</span>
								</label>

								<label class="payment-option">
									<input
										class="payment-option__input"
										type="radio"
										name="paymentMethod"
										value="yape"
										data-payment-method
									/>

									<span class="payment-option__logo">
										<img
											class="payment-option__yape-logo"
											src={yapeLogo}
											alt="Yape"
											width="62"
											height="34"
										/>
									</span>

									<span class="payment-option__body">
										<span class="payment-option__name">
											Pagar con Yape
										</span>
										<span class="payment-option__text">
											Yapea al número de TAQTO y
											envíanos tu comprobante.
										</span>
									</span>

									<span
										class="payment-option__check"
										aria-hidden="true"
									>
										<Check stroke-width={1.75} />
									</span>
								</label>
							</div>

							<div class="cart-step-actions">
								<button
									type="button"
									class="btn btn--primary btn--full cart-primary-button"
									id="confirm-payment"
									disabled
								>
									<LockKeyhole aria-hidden="true" stroke-width={1.75} />
									Confirmar método de pago
								</button>

								<button
									type="button"
									class="btn btn--secondary btn--full cart-secondary-button"
									data-go-step="2"
								>
									<ArrowLeft aria-hidden="true" stroke-width={1.75} />
									Volver a datos de envío
								</button>
							</div>
						</div>

						<p
							class="order-confirm__error"
							id="order-confirm-error"
							role="alert"
							hidden
						></p>

						<div
							class="order-created"
							id="order-created-block"
							hidden
						>
							<p class="order-created__label">
								¡Pedido creado!
							</p>

							<p
								class="order-created__code"
								id="order-created-code"
							></p>

							<p class="order-created__hint">
								Guarda este código: lo vas a usar para
								confirmar tu pago.
							</p>
						</div>

						<div class="yape-panel" id="yape-panel" hidden>
							<img
								class="yape-panel__logo"
								src={yapeLogo}
								alt="Yape"
								width="72"
								height="38"
							/>

							<div class="yape-panel__details">
								<p>
									<span>Nombre</span>
									Gianmarco Santillán
								</p>
								<p>
									<span>Número</span>
									977 600 400
								</p>
							</div>

							<div class="yape-panel__qr-frame">
								<img
									class="yape-panel__qr"
									src={yapeQr}
									alt="Código QR de Yape para pagar"
									width="180"
									height="180"
								/>
							</div>

							<a
								class="btn btn--primary btn--full cart-primary-button"
								id="yape-send-proof"
								target="_blank"
								rel="noopener noreferrer"
							>
								Enviar comprobante
							</a>
						</div>
					</aside>
				</div>
			</section>
		</div>
	</main>

	<!-- Plantilla de linea de carrito con iconos Lucide reales. -->
	<template data-cart-item-template>
		<li class="cart-item">
			<span class="cart-item__media">
				<img data-role="image" alt="" loading="lazy" />
				<span class="cart-item__placeholder" data-role="placeholder">
					TAQTO
				</span>
			</span>

			<div class="cart-item__content">
				<p class="cart-item__title" data-role="title"></p>
				<p class="cart-item__variant" data-role="variant"></p>
				<p class="cart-item__engraving" data-role="engraving"></p>
				<p class="cart-item__price" data-role="unit-price"></p>
			</div>

			<div class="cart-item__qty" data-role="quantity">
				<button type="button" data-role="decrease">
					<Minus aria-hidden="true" stroke-width={1.75} />
				</button>

				<span data-role="quantity-value">1</span>

				<button type="button" data-role="increase">
					<Plus aria-hidden="true" stroke-width={1.75} />
				</button>
			</div>

			<p class="cart-item__line-total" data-role="line-total"></p>

			<button type="button" class="btn btn--danger cart-item__remove" data-role="remove">
				<Trash2 aria-hidden="true" stroke-width={1.75} />
				<span>Quitar</span>
			</button>
		</li>
	</template>
</BaseLayout>

<script>
	import {
		getCart,
		updateQuantity,
		removeItem,
		onCartUpdated,
		type CartItem,
	} from "../lib/cart";

	import { formatPEN } from "../lib/productPricing";

	import {
		getDepartamentos,
		getProvincias,
		getDistritos,
		getDepartamentoName,
		getProvinciaName,
		getDistritoName,
		isLimaMetropolitana,
		type UbigeoOption,
	} from "../lib/peruUbigeo";

	import {
		WHATSAPP_NUMBER,
		SHIPPING_COST,
	} from "../lib/constants";

	import { supabase } from "../lib/supabase";

	const escapeHtml = (value: string) =>
		value.replace(
			/[&<>"']/g,
			(char) =>
				({
					"&": "&amp;",
					"<": "&lt;",
					">": "&gt;",
					'"': "&quot;",
					"'": "&#39;",
				})[char] || char,
		);

	const steps = Array.from(
		document.querySelectorAll<HTMLElement>(
			"[data-step]",
		),
	);

	const stepIndicators = Array.from(
		document.querySelectorAll<HTMLElement>(
			"[data-step-indicator]",
		),
	);

	const stepProgress = document.querySelector<HTMLElement>(
		"[data-step-progress]",
	);

	const renderStepper = (stepNumber: number) => {
		// Paso 1: 0%. Paso 2: 50%. Paso 3: 100%.
		if (stepProgress) {
			stepProgress.style.width = `${
				((stepNumber - 1) / (stepIndicators.length - 1 || 1)) * 100
			}%`;
		}

		stepIndicators.forEach((indicator) => {
			const stepValue = Number(
				indicator.dataset.stepIndicator,
			);

			const isActive = stepValue === stepNumber;
			const isComplete = stepValue < stepNumber;

			indicator.classList.toggle("is-active", isActive);
			indicator.classList.toggle("is-complete", isComplete);

			if (isActive) {
				indicator.setAttribute("aria-current", "step");
			} else {
				indicator.removeAttribute("aria-current");
			}

			// El icono del paso se sustituye por un check cuando ya se
			// completo: el estado no depende solo del color.
			const stepIcon = indicator.querySelector<HTMLElement>(
				".stepper__icon:not(.stepper__icon--check)",
			);

			const checkIcon = indicator.querySelector<HTMLElement>(
				".stepper__icon--check",
			);

			if (stepIcon) stepIcon.hidden = isComplete;
			if (checkIcon) checkIcon.hidden = !isComplete;

			const stateLabel = indicator.querySelector<HTMLElement>(
				"[data-step-state]",
			);

			if (stateLabel) {
				stateLabel.textContent = isComplete
					? " (completado)"
					: isActive
						? " (paso actual)"
						: " (pendiente)";
			}
		});
	};

	const goToStep = (stepNumber: number) => {
		steps.forEach((section) => {
			const isActive =
				section.dataset.step === String(stepNumber);

			section.hidden = !isActive;
			section.classList.toggle("is-active", isActive);
		});

		renderStepper(stepNumber);

		window.scrollTo({ top: 0, behavior: "smooth" });
	};

	renderStepper(1);

	document
		.querySelectorAll<HTMLButtonElement>(
			"[data-go-step]",
		)
		.forEach((button) => {
			button.addEventListener("click", () => {
				goToStep(
					Number(button.dataset.goStep),
				);
			});
		});

	// ---------- PASO 1: CARRITO ----------

	const cartItemsContainer =
		document.querySelector<HTMLElement>(
			"#cart-items",
		)!;

	const cartEmptyState =
		document.querySelector<HTMLElement>(
			"#cart-empty",
		)!;

	const cartSubtotalLabel =
		document.querySelector<HTMLElement>(
			"#cart-subtotal",
		)!;

	const goToStep2Button =
		document.querySelector<HTMLButtonElement>(
			"#go-to-step-2",
		)!;

	const getCartSubtotal = (items: CartItem[]) =>
		items.reduce(
			(total, item) =>
				total + item.unitPrice * item.quantity,
			0,
		);

	const variantLabelOf = (item: CartItem) =>
		[item.woodTitle, item.sizeTitle]
			.filter(Boolean)
			.join(" · ");

	const cartItemTemplate =
		document.querySelector<HTMLTemplateElement>(
			"[data-cart-item-template]",
		)!;

	const buildCartRow = (item: CartItem) => {
		const row =
			cartItemTemplate.content.firstElementChild!.cloneNode(
				true,
			) as HTMLElement;

		const pick = <T extends HTMLElement>(role: string) =>
			row.querySelector<T>(`[data-role="${role}"]`);

		const image = pick<HTMLImageElement>("image");
		const placeholder = pick("placeholder");

		if (item.image && image) {
			image.src = item.image;
			image.alt = item.title;
			placeholder?.remove();
		} else {
			image?.remove();
		}

		const title = pick("title");
		if (title) title.textContent = item.title;

		const variantLabel = variantLabelOf(item);
		const variant = pick("variant");

		if (variant) {
			if (variantLabel) {
				variant.textContent = variantLabel;
			} else {
				variant.remove();
			}
		}

		const engraving = pick("engraving");

		if (engraving) {
			if (item.engravingText) {
				engraving.textContent = `Grabado: “${item.engravingText}”`;
			} else {
				engraving.remove();
			}
		}

		const unitPrice = pick("unit-price");

		if (unitPrice) {
			unitPrice.textContent = `${formatPEN(item.unitPrice)} c/u`;
		}

		pick("quantity")?.setAttribute(
			"aria-label",
			`Cantidad de ${item.title}`,
		);

		const quantityValue = pick("quantity-value");

		if (quantityValue) {
			quantityValue.textContent = String(item.quantity);
		}

		const decrease = pick<HTMLButtonElement>("decrease");

		if (decrease) {
			decrease.setAttribute(
				"aria-label",
				`Disminuir cantidad de ${item.title}`,
			);
			decrease.disabled = item.quantity <= 1;
			decrease.addEventListener("click", () => {
				updateQuantity(item.id, item.quantity - 1);
			});
		}

		const increase = pick<HTMLButtonElement>("increase");

		if (increase) {
			increase.setAttribute(
				"aria-label",
				`Aumentar cantidad de ${item.title}`,
			);
			increase.addEventListener("click", () => {
				updateQuantity(item.id, item.quantity + 1);
			});
		}

		const lineTotal = pick("line-total");

		if (lineTotal) {
			lineTotal.textContent = formatPEN(
				item.unitPrice * item.quantity,
			);
		}

		const remove = pick<HTMLButtonElement>("remove");

		if (remove) {
			remove.setAttribute(
				"aria-label",
				`Quitar ${item.title} del carrito`,
			);
			remove.addEventListener("click", () => {
				removeItem(item.id);
			});
		}

		return row;
	};

	const renderCartItems = () => {
		const items = getCart();
		const isEmpty = items.length === 0;

		cartItemsContainer.replaceChildren();
		cartEmptyState.hidden = !isEmpty;
		goToStep2Button.disabled = isEmpty;

		if (!isEmpty) {
			const list = document.createElement("ul");
			list.className = "cart-lines";

			items.forEach((item) => {
				list.appendChild(buildCartRow(item));
			});

			cartItemsContainer.appendChild(list);
		}

		cartSubtotalLabel.textContent = formatPEN(
			getCartSubtotal(items),
		);
	};

	renderCartItems();
	onCartUpdated(renderCartItems);

	goToStep2Button.addEventListener("click", () => {
		if (getCart().length === 0) return;
		goToStep(2);
	});

	// ---------- MINI RESUMEN (PASO 2) ----------

	const miniProductsSummary =
		document.querySelector<HTMLElement>(
			"#mini-products-summary",
		)!;

	const miniSubtotalLabel =
		document.querySelector<HTMLElement>(
			"#mini-subtotal",
		)!;

	const miniShippingLabelEl =
		document.querySelector<HTMLElement>(
			"#mini-shipping-label",
		)!;

	const miniShippingAmountLabel =
		document.querySelector<HTMLElement>(
			"#mini-shipping-amount",
		)!;

	const miniTotalLabel =
		document.querySelector<HTMLElement>(
			"#mini-total",
		)!;

	const renderProductLines = (
		container: HTMLElement,
		items: CartItem[],
	) => {
		container.innerHTML = items
			.map((item) => {
				const variant = variantLabelOf(item);

				return `
					<div class="order-summary__product">
						<span>
							${item.title}${variant ? ` — ${variant}` : ""}
							× ${item.quantity}
							${
								item.engravingText
									? `<br /><small>Grabado: “${escapeHtml(item.engravingText)}”</small>`
									: ""
							}
						</span>
						<strong>${formatPEN(item.unitPrice * item.quantity)}</strong>
					</div>
				`;
			})
			.join("");
	};

	const renderMiniSummary = () => {
		const items = getCart();
		const subtotal = getCartSubtotal(items);

		renderProductLines(miniProductsSummary, items);
		miniSubtotalLabel.textContent = formatPEN(subtotal);

		const departamentoValue =
			departamentoSelect.value;

		if (!departamentoValue) {
			miniShippingLabelEl.textContent = "Envío";
			miniShippingAmountLabel.textContent = "—";
			miniTotalLabel.textContent = formatPEN(subtotal);
			return;
		}

		const isLima = isLimaMetropolitana(
			departamentoValue,
		);

		miniShippingLabelEl.textContent = isLima
			? "Delivery (Lima)"
			: "Envío a agencia";

		miniShippingAmountLabel.textContent =
			formatPEN(SHIPPING_COST);

		miniTotalLabel.textContent = formatPEN(
			subtotal + SHIPPING_COST,
		);
	};

	// ---------- PASO 2: DATOS DE ENVIO ----------

	const shippingForm =
		document.querySelector<HTMLFormElement>(
			"#shipping-form",
		)!;

	const departamentoSelect =
		document.querySelector<HTMLSelectElement>(
			"#select-departamento",
		)!;

	const provinciaSelect =
		document.querySelector<HTMLSelectElement>(
			"#select-provincia",
		)!;

	const distritoSelect =
		document.querySelector<HTMLSelectElement>(
			"#select-distrito",
		)!;

	const shippingMethodPreview =
		document.querySelector<HTMLElement>(
			"#shipping-method-preview",
		)!;

	const populateSelect = (
		select: HTMLSelectElement,
		options: UbigeoOption[],
		placeholder: string,
	) => {
		select.innerHTML = "";

		const placeholderOption =
			document.createElement("option");

		placeholderOption.value = "";
		placeholderOption.textContent = placeholder;
		placeholderOption.disabled = true;
		placeholderOption.selected = true;

		select.appendChild(placeholderOption);

		options.forEach((option) => {
			const optionEl =
				document.createElement("option");

			optionEl.value = option.id;
			optionEl.textContent = option.name;
			select.appendChild(optionEl);
		});
	};

	const getShippingLabel = () => {
		if (!departamentoSelect.value) {
			return "Elige tu departamento para ver el método y costo de envío.";
		}

		const isLima = isLimaMetropolitana(
			departamentoSelect.value,
		);

		return isLima
			? `Delivery a domicilio (Lima Metropolitana) — ${formatPEN(SHIPPING_COST)}`
			: `Envío a agencia en tu ciudad — ${formatPEN(SHIPPING_COST)}`;
	};

	const updateShippingPreview = () => {
		shippingMethodPreview.textContent =
			getShippingLabel();

		renderMiniSummary();
	};

	populateSelect(
		departamentoSelect,
		getDepartamentos(),
		"Selecciona un departamento",
	);

	departamentoSelect.addEventListener(
		"change",
		() => {
			const provincias = getProvincias(
				departamentoSelect.value,
			);

			populateSelect(
				provinciaSelect,
				provincias,
				"Selecciona una provincia",
			);

			provinciaSelect.disabled =
				provincias.length === 0;

			populateSelect(
				distritoSelect,
				[],
				"Selecciona una provincia primero",
			);

			distritoSelect.disabled = true;

			updateShippingPreview();
		},
	);

	provinciaSelect.addEventListener("change", () => {
		const distritos = getDistritos(
			provinciaSelect.value,
		);

		populateSelect(
			distritoSelect,
			distritos,
			"Selecciona un distrito",
		);

		distritoSelect.disabled =
			distritos.length === 0;
	});

	onCartUpdated(renderMiniSummary);
	renderMiniSummary();

	const goToStep3Button =
		document.querySelector<HTMLButtonElement>(
			"#go-to-step-3",
		)!;

	goToStep3Button.addEventListener("click", () => {
		if (!shippingForm.reportValidity()) return;

		buildOrderSummary();
		goToStep(3);
	});

	// ---------- PASO 3: PAGO ----------

	const orderCustomerSummary =
		document.querySelector<HTMLElement>(
			"#order-customer-summary",
		)!;

	const orderProductsSummary =
		document.querySelector<HTMLElement>(
			"#order-products-summary",
		)!;

	const orderSubtotalLabel =
		document.querySelector<HTMLElement>(
			"#order-subtotal",
		)!;

	const orderShippingLabelEl =
		document.querySelector<HTMLElement>(
			"#order-shipping-label",
		)!;

	const orderShippingAmountLabel =
		document.querySelector<HTMLElement>(
			"#order-shipping-amount",
		)!;

	const orderTotalLabel =
		document.querySelector<HTMLElement>(
			"#order-total",
		)!;

	const getCustomerData = () => {
		const formData = new FormData(shippingForm);

		const departamentoId = String(
			formData.get("departamento") || "",
		);

		const provinciaId = String(
			formData.get("provincia") || "",
		);

		const distritoId = String(
			formData.get("distrito") || "",
		);

		return {
			firstName: String(
				formData.get("firstName") || "",
			),
			lastName: String(
				formData.get("lastName") || "",
			),
			email: String(formData.get("email") || ""),
			phone: `+51 ${String(formData.get("phone") || "")}`,
			departamento:
				getDepartamentoName(departamentoId),
			provincia: getProvinciaName(provinciaId),
			distrito: getDistritoName(distritoId),
			direccion: String(
				formData.get("direccion") || "",
			),
			referencia: String(
				formData.get("referencia") || "",
			),
			giftMessage: String(
				formData.get("giftMessage") || "",
			),
			isLima: isLimaMetropolitana(departamentoId),
		};
	};

	const buildOrderSummary = () => {
		const customer = getCustomerData();
		const items = getCart();
		const subtotal = getCartSubtotal(items);
		const total = subtotal + SHIPPING_COST;

		const shippingLabel = customer.isLima
			? "Delivery a domicilio (Lima Metropolitana)"
			: "Envío a agencia en tu ciudad";

		orderCustomerSummary.innerHTML = `
			<div>
				<dt>Nombre</dt>
				<dd>${customer.firstName} ${customer.lastName}</dd>
			</div>
			<div>
				<dt>Correo</dt>
				<dd>${customer.email}</dd>
			</div>
			<div>
				<dt>Teléfono</dt>
				<dd>${customer.phone}</dd>
			</div>
			<div>
				<dt>Dirección</dt>
				<dd>${customer.direccion}${
					customer.referencia
						? ` (${customer.referencia})`
						: ""
				}</dd>
			</div>
			<div>
				<dt>Ubicación</dt>
				<dd>${customer.distrito}, ${customer.provincia}, ${customer.departamento}</dd>
			</div>
			${
				customer.giftMessage
					? `<div><dt>Tarjeta de regalo</dt><dd>${customer.giftMessage}</dd></div>`
					: ""
			}
		`;

		renderProductLines(orderProductsSummary, items);

		orderSubtotalLabel.textContent =
			formatPEN(subtotal);

		orderShippingLabelEl.textContent = shippingLabel;
		orderShippingAmountLabel.textContent =
			formatPEN(SHIPPING_COST);

		orderTotalLabel.textContent = formatPEN(total);
	};

	const buildWhatsAppOrderMessage = (
		orderCode: string,
	) =>
		`Hola TAQTO, acabo de registrar el pedido ${orderCode}. Quisiera confirmar el pago y la personalización.`;

	const buildWhatsAppReceiptMessage = (
		orderCode: string,
	) =>
		`Hola TAQTO, ya yapeé el pedido ${orderCode}. Adjunto la captura del comprobante.`;

	// ---------- CREAR PEDIDO EN SUPABASE ----------

	let createdOrderCode: string | null = null;
	let orderCreationInFlight = false;

	const orderConfirmError =
		document.querySelector<HTMLElement>(
			"#order-confirm-error",
		)!;

	const orderCreatedBlock =
		document.querySelector<HTMLElement>(
			"#order-created-block",
		)!;

	const orderCreatedCode =
		document.querySelector<HTMLElement>(
			"#order-created-code",
		)!;

	const paymentMethodInputs = Array.from(
		document.querySelectorAll<HTMLInputElement>(
			"[data-payment-method]",
		),
	);

	const confirmPaymentButton =
		document.querySelector<HTMLButtonElement>(
			"#confirm-payment",
		)!;

	const yapePanel =
		document.querySelector<HTMLElement>(
			"#yape-panel",
		)!;

	const yapeSendProofLink =
		document.querySelector<HTMLAnchorElement>(
			"#yape-send-proof",
		)!;

	const buildOrderItemsPayload = (items: CartItem[]) =>
		items.map((item) => ({
			sanityProductId: item.productId,
			sanityProductSlug: item.slug,
			productName: item.title,
			productSku: item.sku,
			woodName: item.woodTitle || null,
			woodSlug: item.woodSlug || null,
			sizeName: item.sizeTitle || null,
			sizeSlug: item.sizeSlug || null,
			dimensionsLabel: item.dimensionsLabel || null,
			engravingText: item.engravingText || null,
			quantity: item.quantity,
			unitPrice: item.unitPrice,
		}));

	const ensureOrderCreated = async (
		paymentMethod: "yape" | "cash_on_delivery",
	): Promise<string | null> => {
		if (createdOrderCode) return createdOrderCode;
		if (orderCreationInFlight) return null;

		const customer = getCustomerData();
		const items = getCart();

		if (items.length === 0) return null;

		if (!supabase) {
			orderConfirmError.textContent =
				"El registro de pedidos no está disponible en este momento. Escríbenos directo por WhatsApp para completar tu compra.";

			orderConfirmError.hidden = false;
			return null;
		}

		const subtotal = getCartSubtotal(items);
		const total = subtotal + SHIPPING_COST;

		orderCreationInFlight = true;
		orderConfirmError.hidden = true;

		confirmPaymentButton.classList.add("is-loading");

		const { data, error } = await supabase.rpc(
			"create_order",
			{
				p_payment_method: paymentMethod,
				p_delivery_method: customer.isLima
					? "lima_delivery"
					: "province_agency",
				p_customer_first_name: customer.firstName,
				p_customer_last_name: customer.lastName,
				p_customer_email: customer.email,
				p_customer_phone: customer.phone,
				p_delivery_department: customer.departamento,
				p_delivery_province: customer.provincia,
				p_delivery_district: customer.distrito,
				p_delivery_address: customer.direccion,
				p_delivery_reference:
					customer.referencia || null,
				p_customer_notes: customer.giftMessage
					? `Mensaje para la tarjeta de regalo: ${customer.giftMessage}`
					: null,
				p_subtotal: subtotal,
				p_delivery_cost: SHIPPING_COST,
				p_total: total,
				p_items: buildOrderItemsPayload(items),
			},
		);

		orderCreationInFlight = false;
		confirmPaymentButton.classList.remove("is-loading");

		if (error || !data) {
			orderConfirmError.textContent =
				"No pudimos registrar tu pedido. Intenta de nuevo o escríbenos directo por WhatsApp.";

			orderConfirmError.hidden = false;
			return null;
		}

		createdOrderCode = data as string;
		orderCreatedBlock.hidden = false;
		orderCreatedCode.textContent = createdOrderCode;

		return createdOrderCode;
	};

	// El pedido y su integracion no cambian: solo se separa "elegir
	// metodo" de "confirmar", como pide la nueva composicion del paso 3.
	const payWithWhatsApp = async () => {
		const code = await ensureOrderCreated(
			"cash_on_delivery",
		);

		if (!code) return;

		const message = encodeURIComponent(
			buildWhatsAppOrderMessage(code),
		);

		window.open(
			`https://wa.me/${WHATSAPP_NUMBER}?text=${message}`,
			"_blank",
			"noopener,noreferrer",
		);

		orderCreatedBlock.scrollIntoView({
			behavior: "smooth",
			block: "center",
		});
	};

	const payWithYape = async () => {
		const code = await ensureOrderCreated("yape");

		if (!code) return;

		yapePanel.hidden = false;

		const message = encodeURIComponent(
			buildWhatsAppReceiptMessage(code),
		);

		yapeSendProofLink.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${message}`;

		yapePanel.scrollIntoView({
			behavior: "smooth",
			block: "center",
		});
	};

	const selectedPaymentMethod = () =>
		paymentMethodInputs.find((input) => input.checked)?.value ?? null;

	const renderPaymentSelection = () => {
		paymentMethodInputs.forEach((input) => {
			input
				.closest(".payment-option")
				?.classList.toggle("is-selected", input.checked);
		});

		confirmPaymentButton.disabled = !selectedPaymentMethod();
	};

	paymentMethodInputs.forEach((input) => {
		input.addEventListener("change", renderPaymentSelection);

		input.addEventListener("focus", () => {
			input
				.closest(".payment-option")
				?.classList.toggle(
					"is-focused",
					input.matches(":focus-visible"),
				);
		});

		input.addEventListener("blur", () => {
			input
				.closest(".payment-option")
				?.classList.remove("is-focused");
		});
	});

	renderPaymentSelection();

	confirmPaymentButton.addEventListener("click", () => {
		const method = selectedPaymentMethod();

		if (method === "whatsapp") {
			void payWithWhatsApp();
		} else if (method === "yape") {
			void payWithYape();
		}
	});
</script>

<style is:global>
	.cart-page {
		padding-block: clamp(28px, 4vw, 48px) clamp(48px, 6vw, 72px);
		background: var(--surface);
		color: var(--color-black);
	}

	.cart-breadcrumbs {
		width: min(calc(100% - 40px), 1360px);
		margin: 0 auto 20px;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		color: var(--ink-55);
		font-size: var(--text-xs);
	}

	.cart-breadcrumbs a {
		color: inherit;
		text-decoration: none;
	}

	.cart-breadcrumbs a:hover {
		color: var(--color-black);
		text-decoration: underline;
	}

	.checkout-shell {
		width: min(calc(100% - 40px), 1360px);
		margin-inline: auto;
	}

	.checkout-title {
		margin: 0 0 clamp(24px, 3vw, 34px);
		font-size: var(--text-2xl);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: var(--leading-tight);
	}

	/* ---------- Stepper ---------- */

	.stepper {
		margin: 0 0 clamp(30px, 4vw, 44px);
	}

	/* Barra de progreso: no atraviesa iconos, texto ni nodos. */
	.stepper__track {
		height: 4px;
		overflow: hidden;
		border-radius: var(--radius-full);
		background: var(--ink-08);
	}

	.stepper__progress {
		display: block;
		width: 0%;
		height: 100%;
		border-radius: inherit;
		background: var(--color-orange);
		transition: width 260ms cubic-bezier(0.33, 1, 0.68, 1);
	}

	.stepper__list {
		margin: 14px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
		list-style: none;
	}

	.stepper__step {
		display: flex;
		align-items: flex-start;
		gap: 9px;
		color: var(--ink-35);
	}

	.stepper__icon-slot {
		flex: 0 0 18px;
		width: 18px;
		height: 18px;
		margin-top: 2px;
		display: grid;
		place-items: center;
	}

	.stepper__icon {
		width: 18px;
		height: 18px;
	}

	.stepper__text {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	/*
	 * El naranja de marca lo lleva el icono (contraste no textual, 3.31:1
	 * sobre blanco, por encima del minimo de 3:1). El texto auxiliar se
	 * queda en tinta para no bajar de AA a 11.5px.
	 */
	.stepper__number {
		color: var(--ink-70);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.05em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.stepper__step.is-active .stepper__number {
		color: var(--color-black);
		font-weight: 600;
	}

	.stepper__name {
		color: var(--ink-55);
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: var(--leading-snug);
	}

	/* Activo en naranja, completado en tinta, pendiente en gris. El
	   estado nunca depende solo del color: el icono cambia a `Check` y
	   hay texto para lector de pantalla. */
	.stepper__step.is-active {
		color: var(--color-orange);
	}

	.stepper__step.is-active .stepper__name {
		color: var(--color-black);
		font-weight: 600;
	}

	.stepper__step.is-complete {
		color: var(--color-black);
	}

	.stepper__step.is-complete .stepper__name {
		color: var(--ink-70);
	}

	.stepper__state {
		position: absolute;
		width: 1px;
