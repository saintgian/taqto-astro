	 * asi que nunca coexisten dos secciones ocupando espacio.
	 */
	.cart-step.cart-step--leaving {
		opacity: 0;
		transition: opacity 130ms var(--ease-step);
	}

	/*
	 * Avanzar entra desde abajo, retroceder desde arriba: el sentido del
