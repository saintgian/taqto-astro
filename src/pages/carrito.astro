	 */
	.cart-step.cart-step--entering {
		opacity: 0;
		transform: translateY(6px);
	}

	.cart-step.cart-step--entering-back {
		transform: translateY(-6px);
	}

	.cart-step.cart-step--enter-active {
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 300ms var(--ease-step),
			transform 300ms var(--ease-step);
