---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import InfoCard from "../components/InfoCard.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import {
	Trees,
	FileText,
	ScanLine,
	TreePine,
	ListChecks,
	CircleQuestionMark,
	Ruler,
	Hammer,
	Users,
} from "@lucide/astro";

const base = import.meta.env.BASE_URL;
const productos = `${base}categorias/`;
const cuidados = `${base}cuidados/`;
const nosotros = `${base}nosotros/`;

const wa = "https://wa.me/51977600400";

const origen = [
	{
		icon: Trees,
		label: "Origen",
		value: "Madera peruana",
		hint: "Parte vinculada al territorio amazónico.",
	},
	{
		icon: FileText,
		label: "Respaldo",
		value: "Proveedores certificados",
		hint: "Con documentación vigente.",
	},
	{
		icon: ScanLine,
		label: "Trazabilidad",
		value: "Especie y lote",
		hint: "Registrados antes de transformar el material.",
	},
];

const valoramos = [
	"Su diversidad de tonos y vetas.",
	"Su relación con el territorio peruano.",
	"Su capacidad para acompañar objetos de uso cotidiano.",
	"La calidez que aporta a hogares, mesas y espacios de trabajo.",
	"La posibilidad de crear piezas con identidad propia.",
	"Su conexión con una tradición local de trabajo en madera.",
];

const criterio = [
	"Seleccionar proveedores formales y certificados.",
	"Solicitar documentación relacionada con la procedencia.",
	"Identificar las especies utilizadas.",
	"Mantener información de trazabilidad de los materiales.",
	"Comunicar certificaciones únicamente cuando existe respaldo vigente.",
	"Evitar afirmaciones ambientales absolutas que no puedan demostrarse.",
];

const trazabilidad = [
	{
		title: "Selección del proveedor",
		text: "Trabajamos con proveedores que puedan respaldar formalmente los materiales que ofrecen.",
	},
	{
		title: "Identificación de la madera",
		text: "Registramos la especie y la información disponible del lote.",
	},
	{
		title: "Revisión del material",
		text: "Evaluamos tono, veta, estructura y características de uso.",
	},
	{
		title: "Diseño y fabricación",
		text: "Cada pieza se trabaja considerando las propiedades reales de la madera.",
	},
	{
		title: "Producto terminado",
		text: "La madera conserva su identidad natural dentro de un objeto funcional y contemporáneo.",
	},
];

const especies = [
	{
		slug: "huayruro",
		title: "Huayruro",
		text: "Una madera de presencia marcada, reconocible por sus tonos cálidos y variaciones expresivas. Se utiliza en piezas donde la veta y el carácter visual tienen un papel importante.",
	},
	{
		slug: "pumaquiro",
		title: "Pumaquiro",
		text: "Una alternativa versátil para diferentes tipos de producto y niveles de producción. Su expresión puede variar según el corte y las características naturales de cada pieza.",
	},
	{
		slug: "cachimbo",
		title: "Cachimbo",
		text: "Una madera que funciona como alternativa intermedia dentro de nuestro sistema de materiales. Permite desarrollar piezas cálidas y funcionales para diferentes contextos de uso.",
	},
	{
		slug: "shihuahuaco",
		title: "Shihuahuaco",
		text: "Se trabaja de manera limitada y únicamente cuando la documentación legal y la trazabilidad del lote respaldan su utilización. Su incorporación depende de la disponibilidad y de las condiciones verificables del material.",
	},
];

const historias = [
	{
		icon: Trees,
		title: "El bosque",
		text: "El territorio y las condiciones naturales en las que se desarrolló la madera.",
	},
	{
		icon: TreePine,
		title: "El material",
		text: "Una especie con características particulares de tono, veta y estructura.",
	},
	{
		icon: Hammer,
		title: "El taller",
		text: "Las manos, herramientas y procesos que transforman el material.",
	},
	{
		icon: Ruler,
		title: "El diseño",
		text: "Una forma pensada para cumplir una función concreta.",
	},
	{
		icon: Users,
		title: "La persona",
		text: "El uso, los momentos y los recuerdos que se incorporan con el tiempo.",
	},
];

const variaciones = [
	"Dirección de la veta.",
	"Intensidad del tono.",
	"Contraste entre zonas.",
	"Distribución de líneas naturales.",
	"Pequeños rasgos propios de la madera.",
	"Cambios graduales producidos por el tiempo y el uso.",
];

const duracion = [
	"Elegir una pieza adecuada para el uso esperado.",
	"Utilizarla según su función.",
	"Limpiarla de acuerdo con el material y acabado.",
	"Evitar el lavavajillas y el remojo prolongado.",
	"Secarla después de la limpieza.",
	"Evitar la exposición continua al sol o al calor intenso.",
	"Mantenerla y renovarla cuando el acabado lo requiera.",
];

const sostenibilidad = [
	{
		title: "Origen documentado",
		text: "Trabajar con información verificable del proveedor o lote.",
	},
	{
		title: "Materialidad honesta",
		text: "Mostrar la madera como es, sin ocultar artificialmente sus variaciones.",
	},
	{
		title: "Diseño útil",
		text: "Utilizar el material para crear objetos con una función real.",
	},
	{
		title: "Uso consciente",
		text: "Ayudar al cliente a elegir, utilizar y cuidar correctamente cada pieza.",
	},
	{
		title: "Mejora continua",
		text: "Revisar materiales, proveedores y procesos a medida que TAQTO crece.",
	},
];

const faqs = [
	{
		q: "¿TAQTO utiliza madera peruana?",
		a: "Sí. La madera peruana forma parte central de nuestro sistema de productos y de nuestra identidad como marca.",
	},
	{
		q: "¿La madera proviene de proveedores certificados?",
		a: "Trabajamos con proveedores certificados y documentación vigente relacionada con la procedencia de los materiales.",
	},
	{
		q: "¿Qué certificaciones tienen los proveedores?",
		a: "Las certificaciones pueden variar según el proveedor y el lote. La información específica debe comunicarse únicamente cuando la certificación correspondiente se encuentre vigente y disponible para verificación.",
	},
	{
		q: "¿Todas las maderas provienen de la Amazonía peruana?",
		a: "Parte de las especies utilizadas está vinculada con el territorio amazónico peruano. El origen específico depende de la especie, el proveedor y el lote correspondiente.",
	},
	{
		q: "¿Qué especies utiliza TAQTO?",
		a: "Nuestro sistema contempla huayruro, pumaquiro, cachimbo y shihuahuaco, además de otras combinaciones de materiales según el producto y la disponibilidad.",
	},
	{
		q: "¿Utilizan shihuahuaco?",
		a: "El shihuahuaco se trabaja de manera limitada y únicamente cuando la documentación legal y la trazabilidad del lote respaldan su utilización.",
	},
	{
		q: "¿Por qué dos productos del mismo modelo pueden verse diferentes?",
		a: "Porque la madera es un material natural. La veta, el tono y los matices cambian de una pieza a otra, incluso cuando el modelo y las medidas son iguales.",
	},
	{
		q: "¿Una variación de veta se considera un defecto?",
		a: "No. Las variaciones naturales de veta, tono y textura forman parte de la identidad del material y no representan por sí mismas un defecto.",
	},
	{
		q: "¿Qué significa trazabilidad?",
		a: "Es la información que permite relacionar el material con su especie, proveedor, lote y documentación disponible antes de su transformación.",
	},
	{
		q: "¿TAQTO es una marca completamente sostenible?",
		a: "Preferimos no utilizar afirmaciones ambientales absolutas. Comunicamos aquello que podemos respaldar: proveedores certificados, documentación, identificación de especies, materialidad honesta y productos pensados para permanecer.",
	},
	{
		q: "¿Cómo puedo cuidar una pieza de madera?",
		a: "Los cuidados dependen del producto y del acabado. Como regla general, evita el lavavajillas, el remojo prolongado, el sol directo y las fuentes intensas de calor.",
	},
];
---

<PageLayout
	title="Madera peruana y origen responsable | TAQTO"
	description="Conoce las maderas peruanas de TAQTO, su origen, trazabilidad, proveedores certificados y la historia natural que hace diferente a cada pieza."
>
	<PageHero
		eyebrow="Material y origen"
		title="Madera peruana con origen responsable"
		lede="Cada pieza comienza mucho antes de llegar a nuestro taller: en la historia natural de la madera, en los bosques del Perú y en una cadena de proveedores que debe trabajar con documentación, trazabilidad y responsabilidad."
		split="7-5"
	>
		<p class="lede measure-lede" style="margin-top:14px">
			En TAQTO elegimos madera peruana para crear objetos contemporáneos
			que conserven la identidad, la calidez y las variaciones reales del
			material.
		</p>

		<div class="actions">
			<a href="#material" class="btn btn--primary">
				Conocer nuestras maderas
			</a>

			<a href={productos} class="sp-btn sp-btn--ghost">
				Explorar productos
			</a>
		</div>

		<p class="note">
			Trabajamos con proveedores certificados y documentación vigente.
		</p>

		<div slot="aside">
			<p class="facts-caption">De dónde viene el material</p>

			<ul class="facts">
				{
					origen.map((item) => {
						const Icon = item.icon;

						return (
							<li>
								<Icon
									class="facts__icon"
									aria-hidden="true"
									size={20}
									stroke-width={1.75}
								/>

								<div>
									<p class="facts__label">{item.label}</p>
									<p class="facts__value">{item.value}</p>
									<p class="facts__hint">{item.hint}</p>
								</div>
							</li>
						);
					})
				}
			</ul>
		</div>
	</PageHero>

	<!-- La madera como material: encabezado 5 + relato 7 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5 flow" style="--flow:15px">
					<h2>La madera no es solamente una materia prima</h2>

					<p class="pull">
						Una pieza de madera no comienza cuando la fabricamos. Su
						historia ya estaba escrita en la veta.
					</p>
				</div>

				<div class="c7 flow measure" style="--flow:15px">
					<p>Cada tabla conserva señales de su origen.</p>

					<p>
						La dirección de la veta, los cambios de tono, la
						densidad y los pequeños rasgos naturales se forman
						durante el crecimiento del árbol. Por eso no existen dos
						piezas exactamente iguales.
					</p>

					<p>
						Nuestro trabajo no busca borrar esas diferencias. Busca
						comprenderlas, seleccionarlas y convertirlas en parte
						visible del diseño.
					</p>

					<p>
						Cada producto TAQTO reúne así varias historias: la del
						bosque, la del material, la del taller y la de la
						persona que finalmente lo utiliza.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Nuestro material: relato 6 + lista 6 -->
	<section class="sect" id="material">
		<div class="wrap">
			<div class="g12">
				<div class="c6 flow" style="--flow:15px">
					<p class="eyebrow">Nuestro material</p>

					<h2>Diseñamos con madera peruana</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Elegir madera peruana es una decisión vinculada con
							nuestra identidad como marca y con la manera en que
							entendemos el diseño.
						</p>

						<p>
							Las especies que utilizamos presentan diferentes
							tonos, vetas, densidades y comportamientos. Estas
							características influyen en la apariencia, el peso,
							el uso y la construcción de cada producto.
						</p>

						<p>
							En lugar de uniformar artificialmente todas las
							piezas, trabajamos reconociendo las propiedades
							reales del material.
						</p>
					</div>
				</div>

				<div class="c6 flow" style="--flow:18px">
					<p class="strong-line">Lo que valoramos de la madera peruana:</p>

					<ul class="list">
						{valoramos.map((item) => <li>{item}</li>)}
					</ul>

					<div class="actions">
						<a href={productos} class="sp-btn sp-btn--ghost">
							Explorar piezas de madera peruana
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Amazonía: relato 7 + cita 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<p class="eyebrow">Territorio y origen</p>

					<h2>Una materialidad conectada con la Amazonía peruana</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							Los bosques de la Amazonía peruana albergan una gran
							diversidad de especies, tonalidades y estructuras
							naturales.
						</p>

						<p>
							Parte de las maderas que llegan a nuestro taller se
							vincula con este territorio. Por eso entendemos que
							su uso exige más que una elección estética: requiere
							conocer su procedencia y trabajar con proveedores
							que puedan respaldar el origen del material.
						</p>

						<p>
							La Amazonía no es una textura decorativa ni un
							argumento publicitario. Es un ecosistema vivo del
							que provienen materiales con una historia, un valor
							y una responsabilidad.
						</p>
					</div>
				</div>

				<div class="c5">
					<p class="pull">
						Hablar del origen de la madera también significa
						reconocer el territorio del que proviene.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Proveedores certificados -->
	<section class="sect sect--tint">
		<div class="wrap">
			<div class="g12">
				<div class="c6 flow" style="--flow:15px">
					<p class="eyebrow">Respaldo documental</p>

					<h2>Trabajamos con proveedores certificados</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							TAQTO adquiere madera mediante proveedores
							certificados que respaldan la procedencia de los
							materiales con documentación vigente.
						</p>

						<p>
							Esta información permite tomar decisiones más
							responsables sobre las especies, los lotes y las
							condiciones en las que una madera puede incorporarse
							a nuestros productos.
						</p>

						<p>
							La certificación y la trazabilidad no deben
							funcionar como frases decorativas. Deben estar
							asociadas a información real y verificable.
						</p>
					</div>

					<p class="pull">
						La confianza no se construye con una etiqueta verde. Se
						construye con información que puede comprobarse.
					</p>
				</div>

				<div class="c6 flow" style="--flow:18px">
					<div class="card">
						<span class="card__icon">
							<ListChecks
								aria-hidden="true"
								size={20}
								stroke-width={1.75}
							/>
						</span>

						<h3 class="card__title card__title--sm">
							Nuestro criterio de trabajo
						</h3>

						<ul class="list">
							{criterio.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<div class="actions">
						<a href="#especies" class="btn btn--primary">
							Conocer nuestros materiales
						</a>

						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="sp-btn sp-btn--ghost"
						>
							Consultar sobre una especie
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Trazabilidad: del proveedor al taller -->
	<section class="sect">
		<div class="wrap">
			<div class="sect__head">
				<h2>Del proveedor al taller</h2>

				<p class="lede measure-lede">
					La trazabilidad permite conservar información sobre la
					madera antes de transformarla en un producto terminado.
					Dependiendo de la especie y del lote, esta documentación
					puede incluir información del proveedor, identificación del
					material, procedencia y respaldos comerciales o legales.
				</p>
			</div>

			<ProcessSteps steps={trazabilidad} cols={3} />

			<p class="note measure" style="margin-top:clamp(24px,2.6vw,34px)">
				Esto no significa que todas las piezas sean idénticas. La
				documentación ayuda a conocer el origen; la veta y el tono
				continúan siendo naturalmente variables.
			</p>
		</div>
	</section>

	<!-- Especies en uso, con fotografía real de cada madera -->
	<section class="sect" id="especies">
		<div class="wrap">
			<div class="sect__head">
				<p class="eyebrow">Especies en uso</p>

				<h2>Diferentes maderas, diferentes expresiones</h2>

				<p class="lede measure-lede">
					Cada especie presenta cualidades propias. Su tono, dibujo,
					densidad y disponibilidad influyen en el tipo de producto
					para el que puede utilizarse.
				</p>
			</div>

			<ul class="cards species" style="--cols:4">
				{
					especies.map((especie) => (
						<li>
							<article class="card species__card">
								<img
									class="species__photo"
									src={`${base}images/home/maderas/${especie.slug}.webp`}
									alt={`Textura y veta de la madera ${especie.title.toLowerCase()}.`}
									width="1320"
									height="990"
									loading="lazy"
									decoding="async"
								/>

								<h3 class="card__title card__title--sm">
									{especie.title}
								</h3>

								<div class="card__body">
									<p>{especie.text}</p>
								</div>
							</article>
						</li>
					))
				}
			</ul>

			<div class="species__footer">
				<p class="note">
					Las especies disponibles pueden cambiar según el producto, el
					lote y la documentación vigente.
				</p>

				<div class="actions">
					<a href={productos} class="sp-btn sp-btn--ghost">
						Ver productos disponibles
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Una veta que no puede repetirse -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c4 flow" style="--flow:15px">
					<h2>Una veta que no puede repetirse</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							La madera registra su crecimiento mediante líneas,
							cambios de color y variaciones de textura.
						</p>

						<p>
							Cuando transformamos el material, esa información no
							desaparece. Permanece visible en la superficie, en
							el canto y en los detalles de cada producto.
						</p>

						<p>
							Por eso dos tablas del mismo modelo pueden presentar
							diferencias naturales sin dejar de responder al
							mismo diseño, medida o función. La geometría puede
							repetirse. La veta, no.
						</p>
					</div>
				</div>

				<ul class="cards c8" style="--cols:3">
					{
						historias.map((item) => (
							<li>
								<InfoCard
									icon={item.icon}
									title={item.title}
									variant="plain"
									compactTitle
								>
									<p>{item.text}</p>
								</InfoCard>
							</li>
						))
					}
				</ul>
			</div>

			<p class="pull" style="margin-top:clamp(28px,3vw,40px)">
				Cada pieza llega con una historia natural y continúa
				escribiéndola a través del uso.
			</p>
		</div>
	</section>

	<!-- Variaciones naturales: relato 7 + lista 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<p class="eyebrow">Ninguna pieza es idéntica</p>

					<h2>La variación forma parte del material</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							Las fotografías de nuestros productos son
							referenciales.
						</p>

						<p>
							La veta, el tono, los matices y ciertos detalles
							naturales pueden variar entre una pieza y otra.
							Estas diferencias no son errores ni imitaciones del
							material: son consecuencia de trabajar con madera
							real.
						</p>

						<p>
							Incluso dentro de una misma tabla pueden convivir
							zonas más claras, oscuras, rectas o expresivas.
						</p>

						<p class="pull">
							No buscamos que la madera parezca artificialmente
							uniforme. Buscamos que cada pieza conserve una
							identidad auténtica.
						</p>
					</div>
				</div>

				<div class="c5">
					<ul class="list">
						{variaciones.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Uso y duración: relato 5 + lista 7 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5 flow" style="--flow:15px">
					<p class="eyebrow">Uso y duración</p>

					<h2>El cuidado también forma parte de la responsabilidad</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							La relación responsable con la madera no termina
							cuando se fabrica el producto.
						</p>

						<p>
							Diseñar objetos funcionales, reparables cuando
							corresponda y pensados para utilizarse durante el
							tiempo ayuda a evitar que el material se convierta
							rápidamente en un objeto descartable. El cuidado
							adecuado también prolonga la vida de cada pieza.
						</p>
					</div>
				</div>

				<div class="c7 flow" style="--flow:20px">
					<ul class="list list--cols">
						{duracion.map((item) => <li>{item}</li>)}
					</ul>

					<div class="actions">
						<a href={cuidados} class="btn btn--primary">
							Ver guía de cuidados
						</a>

						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="sp-btn sp-btn--ghost"
						>
							Consultar sobre mi producto
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Precisión antes que promesas -->
	<section class="sect sect--tint">
		<div class="wrap">
			<div class="sect__head">
				<h2>Precisión antes que promesas</h2>

				<p class="lede measure-lede">
					Para TAQTO, comunicar sostenibilidad significa hablar con
					claridad sobre aquello que podemos respaldar: proveedores
					certificados, documentación, especies identificadas,
					variaciones naturales respetadas y productos pensados para
					permanecer.
				</p>
			</div>

			<ul class="cards" style="--cols:3">
				{
					sostenibilidad.map((item) => (
						<li>
							<InfoCard title={item.title} compactTitle>
								<p>{item.text}</p>
							</InfoCard>
						</li>
					))
				}
			</ul>

			<p class="note measure" style="margin-top:clamp(24px,2.6vw,34px)">
				No utilizamos expresiones como “cero impacto”, “completamente
				ecológico” o “100 % sostenible” cuando no existe evidencia
				suficiente para demostrarlas. Preferimos comunicar el origen y
				las condiciones de cada material con un alcance claro.
			</p>
		</div>
	</section>

	<!-- Preguntas frecuentes -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c4 flow" style="--flow:14px">
					<span class="card__icon">
						<CircleQuestionMark
							aria-hidden="true"
							size={20}
							stroke-width={1.75}
						/>
					</span>

					<h2>Preguntas frecuentes sobre nuestras maderas</h2>
				</div>

				<div class="c8">
					<div class="faq">
						{
							faqs.map((item) => (
								<details>
									<summary>{item.q}</summary>

									<div class="faq__answer">
										<p>{item.a}</p>
									</div>
								</details>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA final -->
	<section class="sect sect--last">
		<div class="wrap">
			<div class="page-cta page-cta--split">
				<div class="page-cta__text">
					<p class="eyebrow">Conoce el material</p>

					<h2>Una historia natural convertida en diseño</h2>

					<p class="measure">
						Descubre piezas de madera peruana que conservan la
						identidad del material y la transforman en objetos para
						la parrilla, la mesa, el hogar y la oficina. Cada veta
						es diferente. Cada pieza continúa una historia.
					</p>

					<p class="note">Diseñado y hecho en Lima, Perú.</p>
				</div>

				<div class="actions">
					<a href={productos} class="btn btn--primary">
						Explorar productos de madera
					</a>

					<a href={nosotros} class="sp-btn sp-btn--ghost">
						Conocer TAQTO
					</a>
				</div>
			</div>
		</div>
	</section>
</PageLayout>

