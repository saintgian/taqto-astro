---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import { buildFaqJsonLd } from "../lib/seo";
import {
	MapPin,
	Truck,
	ScanLine,
	CreditCard,
	TriangleAlert,
	CircleQuestionMark,
} from "@lucide/astro";

const base = import.meta.env.BASE_URL;
const productos = `${base}categorias/`;

const wa = "https://wa.me/51977600400";

/*
 * Resumen de cobertura. Los cuatro datos provienen del contenido real
 * de la página; antes vivían en una rejilla de tarjetas que repetía
 * lo explicado más abajo.
 */
const cobertura = [
	{
		icon: MapPin,
		label: "Lima Metropolitana",
		value: "2 días hábiles",
		hint: "Entrega estimada desde la confirmación del pago.",
	},
	{
		icon: Truck,
		label: "Provincias",
		value: "Agencia a tu elección",
		hint: "El tiempo de traslado depende del destino.",
	},
	{
		icon: ScanLine,
		label: "Productos personalizados",
		value: "Producción extra",
		hint: "El grabado láser puede requerir días adicionales.",
	},
	{
		icon: CreditCard,
		label: "Costo del envío",
		value: "Tarifa plana",
		hint: "En Lima y provincia.",
	},
];

const datosProvincia = [
	"El producto o los productos elegidos.",
	"La cantidad de unidades.",
	"La ciudad y provincia de destino.",
	"La agencia de tu preferencia.",
	"La personalización solicitada, cuando corresponda.",
];

const pedido = [
	{
		title: "Elige tu producto",
		text: "Explora el catálogo y selecciona la pieza, medida o presentación que prefieras.",
	},
	{
		title: "Confirma los detalles",
		text: "Coordinamos el destino, la cantidad, la personalización y las condiciones del pedido.",
	},
	{
		title: "Realiza el pago",
		text: "El plazo de preparación comienza después de la confirmación del pago.",
	},
	{
		title: "Aprobamos la personalización",
		text: "Cuando el producto incluye grabado, revisamos contigo el texto, logo, imagen o propuesta visual antes de producirlo.",
	},
	{
		title: "Preparamos tu pedido",
		text: "La pieza se fabrica o acondiciona y se embala según su material, tamaño y características.",
	},
	{
		title: "Coordinamos el envío",
		text: "Te informamos el costo y la modalidad antes de confirmar el despacho.",
	},
];

const datosIncidencia = [
	"Nombre de la persona que realizó el pedido.",
	"Producto recibido.",
	"Descripción de la incidencia.",
	"Fotografías claras del producto y del embalaje.",
	"Información del envío o agencia utilizada.",
];

const faqs = [
	{
		q: "¿Cuánto demora un pedido en Lima Metropolitana?",
		a: "El plazo estimado es de dos días hábiles desde la confirmación del pago. Si el producto incluye grabado personalizado, pueden añadirse días de producción, los cuales se informarán antes de confirmar el pedido.",
	},
	{
		q: "¿Realizan envíos a provincias?",
		a: "Sí. Realizamos envíos a provincias mediante la agencia que el cliente elija.",
	},
	{
		q: "¿Puedo elegir la agencia de transporte?",
		a: "Sí. Puedes indicarnos la agencia de tu preferencia al momento de coordinar el pedido.",
	},
	{
		q: "¿Cuánto demora un envío a provincias?",
		a: "El tiempo depende de la ciudad de destino y de las condiciones de la agencia seleccionada. TAQTO coordina la preparación y el despacho, mientras que el tiempo de traslado depende de la agencia.",
	},
	{
		q: "¿Cuánto cuesta el envío?",
		a: "El costo depende del destino, el tamaño del pedido y la modalidad de entrega. Te informaremos el monto antes de confirmar la compra.",
	},
	{
		q: "¿Desde cuándo se cuenta el plazo de entrega?",
		a: "El plazo comienza después de la confirmación del pago. En productos personalizados también debe considerarse el tiempo de aprobación y producción del grabado.",
	},
	{
		q: "¿El grabado puede aumentar el tiempo de entrega?",
		a: "Sí. El grabado láser requiere una etapa adicional de revisión y producción. Te indicaremos el plazo estimado antes de iniciar el pedido.",
	},
	{
		q: "¿Debo aprobar el grabado antes de la producción?",
		a: "Sí. Antes de producir la pieza se confirma el texto, nombre, frase, imagen, logo o propuesta visual correspondiente.",
	},
	{
		q: "¿Qué ocurre si escribí incorrectamente un nombre o una fecha?",
		a: "La información aprobada por el cliente será utilizada para producir el grabado. Por eso, recomendamos revisar cuidadosamente nombres, fechas, ortografía y demás detalles antes de confirmar.",
	},
	{
		q: "¿Cómo puedo consultar el envío de un producto?",
		a: "Puedes escribirnos por WhatsApp indicando el producto que deseas, la cantidad y tu ciudad o distrito de entrega.",
	},
	{
		q: "¿Qué sucede si el pedido presenta una incidencia?",
		a: "Debes comunicarte con TAQTO y enviar la información y fotografías del caso. Evaluaremos si la incidencia es atribuible al producto o a la entrega y coordinaremos la solución correspondiente cuando aplique.",
	},
];

const faqJsonLd = buildFaqJsonLd(faqs);
const shippingPageJsonLd = faqJsonLd ? [faqJsonLd] : [];
---

<PageLayout
	title="Envíos en Lima y provincias | TAQTO"
	description="Conoce los tiempos de entrega de TAQTO en Lima Metropolitana y provincias, costos de envío, pedidos personalizados y coordinación por WhatsApp."
	jsonLd={shippingPageJsonLd}
>
	<PageHero
		eyebrow="Envíos y entregas"
		title="Envíos de TAQTO en Lima y provincias"
		lede="Preparamos cada pedido con cuidado y te informamos el plazo, la modalidad y el costo del envío antes de confirmarlo."
		split="7-5"
	>
		<p class="lede measure-lede" style="margin-top:14px">
			Realizamos entregas en Lima Metropolitana y envíos a provincias
			mediante la agencia que el cliente elija. Las piezas con grabado
			personalizado pueden requerir días adicionales de producción.
		</p>

		<div class="actions">
			<a
				href={wa}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn--primary"
			>
				Consultar mi envío
			</a>

			<a href={productos} class="sp-btn sp-btn--ghost">
				Explorar productos
			</a>
		</div>

		<p class="note">
			El costo del envío se informa antes de confirmar el pedido.
		</p>

		<div slot="aside">
			<p class="facts-caption">Resumen de cobertura</p>

			<ul class="facts">
				{
					cobertura.map((item) => {
						const Icon = item.icon;

						return (
							<li>
								<Icon
									class="facts__icon"
									aria-hidden="true"
									size={20}
									stroke-width={1.75}
								/>

								<div>
									<p class="facts__label">{item.label}</p>
									<p class="facts__value">{item.value}</p>
									<p class="facts__hint">{item.hint}</p>
								</div>
							</li>
						);
					})
				}
			</ul>
		</div>
	</PageHero>

	<!-- Coordinación: encabezado 5 + explicación 7 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c5">
					<h2>Tu pedido, coordinado con claridad</h2>
				</div>

				<div class="c7 flow measure" style="--flow:15px">
					<p>
						Cada pieza TAQTO requiere una preparación acorde con su
						material, tamaño y características.
					</p>

					<p>
						Por eso, antes de confirmar tu pedido, revisamos contigo
						el producto elegido, la personalización cuando
						corresponda, el destino y la modalidad de envío.
					</p>

					<p>
						Nuestro objetivo es que conozcas las condiciones de
						entrega desde el inicio, sin costos inesperados ni
						información ambigua.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Cobertura por destino: dos bloques de 6 columnas -->
	<section class="sect sect--tint">
		<div class="wrap">
			<div class="g12">
				<section class="c6 flow" style="--flow:15px">
					<h2>Entregas en Lima Metropolitana</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Los pedidos con entrega en Lima Metropolitana
							tienen un plazo estimado de dos días hábiles desde
							la confirmación del pago.
						</p>

						<p>
							Este plazo corresponde a productos disponibles que
							no requieren tiempo adicional de personalización.
							Cuando una pieza incluye un nombre, frase, imagen o
							logo grabado, te indicaremos previamente los días
							de producción correspondientes.
						</p>
					</div>

					<ul class="list">
						<li>
							El plazo comienza después de la confirmación del
							pago.
						</li>

						<li>
							En productos personalizados, el tiempo total
							considera la aprobación del grabado, la producción
							de la pieza y la posterior coordinación de la
							entrega.
						</li>
					</ul>

					<p class="note">
						Indícanos el producto y el distrito de entrega para
						orientarte.
					</p>
				</section>

				<section class="c6 flow" style="--flow:15px">
					<h2>Envíos a provincias del Perú</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Realizamos envíos a provincias mediante la agencia
							que el cliente elija.
						</p>

						<p>
							El tiempo de traslado depende de la ciudad de
							destino, la cobertura y las condiciones de la
							agencia seleccionada. Antes de confirmar el pedido,
							te informaremos el costo y coordinaremos contigo
							los datos necesarios para el despacho.
						</p>

						<p class="strong-line">
							Para ayudarte necesitaremos conocer:
						</p>
					</div>

					<ul class="list">
						{datosProvincia.map((item) => <li>{item}</li>)}
					</ul>

					<p class="pull">
						No realizamos el despacho sin que conozcas previamente
						la modalidad y el costo del envío.
					</p>

					<div class="actions">
						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="sp-btn sp-btn--ghost"
						>
							Consultar envío a mi ciudad
						</a>
					</div>
				</section>
			</div>
		</div>
	</section>

	<!-- Grabado láser: relato 7 + advertencia 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<h2>¿Tu pedido incluye grabado láser?</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							Las piezas personalizadas requieren una etapa
							adicional de revisión y producción.
						</p>

						<p>
							Antes de iniciar el grabado, confirmaremos contigo
							el nombre, frase, imagen, logo o propuesta visual
							que se aplicará sobre el producto.
						</p>

						<p>
							La posibilidad de realizar el grabado dependerá del
							espacio disponible, el material, la legibilidad y
							las características del diseño.
						</p>

						<p>
							Una vez aprobada la personalización, te
							informaremos el plazo estimado de producción y
							entrega.
						</p>
					</div>
				</div>

				<div class="c5">
					<p class="pull">
						Revisa cuidadosamente nombres, fechas, frases,
						ortografía y detalles del diseño antes de aprobar la
						personalización.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Proceso completo del pedido -->
	<section class="sect">
		<div class="wrap">
			<div class="sect__head">
				<h2>Del producto elegido hasta la entrega</h2>

				<p class="lede measure-lede">
					Seis pasos, desde que eliges la pieza hasta que sale del
					taller.
				</p>
			</div>

			<ProcessSteps steps={pedido} cols={3} />
		</div>
	</section>

	<!-- Embalaje y costo: dos bloques de 6 columnas -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<section class="c6 flow" style="--flow:15px">
					<h2>Preparado de acuerdo con cada producto</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							Las piezas de madera y cuero requieren una
							preparación adecuada para su traslado.
						</p>

						<p>
							El embalaje se adapta al tamaño, material y
							características del producto para protegerlo
							durante el proceso de entrega.
						</p>

						<p>
							En los pedidos personalizados también verificamos
							que la información coordinada corresponda con el
							grabado aprobado antes del despacho.
						</p>
					</div>

					<p class="pull">
						Cada pedido se prepara de forma individual, de acuerdo
						con las características reales de la pieza.
					</p>
				</section>

				<section class="c6 flow" style="--flow:15px">
					<h2>Conoce el costo antes de confirmar</h2>

					<div class="flow measure-tight" style="--flow:14px">
						<p>
							El costo del envío depende del destino, el tamaño
							del pedido y la modalidad de entrega seleccionada.
						</p>

						<p>
							Antes de confirmar tu compra recibirás la
							información correspondiente al producto, la
							personalización cuando aplique y el costo del
							envío.
						</p>

						<p>
							Así podrás revisar las condiciones y el monto total
							antes de realizar la confirmación final.
						</p>
					</div>

					<p class="pull">
						Sin costos de envío inesperados: conocerás el monto
						antes de confirmar tu pedido.
					</p>
				</section>
			</div>
		</div>
	</section>

	<!-- Incidencias: explicación 7 + acción 5 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c7 flow" style="--flow:15px">
					<h2>¿Tu pedido presentó una incidencia?</h2>

					<div class="flow measure" style="--flow:15px">
						<p>
							Si al recibir tu pedido identificas algún problema
							atribuible al producto o a la entrega, comunícate
							con TAQTO para que podamos evaluar el caso.
						</p>

						<p>
							Revisaremos la información disponible y
							coordinaremos la solución correspondiente cuando la
							incidencia sea atribuible al producto o al proceso
							de entrega.
						</p>
					</div>
				</div>

				<div class="c5 flow" style="--flow:16px">
					<div class="card">
						<span class="card__icon">
							<TriangleAlert
								aria-hidden="true"
								size={20}
								stroke-width={1.75}
							/>
						</span>

						<h3 class="card__title card__title--sm">
							Qué información debes enviarnos
						</h3>

						<ul class="list">
							{datosIncidencia.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<div class="actions">
						<a
							href={wa}
							target="_blank"
							rel="noopener noreferrer"
							class="sp-btn sp-btn--ghost"
						>
							Reportar una incidencia
						</a>
					</div>

					<p class="note">
						Conserva el producto y el embalaje mientras evaluamos
						el caso.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Preguntas frecuentes: encabezado 4 + acordeón 8 -->
	<section class="sect">
		<div class="wrap">
			<div class="g12">
				<div class="c4 flow" style="--flow:14px">
					<span class="card__icon">
						<CircleQuestionMark
							aria-hidden="true"
							size={20}
							stroke-width={1.75}
						/>
					</span>

					<h2>Preguntas frecuentes sobre envíos</h2>
				</div>

				<div class="c8">
					<div class="faq">
						{
							faqs.map((item) => (
								<details>
									<summary>{item.q}</summary>

									<div class="faq__answer">
										<p>{item.a}</p>
									</div>
								</details>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA final -->
	<section class="sect sect--last">
		<div class="wrap">
			<div class="page-cta page-cta--split">
				<div class="page-cta__text">
					<p class="eyebrow">¿Tienes un destino en mente?</p>

					<h2>
						Confirma las condiciones de tu envío antes de realizar
						el pedido
					</h2>

					<p class="measure">
						Cuéntanos qué producto deseas y dónde debemos
						entregarlo. Te ayudaremos a revisar el plazo estimado,
						la personalización, la modalidad disponible y el costo
						del envío.
					</p>

					<p class="note">
						Indícanos el producto, la cantidad y tu ciudad o
						distrito de entrega.
					</p>
				</div>

				<div class="actions">
					<a
						href={wa}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn--primary"
					>
						Consultar mi envío por WhatsApp
					</a>

					<a href={productos} class="sp-btn sp-btn--ghost">
						Explorar productos TAQTO
					</a>
				</div>
			</div>
		</div>
	</section>
</PageLayout>
